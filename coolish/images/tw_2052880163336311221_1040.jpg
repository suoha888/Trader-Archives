ult:$R[102]={__typename:"User",avatar:$R[103]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[104]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[105]={},privacy:$R[106]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[107]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[108]={tweets:4183},verification:$R[109]={is_blue_verified:!0}}}},counts:$R[110]={bookmark_count:132,favorite_count:169,quote_count:7,reply_count:61,retweet_count:13},details:$R[111]={cashtag_entities:$R[112]=[],created_at_ms:1778279746000,display_text_range:$R[113]=[0,162],full_text:"通宵手搓了个逆天的全网首创“X Skill”，\n去睡前先大致说下：\n实时语音Agent，不仅能拉它上 X Space 跟多人语音，\n而且还能在语音中，光动嘴就指挥它在 X 上“做事”。\n\n如图1，在实时语音中，\n我（或者甚至其他发言人）可以跟Agent说：\n\n“你搜一下 X 上关于减肥针风险的推文，\n把最靠谱的推文 URL https://t.co/zFkuidOQbT",hashtag_entities:$R[114]=[],smarttags:$R[115]=[],timestamp_entities:$R[116]=[]},edit_control:$R[117]={__typename:"EditControlInitial",edit_tweet_ids:$R[118]=["2052880163336311221"]},grok_translated_post_with_availability:$R[119]={is_available:!1},id:"VHdlZXQ6MjA1Mjg4MDE2MzMzNjMxMTIyMQ==",legacy:$R[120]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[121]=[$R[122]={allow_download_status:$R[123]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2052880163336311221/photo/1",ext_media_availability:$R[124]={status:"Available"},ext_playlists:$R[125]=[],features:$R[126]={},id_str:"2052876863853465600",indices:$R[127]=[163,186],media_url_https:"https://pbs.twimg.com/media/HH1IoY2akAAJ_yc.jpg",original_info:$R[128]={height:966,width:1216},type:"photo"},$R[129]={allow_download_status:$R[130]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2052880163336311221/photo/1",ext_media_availability:$R[131]={status:"Available"},ext_playlists:$R[132]=[],features:$R[133]={},id_str:"2052876939573252096",indices:$R[134]=[163,186],media_url_https:"https://pbs.twimg.com/media/HH1Isy7a0AA-JgA.jpg",original_info:$R[135]={height:1236,width:1178},type:"photo"},$R[136]={allow_download_status:$R[137]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2052880163336311221/photo/1",ext_media_availability:$R[138]={status:"Available"},ext_playlists:$R[139]=[],features:$R[140]={},id_str:"2052879435054092288",indices:$R[141]=[163,186],media_url_https:"https://pbs.twimg.com/media/HH1K-DUakAADR72.jpg",original_info:$R[142]={height:3515,width:3110},type:"photo"}],mention_entities:$R[143]=[],note_tweet:$R[144]={is_expandable:!0,note_tweet_results:$R[145]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODgwMTYzMjczMzY3NTUy",result:$R[146]={__typename:"NoteTweet",entity_set:$R[147]={hashtags:$R[148]=[],smarttags:$R[149]=[],symbols:$R[150]=[],urls:$R[151]=[],user_mentions:$R[152]=[]},id:"Tm90ZVR3ZWV0OjIwNTI4ODAxNjMyNzMzNjc1NTI=",rest_id:"2052880163273367552",text:"通宵手搓了个逆天的全网首创“X Skill”，\n去睡前先大致说下：\n实时语音Agent，不仅能拉它上 X Space 跟多人语音，\n而且还能在语音中，光动嘴就指挥它在 X 上“做事”。\n\n如图1，在实时语音中，\n我（或者甚至其他发言人）可以跟Agent说：\n\n“你搜一下 X 上关于减肥针风险的推文，\n把最靠谱的推文 URL 发到这个 Space 下的评论区。”\n\n然后它就真的做到了！（图2）\n\n核心是：\nGrok 的各个模型，包括实时语音模型API，\n都具有自然语言发起“Function Calling”的能力\n（图3）\n用这个去调用 X 账号的OAuth，那么就相当于：\n\n利用 Grok API 原生自带对 X 的自然语义检索能力\n乘以\nX API的读写能力（发推甚至发私信）\n\n这两个互相一乘，可玩空间太大了。\n\n不得不说，\nOpenAI GPT-Realtime-2 实时语音模型再好，\n可是架不住\nGrok Realtime API 实时语音API能玩转X啊。\n\n三言两语说的不是很清楚，\n后续我再让 Codex 整理个更清楚的说明书。\n\n明后天我可以找时间另开 Space 公开演示说明。"}}},rest_id:"2052880163336311221",url_entities:$R[153]=[],views:$R[154]={count:"56804"}}}}},entry_id:"tweet-2052880163336311221",sort_index:"2103760846961246208"},$R[155]={content:$R[156]={__typename:"TimelineTimelineModule",client_event_info:$R[157]={component:"tweet"},display_type:"VerticalConversation",items:$R[158]=[$R[159]={entry_id:"conversationthread-2052905960981897506-tweet-2052905960981897506",item:$R[160]={__typename:"TimelineTimelineItem",client_event_info:$R[161]={component:"tweet",details:$R[162]={conversation_details:$R[163]={co