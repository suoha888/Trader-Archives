full_text:"@BlockChainChad Close, but OXBT stands for:\n\nO - Ordinal\nXBT - First Perpetual Futures for Bitcoin from @BitMEX in 2016 were stated as 'XBT/USD' \n\n$OXBT is inscribed on an uncommon sat from 2014 - the year BitMEX was founded ;)\n\nWe are big fans of @CryptoHayes",hashtag_entities:$R[108]=[],smarttags:$R[109]=[],timestamp_entities:$R[110]=[]},edit_control:$R[111]={__typename:"EditControlInitial",edit_tweet_ids:$R[112]=["1662535538014928896"]},grok_translated_post_with_availability:$R[113]={is_available:!1},id:"VHdlZXQ6MTY2MjUzNTUzODAxNDkyODg5Ng==",legacy:$R[114]={},media_entities2:$R[115]=[],mention_entities:$R[116]=[$R[117]={id_str:"1231279521304891394",indices:$R[118]=[0,15],screen_name:"BlockChainChad"},$R[119]={id_str:"2439495535",indices:$R[120]=[104,111],screen_name:"BitMEX"},$R[121]={id_str:"983993370048630785",indices:$R[122]=[248,260],screen_name:"CryptoHayes"}],reply_to_results:$R[123]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE2NjI1MjQ2MzAwNjQ1OTA4NDk=",rest_id:"1662524630064590849"},reply_to_user_results:$R[124]={id:"VXNlclJlc3VsdHM6MTIzMTI3OTUyMTMwNDg5MTM5NA==",rest_id:"1231279521304891394",result:$R[125]={__typename:"User",core:$R[126]={screen_name:"BlockChainChad"},id:"VXNlcjoxMjMxMjc5NTIxMzA0ODkxMzk0",rest_id:"1231279521304891394"}},rest_id:"1662535538014928896",url_entities:$R[127]=[],views:$R[128]={count:"71132"}}},rest_id:"1663655466420035584",url_entities:$R[129]=[],views:$R[130]={count:"12296"}}}}}}}],graphqlRequestStream:$R[131]=($R[132]=(stream) => new ReadableStream({ start(controller) {
