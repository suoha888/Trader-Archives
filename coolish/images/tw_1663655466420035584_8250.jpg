_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410653247,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀coolish",u:1790410653247,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀coolish␀status␀1663655466420035584␀{}",u:1790410653597,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg",authorDescription:void 0,authorName:"paulwei",focalTweetId:"1663655466420035584",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1663655466420035584",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"paulwei profile picture",url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg"},screenName:"coolish",url:"https://x.com/coolish"},bodyText:"OXBT 这个名字，包含 Bitgod 对 Bitmex 的致敬。\n是Bitmex发明了永续合约这个币圈拳头产品。\n刚刚发现，Bitmex也上线了 $ordi 50x永续合约。不过成交量实在清淡，也几乎没人谈论此事。唏嘘，曾经的王者交易所。\n\nThe name OXBT is a tribute to Bitmex by @BitGod21. Bitmex invented perpetual contracts.\nJust discovered that Bitmex has also launched a 50x perpetual contract for $ordi. However, the trading volume is currently quite low, and there is hardly any discussion about it. \nIt's nostalgic to see the former king of exchanges in such a state.\n#BRC20",canonicalPath:"/coolish/status/1663655466420035584",canonicalUrl:"https://x.com/coolish/status/1663655466420035584",description:"OXBT 这个名字，包含 Bitgod 对 Bitmex 的致敬。\n是Bitmex发明了永续合约这个币圈拳头产品。\n刚刚发现，Bitmex也上线了 $ordi 50x永续合约。不过成交量实在清淡，也几乎没人谈论此事。唏嘘，曾经的王者交易所。\n\nThe name OXBT is a tribute to Bitmex by @BitGod21. Bitmex invented perpetual contracts.\nJust discovered that Bitmex has also launched a 50x perpetual contract for $ordi. However, the trading volume is currently quite low, and there is hardly any discussion about it. \nIt's nostalgic to see the former king of exchanges in such a state.\n#BRC20",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:114,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/FxZ9uvFaUAAMUmR?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/FxZ9uvFaUAAMUmR?format=webp&name=small 680w, https://pbs.twimg.com/media/FxZ9uvFaUAAMUmR?format=webp&name=medium 1200w, https://pbs.twimg.com/media/FxZ9uvFaUAAMUmR?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/FxZ9uvFaUAAMUmR?format=webp&name=large",width:255},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2023-05-30T21:15:47.000Z",replyCount:2,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/BitGod21/status/1662535538014928896","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"BitGod21",identifier:"1638724648576622593",image:"https://pbs.twimg.com/profile_images/2029162098421542912/MTbTKudL_400x400.jpg",name:"BG",url:"https://x.com/BitGod21"},datePublished:"2023-05-27T19:05:35.000Z",identifier:"1662535538014928896",url:"https://x.com/BitGod21/status/1662535538014928896",engagement:$R[17]=[$R[18]={action:"LikeAction",name:"Likes",url:"https://x.com/BitGod21/status/1662535538014928896/likes",count:771},$R[19]={action:"ShareAction",name:"Retweets",url:"https://x.com/BitGod21/status/1662535538014928896/retweets",count:174},$R[20]={action:"ReplyAction",name:"Replies",url:null,count:76},$R[21]={action:"ViewAction",name:"Views",count:71132}],text:"@BlockChainChad Close, but OXBT stands for:\n\nO - Ordinal\nXBT - First Perpetual Futures for Bitcoin from @BitMEX in 2016 were stated as 'XBT/USD' \n\n$OXBT is inscribed on an uncommon sat from 2014 - the year BitMEX was founded ;)\n\nWe are big fans of @CryptoHayes"}},socialTitle:"paulwei (@coolish) on X",title:"paulwei on X: \"OXBT 这个名字，包含 Bitgod 对 Bitmex 的致敬。\n是Bitmex发明了永续合约这个币圈拳头产品。\n刚刚发现，Bitmex也上线了 $ordi 50x永续合约。不过成交量实在清淡，也几乎没人谈论此事。唏嘘，曾经的王者交易所。\n\nThe name OXBT is a tribute to Bitmex by @BitGod21. Bitmex invented perpetual contracts.\nJust discovered that Bitmex has also launched a 50x perpetual contract for $ordi. However, the trading volume is currently quite low, and there is hardly any discussion about it. \nIt's nostalgic to see the former king of exchanges in such a state.\n#BRC20\""},replyCount:2,screenName:"coolish",status:"available",text:"OXBT 这个名字，包含 Bitgod 对 Bitmex 的致敬。\n是Bitmex发明了永续合约这个币圈拳头产品。\n刚刚发现，Bitmex也上线了 $ordi 50x永续合约。不过成交量实在清淡，也几乎没人谈论此事。唏嘘，曾经的王者交易所。\n\nThe name OXBT is a tribute to Bitmex by @BitGod21. Bitmex invented perpetual contracts.\nJust discovered that Bitmex has also launched a 50x perpetual contract for $ordi. However, the trading volume is currently quite low, and there is hardly any discussion about it. \nIt's nostalgic to see the former king of exchanges in such a state.\n#BRC20"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[22]={messagesBeforeDehydration:$R[23]=[$R[24]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1663655466420035584\"}",name:"TweetResultByRestId"},$R[25]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1663655466420035584\"}",result:$R[26]={kind:"Result.Ok",value:$R[27]={data:$R[28]={tweet_result_by_rest_id:$R[29]={id:"VHdlZXRSZXN1bHRzOjE2NjM2NTU0NjY0MjAwMzU1ODQ=",rest_id:"1663655466420035584",result:$R[30]={__typename:"Tweet",cashtag_attachments:$R[31]=[],core:$R[32]={user_results:$R[33]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[34]={__typename:"User",avatar:$R[35]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[36]={na