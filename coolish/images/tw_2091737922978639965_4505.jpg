,220 71,1 229,254 h 219 s 40,94 171,244" fill="#1d9bf008"></path></g></svg><svg viewBox="0 0 24 24" id="loading-x-anim-3" aria-hidden="true" class="r-1p0dtai r-13gxpu9 r-4qtqp9 r-yyyyoo r-wy61xf r-1d2f490 r-bqkkf0 r-ywje51 r-dnmrzs r-u8s1d r-zchlnj r-1plcrui r-ipm5af r-lrvibr r-1blnp2b"><g><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path><path d="M 10,30 C 69,202 160,199 49,96 h 187 s 202,145 198,155 C 76,207 117,30 103,83 h 130 s 136,169 80,214 C 127,143 102,35 59,31 h 251 s 51,4 46,50 C 147,138 103,26 245,239 h 66 s 227,111 230,49 C 71,98 142,81 255,5 h 211 s 150,37 111,19 C 230,50 234,228 54,156 h 162 s 208,160 96,198 C 89,244 151,38 149,147 h 199 s 160,124 148,176 C 198,146 6,174 164,101 h 109 s 45,227 203,77 C 96,35 184,78 129,209 h 113 s 236,129 187,87 C 175,84 98,10 213,9 h 198 s 234,78 64,180 C 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="tridelglhpSZqATr6UFF+A==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="tridelglhpSZqATr6UFF+A==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410649655,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀coolish",u:1790410649655,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀coolish␀status␀2091737922978639965␀{}",u:1790410649978,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg",authorDescription:void 0,authorName:"paulwei",focalTweetId:"2091737922978639965",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=2091737922978639965",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"paulwei profile picture",url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg"},screenName:"coolish",url:"https://x.com/coolish"},bodyText:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/lUMvTHTMBi\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构，\n上方：主图。\n显示BTC历史订单和成交，\n居然能把所有历史订单，通过横线宽度，\n来表示买卖订单从什么时候开始挂到哪，\n什么时候订单撤销/成交\n（虚线和实线代表最后是否成交），\n9个月来的历史订单调整过程和结果，\n用创新的可视化一目了然。\n纳入了时光机的理念。\n可指针筛选所处时间点的订单，\n可筛选显示主动成交标记。\n\n中间：仓位杠杆率曲线图。\n绿色/红色柱曲线，分别体现\n此时间段做多/做空+仓位轻重。\n黄色柱代表此时仓位轻重超过100%账号资金，处于杠杆状态。\n“当下持仓是多少”胜过千言万语。这也是我近两年越来越少发 BTC价格行情观点推文的原因。因为当你可以只需要通过一个URL就能在几秒钟内访问看到我的实时实盘仓位（无需app无需登录），那就不需要用文字再去说了。\n\n下方：累计盈亏。\n可切换USD 或 BTC 不同本位。\n\n这个上、中、下3层，依顺序其实就是\n上：在什么市场环境下\n中：调整成什么仓位姿势去迎接\n下：获得什么样的结果\n\n这个产品的设计巧思，创新展现方式，\n不谋而合地抓住了我很久以来心里所想的，\n一个真实用的交易实盘信息面板，\n尤其是长期交易实盘，所应该体现的重点。\n不是只有当下快照、一行行列表，\n或者像给资深工程师科学家看的那种，\n眼花但其实没什么卵用的统计数字。\n这是\n真在交易的人，真有持续思考交易的人，\n而且还懂产品，才做得出的产品。\n这以至于让我有一种\n像被使了读心术的感动和爽。\n\n这事后看上去好像不是很复杂？\n但为什么之前的实盘平台，\n没有过这种设计？\n后视镜去看总觉得简单，\n但在事前的无数选项中，\n去做这种减法筛选是最难的。",canonicalPath:"/coolish/status/2091737922978639965",canonicalUrl:"https://x.com/coolish/status/2091737922978639965",description:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/lUMvTHTMBi\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构，\n上方：主图。\n显示BTC历史订单和成交，\n居然能把所有历史订单，通过横线宽度，\n来表示买卖订单从什么时候开始挂到哪，\n什么时候订单撤销/成交\n（虚线和实线代表最后是否成交），\n9个月来的历史订单调整过程和结果，\n用创新的可视化一目了然。\n纳入了时光机的理念。\n可指针筛选所处时间点的订单，\n可筛选显示主动成交标记。\n\n中间：仓位杠杆率曲线图。\n绿色/红色柱曲线，分别体现\n此时间段做多/做空+仓位轻重。\n黄色柱代表此时仓位轻重超过100%账号资金，处于杠杆状态。\n“当下持仓是多少”胜过千言万语。这也是我近两年越来越少发 BTC价格行情观点推文的原因。因为当你可以只需要通过一个URL就能在几秒钟内访问看到我的实时实盘仓位（无需app无需登录），那就不需要用文字再去说了。\n\n下方：累计盈亏。\n可切换USD 或 BTC 不同本位。\n\n这个上、中、下3层，依顺序其实就是\n上：在什么市场环境下\n中：调整成什么仓位姿势去迎接\n下：获得什么样的结果\n\n这个产品的设计巧思，创新展现方式，\n不谋而合地抓住了我很久以来心里所想的，\n一个真实用的交易实盘信息面板，\n尤其是长期交易实盘，所应该体现的重点。\n不是只有当下快照、一行行列表，\n或者像给资深工程师科学家看的那种，\n眼花但其实没什么卵用的统计数字。\n这是\n真在交易的人，真有持续思考交易的人，\n而且还懂产品，才做得出的产品。\n这以至于让我有一种\n像被使了读心术的感动和爽。\n\n这事后看上去好像不是很复杂？\n但为什么之前的实盘平台，\n没有过这种设计？\n后视镜去看总觉得简单，\n但在事前的无数选项中，\n去做这种减法筛选是最难的。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:1168,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/HQdJvnuaMAAgNDC?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/HQdJvnuaMAAgNDC?format=webp&name=small 680w, https://pbs.twimg.com/media/HQdJvnuaMAAgNDC?format=webp&name=medium 1200w, https://pbs.twimg.com/media/HQdJvnuaMAAgNDC?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/HQdJvnuaMAAgNDC?format=webp&name=large",width:1200},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2026-08-24T04:02:38.000Z",replyCount:56,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/catseyeinstinct/status/2090853294436409618","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"catseyeinstinct",identifier:"905269666490220547",image:"https://pbs.twimg.com/profile_images/2090844595403808768/ZHhFgxX2_400x400.jpg",name:"猫眼观察员",url:"https://x.com/catseyeinstinct"},datePublished:"2026-08-21T17:27:26.000Z",identifier:"2090853294436409618",url:"https://x.com/catseyeinstinct/status/2090853294436409618",image:$R[17]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/HQQv7mZWgAAfFg2?format=webp&name=large",description:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/aKAWsI9q0y\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。\n\n把这些订单沿着时间轴串起来，我们就能看到整个仓位管理过程。\n\n过去我们看到的更多是结果，现在终于可以看到策略本身。\n\n欢迎来玩，也欢迎提需求🐈",height:1202,name:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/aKAWsI9q0y\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。\n\n把这些订单沿着时间轴串起来，我们就能看到整个仓位管理过程。\n\n过去我们看到的更多是结果，现在终于可以看到策略本身。\n\n欢迎来玩，也欢迎提需求🐈",thumbnailUrl:"https://pbs.twimg.com/media/HQQv7mZWgAAfFg2?format=webp&name=small",uploadDate:"2026-08-21T17:27:26.000Z",url:"https://pbs.twimg.com/media/HQQv7mZWgAAfFg2?format=webp&name=large",width:2542},engagement:$R[18]=[$R[19]={action:"LikeAction",name:"Likes",url:"https://x.com/catseyeinstinct/status/2090853294436409618/likes",count:178},$R[20]={action:"ShareAction",name:"Retweets",url:"https://x.com/catseyeinstinct/status/2090853294436409618/retweets",count:24},$R[21]={action:"ReplyAction",name:"Replies",url:null,count:17},$R[22]={action:"ViewAction",name:"Views",count:91961}],text:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/aKAWsI9q0y\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。\n\n把这些订单沿着时间轴串起来，我们就能看到整个仓位管理过程。\n\n过去我们看到的更多是结果，现在终于可以看到策略本身。\n\n欢迎来玩，也欢迎提需求🐈"}},socialTitle:"paulwei (@coolish) on X",title:"paulwei on X: \"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/lUMvTHTMBi\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构，\n上方：主图。\n显示BTC历史订单和成交，\n居然能把所有历史订单，通过横线宽度，\n来表示买卖订单从什么时候开始挂到哪，\n什么时候订单撤销/成交\n（虚线和实线代表最后是否成交），\n9个月来的历史订单调整过程和结果，\n用创新的可视化一目了然。\n纳入了时光机的理念。\n可指针筛选所处时间点的订单，\n可筛选显示主动成交标记。\n\n中间：仓位杠杆率曲线图。\n绿色/红色柱曲线，分别体现\n此时间段做多/做空+仓位轻重。\n黄色柱代表此时仓位轻重超过100%账号资金，处于杠杆状态。\n“当下持仓是多少”胜过千言万语。这也是我近两年越来越少发 BTC价格行情观点推文的原因。因为当你可以只需要通过一个URL就能在几秒钟内访问看到我的实时实盘仓位（无需app无需登录），那就不需要用文字再去说了。\n\n下方：累计盈亏。\n可切换USD 或 BTC 不同本位。\n\n这个上、中、下3层，依顺序其实就是\n上：在什么市场环境下\n中：调整成什么仓位姿势去迎接\n下：获得什么样的结果\n\n这个产品的设计巧思，创新展现方式，\n不谋而合地抓住了我很久以来心里所想的，\n一个真实用的交易实盘信息面板，\n尤其是长期交易实盘，所应该体现的重点。\n不是只有当下快照、一行行列表，\n或者像给资深工程师科学家看的那种，\n眼花但其实没什么卵用的统计数字。\n这是\n真在交易的人，真有持续思考交易的人，\n而且还懂产品，才做得出的产品。\n这以至于让我有一种\n像被使了读心术的感动和爽。\n\n这事后看上去好像不是很复杂？\n但为什么之前的实盘平台，\n没有过这种设计？\n后视镜去看总觉得简单，\n但在事前的无数选项中，\n去做这种减法筛选是最难的。\""},replyCount:56,screenName:"coolish",status:"available",text:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/lUMvTHTMBi\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构，\n上方：主图。\n显示BTC历史订单和成交，\n居然能把所有历史订单，通过横线宽度，\n来表示买卖订单从什么时候开始挂到哪，\n什么时候订单撤销/成交\n（虚线和实线代表最后是否成交），\n9个月来的历史订单调整过程和结果，\n用创新的可视化一目了然。\n纳入了时光机的理念。\n可指针筛选所处时间点的订单，\n可筛选显示主动成交标记。\n\n中间：仓位杠杆率曲线图。\n绿色/红色柱曲线，分别体现\n此时间段做多/做空+仓位轻重。\n黄色柱代表此时仓位轻重超过100%账号资金，处于杠杆状态。\n“当下持仓是多少”胜过千言万语。这也是我近两年越来越少发 BTC价格行情观点推文的原因。因为当你可以只需要通过一个URL就能在几秒钟内访问看到我的实时实盘仓位（无需app无需登录），那就不需要用文字再去说了。\n\n下方：累计盈亏。\n可切换USD 或 BTC 不同本位。\n\n这个上、中、下3层，依顺序其实就是\n上：在什么市场环境下\n中：调整成什么仓位姿势去迎接\n下：获得什么样的结果\n\n这个产品的设计巧思，创新展现方式，\n不谋而合地抓住了我很久以来心里所想的，\n一个真实用的交易实盘信息面板，\n尤其是长期交易实盘，所应该体现的重点。\n不是只有当下快照、一行行列表，\n或者像给资深工程师科学家看的那种，\n眼花但其实没什么卵用的统计数字。\n这是\n真在交易的人，真有持续思考交易的人，\n而且还懂产品，才做得出的产品。\n这以至于让我有一种\n像被使了读心术的感动和爽。\n\n这事后看上去好像不是很复杂？\n但为什么之前的实盘平台，\n没有过这种设计？\n后视镜去看总觉得简单，\n但在事前的无数选项中，\n去做这种减法筛选是最难的。"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[23]={messagesBeforeDehydration:$R[24]=[$R[25]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"2091737922978639965\"}",name:"TweetResultByRestId"},$R[26]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"2091737922978639965\"}",result:$R[27]={kind:"Result.Ok",value:$R[28]={data:$R[29]={tweet_result_by_rest_id:$R[30]={id:"VHdlZXRSZXN1bHRzOjIwOTE3Mzc5MjI5Nzg2Mzk5NjU=",rest_id:"2091737922978639965",result:$R[31]={__typename:"Tweet",cashtag_attachments:$R[32]=[],core:$R[33]={user_results:$R[34]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[35]={__typename:"User",avatar:$R[36]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[37]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[38]={},privacy:$R[39]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[40]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[41]={tweets:4183},verification:$R[42]={is_blue_verified:!0}}}},counts:$R[43]={bookmark_count:524,favorite_count:485,quote_count:3,reply_count:56,retweet_count:72},details:$R[44]={cashtag_entities:$R[45]=[],created_at_ms:1787544158000,display_text_range:$R[46]=[0,175],full_text:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/MUA6Ph8QBA\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构， https://t.co/monJV3N5Mb",hashtag_entities:$R[47]=[],smarttags:$R[48]=[],timestamp_entities:$R[49]=[]},edit_control:$R[50]={__typename:"EditControlInitial",edit_tweet_ids:$R[51]=["2091737922978639965"]},grok_translated_post_with_availability:$R[52]={is_available:!1},id:"VHdlZXQ6MjA5MTczNzkyMjk3ODYzOTk2NQ==",legacy:$R[53]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[54]=[$R[55]={expanded_url:"https://x.com/coolish/status/2091737922978639965/photo/1",ext_media_availability:$R[56]={status:"Available"},ext_playlists:$R[57]=[],features:$R[58]={},id_str:"2091721634403201024",indices:$R[59]=[176,199],media_url_https:"https://pbs.twimg.com/media/HQdJvnuaMAAgNDC.jpg",original_info:$R[60]={height:1168,width:1200},type:"photo"}],mention_entities:$R[61]=[$R[62]={id_str:"905269666490220547",indices:$R[63]=[87,103],screen_name:"catseyeinstinct"}],note_tweet:$R[64]={is_expandable:!0,note_tweet_results:$R[65]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDkxNzM3OTIyNjY4Mjk4MjQw",result:$R[66]={__typename:"NoteTweet",entity_set:$R[67]={hashtags:$R[68]=[],smarttags:$R[69]=[],symbols:$R[70]=[],timestamps:$R[71]=[],urls:$R[72]=[$R[73]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today",indices:$R[74]=[116,139],url:"https://t.co/lUMvTHTMBi"}],user_mentions:$R[75]=[$R[76]={id_str:"905269666490220547",indices:$R[77]=[87,103],screen_name:"catseyeinstinct"}]},id:"Tm90ZVR3ZWV0OjIwOTE3Mzc5MjI2NjgyOTgyNDA=",rest_id:"2091737922668298240",text:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/lUMvTHTMBi\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构，\n上方：主图。\n显示BTC历史订单和成交，\n居然能把所有历史订单，通过横线宽度，\n来表示买卖订单从什么时候开始挂到哪，\n什么时候订单撤销/成交\n（虚线和实线代表最后是否成交），\n9个月来的历史订单调整过程和结果，\n用创新的可视化一目了然。\n纳入了时光机的理念。\n可指针筛选所处时间点的订单，\n可筛选显示主动成交标记。\n\n中间：仓位杠杆率曲线图。\n绿色/红色柱曲线，分别体现\n此时间段做多/做空+仓位轻重。\n黄色柱代表此时仓位轻重超过100%账号资金，处于杠杆状态。\n“当下持仓是多少”胜过千言万语。这也是我近两年越来越少发 BTC价格行情观点推文的原因。因为当你可以只需要通过一个URL就能在几秒钟内访问看到我的实时实盘仓位（无需app无需登录），那就不需要用文字再去说了。\n\n下方：累计盈亏。\n可切换USD 或 BTC 不同本位。\n\n这个上、中、下3层，依顺序其实就是\n上：在什么市场环境下\n中：调整成什么仓位姿势去迎接\n下：获得什么样的结果\n\n这个产品的设计巧思，创新展现方式，\n不谋而合地抓住了我很久以来心里所想的，\n一个真实用的交易实盘信息面板，\n尤其是长期交易实盘，所应该体现的重点。\n不是只有当下快照、一行行列表，\n或者像给资深工程师科学家看的那种，\n眼花但其实没什么卵用的统计数字。\n这是\n真在交易的人，真有持续思考交易的人，\n而且还懂产品，才做得出的产品。\n这以至于让我有一种\n像被使了读心术的感动和爽。\n\n这事后看上去好像不是很复杂？\n但为什么之前的实盘平台，\n没有过这种设计？\n后视镜去看总觉得简单，\n但在事前的无数选项中，\n去做这种减法筛选是最难的。"}}},quoted_tweet_results:$R[78]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwOTA4NTMyOTQ0MzY0MDk2MTg=",rest_id:"2090853294436409618",result:$R[79]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[80]=[],core:$R[81]={user_results:$R[82]={id:"VXNlclJlc3VsdHM6OTA1MjY5NjY2NDkwMjIwNTQ3",result:$R[83]={__typename:"User",avatar:$R[84]={image_url:"https://pbs.twimg.com/profile_images/2090844595403808768/ZHhFgxX2_normal.jpg"},core:$R[85]={name:"猫眼观察员",screen_name:"catseyeinstinct"},id:"VXNlcjo5MDUyNjk2NjY0OTAyMjA1NDc=",identity_profile_labels_highlighted_label:$R[86]={},privacy:$R[87]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[88]={followers:310,following:130},rest_id:"905269666490220547",super_follow_eligible:!1,tweet_counts:$R[89]={tweets:39},verification:$R[90]={is_blue_verified:!0}}}},counts:$R[91]={bookmark_count:181,favorite_count:178,quote_count:2,reply_count:17,retweet_count:24},details:$R[92]={cashtag_entities:$R[93]=[],created_at_ms:1787333246000,display_text_range:$R[94]=[0,145],full_text:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/mpe0gkvIXB\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。 https://t.co/4xtgGBu08Z",hashtag_entities:$R[95]=[],smarttags:$R[96]=[],timestamp_entities:$R[97]=[]},edit_control:$R[98]={__typename:"EditControlEdit",edit_control_initial:$R[99]={edit_tweet_ids:$R[100]=["2090850770199494771","2090853088500359447","2090853294436409618"]}},grok_translated_post_with_availability:$R[101]={is_available:!1},id:"VHdlZXQ6MjA5MDg1MzI5NDQzNjQwOTYxOA==",legacy:$R[102]={possibly_sensitive:!1},media_entities2:$R[103]=[$R[104]={allow_download_status:$R[105]={allow_download:!0},expanded_url:"https://x.com/catseyeinstinct/status/2090853294436409618/photo/1",ext_media_availability:$R[106]={status:"Available"},ext_playlists:$R[107]=[],features:$R[108]={all:$R[109]={tags:$R[110]=[$R[111]={name:"paulwei",type:"user",user_id:"28754022"}]}},id_str:"2090848827972419584",indices:$R[112]=[146,169],media_url_https:"https://pbs.twimg.com/media/HQQv7mZWgAAfFg2.png",original_info:$R[113]={height:1202,width:2542},type:"photo"}],mention_entities:$R[114]=[],note_tweet:$R[115]={is_expandable:!0,note_tweet_results:$R[116]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDkwODUzMjk0MzczNTI3NTUy",result:$R[117]={__typename:"NoteTweet",entity_set:$R[118]={hashtags:$R[119]=[],smarttags:$R[120]=[],symbols:$R[121]=[],urls:$R[122]=[$R[123]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today/",indices:$R[124]=[28,51],url:"https://t.co/aKAWsI9q0y"}],user_mentions:$R[125]=[]},id:"Tm90ZVR3ZWV0OjIwOTA4NTMyOTQzNzM1Mjc1NTI=",rest_id:"2090853294373527552",text:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/aKAWsI9q0y\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。\n\n把这些订单沿着时间轴串起来，我们就能看到整个仓位管理过程。\n\n过去我们看到的更多是结果，现在终于可以看到策略本身。\n\n欢迎来玩，也欢迎提需求🐈"}}},rest_id:"2090853294436409618",url_entities:$R[126]=[$R[127]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today/",indices:$R[128]=[28,51],url:"https://t.co/mpe0gkvIXB"}],views:$R[129]={count:"91961"}}},rest_id:"2091737922978639965",url_entities:$R[130]=[$R[131]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today",indices:$R[132]=[116,139],url:"https://t.co/MUA6Ph8QBA"}],views:$R[133]={count:"75167"}}}}}}}],graphqlRequestStream:$R[134]=($R[135]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[136]=($R[137]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="tridelglhpSZqATr6UFF+A==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="tridelglhpSZqATr6UFF+A==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="tridelglhpSZqATr6UFF+A==">($R=>$R[136].next($R[138]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"2091737922978639965\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="tridelglhpSZqATr6UFF+A==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="tridelglhpSZqATr6UFF+A==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="tridelglhpSZqATr6UFF+A==">($R=>$R[136].next($R[139]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"2091737922978639965\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[140]={kind:"Result.Ok",value:$R[141]={data:$R[142]={threaded_conversation_with_injections_v2:$R[143]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[144]=[$R[145]={__typename:"TimelineClearCache"},$R[146]={__typename:"TimelineAddEntries",entries:$R[147]=[$R[148]={content:$R[149]={__typename:"TimelineTimelineItem",client_event_info:$R[150]={component:"tweet",element:"tweet"},content:$R[151]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[152]={id:"VHdlZXRSZXN1bHRzOjIwOTE3Mzc5MjI5Nzg2Mzk5NjU=",rest_id:"2091737922978639965",result:$R[153]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[154]=[],core:$R[155]={user_results:$R[156]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[157]={__typename:"User",avatar:$R[158]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[159]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[160]={},privacy:$R[161]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[162]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[163]={tweets:4183},verification:$R[164]={is_blue_verified:!0}}}},counts:$R[165]={bookmark_count:524,favorite_count:485,quote_count:3,reply_count:56,retweet_count:72},details:$R[166]={cashtag_entities:$R[167]=[],created_at_ms:1787544158000,display_text_range:$R[168]=[0,175],full_text:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/MUA6Ph8QBA\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构， https://t.co/monJV3N5Mb",hashtag_entities:$R[169]=[],smarttags:$R[170]=[],timestamp_entities:$R[171]=[]},edit_control:$R[172]={__typename:"EditControlInitial",edit_tweet_ids:$R[173]=["2091737922978639965"]},grok_translated_post_with_availability:$R[174]={is_available:!1},id:"VHdlZXQ6MjA5MTczNzkyMjk3ODYzOTk2NQ==",legacy:$R[175]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[176]=[$R[177]={expanded_url:"https://x.com/coolish/status/2091737922978639965/photo/1",ext_media_availability:$R[178]={status:"Available"},ext_playlists:$R[179]=[],features:$R[180]={},id_str:"2091721634403201024",indices:$R[181]=[176,199],media_url_https:"https://pbs.twimg.com/media/HQdJvnuaMAAgNDC.jpg",original_info:$R[182]={height:1168,width:1200},type:"photo"}],mention_entities:$R[183]=[$R[184]={id_str:"905269666490220547",indices:$R[185]=[87,103],screen_name:"catseyeinstinct"}],note_tweet:$R[186]={is_expandable:!0,note_tweet_results:$R[187]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDkxNzM3OTIyNjY4Mjk4MjQw",result:$R[188]={__typename:"NoteTweet",entity_set:$R[189]={hashtags:$R[190]=[],smarttags:$R[191]=[],symbols:$R[192]=[],timestamps:$R[193]=[],urls:$R[194]=[$R[195]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today",indices:$R[196]=[116,139],url:"https://t.co/lUMvTHTMBi"}],user_mentions:$R[197]=[$R[198]={id_str:"905269666490220547",indices:$R[199]=[87,103],screen_name:"catseyeinstinct"}]},id:"Tm90ZVR3ZWV0OjIwOTE3Mzc5MjI2NjgyOTgyNDA=",rest_id:"2091737922668298240",text:"仅凭这一张图，就能一目了然\n近大半年的 BTC 合约交易历程？\n\n前天我发推说，找不到满意的 \n公开 HyperLiquid 合约交易实盘面板，\n不到24小时，这位陌生网友\n@catseyeinstinct 就 Vibe 上线了：\nhttps://t.co/lUMvTHTMBi\n\n这产品的可视化设计创新，\n是市面上找不到的：\n\n界面上中下3层结构，\n上方：主图。\n显示BTC历史订单和成交，\n居然能把所有历史订单，通过横线宽度，\n来表示买卖订单从什么时候开始挂到哪，\n什么时候订单撤销/成交\n（虚线和实线代表最后是否成交），\n9个月来的历史订单调整过程和结果，\n用创新的可视化一目了然。\n纳入了时光机的理念。\n可指针筛选所处时间点的订单，\n可筛选显示主动成交标记。\n\n中间：仓位杠杆率曲线图。\n绿色/红色柱曲线，分别体现\n此时间段做多/做空+仓位轻重。\n黄色柱代表此时仓位轻重超过100%账号资金，处于杠杆状态。\n“当下持仓是多少”胜过千言万语。这也是我近两年越来越少发 BTC价格行情观点推文的原因。因为当你可以只需要通过一个URL就能在几秒钟内访问看到我的实时实盘仓位（无需app无需登录），那就不需要用文字再去说了。\n\n下方：累计盈亏。\n可切换USD 或 BTC 不同本位。\n\n这个上、中、下3层，依顺序其实就是\n上：在什么市场环境下\n中：调整成什么仓位姿势去迎接\n下：获得什么样的结果\n\n这个产品的设计巧思，创新展现方式，\n不谋而合地抓住了我很久以来心里所想的，\n一个真实用的交易实盘信息面板，\n尤其是长期交易实盘，所应该体现的重点。\n不是只有当下快照、一行行列表，\n或者像给资深工程师科学家看的那种，\n眼花但其实没什么卵用的统计数字。\n这是\n真在交易的人，真有持续思考交易的人，\n而且还懂产品，才做得出的产品。\n这以至于让我有一种\n像被使了读心术的感动和爽。\n\n这事后看上去好像不是很复杂？\n但为什么之前的实盘平台，\n没有过这种设计？\n后视镜去看总觉得简单，\n但在事前的无数选项中，\n去做这种减法筛选是最难的。"}}},quoted_tweet_results:$R[200]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwOTA4NTMyOTQ0MzY0MDk2MTg=",rest_id:"2090853294436409618",result:$R[201]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[202]=[],core:$R[203]={user_results:$R[204]={id:"VXNlclJlc3VsdHM6OTA1MjY5NjY2NDkwMjIwNTQ3",result:$R[205]={__typename:"User",avatar:$R[206]={image_url:"https://pbs.twimg.com/profile_images/2090844595403808768/ZHhFgxX2_normal.jpg"},core:$R[207]={name:"猫眼观察员",screen_name:"catseyeinstinct"},id:"VXNlcjo5MDUyNjk2NjY0OTAyMjA1NDc=",identity_profile_labels_highlighted_label:$R[208]={},privacy:$R[209]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[210]={followers:310,following:130},rest_id:"905269666490220547",super_follow_eligible:!1,tweet_counts:$R[211]={tweets:39},verification:$R[212]={is_blue_verified:!0}}}},counts:$R[213]={bookmark_count:181,favorite_count:178,quote_count:2,reply_count:17,retweet_count:24},details:$R[214]={cashtag_entities:$R[215]=[],created_at_ms:1787333246000,display_text_range:$R[216]=[0,145],full_text:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/mpe0gkvIXB\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。 https://t.co/4xtgGBu08Z",hashtag_entities:$R[217]=[],smarttags:$R[218]=[],timestamp_entities:$R[219]=[]},edit_control:$R[220]={__typename:"EditControlEdit",edit_control_initial:$R[221]={edit_tweet_ids:$R[222]=["2090850770199494771","2090853088500359447","2090853294436409618"]}},grok_translated_post_with_availability:$R[223]={is_available:!1},id:"VHdlZXQ6MjA5MDg1MzI5NDQzNjQwOTYxOA==",legacy:$R[224]={possibly_sensitive:!1},media_entities2:$R[225]=[$R[226]={allow_download_status:$R[227]={allow_download:!0},expanded_url:"https://x.com/catseyeinstinct/status/2090853294436409618/photo/1",ext_media_availability:$R[228]={status:"Available"},ext_playlists:$R[229]=[],features:$R[230]={all:$R[231]={tags:$R[232]=[$R[233]={name:"paulwei",type:"user",user_id:"28754022"}]}},id_str:"2090848827972419584",indices:$R[234]=[146,169],media_url_https:"https://pbs.twimg.com/media/HQQv7mZWgAAfFg2.png",original_info:$R[235]={height:1202,width:2542},type:"photo"}],mention_entities:$R[236]=[],note_tweet:$R[237]={is_expandable:!0,note_tweet_results:$R[238]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDkwODUzMjk0MzczNTI3NTUy",result:$R[239]={__typename:"NoteTweet",entity_set:$R[240]={hashtags:$R[241]=[],smarttags:$R[242]=[],symbols:$R[243]=[],urls:$R[244]=[$R[245]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today/",indices:$R[246]=[28,51],url:"https://t.co/aKAWsI9q0y"}],user_mentions:$R[247]=[]},id:"Tm90ZVR3ZWV0OjIwOTA4NTMyOTQzNzM1Mjc1NTI=",rest_id:"2090853294373527552",text:"paul的hyperliquid交易可视化面板上线啦！\nhttps://t.co/aKAWsI9q0y\n\n感谢魏神无私分享自己的交易记录🎇\n\n借助 Hyperliquid 的公开数据, 现在终于可以可视化每一笔挂单完整的「生命周期」：什么时候出现、存在多久、如何调整，以及最终成交还是撤单。\n\n把这些订单沿着时间轴串起来，我们就能看到整个仓位管理过程。\n\n过去我们看到的更多是结果，现在终于可以看到策略本身。\n\n欢迎来玩，也欢迎提需求🐈"}}},rest_id:"2090853294436409618",url_entities:$R[248]=[$R[249]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today/",indices:$R[250]=[28,51],url:"https://t.co/mpe0gkvIXB"}],views:$R[251]={count:"91961"}}},rest_id:"2091737922978639965",url_entities:$R[252]=[$R[253]={display_url:"paul.catseye.today",expanded_url:"https://paul.catseye.today",indices:$R[254]=[116,139],url:"https://t.co/MUA6Ph8QBA"}],views:$R[255]={count:"75167"}}}}},entry_id:"tweet-2091737922978639965",sort_index:"2103760863428083712"},$R[256]={content:$R[257]={__typename:"TimelineTimelineModule",client_event_info:$R[258]={component:"tweet"},display_type:"VerticalConversation",items:$R[259]=[$R[260]={entry_id:"conversationthread-2091746254908739939-tweet-2091746254908739939",item:$R[261]={__typename:"TimelineTimelineItem",client_event_info:$R[262]={component:"tweet",details:$R[263]={conversation_details:$R[264]={conversation_section:"HighQuality"},timelines_details:$R[265]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcynLFAAAAAA=="}},element:"tweet"},content:$R[266]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[267]={id:"VHdlZXRSZXN1bHRzOjIwOTE3NDYyNTQ5MDg3Mzk5Mzk=",rest_id:"2091746254908739939",result:$R[268]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[269]=[],core:$R[270]={user_results:$R[271]={id:"VXNlclJlc3VsdHM6OTA1MjY5NjY2NDkwMjIwNTQ3",result:$R[272]={__typename:"User",avatar:$R[273]={image_url:"https://pbs.twimg.com/profile_images/2090844595403808768/ZHhFgxX2_normal.jpg"},core:$R[274]={name:"猫眼观察员",screen_name:"ca