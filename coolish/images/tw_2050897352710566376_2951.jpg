 min-h-6 items-center leading-6 text-gray-700 hover:underline" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_r9ab5336_" data-slot="xds-menu-trigger">More<svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more-dots-hor" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" class="ms-0.5 size-[1em]" aria-hidden="true"><path d="M14 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0m7 0a2 2 0 1 1-4 0 2 2 0 0 1 4 0M7 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0"></path></svg></button><span class="max-w-full text-subtext3 font-normal ps-1 text-gray-700">© 2026 X Corp.</span></nav></div></div></aside></div></div><div aria-live="polite" aria-atomic="true" class="sr-only"></div><script nonce="nV0/VHPB/3FNZrhJtDJxbw==">window.__INITIAL_DATA__={"appMetadata":{"appEnvironment":"prod","observabilityEnvironment":"production","appVersion":"3a208da8280fa952f91f2112deab97f8f21742ab","country":"SG","isTwoffice":false},"featureSwitchPayload":{"features":{"blue_business_vo_nav_for_legacy_verified":true,"complat_x_migration_enabled":false,"rweb_client_transaction_id_enabled":true,"subscriptions_feature_can_gift_premium":true,"subscriptions_management_failed_payment_menu_alert_enabled":true,"subscriptions_sign_up_enabled":true},"impressionPointers":{},"impressions":{},"settingsVersion":"e09b3389c1d12d412106cdd330424baf"}};;document.currentScript.remove()</script><div><svg viewBox="0 0 24 24" id="loading-x-anim-0" aria-hidden="true" class="r-1p0dtai r-13gxpu9 r-4qtqp9 r-yyyyoo r-wy61xf r-1d2f490 r-bqkkf0 r-ywje51 r-dnmrzs r-u8s1d r-zchlnj r-1plcrui r-ipm5af r-lrvibr r-1blnp2b"><g><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path><path d="M 10,30 C 66,7 252,230 139,129 h 219 s 196,198 32,210 C 57,137 85,154 114,68 h 166 s 139,1 110,57 C 198,99 187,222 191,208 h 246 s 144,149 31,245 C 198,107 173,75 144,195 h 28 s 18,26 245,44 C 209,177 