}),
"formatRelativePastTimestamp": (function formatRelativePastTimestamp({ timestamp, lang, timeZone, nowLabel }) {
	const date = new Date(timestamp);
	const now = /* @__PURE__ */ new Date();
	const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1e3);
	if (diffInSeconds <= 0) return nowLabel ?? new Intl.RelativeTimeFormat(lang, { numeric: "auto" }).format(0, "second");
	if (diffInSeconds < 60) return new Intl.NumberFormat(lang, {
		style: "unit",
		unit: "second",
		unitDisplay: "narrow"
	}).format(diffInSeconds);
	if (diffInSeconds < 3600) return new Intl.NumberFormat(lang, {
