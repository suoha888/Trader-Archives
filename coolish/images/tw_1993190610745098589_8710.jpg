ms:1764076893000,display_text_range:$R[383]=[39,62],full_text:"@coolish @Mstone_crypto @fuckboi999911 https://t.co/icU6pCo5lP",hashtag_entities:$R[384]=[],smarttags:$R[385]=[],timestamp_entities:$R[386]=[]},edit_control:$R[387]={__typename:"EditControlInitial",edit_tweet_ids:$R[388]=["1993309079868145883"]},grok_translated_post_with_availability:$R[389]={is_available:!1},id:"VHdlZXQ6MTk5MzMwOTA3OTg2ODE0NTg4Mw==",legacy:$R[390]={lang:"qme",possibly_sensitive:!1},media_entities2:$R[391]=[],mention_entities:$R[392]=[$R[393]={id_str:"28754022",indices:$R[394]=[0,8],screen_name:"coolish"},$R[395]={id_str:"1058070741663371264",indices:$R[396]=[9,23],screen_name:"Mstone_crypto"}],quoted_tweet_results:$R[397]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5OTMzMDkwMTA5NzY3NDM4NTA=",rest_id:"1993309010976743850",result:$R[398]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[399]=[],core:$R[400]={user_results:$R[401]={id:"VXNlclJlc3VsdHM6MTY0NTU5Njk1MjM0NjkwNjYyNA==",result:$R[402]={__typename:"User",avatar:$R[403]={image_url:"https://pbs.twimg.com/profile_images/2098806821373067264/8JwH_vtn_normal.jpg"},core:$R[404]={name:"Mextrel",screen_name:"Mextric"},id:"VXNlcjoxNjQ1NTk2OTUyMzQ2OTA2NjI0",identity_profile_labels_highlighted_label:$R[405]={},privacy:$R[406]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[407]={followers:7940,following:368},rest_id:"1645596952346906624",super_follow_eligible:!1,tweet_counts:$R[408]={tweets:8267},verification:$R[409]={is_blue_verified:!0}}}},counts:$R[410]={bookmark_count:175,favorite_count:152,quote_count:6,reply_count:9,retweet_count:30},details:$R[411]={cashtag_entities:$R[412]=[],created_at_ms:1764076876000,display_text_range:$R[413]=[0,161],full_text:"之前魏神 @coolish  公开 API 后，很快扒了所有交易数据进行观摩学习并在 Notion 存档了原始数据。\n\n今天看到魏神发了个二次分享汇总，那应该是能公开分享的，感谢魏神🫡\n\n感兴趣的在下面自取，复制权限也打开了，应该是最全的。\n包含原始数据的 json csv 文件以及 Notion 自带的一点可视化分析。 https://t.co/qDf1HZ73DR",hashtag_entities:$R[414]=[],smarttags:$R[415]=[],timestam