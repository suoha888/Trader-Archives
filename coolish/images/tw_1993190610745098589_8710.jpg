_to_results:$R[486]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5OTMxOTA2MTA3NDUwOTg1ODk=",rest_id:"1993190610745098589"},reply_to_user_results:$R[487]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[488]={__typename:"User",core:$R[489]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"1993214722779627838",url_entities:$R[490]=[],views:$R[491]={count:"1685"}}}}}}],metadata:$R[492]={conversation_metadata:$R[493]={all_tweet_ids:$R[494]=["1993214722779627838"],enable_deduplication:!0}}},entry_id:"conversationthread-1993214722779627838",sort_index:"2103760901046796258"}]},$R[495]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[496]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[497]={id:"VHdlZXRSZXN1bHRzOjE5OTMxOTA2MTA3NDUwOTg1ODk=",rest_id:"1993190610745098589",result:$R[498]={__typename:"Tweet",core:$R[499]={user_results:$R[500]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[501]={__typename:"User",avatar:$R[502]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[503]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",profile_bio:$R[504]={description:"crypto trader since 2013 / ex co-founder of social network apps with 50+ million users"}}}},counts:$R[505]={favorite_count:816,reply_count:75},details:$R[506]={full_text:"我应该是第一个，把自己Cex实盘只读Api，\n直接公布于众的人？\n\n一两天的工夫，已经有好几个推友公开分享，\n把我2020年5月~2025年11月，\n长达5年半、每天不间断的交易数据，扒了底朝天：\n\n@Mstone_crypto ：\nhttps://t.co/ogJZeGgbc6\n独到的2020年~2025年“实际杠杆率”可视化（图1~2）\n\n@fuckboi999911 https://t.co/aMf2oF38l9",smarttags:$R[507]=[]},id:"VHdlZXQ6MTk5MzE5MDYxMDc0NTA5ODU4OQ==",note_tweet:$R[508]={note_tweet_results:$R[509]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTkzMTkwNjEwNTUyMjA5NDE5",result:$R[510]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5OTMxOTA2MTA1NTIyMDk0MTk=",text:"我应该是第一个，把自己Cex实盘只读Api，\n直接公布于众的人？\n\n一两天的工夫，已经有好几个推友公开分享，\n把我2020年5月~2025年11月，\n长达5年半、每天不间断的交易数据，扒了底朝天：\n\n@Mstone_crypto ：\nhttps://t.co/jYMB5M7ZLl\n独到的2020年~2025年“实际杠杆率”可视化（图1~2）\n\n@fuckboi999911 ：\nhttps://t.co/fo6543skav\n导出60多mb原始数据csv，还先问过我之后放到网盘分享给推友（图3）\n\n@HyperTrenders ：https://t.co/tktreSIc3S\n好家伙，直接把20多mb的csv公开下载链接了（图4）\n\n跟这些推友都素不相识，事先也没有私聊过，\n但对公开事物真相的认真研究求索、分享精神不谋而合。\n\n最近其他基于我实盘的推友分析\n@wendy_2026 ：\nhttps://t.co/FGI5BpUeqR\n已经是第7篇分析，相对前面几篇的洞察深度、角度有明显的迭代进步\n@bitares：\nhttps://t.co/g0VnHRj0vF\n用我的 HyperLiquid 实盘练习 Vibe coding 可视化需求，甚至可视化到TradingView上\n\n这是一种我眼中 \"Open Intelligence\" 的魅力。\n\n也关联呼应我之前的一些推文：\nhttps://t.co/6gZZS89xyu\n关于公开实盘的想法\nhttps://t.co/9Ifv4WVxJe\n对新一代+ai、 community-driven实盘平台的期待\n\n希望以此抛砖引玉，\n引起更多人在实盘这件事上挖掘、创造价值的兴趣。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1993190610745098589:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/coolish" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@coolish" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_mini.jpg 24w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8