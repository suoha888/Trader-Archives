.com/coolish/status…",expanded_url:"https://x.com/coolish/status/1988864007407824995",indices:$R[101]=[595,618],url:"https://t.co/6gZZS89xyu"},$R[102]={display_url:"x.com/coolish/status…",expanded_url:"https://x.com/coolish/status/1984117602680238368",indices:$R[103]=[629,652],url:"https://t.co/9Ifv4WVxJe"}],user_mentions:$R[104]=[$R[105]={id_str:"1058070741663371264",indices:$R[106]=[100,114],screen_name:"Mstone_crypto"},$R[107]={id_str:"2880662977",indices:$R[108]=[251,265],screen_name:"HyperTrenders"},$R[109]={id_str:"1310189529676918784",indices:$R[110]=[383,394],screen_name:"wendy_2026"},$R[111]={id_str:"1273937437408899072",indices:$R[112]=[453,461],screen_name:"bitares"}]},id:"Tm90ZVR3ZWV0OjE5OTMxOTA2MTA1NTIyMDk0MTk=",rest_id:"1993190610552209419",text:"我应该是第一个，把自己Cex实盘只读Api，\n直接公布于众的人？\n\n一两天的工夫，已经有好几个推友公开分享，\n把我2020年5月~2025年11月，\n长达5年半、每天不间断的交易数据，扒了底朝天：\n\n@Mstone_crypto ：\nhttps://t.co/jYMB5M7ZLl\n独到的2020年~2025年“实际杠杆率”可视化（图1~2）\n\n@fuckboi999911 ：\nhttps://t.co/fo6543skav\n导出60多mb原始数据csv，还先问过我之后放到网盘分享给推友（图3）\n\n@HyperTrenders ：https://t.co/tktreSIc3S\n好家伙，直接把20多mb的csv公开下载链接了（图4）\n\n跟这些推友都素不相识，事先也没有私聊过，\n但对公开事物真相的认真研究求索、分享精神不谋而合。\n\n最近其他基于我实盘的推友分析\n@wendy_2026 ：\nhttps://t.co/FGI5BpUeqR\n已经是第7篇分析，相对前面几篇的洞察深度、角度有明显的迭代进步\n@bitares：\nhttps://t.co/g0VnHRj0vF\n用我的 HyperLiquid 实盘练习 Vibe coding 可视化需求，甚至可视化到TradingView上\n\n这是一种我眼中 \"Open Intelligence\" 的魅力。\n\n也关联呼应我之前的一些推文：\nhttps://t.co/6gZZS89xyu\n关于公开实盘的想法\nhttps://t.co/9Ifv4WVxJe\n对新一代+ai、 community-driven实盘平台的期待\n\n希望以此抛砖引玉，\n引起更多人在实盘这件事上挖掘、创造价值的兴趣。"}}},quoted_tweet_results:$R[113]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5OTI1MzI2NTIwMDA0NTcxOTY=",rest_id:"1992532652000457196",result:$R[114]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[115]=[],core:$R[116]={user_results:$R[117]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[118]={__typename:"User",avatar:$R[119]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[120]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[121]={},privacy:$R[122]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[123]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[124]={tweets:4183},verification:$R[125]={is_blue_verified:!0}}}},counts:$R[126]={bookmark_count:328,favorite_count:458,quote_count:15,reply_count:40,retweet_count:54},details:$R[127]={cashtag_entities:$R[128]=[],created_at_ms:1763891778000,display_text_range:$R[129]=[0,147],full_text:"我就是只看K线，手动交易的“原始交易者”，\n但不是崇拜者，只是论道，跟爱憎也没关系。\n因为我认为条条道路通罗马，不同方法体系各有优劣，以及不同的方法，对于不同的人和市场来说，适合度也不同。不认同粗糙地褒扬一种方法的同时，把另一种方法过度贬低至无用。\n\n1. \n多数“逐笔/精细量化分析交易者”，",hashtag_entities:$R[130]=[],smarttags:$R[131]=[],timestamp_entities:$R[132]=[]},edit_control:$R[133]={__typename:"EditControlInitial",edit_tweet_ids:$R[134]=["1992532652000457196"]},grok_translated_post_with_availability:$R[135]={is_available:!1},id:"VHdlZXQ6MTk5MjUzMjY1MjAwMDQ1NzE5Ng==",legacy:$R[136]={},media_entities2:$R[137]=[],mention_entities:$R[138]=[],note_tweet:$R[139]={is_expandable:!0,note_tweet_results:$R[140]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTkyNTMyNjUxODk1NjI3Nzc2",result:$R[141]={__typename:"NoteTweet",entity_set:$R[142]={hashtags:$R[143]=[],symbols:$R[144]=[],urls:$R[145]=[],user_mentions:$R[146]=[]},id:"Tm90ZVR3ZWV0OjE5OTI1MzI2NTE4OTU2Mjc3NzY=",rest_id:"1992532651895627776",text:"我就是只看K线，手动交易的“原始交易者”，\n但不是崇拜者，只是论道，跟爱憎也没关系。\n因为我认为条条道路通罗马，不同方法体系各有优劣，以及不同的方法，对于不同的人和市场来说，适合度也不同。不认同粗糙地褒扬一种方法的同时，把另一种方法过度贬低至无用。\n\n1. \n多数“逐笔/精细量化分析交易者”，\n平均表现上，\n能超越“只看粗糙K线的原始交易者”\n这个结论问题不大，\n但 “A>B” 和 “B行不通、没有用” 显然是两码事，\n这样偷换概念，会更容易引起更多拉低质量的片面讨论。\n\n2. \n我的“只看粗糙K线的原始交易”\n有近4年多实时全透明公开数据Bitmex实盘，在币coin，\n近一周/4个月，也开了HyperLiquid、币安两个实盘，\n在最近一个月的推文里都可以看到，平台上公开都可查，\n长期、中期都跑赢BTC。\n并且前两个实盘，都是每笔成交明细、盈亏实时展示，\n甚至HyperLiquid平台上，连挂单状态都可以看到。\n向来无任何带单、不付费加群、不搞交易返佣、不接广。\n\n“不为结果负责”这一点倒是说对了，\n因为没有上述这些，纯凭兴趣、交流热情，\n不跟人有资金往来，自然不用为任何人的结果负责。\n\n说某类方法有没有用，\n最简单的论证方式就是，拿可验证的成绩辅助论证。\n只要这方法，有人能长期做出还可以的表现，便是有用，\n这是再简单不过的逻辑。\n\n除非说，我这不是“原始交易”，其实是在偷偷跑量化？\n那么再严谨点，\n我直接把上述4年多实盘近2年多交易量99%+都是BTC的\n只读API丢这里，公开几天供检阅：\nId: ADU5yR0QPA6622twEtmPxVsW\nKey: arodVpSl9kBFWSLkxK5gCZIFI6BV-GZ8PQWUbGS4ncI5GBhQ\n欢迎“录一下数据，写程序做逐笔分析”\n看看有没有“非原始交易”的量化特征？\n\n就像竞技运动员，不看比赛成绩，\n光靠嘴讨论方法有没有用，始终是片面低效的。"}}},quoted_tweet_results:$R[147]={id:"VHdlZXRSZXN1bHRzOjE5OTIyNjU5NjUyMzc4NTQ3MDQ=",rest_id:"1992265965237854704",result:$R[148]={__typename:"Tweet",core:$R[149]={user_results:$R[150]={id:"VXNlclJlc3VsdHM6ODU4MTI0MDY0NDc2NDc5NDg4",result:$R[151]={__typename:"User",id:"VXNlcjo4NTgxMjQwNjQ0NzY0Nzk0ODg=",rest_id:"858124064476479488"}}},id:"VHdlZXQ6MTk5MjI2NTk2NTIzNzg1NDcwNA==",rest_id:"1992265965237854704"}},rest_id:"1992532652000457196",url_entities:$R[152]=[],views:$R[153]={count:"373026"}}},rest_id:"1993190610745098589",url_entities:$R[154]=[$R[155]={display_url:"x.com/Mstone_crypto/…",expanded_url:"https://x.com/Mstone_crypto/status/1992943911682318563",indices:$R[156]=[117,140],url:"https://t.co/ogJZeGgbc6"}],views:$R[157]={count:"308937"}}}}}}}],graphqlRequestStream:$R[158]=($R[159]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[160]=($R[161]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="SpMoXMgrdhagFJ55jZnRng==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="SpMoXMgrdhagFJ55jZnRng==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="SpMoXMgrdhagFJ55jZnRng==">($R=>$R[160].next($R[162]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1993190610745098589\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="SpMoXMgrdhagFJ55jZnRng==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="SpMoXMgrdhagFJ55jZnRng==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="SpMoXMgrdhagFJ55jZnRng==">($R=>$R[160].next($R[163]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1993190610745098589\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[164]={kind:"Result.Ok",value:$R[165]={data:$R[166]={threaded_conversation_with_injections_v2:$R[167]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[168]=[$R[169]={__typename:"TimelineClearCache"},$R[170]={__typename:"TimelineAddEntries",entries:$R[171]=[$R[172]={content:$R[173]={__typename:"TimelineTimelineItem",client_event_info:$R[174]={component:"tweet",element:"tweet"},content:$R[175]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[176]={id:"VHdlZXRSZXN1bHRzOjE5OTMxOTA2MTA3NDUwOTg1ODk=",rest_id:"1993190610745098589",result:$R[177]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_atta