	});
} }))($R[76]=($R[77]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="kuB74P0oSGkommZ4/NnTzg==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="kuB74P0oSGkommZ4/NnTzg==">($R=>$R[76].next($R[78]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"2050541619561341310\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="kuB74P0oSGkommZ4/NnTzg==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="kuB74P0oSGkommZ4/NnTzg==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="kuB74P0oSGkommZ4/NnTzg==">($R=>$R[76].next($R[79]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"2050541619561341310\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[80]={kind:"Result.Ok",value:$R[81]={data:$R[82]={threaded_conversation_with_injections_v2:$R[83]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[84]=[$R[85]={__typename:"TimelineClearCache"},$R[86]={__typename:"TimelineAddEntries",entries:$R[87]=[$R[88]={content:$R[89]={__typename:"TimelineTimelineItem",client_event_info:$R[90]={component:"tweet",element:"tweet"},content:$R[91]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[92]={id:"VHdlZXRSZXN1bHRzOjIwNTA1NDE2MTk1NjEzNDEzMTA=",rest_id:"2050541619561341310",result:$R[93]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[94]=[],core:$R[95]={user_results:$R[96]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[97]={__typename:"User",avatar:$R[98]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[99]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[100]={},privacy:$R[101]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[102]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[103]={tweets:4183},verification:$R[104]={is_blue_verified:!0}}}},counts:$R[105]={bookmark_count:155,favorite_count:178,quote_count:7,reply_count:49,retweet_count:16},details:$R[106]={cashtag_entities:$R[107]=[],created_at_ms:1777722193000,display_text_range:$R[108]=[0,149],full_text:"我Steam里有800多个游戏（图2），\n强烈推荐对 游戏+AI化 感兴趣的人，\n玩一下《苏丹的游戏》（图1，Win/Mac都有）\n\n1. 是我近一年玩过最与众不同的游戏。\n2. 是国产游戏，但题材背景却是中世纪中东。\n3. 文字演绎，但自由度前无古人，尺度无下限。\n\n游戏通过每回合，在不同场景， https://t.co/j5sAVD1VgY",hashtag_entities:$R[109]=[],smarttags:$R[110]=[],timestamp_entities:$R[111]=[]},edit_control:$R[112]={__typename:"EditControlInitial",edit_tweet_ids:$R[113]=["2050541619561341310"]},grok_translated_post_with_availability:$R[114]={is_available:!1},id:"VHdlZXQ6MjA1MDU0MTYxOTU2MTM0MTMxMA==",legacy:$R[115]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[116]=[$R[117]={allow_download_status:$R[118]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2050541619561341310/photo/1",ext_media_availability:$R[119]={status:"Available"},ext_playlists:$R[120]=[],features:$R[121]={},id_str:"2050530403283611648",indices:$R[122]=[150,173],media_url_https:"https://pbs.twimg.com/media/HHTyiaDbsAAhjXS.jpg",original_info:$R[123]={height:2225,width:2478},type:"photo"},$R[124]={allow_download_status:$R[125]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2050541619561341310/photo/1",ext_media_availability:$R[126]={status:"Available"},ext_playlists:$R[127]=[],features:$R[128]={},id_str:"2050530658615988224",indices:$R[129]=[150,173],media_url_https:"https://pbs.twimg.com/media/HHTyxRPakAALXqH.jpg",original_info:$R[130]={height:2005,width:1650},type:"photo"}],mention_entities:$R[131]=[],note_tweet:$R[132]={is_expandable:!0,note_tweet_results:$R[133]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUwNTQxNjE5MzM5MDE4MjQw",result:$R[134]={__typename:"NoteTweet",entity_set:$R[135]={hashtags:$R[136]=[],smarttags:$R[137]=[],symbols:$R[138]=[],urls:$R[139]=[$R[140]={display_url:"wiki.biligame.com/sultansgame",expanded_url:"https://wiki.biligame.com/sultansgame",indices:$R[141]=[870,893],url:"https://t.co/g07C3s5tiq"}],user_mentions:$R[142]=[]},id:"Tm90ZVR3ZWV0OjIwNTA1NDE2MTkzMzkwMTgyNDA=",rest_id:"2050541619339018240",text:"我Steam里有800多个游戏（图2），\n强烈推荐对 游戏+AI化 感兴趣的人，\n玩一下《苏丹的游戏》（图1，Win/Mac都有）\n\n1. 是我近一年玩过最与众不同的游戏。\n2. 是国产游戏，但题材背景却是中世纪中东。\n3. 文字演绎，但自由度前无古人，尺度无下限。\n\n游戏通过每回合，在不同场景，\n打出不同的人物、道具等卡牌，来推进剧情。\n举例：\n在某野外场景，遇到一头“犀牛”，\n那么如果你打出“主角+纵欲”二张卡，\n这三张卡就会组合产生一些无下限的剧情...\n而且同样的场景、卡牌组合，还根据骰子检定变化，\n比如这头犀牛可能是先死了，然后...（不能说了）\n\n你的任何一次行为，\n都可能对游戏剧情产生千丝万缕的影响，\n导致数不清的交叉后果、分支和结局。\n\n重点来了：\n暗黑无下限只是表面，重点是这个自由度，\n和这个游戏玩法模式，\n意外地是一个极佳的AI化“底座”。\n\n通常我们谈到游戏+AI，\n往往是用AI来做游戏，\n本质上只是在说Vibe Coding游戏软件而已。\n\n而游戏AI化，则完全是不同的其他几种语境\n比如：\n1. 像《燕云十六声》里NPC对话、次要行为由AI生成\n2. AI实时生成游戏画面\n\n但这两种\n1不是游戏主线玩法\n2估计还需要几年发展才可做可玩\n\n而《苏丹的游戏》，\n其主线玩法就是文字，\n作为主要甚至唯一驱动，和表现形式。\n你可以理解为\n“互动文字小说+RPG+卡牌”，\n但其剧情本质还是If-Else构成\n（虽然光靠If-Else都实现了数不清的故事线）。\n\n如果用AI来改造这个独特的游戏类型，\n就能做出，或者魔改出\n一款完全由AI来实时驱动“无限剧情”走向的游戏，\n这会是最快能诞生此类次世代AI游戏的路径，\n原因是：\n这类游戏的核心反馈，也就是无限变化的剧情产出，\n不需要用图片、视频素材形式来交付，只需文字。\n加上，此游戏核心玩法中的“出牌”组合，\n本质上就是AI生成剧情的“提示词”组合，\n这就完美契合了当下大语言模型已充分成熟的能力阶段。\n\n甚至B站还有此游戏完整WIKI资源数据库可供取用：\nhttps://t.co/g07C3s5tiq\n\n从玩家角度来说，\n这个游戏类型和玩法，虽说独特，\n但却绝不算是小众游戏，\n《苏丹的游戏》作为一款国产游戏，\n在Steam上有2万多“特别好评”。\n\n我以Steam库800多个游戏履历担保：\n1.\n即使你对AI没什么兴趣，\n只要喜欢卡牌/RPG，甚至只是爱看小说，\n这个游戏非常适合，新颖体验且耐玩度极高。\n\n2.\n而对AI驱动游戏的未来形态感兴趣的人来说，\n这是真正的AI游戏到来之前，\n此刻马上就能获得类似体验的尝鲜。\n\n3.\n而对于更进阶的个人Vibe Coder，\n想要尝试不仅仅是Vibe做一个游戏，\n而是做一种，\n既是市面上还没有的创新游戏，\n也是已有广泛玩家数基础，同时运行性能需求低，\n玩法机制定义边界清晰，开发门槛低的尝试。\n那么先至少体验一下它，\n一定能获得很大的启发。"}}},rest_id:"2050541619561341310",url_entities:$R[143]=[],views:$R[144]={count:"71131"}}}}},entry_id:"tweet-2050541619561341310",sort_index:"2103760850820005888"},$R[145]={content:$R[146]={__typename:"TimelineTimelineModule",client_event_info:$R[147]={component:"tweet"},display_type:"VerticalConversation",items:$R[148]=[$R[149]={entry_id:"conversationthread-2050545388785218010-tweet-2050545388785218010",item:$R[150]={__typename:"TimelineTimelineItem",client_event_info:$R[151]={component:"tweet",details:$R[152]={conversation_details:$R[153]={conversation_section:"HighQuality"},timelines_details:$R[154]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcymctAAAAAA=="}},element:"tweet"},content:$R[155]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[156]={id:"VHdlZXRSZXN1bHRzOjIwNTA1NDUzODg3ODUyMTgwMTA=",rest_id:"2050545388785218010",result:$R[157]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[158]=[],core:$R[159]={user_results:$R[160]={id:"VXNlclJlc3VsdHM6MTE0NzEzNDYxODU2NDM0NTg1Ng==",result:$R[161]={__typename:"User",avatar:$R[162]={image_url:"https://pbs.twimg.com/profile_images/1149830031364935680/9NXvWe1B_normal.jpg"},core:$R[163]={name:"c_Up1d",screen_name:"c_up1d"},id:"VXNlcjoxMTQ3MTM0NjE4NTY0MzQ1ODU2",identity_profile_labels_highlighted_label:$R[164]={},privacy:$R[165]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[166]={followers:3,following:93},rest_id:"1147134618564345856",super_follow_eligible:!1,tweet_counts:$R[167]={tweets:33},verification:$R[168]={is_blue_verified:!1}}}},counts:$R[169]={bookmark_count:2,favorite_count:5,quote_count:0,reply_count:2,retweet_count:0},details:$R[170]={cashtag_entities:$R[171]=[],created_at_ms:1777723092000,display_text_range:$R[172]=[9,52],full_text:"@coolish 魏神你是否在找silly tavern（\n搭配不同角色卡+世界书基本能实现您描述的效果",hashtag_entities:$R[173]=[],smarttags:$R[174]=[],timestamp_entities:$R[175]=[]},edit_control:$R[176]={__typename:"EditControlInitial",edit_tweet_ids:$R[177]=["2050545388785218010"]},grok_translated_post_with_availability:$R[178]={is_available:!1},id:"VHdlZXQ6MjA1MDU0NTM4ODc4NTIxODAxMA==",legacy:$R[179]={lang:"zh"},media_entities2:$R[180]=[],mention_entities:$R[181]=[$R[182]={id_str:"28754022",indices:$R[183]=[0,8],screen_name:"coolish"}],reply_to_results:$R[184]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwNTA1NDE2MTk1NjEzNDEzMTA=",rest_id:"2050541619561341310"},reply_to_user_results:$R[185]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[186]={__typename:"User",core:$R[187]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"2050545388785218010",url_entities:$R[188]=[],views:$R[189]={count:"2228"}}}}}}],metadata:$R[190]={conversation_metadata:$R[191]={all_tweet_ids:$R[192]=["2050545388785218010"],enable_deduplication:!0}}},entry_id:"conversationthread-2050545388785218010",sort_index:"2103760850820005878"},$R[193]={content:$R[194]={__typename:"TimelineTimelineModule",client_event_info:$R[195]={component:"tweet"},display_type:"VerticalConversation",items:$R[196]=[$R[197]={entry_id:"conversationthread-2050582159384363195-tweet-2050582159384363195",item:$R[198]={__typename:"TimelineTimelineItem",client_event_info:$R[199]={component:"tweet",details:$R[200]={conversation_details:$R[201]={conversation_section:"HighQuality"},timelines_details:$R[202]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcymctAAAAAA=="}},element:"tweet"},content:$R[203]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[204]={id:"VHdlZXRSZXN1bHRzOjIwNTA1ODIxNTkzODQzNjMxOTU=",rest_id:"2050582159384363195",result:$R[205]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[206]=[],core:$R[207]={user_results:$R[208]={id:"VXNlclJlc3VsdHM6MTkxOTcxMDk0Mzc4NzAyNDM4NQ==",result:$R[209]={__typename:"User",avatar:$R[210]={image_url:"https://pbs.twimg.com/profile_images/1997609330619961344/miwqcAXd_normal.jpg"},core:$R[211]={name:"Shadow Lure",screen_name:"EthanYin0617"},id:"VXNlcjoxOTE5NzEwOTQzNzg3MDI0Mzg1",identity_profile_labels_highlighted_label:$R[212]={},privacy:$R[213]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[214]={followers:237,following:200},rest_id:"1919710943787024385",super_follow_eligible:!1,tweet_counts:$R[215]={tweets:800},verification:$R[216]={is_blue_verified:!0}}}},counts:$R[217]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:0,retweet_count:0},details:$R[218]={cashtag_entities:$R[219]=[],created_at_ms:1777731859000,display_text_range:$R[220]=[9,134],full_text:"@coolish 我的AI游戏项目已经做了快半年了，第一个demo就正式上线了。以我这半年踩过的坑以及不断的尝试最新的AI模型得出的结论。\n\n至少在现阶段，由AI来实时驱动产生的无限剧情，完全做不到真正的无限。先不说质量和人类写手的差距（即便用skill+claude",hashtag_entities:$R[221]=[],smarttags:$R[222]=[],timestamp_entities:$R[223]=[]},edit_control:$R[224]={__typename:"EditControlInitial",edit_tweet_ids:$R[225]=["2050582159384363195"]},grok_translated_post_with_availability:$R[226]={is_available:!1},id:"VHdlZXQ6MjA1MDU4MjE1OTM4NDM2MzE5NQ==",legacy:$R[227]={lang:"zh"},media_entities2:$R[228]=[],mention_entities:$R[229]=[$R[230]={id_str:"28754022",indices:$R[231]=[0,8],screen_name:"coolish"}],note_tweet:$R[232]={is_expandable:!0,note_tweet_results:$R[233]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUwNTgyMTU5MzI5NzM4NzUz",result:$R[234]={__typename:"NoteTweet",entity_set:$R[235]={hashtags:$R[236]=[],smarttags:$R[237]=[],symbols:$R[238]=[],urls:$R[239]=[],user_mentions:$R[240]=[]},id:"Tm90ZVR3ZWV0OjIwNTA1ODIxNTkzMjk3Mzg3NTM=",rest_id:"2050582159329738753",text:"我的AI游戏项目已经做了快半年了，第一个demo就正式上线了。以我这半年踩过的坑以及不断的尝试最新的AI模型得出的结论。\n\n至少在现阶段，由AI来实时驱动产生的无限剧情，完全做不到真正的无限。先不说质量和人类写手的差距（即便用skill+claude 4.6写出来的东西也只能达到一个刚毕业的新人编剧水平），AI在多样性上的能力非常差，写不了几个类型就会换汤不换药的开始重复。但AI对生产管线的改变是革命级的，我现在动辄一版本更新就推翻70%的美术资产重新做，2个星期就能做出新版本，这种迭代程度过去是不敢想象的。\n\nAI正在改变游戏的生产流程，但让AI成为游戏的一部分，我相信大多数制作人和我一样，还在探索阶段。"}}},reply_to_results:$R[241]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwNTA1NDE2MTk1NjEzNDEzMTA=",rest_id:"2050541619561341310"},reply_to_user_results:$R[242]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[243]={__typename:"User",core:$R[244]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"2050582159384363195",url_entities:$R[245]=[],views:$R[246]={count:"589"}}}}}}],metadata:$R[247]={conversation_metadata:$R[248]={all_tweet_ids:$R[249]=["2050582159384363195"],enable_deduplication:!0}}},entry_id:"conversationthread-2050582159384363195",sort_index:"2103760850820005868"},$R[250]={content:$R[251]={__typename:"TimelineTimelineModule",client_event_info:$R[252]={component:"tweet"},display_type:"VerticalConversation",items:$R[253]=[$R[254]={entry_id:"conversationthread-2050543914030133334-tweet-2050543914030133334",item:$R[255]={__typename:"TimelineTimelineItem",client_event_info:$R[256]={component:"tweet",details:$R[257]={conversation_details:$R[258]={conversation_section:"HighQuality"},timelines_details:$R[259]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcymctAAAAAA=="}},element:"tweet"},content:$R[260]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[261]={id:"VHdlZXRSZXN1bHRzOjIwNTA1NDM5MTQwMzAxMzMzMzQ=",rest_id:"2050543914030133334",result:$R[262]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[263]=[],core:$R[264]={user_results:$R[265]={id:"VXNlclJlc3VsdHM6MTczNDYwNTU5NTkzOTE0Nzc3Ng==",result:$R[266]={__typename:"User",avatar:$R[267]={image_url:"https://pbs.twimg.com/profile_images/1916881063391232000/CpcXOOMx_normal.jpg"},core:$R[268]={name:"小新交易员",screen_name:"Chadxiaye"},id:"VXNlcjoxNzM0NjA1NTk1OTM5MTQ3Nzc2",identity_profile_labels_highlighted_label:$R[269]={},privacy:$R[270]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[271]={followers:266,following:176},rest_id:"1734605595939147776",super_follow_eligible:!1,tweet_counts:$R[272]={tweets:1397},verification:$R[273]={is_blue_verified:!0}}}},counts:$R[274]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:0,retweet_count:0},details:$R[275]={cashtag_entities:$R[276]=[],created_at_ms:1777722741000,display_text_range:$R[277]=[9,53],full_text:"@coolish 最近在尝试用 ai 来做一款我梦想中的游戏，奈何目前 ai 美术还是没办法达到可用的标准",hashtag_entities:$R[278]=[],smarttags:$R[279]=[],timestamp_entities:$R[280]=[]},edit_control:$R[281]={__typename:"EditControlInitial",edit_tweet_ids:$R[282]=["2050543914030133334"]},grok_translated_post_with_availability:$R[283]={is_available:!1},id:"VHdlZXQ6MjA1MDU0MzkxNDAzMDEzMzMzNA==",legacy:$R[284]={lang:"zh"},media_entities2:$R[285]=[],mention_entities:$R[286]=[$R[287]={id_str:"28754022",indices:$R[288]=[0,8],screen_name:"coolish"}],reply_to_results:$R[289]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwNTA1NDE2MTk1NjEzNDEzMTA=",rest_id:"2050541619561341310"},reply_to_user_results:$R[290]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[291]={__typename:"User",core:$R[292]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"2050543914030133334",url_entities:$R[293]=[],views:$R[294]={count:"636"}}}}}}],metadata:$R[295]={conversation_metadata:$R[296]={all_tweet_ids:$R[297]=["2050543914030133334"],enable_deduplication:!0}}},entry_id:"conversationthread-2050543914030133334",sort_index:"2103760850820005858"}]},$R[298]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[299]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[300]={id:"VHdlZXRSZXN1bHRzOjIwNTA1NDE2MTk1NjEzNDEzMTA=",rest_id:"2050541619561341310",result:$R[301]={__typename:"Tweet",core:$R[302]={user_results:$R[303]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[304]={__typename:"User",avatar:$R[305]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[306]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",profile_bio:$R[307]={description:"crypto trader since 2013 / ex co-founder of social network apps with 50+ million users"}}}},counts:$R[308]={favorite_count:178,reply_count:49},details:$R[309]={full_text:"我Steam里有800多个游戏（图2），\n强烈推荐对 游戏+AI化 感兴趣的人，\n玩一下《苏丹的游戏》（图1，Win/Mac都有）\n\n1. 是我近一年玩过最与众不同的游戏。\n2. 是国产游戏，但题材背景却是中世纪中东。\n3. 文字演绎，但自由度前无古人，尺度无下限。\n\n游戏通过每回合，在不同场景， https://t.co/j5sAVD1VgY",smarttags:$R[310]=[]},id:"VHdlZXQ6MjA1MDU0MTYxOTU2MTM0MTMxMA==",note_tweet:$R[311]={note_tweet_results:$R[312]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUwNTQxNjE5MzM5MDE4MjQw",result:$R[313]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjIwNTA1NDE2MTkzMzkwMTgyNDA=",text:"我Steam里有800多个游戏（图2），\n强烈推荐对 游戏+AI化 感兴趣的人，\n玩一下《苏丹的游戏》（图1，Win/Mac都有）\n\n1. 是我近一年玩过最与众不同的游戏。\n2. 是国产游戏，但题材背景却是中世纪中东。\n3. 文字演绎，但自由度前无古人，尺度无下限。\n\n游戏通过每回合，在不同场景，\n打出不同的人物、道具等卡牌，来推进剧情。\n举例：\n在某野外场景，遇到一头“犀牛”，\n那么如果你打出“主角+纵欲”二张卡，\n这三张卡就会组合产生一些无下限的剧情...\n而且同样的场景、卡牌组合，还根据骰子检定变化，\n比如这头犀牛可能是先死了，然后...（不能说了）\n\n你的任何一次行为，\n都可能对游戏剧情产生千丝万缕的影响，\n导致数不清的交叉后果、分支和结局。\n\n重点来了：\n暗黑无下限只是表面，重点是这个自由度，\n和这个游戏玩法模式，\n意外地是一个极佳的AI化“底座”。\n\n通常我们谈到游戏+AI，\n往往是用AI来做游戏，\n本质上只是在说Vibe Coding游戏软件而已。\n\n而游戏AI化，则完全是不同的其他几种语境\n比如：\n1. 像《燕云十六声》里NPC对话、次要行为由AI生成\n2. AI实时生成游戏画面\n\n但这两种\n1不是游戏主线玩法\n2估计还需要几年发展才可做可玩\n\n而《苏丹的游戏》，\n其主线玩法就是文字，\n作为主要甚至唯一驱动，和表现形式。\n你可以理解为\n“互动文字小说+RPG+卡牌”，\n但其剧情本质还是If-Else构成\n（虽然光靠If-Else都实现了数不清的故事线）。\n\n如果用AI来改造这个独特的游戏类型，\n就能做出，或者魔改出\n一款完全由AI来实时驱动“无限剧情”走向的游戏，\n这会是最快能诞生此类次世代AI游戏的路径，\n原因是：\n这类游戏的核心反馈，也就是无限变化的剧情产出，\n不需要用图片、视频素材形式来交付，只需文字。\n加上，此游戏核心玩法中的“出牌”组合，\n本质上就是AI生成剧情的“提示词”组合，\n这就完美契合了当下大语言模型已充分成熟的能力阶段。\n\n甚至B站还有此游戏完整WIKI资源数据库可供取用：\nhttps://t.co/g07C3s5tiq\n\n从玩家角度来说，\n这个游戏类型和玩法，虽说独特，\n但却绝不算是小众游戏，\n《苏丹的游戏》作为一款国产游戏，\n在Steam上有2万多“特别好评”。\n\n我以Steam库800多个游戏履历担保：\n1.\n即使你对AI没什么兴趣，\n只要喜欢卡牌/RPG，甚至只是爱看小说，\n这个游戏非常适合，新颖体验且耐玩度极高。\n\n2.\n而对AI驱动游戏的未来形态感兴趣的人来说，\n这是真正的AI游戏到来之前，\n此刻马上就能获得类似体验的尝鲜。\n\n3.\n而对于更进阶的个人Vibe Coder，\n想要尝试不仅仅是Vibe做一个游戏，\n而是做一种，\n既是市面上还没有的创新游戏，\n也是已有广泛玩家数基础，同时运行性能需求低，\n玩法机制定义边界清晰，开发门槛低的尝试。\n那么先至少体验一下它，\n一定能获得很大的启发。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:2050541619561341310:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/coolish" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@coolish" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_mini.jpg 24w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg 48w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_x96.jpg 96w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/coolish" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">paulwei</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1v5c9pimb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/coolish" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@coolish</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qqc9pimb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">我Steam里有800多个游戏（图2），
强烈推荐对 游戏+AI化 感兴趣的人，
玩一下《苏丹的游戏》（图1，Win/Mac都有）

1. 是我近一年玩过最与众不同的游戏。
2. 是国产游戏，但题材背景却是中世纪中东。
3. 文字演绎，但自由度前无古人，尺度无下限。

游戏通过每回合，在不同场景，
打出不同的人物、道具等卡牌，来推进剧情。
举例：
在某野外场景，遇到一头“犀牛”，
那么如果你打出“主角+纵欲”二张卡，
这三张卡就会组合产生一些无下限的剧情...
而且同样的场景、卡牌组合，还根据骰子检定变化，
比如这头犀牛可能是先死了，然后...（不能说了）

你的任何一次行为，
都可能对游戏剧情产生千丝万缕的影响，
导致数不清的交叉后果、分支和结局。

重点来了：
暗黑无下限只是表面，重点是这个自由度，
和这个游戏玩法模式，
意外地是一个极佳的AI化“底座”。

通常我们谈到游戏+AI，
往往是用AI来做游戏，
本质上只是在说Vibe Coding游戏软件而已。

而游戏AI化，则完全是不同的其他几种语境
比如：
1. 像《燕云十六声》里NPC对话、次要行为由AI生成
2. AI实时生成游戏画面

但这两种
1不是游戏主线玩法
2估计还需要几年发展才可做可玩

而《苏丹的游戏》，
其主线玩法就是文字，
作为主要甚至唯一驱动，和表现形式。
你可以理解为
“互动文字小说+RPG+卡牌”，
但其剧情本质还是If-Else构成
（虽然光靠If-Else都实现了数不清的故事线）。

如果用AI来改造这个独特的游戏类型，
就能做出，或者魔改出
一款完全由AI来实时驱动“无限剧情”走向的游戏，
这会是最快能诞生此类次世代AI游戏的路径，
原因是：
这类游戏的核心反馈，也就是无限变化的剧情产出，
不需要用图片、视频素材形式来交付，只需文字。
加上，此游戏核心玩法中的“出牌”组合，
本质上就是AI生成剧情的“提示词”组合，
这就完美契合了当下大语言模型已充分成熟的能力阶段。

甚至B站还有此游戏完整WIKI资源数据库可供取用：
</span><a class="font-chirp max-w-full whitespace-pre-wrap break-words text-brand text-[length:inherit] font-inherit hover:underline" href="https://wiki.biligame.com/sultansgame" rel="noopener noreferrer" target="_blank">wiki.biligame.com/sultansgame</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">

从玩家角度来说，
这个游戏类型和玩法，虽说独特，
但却绝不算是小众游戏，
《苏丹的游戏》作为一款国产游戏，
在Steam上有2万多“特别好评”。

我以Steam库800多个游戏履历担保：
1.
即使你对AI没什么兴趣，
只要喜欢卡牌/RPG，甚至只是爱看小说，
这个游戏非常适合，新颖体验且耐玩度极高。

2.
而对AI驱动游戏的未来形态感兴趣的人来说，
这是真正的AI游戏到来之前，
此刻马上就能获得类似体验的尝鲜。

3.
而对于更进阶的个人Vibe Coder，
想要尝试不仅仅是Vibe做一个游戏，
而是做一种，
既是市面上还没有的创新游戏，
也是已有广泛玩家数基础，同时运行性能需求低，
玩法机制定义边界清晰，开发门槛低的尝试。
那么先至少体验一下它，
一定能获得很大的启发。</span></div><div class="flex flex-col gap-1 empty:hidden"><div class="relative"><div class="flex flex-col"><div class="relative h-0" style="padding-bottom:calc(51.6355% - 2.065px)"><div class="absolute -inset-0.5"><div class="group/carousel relative h-full"><div class="h-full w-full"><div class="scrollbar-hide flex overflow-x-auto gap-1 h-full snap-x snap-mandatory overscroll-x-contain py-0.5 -ms-3.5 -me-3.5 ps-4 pe-4"><div class="border-normal h-full min-h-0 min-w-[auto] shrink-0 snap-center overflow-hidden rounded-sm border" style="aspect-ratio:1.1137078651685393"><div class="relative h-full w-full"><div inert="" class="h-full w-full"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] block h-full w-full cursor-zoom-in appearance-none border-none bg-transparent p-0 text-inherit" aria-label="Image" href="/coolish/status/2050541619561341310/photo/1"><img fetchPriority="high" height="2225" width="2478" alt="" class="h-full w-full object-cover" decoding="async" loading="eager" sizes="(max-width: 600px) calc(100vw - 80px), 600px" src="https://pbs.twimg.com/media/HHTyiaDbsAAhjXS?format=webp&amp;name=large" srcSet="https://pbs.twimg.com/media/HHTyiaDbsAAhjXS?format=webp&amp;name=small 680w, https://pbs.twimg.com/media/HHTyiaDbsAAhjXS?format=webp&amp;name=medium 1200w, https://pbs.twimg.com/media/HHTyiaDbsAAhjXS?format=webp&amp;name=large 2048w"/></a></div><a aria-label="View media" class="absolute inset-0 z-10" href="/coolish/status/2050541619561341310/photo/1"></a></div></div><div class="border-normal h-full min-h-0 min-w-[auto] shrink-0 snap-center overflow-hidden rounded-sm border" style="aspect-ratio:0.8229426433915212"><div class="relative h-full w-full"><div inert="" class="h-full w-full"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] block h-full w-ful