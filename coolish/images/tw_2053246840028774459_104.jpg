chments:$R[153]=[],core:$R[154]={user_results:$R[155]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[156]={__typename:"User",avatar:$R[157]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[158]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[159]={},privacy:$R[160]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[161]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[162]={tweets:4183},verification:$R[163]={is_blue_verified:!0}}}},counts:$R[164]={bookmark_count:65,favorite_count:93,quote_count:2,reply_count:40,retweet_count:4},details:$R[165]={cashtag_entities:$R[166]=[],created_at_ms:1778367168000,display_text_range:$R[167]=[0,169],full_text:"Grok 实时语音模型 + X API 的化学反应，\n实在太被忽视了，整个 X 没人原创下这方面？\n\n原生内置“24小时更新的 X 全网上下文”加持下，\n跟 OpenAI 实时语音那种傻快，根本不是一个物种。\n\nAGI 还没来，我手搓“XGI”，这又搓了个通宵。\n希望明天有时间开 Space ，让大家来多人一起玩。\n\n先从视频感受下⬇️ https://t.co/LrTBXQNrZs",hashtag_entities:$R[168]=[],smarttags:$R[169]=[],timestamp_entities:$R[170]=[]},edit_control:$R[171]={__typename:"EditControlInitial",edit_tweet_ids:$R[172]=["2053246840028774459"]},grok_translated_post_with_availability:$R[173]={is_available:!1},id:"VHdlZXQ6MjA1MzI0Njg0MDAyODc3NDQ1OQ==",legacy:$R[174]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[175]=[$R[176]={additional_media_info:$R[177]={monetizable:!1},allow_download_status:$R[178]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2053246840028774459/video/1",ext_media_availability:$R[179]={status:"Available"},ext_playlists:$R[180]=[],id_str:"2053243719294558208",indices:$R[181]=[170,193],media_url_https:"https://pbs.twimg.com/amplify_video_thumb/2053243719294558208/img/NtGQ99ae_1e7By6f.jpg",original_info:$R[182]={height:2348,width:1080},type:"video",video_info:$R[183]={duration_millis:83545,variants:$R[184]=[$R[185]={content_type:"application/x-mpegURL",url:"https://video.twimg.com/amplify_video/2053243719294558208/pl/hsWKogvOOFrO-Lr7.m3u8?tag=27&v=a3a"},$R[186]={bitrate:632000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2053243719294558208/vid/avc1/320x694/3xu5lD9xqDOdtm0E.mp4?tag=27"},$R[187]={bitrate:950000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2053243719294558208/vid/avc1/480x1042/yC7KkDK7q8-wMaBG.mp4?tag=27"},$R[188]={bitrate:2176000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2053243719294558208/vid/avc1/720x1564/GAUK8zAIHVMGJESd.mp4?tag=27"},$R[189]={bitrate:10368000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/2053243719294558208/vid/avc1/1080x2348/55IacviA1S65MPQ2.mp4?tag=27"}]}}],mention_entities:$R[190]=[],quoted_tweet_results:$R[191]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwNTI4ODAxNjMzMzYzMTEyMjE=",rest_id:"2052880163336311221",result:$R[192]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[193]=[],core:$R[194]={user_results:$R[195]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[196]={__typename:"User",avatar:$R[197]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[198]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[199]={},privacy:$R[200]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[201]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[202]={tweets:4183},verification:$R[203]={is_blue_verified:!0}}}},counts:$R[204]={bookmark_count:132,favorite_count:169,quote_count:7,reply_count:61,retweet_count:13},details:$R[205]={cashtag_entities:$R[206]=[],created_at_ms:1778279746000,display_text_range:$R[207]=[0,162],full_text:"通宵手搓了个逆天的全网首创“X Skill”，\n去睡前先大致说下：\n实时语音Agent，不仅能拉它上 X Space 跟多人语音，\n而且还能在语音中，光动嘴就指挥它在 X 上“做事”。\n\n如图1，在实时语音中，\n我（或者甚至其他发言人）可以跟Agent说：\n\n“你搜一下 X 上关于减肥针风险的推文，\n把最靠谱的推文 URL https://t.co/zFkuidOQbT",hashtag_entities:$R[208]=[],smarttags:$R[209]=[],timestamp_entities:$R[210]=[]},edit_control:$R[211]={__typename:"EditControlInitial",edit_tweet_ids:$R[212]=["2052880163336311221"]},grok_translated_post_with_availability:$R[213]={is_available:!1},id:"VHdlZXQ6MjA1Mjg4MDE2MzMzNjMxMTIyMQ==",legacy:$R[214]={possibly_sensitive:!1},media_entities2:$R[215]=[$R[216]={allow_download_status:$R[217]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2052880163336311221/photo/1",ext_media_availability:$R[218]={status:"Available"},ext_playlists:$R[219]=[],features:$R[220]={},id_str:"2052876863853465600",indices:$R[221]=[163,186],media_url_https:"https://pbs.twimg.com/media/HH1IoY2akAAJ_yc.jpg",original_info:$R[222]={height:966,width:1216},type:"photo"},$R[223]={allow_download_status:$R[224]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2052880163336311221/photo/1",ext_media_availability:$R[225]={status:"Available"},ext_playlists:$R[226]=[],features:$R[227]={},id_str:"2052876939573252096",indices:$R[228]=[163,186],media_url_https:"https://pbs.twimg.com/media/HH1Isy7a0AA-JgA.jpg",original_info:$R[229]={height:1236,width:1178},type:"photo"},$R[230]={allow_download_status:$R[231]={allow_download:!0},expanded_url:"https://x.com/coolish/status/2052880163336311221/photo/1",ext_media_availability:$R[232]={status:"Available"},ext_playlists:$R[233]=[],features:$R[234]={},id_str:"2052879435054092288",indices:$R[235]=[163,186],media_url_https:"https://pbs.twimg.com/media/HH1K-DUakAADR72.jpg",original_info:$R[236]={height:3515,width:3110},type:"photo"}],mention_entities:$R[237]=[],note_tweet:$R[238]={is_expandable:!0,note_tweet_results:$R[239]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUyODgwMTYzMjczMzY3NTUy",result:$R[240]={__typename:"NoteTweet",entity_set:$R[241]={hashtags:$R[242]=[],smarttags:$R[243]=[],symbols:$R[244]=[],urls:$R[245]=[],user_mentions:$R[246]=[]},id:"Tm90ZVR3ZWV0OjIwNTI4ODAxNjMyNzMzNjc1NTI=",rest_id:"2052880163273367552",text:"通宵手搓了个逆天的全网首创“X Skill”，\n去睡前先大致说下：\n实时语音Agent，不仅能拉它上 X Space 跟多人语音，\n而且还能在语音中，光动嘴就指挥它在 X 上“做事”。\n\n如图1，在实时语音中，\n我（或者甚至其他发言人）可以跟Agent说：\n\n“你搜一下 X 上关于减肥针风险的推文，\n把最靠谱的推文 URL 发到这个 Space 下的评论区。”\n\n然后它就真的做到了！（图2）\n\n核心是：\nGrok 的各个模型，包括实时语音模型API，\n都具有自然语言发起“Function Calling”的能力\n（图3）\n用这个去调用 X 账号的OAuth，那么就相当于：\n\n利用 Grok API 原生自带对 X 的自然语义检索能力\n乘以\nX API的读写能力（发推甚至发私信）\n\n这两个互相一乘，可玩空间太大了。\n\n不得不说，\nOpenAI GPT-Realtime-2 实时语音模型再好，\n可是架不住\nGrok Realtime API 实时语音API能玩转X啊。\n\n三言两语说的不是很清楚，\n后续我再让 Codex 整理个更清楚的说明书。\n\n明后天我可以找时间另开 Space 公开演示说明。"}}},rest_id:"2052880163336311221",url_entities:$R[247]=[],views:$R[248]={count:"56804"}}},rest_id:"2053246840028774459",url_entities:$R[249]=[],views:$R[250]={count:"38284"}}}}},entry_id:"tweet-2053246840028774459",sort_index:"2103760891206959104"},$R[251]={content:$R[252]={__typename:"TimelineTimelineModule",client_event_info:$R[253]={component:"tweet"},display_type:"VerticalConversation",items:$R[254]=[$R[255]={entry_id:"conversationthread-2053335912042639560-tweet-2053335912042639560",item:$R[256]={__typename:"TimelineTimelineItem",client_event_info:$R[257]={component:"tweet",details:$R[258]={conversation_details:$R[259]={conversation_section:"HighQuality"},timelines_details:$R[260]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyo0AAAAAAA=="}},element:"tweet"},content:$R[261]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[262]={id:"VHdlZXRSZXN1bHRzOjIwNTMzMzU5MTIwNDI2Mzk1NjA=",rest_id:"2053335912042639560",result:$R[263]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[264]=[],core:$R[265]={user_results:$R[266]={id:"VXNlclJlc3VsdHM6MTY2Mzk1MTEzNzQwNDUwMjAxNg==",result:$R[267]={__typename:"User",avatar:$R[268]={image_url:"https://pbs.twimg.com/profile_images/1988461934308716547/j9xGzxYO_normal.jpg"},core:$R[269]={name:"AgendaLin 議程",screen_name:"Agenda_Lin"},id:"VXNlcjoxNjYzOTUxMTM3NDA0NTAyMDE2",identity_profile_labels_highlighted_label:$R[270]={},privacy:$R[271]={protected:!1}