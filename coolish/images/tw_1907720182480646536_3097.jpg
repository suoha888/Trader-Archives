74 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="XSs6RBsHw1bLj8g9F8yx9A==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410651723,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀coolish",u:1790410651723,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀coolish␀status␀1907720182480646536␀{}",u:1790410652142,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg",authorDescription:void 0,authorName:"paulwei",focalTweetId:"1907720182480646536",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1907720182480646536",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"paulwei profile picture",url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg"},screenName:"coolish",url:"https://x.com/coolish"},bodyText:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。",canonicalPath:"/coolish/status/1907720182480646536",canonicalUrl:"https://x.com/coolish/status/1907720182480646536",description:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:2868,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&name=small 680w, https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&name=medium 1200w, https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&name=large",width:2676},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/1907720182480646536",publishedTime:"2025-04-03T09:01:49.000Z",replyCount:54,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/coolish/status/1903492846151483477","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"coolish",identifier:"28754022",image:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg",name:"paulwei",url:"https://x.com/coolish"},datePublished:"2025-03-22T17:03:54.000Z",identifier:"1903492846151483477",url:"https://x.com/coolish/status/1903492846151483477",engagement:$R[17]=[$R[18]={action:"LikeAction",name:"Likes",url:"https://x.com/coolish/status/1903492846151483477/likes",count:41},$R[19]={action:"ShareAction",name:"Retweets",url:"https://x.com/coolish/status/1903492846151483477/retweets",count:6},$R[20]={action:"ReplyAction",name:"Replies",url:null,count:1},$R[21]={action:"ViewAction",name:"Views",count:230724}],text:"取决于你怎么看待定义“红利”：\n如果红利是指，更多借运气就能赢钱的红利，那么无论是BTC还是任何其他币，2023这轮至今是比2020年红利更少的。体现在，BTC的震荡更多，单边性更少；小币的拉盘持续时长更短，最高涨幅更小。\n\n如果红利是指，长期相对多分配大部分精力在做BTC交易，所带来的对BTC走势的熟悉度、交易水平提升所带来的好处，我觉得这方面红利还是很大。原因比如“交易BTC”这个技能可能可以受用一辈子；比如对BTC走势更熟悉能帮助未来对其他小币机会周期的把握。"}},socialTitle:"paulwei (@coolish) on X",title:"paulwei on X: \"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。\""},replyCount:54,screenName:"coolish",status:"available",text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[22]={messagesBeforeDehydration:$R[23]=[$R[24]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1907720182480646536\"}",name:"TweetResultByRestId"},$R[25]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1907720182480646536\"}",result:$R[26]={kind:"Result.Ok",value:$R[27]={data:$R[28]={tweet_result_by_rest_id:$R[29]={id:"VHdlZXRSZXN1bHRzOjE5MDc3MjAxODI0ODA2NDY1MzY=",rest_id:"1907720182480646536",result:$R[30]={__typename:"Tweet",cashtag_attachments:$R[31]=[],core:$R[32]={user_results:$R[33]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[34]={__typename:"User",avatar:$R[35]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[36]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[37]={},privacy:$R[38]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[39]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[40]={tweets:4183},verification:$R[41]={is_blue_verified:!0}}}},counts:$R[42]={bookmark_count:445,favorite_count:603,quote_count:11,reply_count:54,retweet_count:104},details:$R[43]={cashtag_entities:$R[44]=[],created_at_ms:1743670909000,display_text_range:$R[45]=[0,138],full_text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ， https://t.co/881d7J0zkC",hashtag_entities:$R[46]=[],smarttags:$R[47]=[],timestamp_entities:$R[48]=[]},edit_control:$R[49]={__typename:"EditControlInitial",edit_tweet_ids:$R[50]=["1907720182480646536"]},grok_translated_post_with_availability:$R[51]={is_available:!1},id:"VHdlZXQ6MTkwNzcyMDE4MjQ4MDY0NjUzNg==",legacy:$R[52]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[53]=[$R[54]={allow_download_status:$R[55]={allow_download:!0},expanded_url:"https://x.com/coolish/status/1907720182480646536/photo/1",ext_media_availability:$R[56]={status:"Available"},ext_playlists:$R[57]=[],features:$R[58]={},id_str:"1907704001979887618",indices:$R[59]=[139,162],media_url_https:"https://pbs.twimg.com/media/GnmGrq6aMAIOW66.jpg",original_info:$R[60]={height:2868,width:2676},type:"photo"},$R[61]={allow_download_status:$R[62]={allow_download:!0},expanded_url:"https://x.com/coolish/status/1907720182480646536/photo/1",ext_media_availability:$R[63]={status:"Available"},ext_playlists:$R[64]=[],features:$R[65]={},id_str:"1907704014659354624",indices:$R[66]=[139,162],media_url_https:"https://pbs.twimg.com/media/GnmGsaJbgAAO3ap.jpg",original_info:$R[67]={height:2868,width:2676},type:"photo"},$R[68]={allow_download_status:$R[69]={allow_download:!0},expanded_url:"https://x.com/coolish/status/1907720182480646536/photo/1",ext_media_availability:$R[70]={status:"Available"},ext_playlists:$R[71]=[],features:$R[72]={},id_str:"1907704048759001088",indices:$R[73]=[139,162],media_url_https:"https://pbs.twimg.com/media/GnmGuZLa0AAEIzS.jpg",original_info:$R[74]={height:1268,width:2244},type:"photo"}],mention_entities:$R[75]=[],note_tweet:$R[76]={is_expandable:!0,note_tweet_results:$R[77]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTA3NzIwMTgyMjgzNTEzODU2",result:$R[78]={__typename:"NoteTweet",entity_set:$R[79]={hashtags:$R[80]=[],symbols:$R[81]=[],urls:$R[82]=[],user_mentions:$R[83]=[]},id:"Tm90ZVR3ZWV0OjE5MDc3MjAxODIyODM1MTM4NTY=",rest_id:"1907720182283513856",text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。"}}},quoted_tweet_results:$R[84]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDM0OTI4NDYxNTE0ODM0Nzc=",rest_id:"1903492846151483477",result:$R[85]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[86]=[],core:$R[87]={user_results:$R[88]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[89]={__typename:"User",avatar:$R[90]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[91]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[92]={},privacy:$R[93]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[94]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[95]={tweets:4183},verification:$R[96]={is_blue_verified:!0}}}},counts:$R[97]={bookmark_count:19,favorite_count:41,quote_count:1,reply_count:1,retweet_count:6},details:$R[98]={cashtag_entities:$R[99]=[],created_at_ms:1742663034000,display_text_range:$R[100]=[30,141],full_text:"@zuiren820 @hazenlee @colinwu 取决于你怎么看待定义“红利”：\n如果红利是指，更多借运气就能赢钱的红利，那么无论是BTC还是任何其他币，2023这轮至今是比2020年红利更少的。体现在，BTC的震荡更多，单边性更少；小币的拉盘持续时长更短，最高涨幅更小。",hashtag_entities:$R[101]=[],smarttags:$R[102]=[],timestamp_entities:$R[103]=[]},edit_control:$R[104]={__typename:"EditControlInitial",edit_tweet_ids:$R[105]=["1903492846151483477"]},grok_translated_post_with_availability:$R[106]={is_available:!1},id:"VHdlZXQ6MTkwMzQ5Mjg0NjE1MTQ4MzQ3Nw==",legacy:$R[107]={},media_entities2:$R[108]=[],mention_entities:$R[109]=[$R[110]={id_str:"1373589134036529152",indices:$R[111]=[0,10],screen_name:"zuiren820"},$R[112]={id_str:"2739080844",indices:$R[113]=[11,20],screen_name:"hazenlee"},$R[114]={id_str:"1457238121679302657",indices:$R[115]=[21,29],screen_name:"colinwu"}],note_tweet:$R[116]={is_expandable:!0,note_tweet_results:$R[117]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTAzNDkyODQ2MDg4NDk1MTA0",result:$R[118]={__typename:"NoteTweet",entity_set:$R[119]={hashtags:$R[120]=[],symbols:$R[121]=[],urls:$R[122]=[],user_mentions:$R[123]=[]},id:"Tm90ZVR3ZWV0OjE5MDM0OTI4NDYwODg0OTUxMDQ=",rest_id:"1903492846088495104",text:"取决于你怎么看待定义“红利”：\n如果红利是指，更多借运气就能赢钱的红利，那么无论是BTC还是任何其他币，2023这轮至今是比2020年红利更少的。体现在，BTC的震荡更多，单边性更少；小币的拉盘持续时长更短，最高涨幅更小。\n\n如果红利是指，长期相对多分配大部分精力在做BTC交易，所带来的对BTC走势的熟悉度、交易水平提升所带来的好处，我觉得这方面红利还是很大。原因比如“交易BTC”这个技能可能可以受用一辈子；比如对BTC走势更熟悉能帮助未来对其他小币机会周期的把握。"}}},reply_to_results:$R[124]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDM0NzUyMjQ1ODg1MTc3NjI=",rest_id:"1903475224588517762"},reply_to_user_results:$R[125]={id:"VXNlclJlc3VsdHM6MTM3MzU4OTEzNDAzNjUyOTE1Mg==",rest_id:"1373589134036529152",result:$R[126]={__typename:"User",core:$R[127]={screen_name:"zuiren820"},id:"VXNlcjoxMzczNTg5MTM0MDM2NTI5MTUy",rest_id:"1373589134036529152"}},rest_id:"1903492846151483477",url_entities:$R[128]=[],views:$R[129]={count:"230724"}}},rest_id:"1907720182480646536",url_entities:$R[130]=[],views:$R[131]={count:"311705"}}}}}}}],graphqlRequestStream:$R[132]=($R[133]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[134]=($R[135]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==">($R=>$R[134].next($R[136]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1907720182480646536\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="XSs6RBsHw1bLj8g9F8yx9A==">($R=>$R[134].next($R[137]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1907720182480646536\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[138]={kind:"Result.Ok",value:$R[139]={data:$R[140]={threaded_conversation_with_injections_v2:$R[141]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[142]=[$R[143]={__typename:"TimelineClearCache"},$R[144]={__typename:"TimelineAddEntries",entries:$R[145]=[$R[146]={content:$R[147]={__typename:"TimelineTimelineItem",client_event_info:$R[148]={component:"tweet",element:"tweet"},content:$R[149]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[150]={id:"VHdlZXRSZXN1bHRzOjE5MDc3MjAxODI0ODA2NDY1MzY=",rest_id:"1907720182480646536",result:$R[151]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[152]=[],core:$R[153]={user_results:$R[154]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[155]={__typename:"User",avatar:$R[156]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[157]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[158]={},privacy:$R[159]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[160]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[161]={tweets:4183},verification:$R[162]={is_blue_verified:!0}}}},counts:$R[163]={bookmark_count:445,favorite_count:603,quote_count:11,reply_count:54,retweet_count:104},details:$R[164]={cashtag_entities:$R[165]=[],created_at_ms:1743670909000,display_text_range:$R[166]=[0,138],full_text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ， https://t.co/881d7J0zkC",hashtag_entities:$R[167]=[],smarttags:$R[168]=[],timestamp_entities:$R[169]=[]},edit_control:$R[170]={__typename:"EditControlInitial",edit_tweet_ids:$R[171]=["1907720182480646536"]},grok_translated_post_with_availability:$R[172]={is_available:!1},id:"VHdlZXQ6MTkwNzcyMDE4MjQ4MDY0NjUzNg==",legacy:$R[173]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[174]=[$R[175]={allow_download_status:$R[176]={allow_download:!0},expanded_url:"https://x.com/coolish/status/1907720182480646536/photo/1",ext_media_availability:$R[177]={status:"Available"},ext_playlists:$R[178]=[],features:$R[179]={},id_str:"1907704001979887618",indices:$R[180]=[139,162],media_url_https:"https://pbs.twimg.com/media/GnmGrq6aMAIOW66.jpg",original_info:$R[181]={height:2868,width:2676},type:"photo"},$R[182]={allow_download_status:$R[183]={allow_download:!0},expanded_url:"https://x.com/coolish/status/1907720182480646536/photo/1",ext_media_availability:$R[184]={status:"Available"},ext_playlists:$R[185]=[],features:$R[186]={},id_str:"1907704014659354624",indices:$R[187]=[139,162],media_url_https:"https://pbs.twimg.com/media/GnmGsaJbgAAO3ap.jpg",original_info:$R[188]={height:2868,width:2676},type:"photo"},$R[189]={allow_download_status:$R[190]={allow_download:!0},expanded_url:"https://x.com/coolish/status/1907720182480646536/photo/1",ext_media_availability:$R[191]={status:"Available"},ext_playlists:$R[192]=[],features:$R[193]={},id_str:"1907704048759001088",indices:$R[194]=[139,162],media_url_https:"https://pbs.twimg.com/media/GnmGuZLa0AAEIzS.jpg",original_info:$R[195]={height:1268,width:2244},type:"photo"}],mention_entities:$R[196]=[],note_tweet:$R[197]={is_expandable:!0,note_tweet_results:$R[198]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTA3NzIwMTgyMjgzNTEzODU2",result:$R[199]={__typename:"NoteTweet",entity_set:$R[200]={hashtags:$R[201]=[],symbols:$R[202]=[],urls:$R[203]=[],user_mentions:$R[204]=[]},id:"Tm90ZVR3ZWV0OjE5MDc3MjAxODIyODM1MTM4NTY=",rest_id:"1907720182283513856",text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。"}}},quoted_tweet_results:$R[205]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDM0OTI4NDYxNTE0ODM0Nzc=",rest_id:"1903492846151483477",result:$R[206]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[207]=[],core:$R[208]={user_results:$R[209]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[210]={__typename:"User",avatar:$R[211]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[212]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",identity_profile_labels_highlighted_label:$R[213]={},privacy:$R[214]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[215]={followers:64831,following:3881},rest_id:"28754022",super_follow_eligible:!1,tweet_counts:$R[216]={tweets:4183},verification:$R[217]={is_blue_verified:!0}}}},counts:$R[218]={bookmark_count:19,favorite_count:41,quote_count:1,reply_count:1,retweet_count:6},details:$R[219]={cashtag_entities:$R[220]=[],created_at_ms:1742663034000,display_text_range:$R[221]=[30,141],full_text:"@zuiren820 @hazenlee @colinwu 取决于你怎么看待定义“红利”：\n如果红利是指，更多借运气就能赢钱的红利，那么无论是BTC还是任何其他币，2023这轮至今是比2020年红利更少的。体现在，BTC的震荡更多，单边性更少；小币的拉盘持续时长更短，最高涨幅更小。",hashtag_entities:$R[222]=[],smarttags:$R[223]=[],timestamp_entities:$R[224]=[]},edit_control:$R[225]={__typename:"EditControlInitial",edit_tweet_ids:$R[226]=["1903492846151483477"]},grok_translated_post_with_availability:$R[227]={is_available:!1},id:"VHdlZXQ6MTkwMzQ5Mjg0NjE1MTQ4MzQ3Nw==",legacy:$R[228]={},media_entities2:$R[229]=[],mention_entities:$R[230]=[$R[231]={id_str:"1373589134036529152",indices:$R[232]=[0,10],screen_name:"zuiren820"},$R[233]={id_str:"2739080844",indices:$R[234]=[11,20],screen_name:"hazenlee"},$R[235]={id_str:"1457238121679302657",indices:$R[236]=[21,29],screen_name:"colinwu"}],note_tweet:$R[237]={is_expandable:!0,note_tweet_results:$R[238]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTAzNDkyODQ2MDg4NDk1MTA0",result:$R[239]={__typename:"NoteTweet",entity_set:$R[240]={hashtags:$R[241]=[],symbols:$R[242]=[],urls:$R[243]=[],user_mentions:$R[244]=[]},id:"Tm90ZVR3ZWV0OjE5MDM0OTI4NDYwODg0OTUxMDQ=",rest_id:"1903492846088495104",text:"取决于你怎么看待定义“红利”：\n如果红利是指，更多借运气就能赢钱的红利，那么无论是BTC还是任何其他币，2023这轮至今是比2020年红利更少的。体现在，BTC的震荡更多，单边性更少；小币的拉盘持续时长更短，最高涨幅更小。\n\n如果红利是指，长期相对多分配大部分精力在做BTC交易，所带来的对BTC走势的熟悉度、交易水平提升所带来的好处，我觉得这方面红利还是很大。原因比如“交易BTC”这个技能可能可以受用一辈子；比如对BTC走势更熟悉能帮助未来对其他小币机会周期的把握。"}}},reply_to_results:$R[245]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDM0NzUyMjQ1ODg1MTc3NjI=",rest_id:"1903475224588517762"},reply_to_user_results:$R[246]={id:"VXNlclJlc3VsdHM6MTM3MzU4OTEzNDAzNjUyOTE1Mg==",rest_id:"1373589134036529152",result:$R[247]={__typename:"User",core:$R[248]={screen_name:"zuiren820"},id:"VXNlcjoxMzczNTg5MTM0MDM2NTI5MTUy",rest_id:"1373589134036529152"}},rest_id:"1903492846151483477",url_entities:$R[249]=[],views:$R[250]={count:"230724"}}},rest_id:"1907720182480646536",url_entities:$R[251]=[],views:$R[252]={count:"311705"}}}}},entry_id:"tweet-1907720182480646536",sort_index:"2103760872387117056"},$R[253]={content:$R[254]={__typename:"TimelineTimelineModule",client_event_info:$R[255]={component:"tweet"},display_type:"VerticalConversation",items:$R[256]=[$R[257]={entry_id:"conversationthread-1907724591570759902-tweet-1907724591570759902",item:$R[258]={__typename:"TimelineTimelineItem",client_event_info:$R[259]={component:"tweet",details:$R[260]={conversation_details:$R[261]={conversation_section:"HighQuality"},timelines_details:$R[262]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcynrsAAAAAA=="}},element:"tweet"},content:$R[263]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[264]={id:"VHdlZXRSZXN1bHRzOjE5MDc3MjQ1OTE1NzA3NTk5MDI=",rest_id:"1907724591570759902",result:$R[265]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[266]=[],core:$R[267]={user_results:$R[268]={id:"VXNlclJlc3VsdHM6MTUyNTQxMzUzMTY0MTkwOTI0OQ==",result:$R[269]={__typename:"User",avatar:$R[270]={image_url:"https://pbs.twimg.com/profile_images/2083139948576952320/GHLUI7VQ_normal.jpg"},core:$R[271]={name:"Trader Maxey",screen_name:"trader_maxey"},id:"VXNlcjoxNTI1NDEzNTMxNjQxOTA5MjQ5",identity_profile_labels_highlighted_label:$R[272]={},privacy:$R[273]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[274]={followers:37780,following:1608},rest_id:"1525413531641909249",super_follow_eligible:!1,tweet_counts:$R[275]={tweets:6474},verification:$R[276]={is_blue_verified:!0}}}},counts:$R[277]={bookmark_count:5,favorite_count:23,quote_count:0,reply_count:3,retweet_count:0},details:$R[278]={cashtag_entities:$R[279]=[],created_at_ms:1743671961000,display_text_range:$R[280]=[9,112],full_text:"@coolish 完全同意魏神，也感谢分享，我入门阶段专门做过对比，在只做btc的情况下，一是只用裸k和价格行为学交易，二是同时打开新闻tg，金十，做交易，最后结果确实第一种更好，第二种经常会因为心态问题打乱自己的正确计划😂",hashtag_entities:$R[281]=[],smarttags:$R[282]=[],timestamp_entities:$R[283]=[]},edit_control:$R[284]={__typename:"EditControlInitial",edit_tweet_ids:$R[285]=["1907724591570759902"]},grok_translated_post_with_availability:$R[286]={is_available:!1},id:"VHdlZXQ6MTkwNzcyNDU5MTU3MDc1OTkwMg==",legacy:$R[287]={lang:"zh"},media_entities2:$R[288]=[],mention_entities:$R[289]=[$R[290]={id_str:"28754022",indices:$R[291]=[0,8],screen_name:"coolish"}],reply_to_results:$R[292]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDc3MjAxODI0ODA2NDY1MzY=",rest_id:"1907720182480646536"},reply_to_user_results:$R[293]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[294]={__typename:"User",core:$R[2