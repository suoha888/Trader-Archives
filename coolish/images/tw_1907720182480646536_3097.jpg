s:27482},verification:$R[327]={is_blue_verified:!0}}}},counts:$R[328]={bookmark_count:1,favorite_count:13,quote_count:0,reply_count:0,retweet_count:0},details:$R[329]={cashtag_entities:$R[330]=[],created_at_ms:1743671202000,display_text_range:$R[331]=[9,117],full_text:"@coolish 所以 其实这也是大资金大机构愿意去做比特币的原因\n\n同为交易员 真没那么多时间去研究宏观经济学\n大资金有80%仓位躺平比特币 小资金自己跟住热点 去链上P一下 保持对市场敏锐度 拿20%去玩山寨玩合约赌链上 就可以了",hashtag_entities:$R[332]=[],smarttags:$R[333]=[],timestamp_entities:$R[334]=[]},edit_control:$R[335]={__typename:"EditControlInitial",edit_tweet_ids:$R[336]=["1907721410195370248"]},grok_translated_post_with_availability:$R[337]={is_available:!1},id:"VHdlZXQ6MTkwNzcyMTQxMDE5NTM3MDI0OA==",legacy:$R[338]={lang:"zh"},media_entities2:$R[339]=[],mention_entities:$R[340]=[$R[341]={id_str:"28754022",indices:$R[342]=[0,8],screen_name:"coolish"}],reply_to_results:$R[343]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDc3MjAxODI0ODA2NDY1MzY=",rest_id:"1907720182480646536"},reply_to_user_results:$R[344]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[345]={__typename:"User",core:$R[346]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"1907721410195370248",url_entities:$R[347]=[],views:$R[348]={count:"4595"}}}}}}],metadata:$R[349]={conversation_metadata:$R[350]={all_tweet_ids:$R[351]=["1907721410195370248"],enable_deduplication:!0}}},entry_id:"conversationthread-1907721410195370248",sort_index:"2103760872387117036"},$R[352]={content:$R[353]={__typename:"TimelineTimelineModule",client_event_info:$R[354]={component:"tweet"},display_type:"VerticalConversation",items:$R[355]=[$R[356]={entry_id:"conversationthread-1907773126261485802-tweet-1907773126261485802",item:$R[357]={__typename:"TimelineTimelineItem",client_event_info:$R[358]={component:"tweet",details:$R[359]={conversation_details:$R[360]={conversation_section:"HighQuality"},timelines_details:$R[361]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcynrsAAAAAA=="}},element:"tweet"},content:$R[362]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[363]={id:"VHdlZXRSZXN1bHRzOjE5MDc3NzMxMjYyNjE0ODU4MDI=",rest_id:"1907773126261485802",result:$R[364]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[365]=[],core:$R[366]={user_results:$R[367]={id:"VXNlclJlc3VsdHM6MTA3MDIyMDY0MTk5Mzk0MDk5Mg==",result:$R[368]={__typename:"User",avatar:$R[369]={image_url:"https://pbs.twimg.com/profile_images/1762501312711979008/a9F51x2M_normal.jpg"},core:$R[370]={name:"问月wmoon | StableStock🐳",screen_name:"_wmoon"},id:"VXNlcjoxMDcwMjIwNjQxOTkzOTQwOTky",identity_profile_labels_highlighted_label:$R[371]={label:$R[372]={badge:$R[373]={url:"https://pbs.twimg.com/profile_images/1950491638486446080/FcZE1gGF_bigger.jpg"},description:"StableStock 🐳",url:$R[374]={url:"https://twitter.com/StableStock"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[375]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[376]={followers:11050,following:1235},rest_id:"1070220641993940992",super_follow_eligible:!1,tweet_counts:$R[377]={tweets:5495},verification:$R[378]={is_blue_verified:!0}}}},counts:$R[379]={bookmark_count:0,favorite_count:7,quote_count:0,reply_count:1,retweet_count:0},details:$R[380]={cashtag_entities:$R[381]=[],created_at_ms:1743683532000,display_text_range:$R[382]=[9,137],full_text:"@coolish 感谢魏神分享，之前一直囿于小资金做BTC盈亏比不高的误区，将大部分精力都放在链上。随着最近你开放的实盘，也开始试着做做BTC，在最近山寨meme泥沙俱下的境况中，反而有种大隐隐于市的沉浸感，对周期也慢慢有了感触，但仍然懂得太少，希望有更多分享，非常有帮助。",hashtag_entities:$R[383]=[],smarttags:$R[384]=[],timestamp_entities:$R[385]=[]},edit_control:$R[386]={__typename:"EditControlInitial",edit_tweet_ids:$R[387]=["1907773126261485802"]},grok_translated_post_with_availability:$R[388]={is_available:!1},id:"VHdlZXQ6MTkwNzc3MzEyNjI2MTQ4NTgwMg==",legacy:$R[389]={lang:"zh"},media_entities2:$R[390]=[],mention_entities:$R[391]=[$R[392]={id_str:"28754022",indices:$R[393]=[0,8],screen_name:"coolish"}],reply_to_results:$R[394]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDc3MjAxODI0ODA2NDY1MzY=",rest_id:"1907720182480646536"},reply_to_user_results:$R[395]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[396]={__typename:"User",core:$R[397]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"1907773126261485802",url_entities:$R[398]=[],views:$R[399]={count:"5072"}}}}}}],metadata:$R[400]={conversation_metadata:$R[401]={all_tweet_ids:$R[402]=["1907773126261485802"],enable_deduplication:!0}}},entry_id:"conversationthread-1907773126261485802",sort_index:"2103760872387117026"}]},$R[403]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[404]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[405]={id:"VHdlZXRSZXN1bHRzOjE5MDc3MjAxODI0ODA2NDY1MzY=",rest_id:"1907720182480646536",result:$R[406]={__typename:"Tweet",core:$R[407]={user_results:$R[408]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[409]={__typename:"User",avatar:$R[410]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[411]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",profile_bio:$R[412]={description:"crypto trader since 2013 / ex co-founder of social network apps with 50+ million users"}}}},counts:$R[413]={favorite_count:603,reply_count:54},details:$R[414]={full_text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ， https://t.co/881d7J0zkC",smarttags:$R[415]=[]},id:"VHdlZXQ6MTkwNzcyMDE4MjQ4MDY0NjUzNg==",note_tweet:$R[416]={note_tweet_results:$R[417]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTA3NzIwMTgyMjgzNTEzODU2",result:$R[418]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5MDc3MjAxODIyODM1MTM4NTY=",text:"在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。\n我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：\n2020年5月1日充值 1.83BTC ，\n2021年4月和12月，和2022年1月和2月提现过（图3）。\n\n2021年2月5日开始接入币coin开始统计至今，\n99%+的交易量都在BTC币本位合约上，\n统计结果如图1~2所示。\n2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。\n\n这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。\n\n这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。\n背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：\n就是大部分时候，炒BTC其实也可以不研究宏观，\n甚至！如果你想的话，\n只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：\n表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”\n但换一个角度理解，\nBTC小盘，是美股大盘，的“调研盘”。\n好比是之前有个人polymarket上赌trump赢，\n是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。\n可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。\n好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。\n那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。\n核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。\n这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。\n我精力有限，所以如无必要，勿增实体。\n\n当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。\n你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。\n长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，\n那么在过程里，面向寻求适合自己的路径\n（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），\n远比面向寻求一时一日的“结果”\n（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），\n要重要得多。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1907720182480646536:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/coolish" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@coolish" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_mini.jpg 24w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg 48w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_x96.jpg 96w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/coolish" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">paulwei</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1v5c9pimb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/coolish" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@coolish</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qqc9pimb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">在币圈如果只炒BTC，甚至极致到只专注BTC本身而忽视宏观，效果可以怎么样？相信很多人或多或少都想到过这个问题。
我最近在币coin实盘公开了一个多月的Bitmex账号（包含近4年数据），应该是一个很好的说明案例。这个账号目前为止：
2020年5月1日充值 1.83BTC ，
2021年4月和12月，和2022年1月和2月提现过（图3）。

2021年2月5日开始接入币coin开始统计至今，
99%+的交易量都在BTC币本位合约上，
统计结果如图1~2所示。
2022年11月（竖直线）之前，资金曲线比较“凉兮”，比较大起大落；在那之后，如同彻头彻尾换了一个人在操作，转向日拱一卒，“慢就是快”。

这个账号4、5年的操作过程里，大体上是我迭代的2.0~3.0阶段，有很多故事和经验总结可以讲，但说来话长，以后有机会再聊。

这里先顺便聊一个，炒BTC是否一定必须要关心宏观经济的问题。长期熟悉我的推友知道，我无论在推特还是微信，都几乎从来不聊不分析宏观。
背后其实有一个常年逐步通过实践在验证的暴论猜想，还没完全形成确定性结论：
就是大部分时候，炒BTC其实也可以不研究宏观，
甚至！如果你想的话，
只把BTC研究透了，并以此从BTC倒推美股大盘，也许也是可行的？：
表面上人会觉得“怎么可能小盘决定大盘？倒反天罡？”
但换一个角度理解，
BTC小盘，是美股大盘，的“调研盘”。
好比是之前有个人polymarket上赌trump赢，
是因为他使用了一种创造性的民间调研方式（问人“你觉得隔壁邻居会投票给谁？”），撇除了其余所有噪音，在茫茫信息海洋中提炼了关键信息差。他用一个局部小样本，去推演全局结果。
可能其实就是因为，全局的趋势倾向，与维度合适的某些局部小样本中也保持一致性。
好比是，我要决策明天要不要带雨伞出门，我不花很大力气去研究复杂的天气因子：气压、气温、风速、风向、湿度、海洋流动、云层等等来判断。我可以只看：今天蜻蜓有没有低飞， 蚂蚁有没有搬家。
那么就是，局部小样本里其实就已经包含了足够反映全局的关键信息。
核心前提是，两者的流动性来源重叠性是很高的，都来自相似的人群的偏高风险的美金钱包。
这也是为什么，专注btc本身，而未必一定要搞懂美股大盘，就也有机会做好btc交易的原因。要搞懂美股大盘，就相当于直接去研究那个全局数据，那因子就复杂多了，那就反而把这个问题的研究拓展复杂了。
我精力有限，所以如无必要，勿增实体。

当然我并非否定研究宏观的价值，我也经常阅读很多人分享的宏观分析，增加自己对别人角度的了解。并不会断定“我的路径是最好的，别的路径不好”，因为这就像不同门派的武功一样，每个人的擅长不一样，每个人可以“连接过去的点”不一样，就适合去修习不同的门派路子，汝之蜜糖彼之砒霜，或反之亦然。我反而是想说，很多条路径都可以通罗马，连我这种有点反直觉的路径都走到现在了还活在市场上，那么说明其中可行的路径的多元化数量，要远比大家想象得多。
你看到一个人在某一条路径上做得好，是个单一的结果，背后看不到的，可能是他试错了很多种路径后才筛选下来的结果。
长期来说，如果认为投资交易是自己要做很多年的事情，甚至是自己四五十岁后最终的可选落脚点之一，
那么在过程里，面向寻求适合自己的路径
（比如多开几个账号，同时试错不同的策略路径，彼此隔离开去benchmark，那么一轮周期下来可能验证了三四种路径对自己的适合度），
远比面向寻求一时一日的“结果”
（全部放在一个账号里，或者即使多个账号其实用的是同一种策略），
要重要得多。</span></div><div class="flex flex-col gap-1 empty:hidden"><div class="relative"><div class="flex flex-col"><div class="relative h-0" style="padding-bottom:68%"><div class="absolute -inset-0.5"><div class="group/carousel relative h-full"><div class="h-full w-full"><div class="scrollbar-hide flex overflow-x-auto gap-1 h-full snap-x snap-mandatory overscroll-x-contain py-0.5 -ms-3.5 -me-3.5 ps-4 pe-4"><div class="border-normal h-full min-h-0 min-w-[auto] shrink-0 snap-center overflow-hidden rounded-sm border" style="aspect-ratio:0.9330543933054395"><div class="relative h-full w-full"><div inert="" class="h-full w-full"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] block h-full w-full cursor-zoom-in appearance-none border-none bg-transparent p-0 text-inherit" aria-label="Image" href="/coolish/status/1907720182480646536/photo/1"><img fetchPriority="high" height="2868" width="2676" alt="" class="h-full w-full object-cover" decoding="async" loading="eager" sizes="(max-width: 600px) calc(100vw - 80px), 600px" src="https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&amp;name=large" srcSet="https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&amp;name=small 680w, https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&amp;name=medium 1200w, https://pbs.twimg.com/media/GnmGrq6aMAIOW66?format=webp&amp;name=large 2048w"/></a></div><a aria-label="View media" class="absolute inset-0 z-10" href="/coolish/status/1907720182480646536/photo/1"></a></div></div><div class="border-normal h-full min-h-0 min-w-[auto] shrink-0 snap-center overflow-hidden rounded-sm border" style="aspect-ratio:0.9330543933054395"><div class="relative h-full w-full"><div inert="" class="h-full w-full"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] block h-full w-full cursor-zoom-in appearanc