sults:$R[326]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",rest_id:"28754022",result:$R[327]={__typename:"User",core:$R[328]={screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",rest_id:"28754022"}},rest_id:"2051657202465968541",url_entities:$R[329]=[],views:$R[330]={count:"1248"}}}}}}],metadata:$R[331]={conversation_metadata:$R[332]={all_tweet_ids:$R[333]=["2051657202465968541"],enable_deduplication:!0}}},entry_id:"conversationthread-2051657202465968541",sort_index:"2103760848236314594"}]},$R[334]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[335]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[336]={id:"VHdlZXRSZXN1bHRzOjIwNTE2NDg4NTM5NjgwODUyODI=",rest_id:"2051648853968085282",result:$R[337]={__typename:"Tweet",core:$R[338]={user_results:$R[339]={id:"VXNlclJlc3VsdHM6Mjg3NTQwMjI=",result:$R[340]={__typename:"User",avatar:$R[341]={image_url:"https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg"},core:$R[342]={name:"paulwei",screen_name:"coolish"},id:"VXNlcjoyODc1NDAyMg==",profile_bio:$R[343]={description:"crypto trader since 2013 / ex co-founder of social network apps with 50+ million users"}}}},counts:$R[344]={favorite_count:215,reply_count:70},details:$R[345]={full_text:"很多人用GPT Image2生成：A网站但B风格/公司来做\n产生大波二创流量。由此我想到：为何止步于网站？\n所以我提出：游戏遗传学\n\nA厂游戏+B厂游戏，能不能生出新游戏儿子：AB？\n儿子AB若是再和CD“混血交配”遗传，\n生出孙子新游戏ABCD...以此类推\n\n未来会不会有一种游戏平台，“SteamX” https://t.co/y2jjGtTeWT",smarttags:$R[346]=[]},id:"VHdlZXQ6MjA1MTY0ODg1Mzk2ODA4NTI4Mg==",note_tweet:$R[347]={note_tweet_results:$R[348]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDUxNjQ4ODUzOTA1MTY2MzM2",result:$R[349]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjIwNTE2NDg4NTM5MDUxNjYzMzY=",text:"很多人用GPT Image2生成：A网站但B风格/公司来做\n产生大波二创流量。由此我想到：为何止步于网站？\n所以我提出：游戏遗传学\n\nA厂游戏+B厂游戏，能不能生出新游戏儿子：AB？\n儿子AB若是再和CD“混血交配”遗传，\n生出孙子新游戏ABCD...以此类推\n\n未来会不会有一种游戏平台，“SteamX”\nAI夜以继日24小时，排列组合生成无限的游戏混血种，\n玩家上去用“游玩时间”投票，\n达尔文式地淘汰筛选出，\n真正可玩、好玩的混血游戏“子嗣”？\n\n难道这就是一种，\n人类不需要工作，只需要天天玩，\n人类只需通过玩，来负责作为“品味筛选器”，\n让AI只管生产的，未来生产关系形态？\n\n我问了下Grok，他说过去从未有人提出这样的概念。\n\n不行了，不能再想了，我要去新建文件夹了。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:2051648853968085282:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/coolish" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@coolish" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_mini.jpg 24w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_normal.jpg 48w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_x96.jpg 96w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1548729057994452992/Kcs8r3YR_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflo