details:$R[238]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbijN0AAAAAA=="}},element:"tweet"},content:$R[239]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[240]={id:"VHdlZXRSZXN1bHRzOjE4NzAxNDE1NDYzODI5OTU5MDE=",rest_id:"1870141546382995901",result:$R[241]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[242]=[],core:$R[243]={user_results:$R[244]={id:"VXNlclJlc3VsdHM6OTk2MTQ4NDEzOTA4NDUxMzI5",result:$R[245]={__typename:"User",avatar:$R[246]={image_url:"https://pbs.twimg.com/profile_images/1948889078075981829/j0fWT5f3_normal.jpg"},core:$R[247]={name:"RWA Review",screen_name:"rwareview"},id:"VXNlcjo5OTYxNDg0MTM5MDg0NTEzMjk=",identity_profile_labels_highlighted_label:$R[248]={},privacy:$R[249]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[250]={followers:102,following:1554},rest_id:"996148413908451329",super_follow_eligible:!1,tweet_counts:$R[251]={tweets:415},verification:$R[252]={is_blue_verified:!1}}}},counts:$R[253]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:0,retweet_count:0},details:$R[254]={cashtag_entities:$R[255]=[],created_at_ms:1734711464000,display_text_range:$R[256]=[9,86],full_text:"@ZTZZBTC 当年不出那些政策，只是用现在的繁荣和进展来看的，如果当时没有清退，或许美帝这边更加严格监管，因为主动权不在美帝了，其实现在如果开放的话，反而是更好的结果。",hashtag_entities:$R[257]=[],smarttags:$R[258]=[],timestamp_entities:$R[259]=[]},edit_control:$R[260]={__typename:"EditControlInitial",edit_tweet_ids:$R[261]=["1870141546382995901"]},grok_translated_post_with_availability:$R[262]={is_available:!1},id:"VHdlZXQ6MTg3MDE0MTU0NjM4Mjk5NTkwMQ==",legacy:$R[263]={lang:"zh"},media_entities2:$R[264]=[],mention_entities:$R[265]=[$R[266]={id_str:"867227639416840192",indices:$R[267]=[0,8],screen_name:"ZTZZBTC"}],reply_to_results:$R[268]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4Njk4MTkwNjA0NzQ4MDIzMDM=",rest_id:"1869819060474802303"},reply_to_user_results:$R[269]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[270]={__typename:"User",core:$R[271]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1870141546382995901",url_entities:$R[272]=[],views:$R[273]={count:"400"}}}}}}],metadata:$R[274]={conversation_metadata:$R[275]={all_tweet_ids:$R[276]=["1870141546382995901"],enable_deduplication:!0}}},entry_id:"conversationthread-1870141546382995901",sort_index:"2103672834071986146"}]},$R[277]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[278]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[279]={id:"VHdlZXRSZXN1bHRzOjE4Njk4MTkwNjA0NzQ4MDIzMDM=",rest_id:"1869819060474802303",result:$R[280]={__typename:"Tweet",core:$R[281]={user_results:$R[282]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[283]={__typename:"User",avatar:$R[284]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[285]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[286]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[287]={favorite_count:162,reply_count:17},details:$R[288]={full_text:"在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。\n1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。 https://t.co/aV4nJGwBgV",smarttags:$R[289]=[]},id:"VHdlZXQ6MTg2OTgxOTA2MDQ3NDgwMjMwMw==",note_tweet:$R[290]={note_tweet_results:$R[291]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODY5ODE5MDYwMzkwOTQ4ODY0",result:$R[292]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE4Njk4MTkwNjAzOTA5NDg4NjQ=",text:"在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。\n1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。\n\n2，我短期不看好ORDI和铭文，我有且只有两个地推项目铭文在身上了。币安下架那难用的钱包，你们非要说币安和铭文对着干，今天下跌过程中，不少人抄ORDI，在我看来是幼稚的赌气行为。\n\n3，那个什么白痴大V李老师从传统行业过来发个披着MEME皮的狗屁项目，出货出的飞起。这是MEME出圈和到顶的标志。PUMP的MEME要暂缓。\n\n4，我也不理解为什么要喷币安的VC币，喷的原因无非是没有造富神话。那MEME你们都富了？\n我今天在MOVE用现货赚翻了，全程实盘公开喊单，很早就说了，这些VC币其实是非常容易赚钱的项目。\n\n6，MEME做空其实是非常简单的事情。时间维度上有非常简单的策略。所以NEIGO和PNUT这种币，收敛到最后，算一下时间维度就知道应该博方向，往下博。\n\n7，这两天的推特氛围极其诡异，反正就是两个字：浮躁。\n或者说，币安的SPACE像是点燃了整个推特的焦虑气氛。\n\n我建议老板们，可以整理一下KOL列表了。整理方法参考我以前的文章。\n\n8，本来想写一下MOVE这波操作的简单复盘的，但是太困了，算了。我觉得如果气氛正常，MOVE这种难度的二级币，肯定有很多人能抓到。\n\n9，美联储的终极目的，是篡夺币圈的自由发币权。以后，币圈发的野生项目，涨幅都有限。但是过美联储任何的币，或者进ETF的币，都会暴涨。\n没错，这个事情已经在灰度BTC预演过了。\n他们会用各种“钦点”的山寨币，去消除美国的资产泡沫。\n\n最TM让我生气的是，如果当年不出那些政策，不把矿场清退，这些，本可以都是我们的。\n\n最后，我要再说一次，我每次熊市都会说的那句话：欢迎来到山寨的熊市，娇贵的小多头们。\n\n这里磨牙吮血，杀人如麻。\n\n这里是生我养我的地方。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1869819060474802303:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@ZTZZBTC" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_mini.jpg 24w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg 48w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_x96.jpg 96w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">ZTZZ ฿</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_3r5c9pimb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-brand flex items-center" aria-label="HertzFlow | Mainnet Arc🎲" href="/Hertzflow_xyz"><img src="https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_normal.jpg" alt="HertzFlow | Mainnet Arc🎲" class="border-normal block size-[1em] shrink-0 overflow-hidden rounded-xxs border object-cover" loading="lazy"/></a></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/ZTZZBTC" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@ZTZZBTC</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qqc9pimb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。
1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。

2，我短期不看好ORDI和铭文，我有且只有两个地推项目铭文在身上了。币安下架那难用的钱包，你们非要说币安和铭文对着干，今天下跌过程中，不少人抄ORDI，在我看来是幼稚的赌气行为。

3，那个什么白痴大V李老师从传统行业过来发个披着MEME皮的狗屁项目，出货出的飞起。这是MEME出圈和到顶的标志。PUMP的MEME要暂缓。

4，我也不理解为什么要喷币安的VC币，喷的原因无非是没有造富神话。那MEME你们都富了？
我今天在MOVE用现货赚翻了，全程实盘公开喊单，很早就说了，这些VC币其实是非常容易赚钱的项目。

6，MEME做空其实是非常简单的事情。时间维度上有非常简单的策略。所以NEIGO和PNUT这种币，收敛到最后，算一下时间维度就知道应该博方向，往下博。

7，这两天的推特氛围极其诡异，反正就是两个字：浮躁。
或者说，币安的SPACE像是点燃了整个推特的焦虑气氛。

我建议老板们，可以整理一下KOL列表了。整理方法参考我以前的文章。

8，本来想写一下MOVE这波操作的简单复盘的，但是太困了，算了。我觉得如果气氛正常，MOVE这种难度的二级币，肯定有很多人能抓到。

9，美联储的终极目的，是篡夺币圈的自由发币权。以后，币圈发的野生项目，涨幅都有限。但是过美联储任何的币，或者进ETF的币，都会暴涨。
没错，这个事情已经在灰度BTC预演过了。
他们会用各种“钦点”的山寨币，去消除美国的资产泡沫。

最TM让我生气的是，如果当年不出那些政策，不把矿场清退，这些，本可以都是我们的。

最后，我要再说一次，我每次熊市都会说的那句话：欢迎来到山寨的熊市，娇贵的小多头们。

这里磨牙吮血，杀人如麻。

