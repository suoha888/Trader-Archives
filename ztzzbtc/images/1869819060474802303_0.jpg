})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="Zcso1yEJ73DDWiam3DBVqw==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="Zcso1yEJ73DDWiam3DBVqw==">($R=>$R[69].next($R[71]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1869819060474802303\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="Zcso1yEJ73DDWiam3DBVqw==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="Zcso1yEJ73DDWiam3DBVqw==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="Zcso1yEJ73DDWiam3DBVqw==">($R=>$R[69].next($R[72]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1869819060474802303\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[73]={kind:"Result.Ok",value:$R[74]={data:$R[75]={threaded_conversation_with_injections_v2:$R[76]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[77]=[$R[78]={__typename:"TimelineClearCache"},$R[79]={__typename:"TimelineAddEntries",entries:$R[80]=[$R[81]={content:$R[82]={__typename:"TimelineTimelineItem",client_event_info:$R[83]={component:"tweet",element:"tweet"},content:$R[84]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[85]={id:"VHdlZXRSZXN1bHRzOjE4Njk4MTkwNjA0NzQ4MDIzMDM=",rest_id:"1869819060474802303",result:$R[86]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[87]=[],core:$R[88]={user_results:$R[89]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5ND