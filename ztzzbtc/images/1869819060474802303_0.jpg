 r-13gxpu9 r-4qtqp9 r-yyyyoo r-wy61xf r-1d2f490 r-bqkkf0 r-ywje51 r-dnmrzs r-u8s1d r-zchlnj r-1plcrui r-ipm5af r-lrvibr r-1blnp2b"><g><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path><path d="M 10,30 C 69,202 160,199 49,96 h 187 s 202,145 198,155 C 76,207 117,30 103,83 h 130 s 136,169 80,214 C 127,143 102,35 59,31 h 251 s 51,4 46,50 C 147,138 103,26 245,239 h 66 s 227,111 230,49 C 71,98 142,81 255,5 h 211 s 150,37 111,19 C 230,50 234,228 54,156 h 162 s 208,160 96,198 C 89,244 151,38 149,147 h 199 s 160,124 148,176 C 198,146 6,174 164,101 h 109 s 45,227 203,77 C 96,35 184,78 129,209 h 113 s 236,129 187,87 C 175,84 98,10 213,9 h 198 s 234,78 64,180 C 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="Zcso1yEJ73DDWiam3DBVqw==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790389661932,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀ZTZZBTC",u:1790389661932,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀ZTZZBTC␀status␀1869819060474802303␀{}",u:1790389662245,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg",authorDescription:void 0,authorName:"ZTZZ ฿",focalTweetId:"1869819060474802303",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1869819060474802303",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"ZTZZ ฿ profile picture",url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_400x400.jpg"},screenName:"ZTZZBTC",url:"https://x.com/ZTZZBTC"},bodyText:"在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。\n1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。\n\n2，我短期不看好ORDI和铭文，我有且只有两个地推项目铭文在身上了。币安下架那难用的钱包，你们非要说币安和铭文对着干，今天下跌过程中，不少人抄ORDI，在我看来是幼稚的赌气行为。\n\n3，那个什么白痴大V李老师从传统行业过来发个披着MEME皮的狗屁项目，出货出的飞起。这是MEME出圈和到顶的标志。PUMP的MEME要暂缓。\n\n4，我也不理解为什么要喷币安的VC币，喷的原因无非是没有造富神话。那MEME你们都富了？\n我今天在MOVE用现货赚翻了，全程实盘公开喊单，很早就说了，这些VC币其实是非常容易赚钱的项目。\n\n6，MEME做空其实是非常简单的事情。时间维度上有非常简单的策略。所以NEIGO和PNUT这种币，收敛到最后，算一下时间维度就知道应该博方向，往下博。\n\n7，这两天的推特氛围极其诡异，反正就是两个字：浮躁。\n或者说，币安的SPACE像是点燃了整个推特的焦虑气氛。\n\n我建议老板们，可以整理一下KOL列表了。整理方法参考我以前的文章。\n\n8，本来想写一下MOVE这波操作的简单复盘的，但是太困了，算了。我觉得如果气氛正常，MOVE这种难度的二级币，肯定有很多人能抓到。\n\n9，美联储的终极目的，是篡夺币圈的自由发币权。以后，币圈发的野生项目，涨幅都有限。但是过美联储任何的币，或者进ETF的币，都会暴涨。\n没错，这个事情已经在灰度BTC预演过了。\n他们会用各种“钦点”的山寨币，去消除美国的资产泡沫。\n\n最TM让我生气的是，如果当年不出那些政策，不把矿场清退，这些，本可以都是我们的。\n\n最后，我要再说一次，我每次熊市都会说的那句话：欢迎来到山寨的熊市，娇贵的小多头们。\n\n这里磨牙吮血，杀人如麻。\n\n这里是生我养我的地方。",canonicalPath:"/ZTZZBTC/status/1869819060474802303",canonicalUrl:"https://x.com/ZTZZBTC/status/1869819060474802303",description:"在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。\n1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。\n\n2，我短期不看好ORDI和铭文，我有且只有两个地推项目铭文在身上了。币安下架那难用的钱包，你们非要说币安和铭文对着干，今天下跌过程中，不少人抄ORDI，在我看来是幼稚的赌气行为。\n\n3，那个什么白痴大V李老师从传统行业过来发个披着MEME皮的狗屁项目，出货出的飞起。这是MEME出圈和到顶的标志。PUMP的MEME要暂缓。\n\n4，我也不理解为什么要喷币安的VC币，喷的原因无非是没有造富神话。那MEME你们都富了？\n我今天在MOVE用现货赚翻了，全程实盘公开喊单，很早就说了，这些VC币其实是非常容易赚钱的项目。\n\n6，MEME做空其实是非常简单的事情。时间维度上有非常简单的策略。所以NEIGO和PNUT这种币，收敛到最后，算一下时间维度就知道应该博方向，往下博。\n\n7，这两天的推特氛围极其诡异，反正就是两个字：浮躁。\n或者说，币安的SPACE像是点燃了整个推特的焦虑气氛。\n\n我建议老板们，可以整理一下KOL列表了。整理方法参考我以前的文章。\n\n8，本来想写一下MOVE这波操作的简单复盘的，但是太困了，算了。我觉得如果气氛正常，MOVE这种难度的二级币，肯定有很多人能抓到。\n\n9，美联储的终极目的，是篡夺币圈的自由发币权。以后，币圈发的野生项目，涨幅都有限。但是过美联储任何的币，或者进ETF的币，都会暴涨。\n没错，这个事情已经在灰度BTC预演过了。\n他们会用各种“钦点”的山寨币，去消除美国的资产泡沫。\n\n最TM让我生气的是，如果当年不出那些政策，不把矿场清退，这些，本可以都是我们的。\n\n最后，我要再说一次，我每次熊市都会说的那句话：欢迎来到山寨的熊市，娇贵的小多头们。\n\n这里磨牙吮血，杀人如麻。\n\n这里是生我养我的地方。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:900,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/GfLuaSPasAITvm7?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/GfLuaSPasAITvm7?format=webp&name=small 680w, https://pbs.twimg.com/media/GfLuaSPasAITvm7?format=webp&name=medium 1200w, https://pbs.twimg.com/media/GfLuaSPasAITvm7?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/GfLuaSPasAITvm7?format=webp&name=large",width:1600},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2024-12-19T18:56:18.000Z",replyCount:17,schema:void 0,socialTitle:"ZTZZ ฿ (@ZTZZBTC) on X",title:"ZTZZ ฿ on X: \"在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。\n1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。\n\n2，我短期不看好ORDI和铭文，我有且只有两个地推项目铭文在身上了。币安下架那难用的钱包，你们非要说币安和铭文对着干，今天下跌过程中，不少人抄ORDI，在我看来是幼稚的赌气行为。\n\n3，那个什么白痴大V李老师从传统行业过来发个披着MEME皮的狗屁项目，出货出的飞起。这是MEME出圈和到顶的标志。PUMP的MEME要暂缓。\n\n4，我也不理解为什么要喷币安的VC币，喷的原因无非是没有造富神话。那MEME你们都富了？\n我今天在MOVE用现货赚翻了，全程实盘公开喊单，很早就说了，这些VC币其实是非常容易赚钱的项目。\n\n6，MEME做空其实是非常简单的事情。时间维度上有非常简单的策略。所以NEIGO和PNUT这种币，收敛到最后，算一下时间维度就知道应该博方向，往下博。\n\n7，这两天的推特氛围极其诡异，反正就是两个字：浮躁。\n或者说，币安的SPACE像是点燃了整个推特的焦虑气氛。\n\n我建议老板们，可以整理一下KOL列表了。整理方法参考我以前的文章。\n\n8，本来想写一下MOVE这波操作的简单复盘的，但是太困了，算了。我觉得如果气氛正常，MOVE这种难度的二级币，肯定有很多人能抓到。\n\n9，美联储的终极目的，是篡夺币圈的自由发币权。以后，币圈发的野生项目，涨幅都有限。但是过美联储任何的币，或者进ETF的币，都会暴涨。\n没错，这个事情已经在灰度BTC预演过了。\n他们会用各种“钦点”的山寨币，去消除美国的资产泡沫。\n\n最TM让我生气的是，如果当年不出那些政策，不把矿场清退，这些，本可以都是我们的。\n\n最后，我要再说一次，我每次熊市都会说的那句话：欢迎来到山寨的熊市，娇贵的小多头们。\n\n这里磨牙吮血，杀人如麻。\n\n这里是生我养我的地方。\""},replyCount:17,screenName:"ZTZZBTC",status:"available",text:"在我睡觉前，发点随笔。如果得罪了某些KOL，那就得罪吧。\n1，BTC以后和山寨币是两个东西了。BTC由USDT和美元两个一般等价物驱动。山寨币只有USDT驱动。山寨的造富神话将会进一步下降，相对应的，这对社区好的项目方是天大的机会。\n\n2，我短期不看好ORDI和铭文，我有且只有两个地推项目铭文在身上了。币安下架那难用的钱包，你们非要说币安和铭文对着干，今天下跌过程中，不少人抄ORDI，在我看来是幼稚的赌气行为。\n\n3，那个什么白痴大V李老师从传统行业过来发个披着MEME皮的狗屁项目，出货出的飞起。这是MEME出圈和到顶的标志。PUMP的MEME要暂缓。\n\n4，我也不理解为什么要喷币安的VC币，喷的原因无非是没有造富神话。那MEME你们都富了？\n我今天在MOVE用现货赚翻了，全程实盘公开喊单，很早就说了，这些VC币其实是非常容易赚钱的项目。\n\n6，MEME做空其实是非常简单的事情。时间维度上有非常简单的策略。所以NEIGO和PNUT这种币，收敛到最后，算一下时间维度就知道应该博方向，往下博。\n\n7，这两天的推特氛围极其诡异，反正就是两个字：浮躁。\n或者说，币安的SPACE像是点燃了整个推特的焦虑气氛。\n\n我建议老板们，可以整理一下KOL列表了。整理方法参考我以前的文章。\n\n8，本来想写一下MOVE这波操作的简单复盘的，但是太困了，算了。我觉得如果气氛正常，MOVE这种难度的二级币，肯定有很多人能抓到。\n\n9，美联储的终极目的，是篡夺币圈的自由发币权。以后，币圈发的野生项目，涨幅都有限。但是过美联储任何的币，或者进ETF的币，都会暴涨。\n没错，这个事情已经在灰度BTC预演过了。\n他们会用各种“钦点”的山寨币，去消除美国的资产泡沫。\n\n最TM让我生气的是，如果当年不出那些政策，不把矿场清退，这些，本可以都是我们的。\n\n最后，我要再说一次，我每次熊市都会说的那句话：欢迎来到山寨的熊市，娇贵的小多头们。\n\n这里磨牙吮血，杀人如麻。\n\n这里是生我养我的地方。"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[14]={messagesBeforeDehydration:$R[15]=[$R[16]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1869819060474802303\"}",name:"TweetResultByRestId"},$R[17]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1869819060474802303\"}",result:$R[18]={kind:"Result.Ok",value:$R[19]={data:$R[20]={tweet_result_by_rest_id:$R[21]={id:"VHdlZXRSZXN1bHRzOjE4Njk4MTkwNjA0NzQ4MDIzMDM=",rest_id:"1869819060474802303",result:$R[22]={__typename:"Tweet",cashtag_attachments:$R[23]=[],core:$R[24]={user_results:$R[25]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[26]={__typename:"User",avatar:$R[27]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[28]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[29]={label:$R[30]={badge:$R[31]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[32]={url:"https://twitter