7]={id:"VHdlZXRSZXN1bHRzOjE5OTAzNzA1MTY3NjM1NjIyMTg=",rest_id:"1990370516763562218",result:$R[288]={__typename:"Tweet",core:$R[289]={user_results:$R[290]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[291]={__typename:"User",avatar:$R[292]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[293]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[294]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[295]={favorite_count:51,reply_count:21},details:$R[296]={full_text:"把师父拉进了群。\n一般在外面我不说这人是我师父，我有时候处事不够沉稳，虽然这两年好了很多，但是还是怕给他丢人。\n为了超越师父，这几年学了很多奇奇怪怪坐庄侧的东西，做了一堆奇奇怪怪的项目。\n为了感谢师父和老板们当年带我，我每年都花很多时间认真教学生。 https://t.co/WMZv61k0gd",smarttags:$R[297]=[]},id:"VHdlZXQ6MTk5MDM3MDUxNjc2MzU2MjIxOA==",note_tweet:$R[298]={note_tweet_results:$R[299]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTkwMzcwNTE2Njk2NTIyNzUy",result:$R[300]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5OTAzNzA1MTY2OTY1MjI3NTI=",text:"把师父拉进了群。\n一般在外面我不说这人是我师父，我有时候处事不够沉稳，虽然这两年好了很多，但是还是怕给他丢人。\n为了超越师父，这几年学了很多奇奇怪怪坐庄侧的东西，做了一堆奇奇怪怪的项目。\n为了感谢师父和老板们当年带我，我每年都花很多时间认真教学生。\n今年真的教出不少年轻有为的，过去播下的种子也算开花结果。\n感谢师父，当年坐了你的911，选择梭哈币圈，是我这辈子最幸运和正确的事情。@coolish\n永远爱你！"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1990370516763562218:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visib