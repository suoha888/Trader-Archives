52]={id_str:"1057065727",indices:$R[253]=[157,170],screen_name:"Nyenchenpepe"},$R[254]={id_str:"1350979881924964357",indices:$R[255]=[172,185],screen_name:"Cryptodengta"},$R[256]={id_str:"1595489335221944321",indices:$R[257]=[187,202],screen_name:"crypto_chanshi"},$R[258]={id_str:"1195728139898376193",indices:$R[259]=[204,219],screen_name:"0xcryptowizard"},$R[260]={id_str:"857226895695335424",indices:$R[261]=[221,235],screen_name:"minimisue2022"},$R[262]={id_str:"1542042946161512448",indices:$R[263]=[236,244],screen_name:"DWFLabs"},$R[264]={id_str:"708561855141183488",indices:$R[265]=[245,253],screen_name:"ethanyu"},$R[266]={id_str:"986453873907781634",indices:$R[267]=[254,264],screen_name:"TeddyAC01"},$R[268]={id_str:"44196397",indices:$R[269]=[265,274],screen_name:"elonmusk"},$R[270]={id_str:"902839045356744704",indices:$R[271]=[275,289],screen_name:"justinsuntron"}]},id:"Tm90ZVR3ZWV0OjE4NjQ1MjM0MTY3MDA4OTkzMzA=",rest_id:"1864523416700899330",text:"@youyou5202\n\n@thecryptoskanda\n\n@coolish\n\n@jackyyyso\n\n@CG_BRC20\n\n@cryptopainter\n\n@enheng456\n\n@Mirro7777\n\n@web3baoan\n\n@TutuCrypto\n\n@xiejiayinBitget\n\n@Mulan0x\n\n@Nyenchenpepe \n@Cryptodengta\n\n@crypto_chanshi\n\n@0xcryptowizard\n\n@minimisue2022\n@DWFLabs\n@ethanyu\n@TeddyAC01\n@elonmusk\n@justinsuntron"}}},reply_to_results:$R[272]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NjQ1MjMxOTk2OTE4MDQ5MDU=",rest_id:"1864523199691804905"},reply_to_user_results:$R[273]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[274]={__typename:"User",core:$R[275]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1864523416776396830",url_entities:$R[276]=[],views:$R[277]={count:"5216"}}}}}},$R[278]={entry_id:"conversationthread-1864523416776396830-tweet-1864523617478078722",item:$R[279]={__typename:"TimelineTimelineItem",client_event_info:$R[280]={component:"tweet",details:$R[281]={conversation_details:$R[282]={conversation_section:"HighQuality"},timelines_details:$R[283]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiZNHAAAAAA=="}},element:"tweet"},content:$R[284]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[285]={id:"VHdlZXRSZXN1bHRzOjE4NjQ1MjM2MTc0NzgwNzg3MjI=",rest_id:"1864523617478078722",result:$R[286]={__isTweetResult:"Tweet",__typename:"Tweet",card:$R[287]={id:"Q2FyZDpodHRwczovL3QuY28vTHFwUmQzUVRVNA=="},cashtag_attachments:$R[288]=[],core:$R[289]={user_results:$R[290]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[291]={__typename:"User",avatar:$R[292]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[293]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[294]={label:$R[295]={badge:$R[296]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[297]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[298]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[299]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[300]={tweets:3544},verification:$R[301]={is_blue_verified:!0}}}},counts:$R[302]={bookmark_count:6,favorite_count:8,quote_count:0,reply_count:0,retweet_count:3},details:$R[303]={cashtag_entities:$R[304]=[],created_at_ms:1733372046000,display_text_range:$R[305]=[0,48],full_text:"https://t.co/LqpRd3QTU4\n散户情顺便把之前的文章看了。还有的文章在置顶里。",hashtag_entities:$R[306]=[],smarttags:$R[307]=[],timestamp_entities:$R[308]=[]},edit_control:$R[309]={__typename:"EditControlInitial",edit_tweet_ids:$R[310]=["1864523617478078722"]},grok_translated_post_with_availability:$R[311]={is_available:!1},id:"VHdlZXQ6MTg2NDUyMzYxNzQ3ODA3ODcyMg==",legacy:$R[312]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[313]=[],mention_entities:$R[314]=[],quoted_tweet_results:$R[315]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NTA5MDMyNzQ3MjEwNTA5ODI=",rest_id:"1850903274721050982",result:$R[316]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[317]=[],core:$R[318]={user_results:$R[319]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[320]={__typename:"User",avatar:$R[321]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[322]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[323]={label:$R[324]={badge:$R[325]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[326]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[327]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[328]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[329]={tweets:3544},verification:$R[330]={is_blue_verified:!0}}}},counts:$R[331]={bookmark_count:732,favorite_count:972,quote_count:45,reply_count:401,retweet_count:284},details:$R[332]={cashtag_entities:$R[333]=[],created_at_ms:1730124703000,display_text_range:$R[334]=[0,123],full_text:"这阵子连续做了6个MEME，连续熬夜给我身体整差了，拿赚了的钱周六去买了个最好的SUV，这两天才休息休息，还TM吃坏了肚子腹泻了。随便写点这几天有感而发的东西，给新人和币圈项目方，VC和交易所看，比较乱，但全是硬干货，请自取：\n\n对项目方：\n1， https://t.co/VSDz03dN9q",hashtag_entities:$R[335]=[],smarttags:$R[336]=[],timestamp_entities:$R[337]=[]},edit_control:$R[338]={__typename:"EditControlInitial",edit_tweet_ids:$R[339]=["1850903274721050982"]},grok_translated_post_with_availability:$R[340]={is_available:!1},id:"VHdlZXQ6MTg1MDkwMzI3NDcyMTA1MDk4Mg==",legacy:$R[341]={possibly_sensitive:!1},media_entities2:$R[342]=[$R[343]={additional_media_info:$R[344]={monetizable:!1},allow_download_status:$R[345]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1850903274721050982/video/1",ext_media_availability:$R[346]={status:"Available"},ext_playlists:$R[347]=[],id_str:"1850898488177070080",indices:$R[348]=[124,147],media_url_https:"https://pbs.twimg.com/ext_tw_video_thumb/1850898488177070080/pu/img/-bBZqTCSbRCn-JV_.jpg",original_info:$R[349]={height:480,width:853},type:"video",video_info:$R[350]={duration_millis:120278,variants:$R[351]=[$R[352]={content_type:"application/x-mpegURL",url:"https://video.twimg.com/ext_tw_video/1850898488177070080/pu/pl/qWex2UIPrlCjMvlc.m3u8?tag=12&v=cd7"},$R[353]={bitrate:256000,content_type:"video/mp4",url:"https://video.twimg.com/ext_tw_video/1850898488177070080/pu/vid/avc1/478x270/eFEQHVjRg8pl9vYC.mp4?tag=12"},$R[354]={bitrate:832000,content_type:"video/mp4",url:"https://video.twimg.com/ext_tw_video/1850898488177070080/pu/vid/avc1/638x360/-EXD1RJbNf7ZNwsk.mp4?tag=12"},$R[355]={bitrate:2176000,content_type:"video/mp4",url:"https://video.twimg.com/ext_tw_video/1850898488177070080/pu/vid/avc1/852x480/rz4NYb2-Lup_asdv.mp4?tag=12"}]}}],mention_entities:$R[356]=[],note_tweet:$R[357]={is_expandable:!0,note_tweet_results:$R[358]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODUwOTAzMjc0MzUxOTcyMzUy",result:$R[359]={__typename:"NoteTweet",entity_set:$R[360]={hashtags:$R[361]=[],symbols:$R[362]=[],timestamps:$R[363]=[],urls:$R[364]=[],user_mentions:$R[365]=[]},id:"Tm90ZVR3ZWV0OjE4NTA5MDMyNzQzNTE5NzIzNTI=",rest_id:"1850903274351972352",text:"这阵子连续做了6个MEME，连续熬夜给我身体整差了，拿赚了的钱周六去买了个最好的SUV，这两天才休息休息，还TM吃坏了肚子腹泻了。随便写点这几天有感而发的东西，给新人和币圈项目方，VC和交易所看，比较乱，但全是硬干货，请自取：\n\n对项目方：\n1， 请项目方放下你们傲慢的架子，多去看看散户和金狗猎手是怎么打MEME的。这个牛熊里，很多项目方连VC币的社区都做不好，就不用谈做好MEME的社区。如果你越傲慢，你对MEME生态的认知一定越低。🙄\n\n2， MEME对于项目方的要求会更高，没有不教学费就能把MEME搞好的项目方。某上大交易所的MEME项目方，连续发了一个月的MEME试错。⌚️⌚️⌚️\n\n3， MEME项目的三个关键是：传播链，筹码分配，MEME题材。这三者共同作用，是保证了MEME的爆发性传播。但最近的MEME项目基本都忽视了MEME题材的重要性，这保证了MEME的上限。\n\n你在买AI16Z的时候，是在买A16Z关注了这个项目从而产生的短暂热度，还是在买AI16Z本身呢？\nMEME的题材注定了一些MEME是绝无可能做大做强甚至是上交易所，所以到某些关键心理位市值，差不多就可以抛了 。⤵️\n\n4，请项目方和VC点开我主页置顶文章中的《Z级MEME模因论》熟读此文章并套例和举一反三。💵💴💶💷\n\n5，过去认为MEME不用做市商。因为做市商的本质是“提供流动性”和“设定做市计划并灵活应变”。但是我最近的实战经验告诉我：MEME也需要做市商。\n\n主要是事先的抛售计划，筹码的分配，优秀的链上能力，对MEME项目的理解和经验，然后是极其强大的应变能力，出货但不改变原有走势的能力。\n不建议传统做市商团队跑来玩MEME。但建议优秀MEME项目方配备一个接地气的市值管理人员。这点到后续不忙的时候写市值管理知识的时候再说。🕊️🕊️\n\n6，对绝大多数想做MEME的项目方而言，困扰你们的绝对是传播链。对此我也没有什么好的办法，毕竟这是比拼大家实力的关键点。\n\n但我可以给大家3点建议：\n一，求求你们找一个好一点的，接地气的运营总监吧。运营总监靠的是脑子灵活举一反三，不是在什么传统大企业任职过。🧐\n二，让这个运营总监去筛选KOL，多查查人家的真实流量，别被倒腾流量的人当傻子割了，最后完全无交易量。\n三，如果以上两个你都搞不定，那实打实的去做社区其实是很好的方法，不要急。\n\n还有，我真的一个运营总监都没有了，你们总不能指望我亲自下场吧。同志们，别问我要运营总监了。🆘\n\n对交易所和VC：\n7，在我眼里币圈的MEME至少已经更新迭代过两次打法，步入了3.0时代。\n一开始是DOGE和SHIB为代表的MEME币，这类币发展过程中会有大量的深度洗盘和换手，MEME的三要素：传播频率，传播耗损，存亡时长都是顶级。属于是最完美的MEME。💕\n\n2.0时代是TROLL和BOME这一类，由于MEME的造富神话培养了用户习惯，所以2.0时代的MEME上涨速度极快，洗盘极少。交易所为了获得用户，尽快上币，更加速了这一过程。他们往往伴随着长时间的洗盘，甚至趋于死亡。这一环节里，坐庄的都是对币圈MEME有长时间了解，能做好大范围营销事件，集中币圈注意力的高手。❤️\n\n3.0时代比较特殊，1.0时代里就有过的动物园币和2.0时代一直有的热点币，在3.0时代终于被发扬光大，因为MEME的造富神话进一步培养用户，且缺乏VC币的造富效应，场内玩家注意力进一步集中到MEME题材。\n\n散户失去建设和推广MEME社区的耐心，不再有洗盘时间，短期内的急速拉升或者死亡更加明显。市场中类似养蛊，流量呈现常年分散状态，但这也预示着币圈顶部如马斯克对流量的聚合效应会更加明显。🈹\n市场内同时进入了各种坐庄侧高手，诞生了诸如PUMP这类的玩法变化，优化坐庄侧，为MEME生态持续造血。\n\n8，交易所和VC要先想明白，不同级别的MEME的项目方是怎么赚钱的。根据自己交易所大小排名的实际情况出发，去组织专门研究MEME的人，最好建立一套自己的上币逻辑或者投资逻辑。这部分我也有点经验，都可以分享。\n\n我本来是在9月KBW和某交易所的投资部老大聊了MEME，他认为MEME是市场接下来除了TON的唯一热点。我比较擅长MEME，于是回来整理了一个供交易所、VC、项目方使用的MEME币筛选评分系统想给他。🉑\n这个系统最不好做的两点，一个是MEME坐庄方式的更新换代太快，一个是MEME项目传播能力的研究可能存在研究案例少的情况。本来只是想和他私聊一下的。结果我两9月末都忙，互相鸽子了。。。。。\n\n如果有VC或者交易所的LISTING需要，直接私我，晚点拉个群给你们直接分享了。我11月10日会去曼谷参加WOWSUMMIT，到时候组个私局线下聊也行。\n散户别找我要了，你们拿这个没用。😂\n\n9，我不认为CEX交易所可以从MEME里获得特别大的好处，MEME的核心玩家和CEX的玩家，用户画像差距非常大。但我依然建议CEX交易所去抓大流量的MEME，这里或许存在三线交易所弯道超车成为二线头部交易所的机会。我知道有些小交易所在做了，但恕我直言，做的不够好。🧐\n\n10，接第九点插播一条。我真挚的建议小交易所和VC，多去招一点常年在币圈一线，有丰富项目经验，有自己方法论的人。\n\n目前币圈的顶部资源已经形成，各大庄家的组局能力基本稳定下来。下面拼的是对币圈风向的把握和快速攒局并执行落地的能力。\n\n铭文和MEME，哪一个不是先从散户中爆发，再开始引资本入局的？顶部的人脉资源几乎固定时，如果交易所或VC有一个极其富有坐庄思维并且常年抓各种热点的老镰刀做中层的支柱人物，他就可以快速反馈给交易所或VC的负责人，并做出弯道超车的决策，攫取巨大的ALPHA利润。我举个例子吧，BRC420（也就是MERL）就是吃到了这样的人带来的红利。💶\n\n如果你实在找不到这样的老家伙，找主观能动性极强，有一技之长的20年左右入圈的人也是OK的，不建议培养新人。\n\n11，关于产品侧，很多BOT机器人之类和MEME相关的产品正在井喷，等等也会进入融资阶段。我不建议VC在没有特别好的投资逻辑和投资轮次时，投关于MEME的工具类产品或者流量类产品，这一类大多是伪需求或者用户获取难度极高，要投的话可选范围其实很窄。💴\n\n如果是PUMP类产品则另外讨论。翻我推特，我在PUMP刚刚火的时候就说那阵子我看了至少6个PUMP的仿盘。PUMP类产品本质上是坐庄侧的优化，谁能寻找到坐庄侧和散户侧那最完美的平衡，充分调动散户的流动性为庄家服务，尽早产生造富神话并持续，谁就是最后的胜者。💵\n给VC和交易所能聊的还有很多，不放在这里细说了。\n\n给散户的放到最后吧：\n12，99.99%的社区都不会带你赚钱，无论是免费的还是付费的。免费的优质社区带你赚钱的概率反而更高。🙏\n\n13，国外的KOL或者MEME大佬高胜率，其实是个伪命题。他们中间的大多数KOL都是接MEME项目方的宣传接到麻了的。😂\n\n14，DEX是币圈既BTC和ICO之后最伟大的发明，而MEME就是DEX皇冠上最耀眼的宝石。我有一个在币圈也算是传奇的老群，名字就叫“请DEX教CEX做人”。请绝对不要怀疑MEME的伟大力量，因为MEME是贴近人类行为学和币圈本质的产物。不过放心，MEME的造富能力很快也会下降的，这是必然。⌚️\n\n15，放心吧，你们看见的外面流传的大部分什么MEME捕捉方法，我看过不少了，他们中间90%都会很快被迭代掉。去思考和寻找那些变化过程中的底层不变逻辑，是脱离散户的重要过程。\n\n16，接上条，从底层逻辑上来说，现在太多散户都陷入了一个误区：要尽早的抓住MEME，所以要细化信息捕捉系统，细化筛选KOL和筛选老鼠仓。\n但大多数人又一定会卖飞。金狗高手们扪心自问，你们是不是都进的很早，但大多卖飞了？\n\n其实在我做过一些项目后反过来看，很多金狗猎手真的不用再细化信息捕捉了，你们的方法论完全够用了，但庄与庄之间是有很大区别的，这点对散户而言是很难辨识的。\n能意识到MEME的叙事上限，以及二级买入时机，再细化一下仓位管理，诞生完整的MEME领域的交易系统，是更重要，更长远的事情。也更有利于你把握住千倍币。🉑\n\n如果你作为KOL，有优秀MEME社区的也请顺便联系我一下。谢谢。\n\n17，我始终认为，如果你是23年进圈的新人，MEME对你来说其实并不是一个学习板块，因为有太多币圈行业必须的东西，只玩MEME是学不会的。但MEME对新人是一个好的历练板块，打MEME打得好的人，执行力和总结能力一定碾碎同人，你就有了向上走的第一块敲门砖。🧐\n\n18，最近找我咨询发MEME项目的23年新人有点多了，就好像21年在我面前吹自己盈利能力如何牛逼，说要做大做强的一些新VC一样。🙄\n我是币圈出了名的没啥架子，我很乐于告诉你们一些干货，帮你们少走弯路。如果你真的在MEME赚到了钱，并且想继续在币圈从业，研究坐庄侧的东西，我很欢迎你来和我讨论。但请信我，MEME项目在现阶段并不好做，你应该试着从传统的小项目入手。\n\n19，MEME社区里的杂音太大了。请散户多思考KOL的话语，识别他们是否真的有赚钱能力。币圈很多人会把自己真实赚钱的方式包装起来，比如某个混蛋把自己包装成做市商实际上是卖马克杯割韭菜的。多思考你跟的那些KOL是怎么赚钱的。多想想自己为什么不赚钱。\n冲MEME会让你常年保持高度兴奋的心流状态，忽视对自己的反思总结。😂\n\n20，最后我想抱怨一句，好多散户推特私信我，我问他干啥。他就回我：加群/带带。\n我真的算是币圈脾气好的。换成别人早喷你或者拉个群割你了。\n就算是在传统领域，大学一毕业就该学会给别人发私信不要发：“在吗？”而要说明自己的来历和想法，减少沟通成本。还有就是想让大佬们带你的前提是，你自己在一群人中起码是比较支棱的那个人。🙏\n\n币圈对新人算是最包容的地方了。很多我这样的币圈老人，都是受了现在币圈头部那帮行业先行者的提携和恩惠，所以我的文章最后总是愿意给散户们多说两句的。\n\n这个行业比起传统行业，永远有更好的机会。不要抱怨头部的人拿了太多的利益，不要抱怨KOL割了你，多去思考，多去培养自己的一技之长。不要做散户，是在币圈走向成功的第一步，也是最重要的一步。\n\n让我依然引用伟大的川皇特朗普的名言结束这段过长的文章：\n “Over the course of your life,you will find that things are not always fair. You will find that things happen to you, that you do not deserve and that are not always warranted. But you have to put your head down and fight,fight,fight. Never,ever,ever give up.Things will work out just fine.”\n特朗普在对海岸警卫队的学生演讲时说：“让我给你们分享一些人生经验吧孩子们。漫漫人生路啊，你会发现，不公平的事情多了海里去了，你会发现，本不属于你的不可承受之重，却结结实实的压在你的肩膀上，而且很多时候，几乎是飞来横祸。但你必须低下头去斗争，斗争，斗争。永远永远不要放弃。一切终将柳暗花明。”\n\n这篇文章传播的难度应该不小，我没啥预期，随缘吧，希望对刷到的老板们有帮助。\n转发并且评论和点赞此文章，在评论区输入0-9999中的一个幸运数字，我会随机抽三个人，请第一名吃饭并给他做行业咨询，请第二名可以打电话做行业咨询或者简单点直接要个财富密码，第三名老规矩，送出满怀祝福的幸运骰子一套。"}}},rest_id:"1850903274721050982",url_entities:$R[366]=[],views:$R[367]={count:"224076"}}},reply_to_results:$R[368]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NjQ1MjM0MTY3NzYzOTY4MzA=",rest_id:"1864523416776396830"},reply_to_user_results:$R[369]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[370]={__typename:"User",core:$R[371]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1864523617478078722",url_entities:$R[372]=[$R[373]={display_url:"x.com/ZTZZBTC/status…",expanded_url:"https://x.com/ZTZZBTC/status/1850903274721050982",indices:$R[374]=[0,23],url:"https://t.co/LqpRd3QTU4"}],views:$R[375]={count:"5425"}}}}}}],metadata:$R[376]={conversation_metadata:$R[377]={all_tweet_ids:$R[378]=["1864523617478078722"],enable_deduplication:!0}}},entry_id:"conversationthread-1864523416776396830",sort_index:"2103672663305093110"},$R[379]={content:$R[380]={__typename:"TimelineTimelineModule",client_event_info:$R[381]={component:"tweet"},display_type:"VerticalConversation",items:$R[382]=[$R[383]={entry_id:"conversationthread-1864553195428864248-tweet-1864553195428864248",item:$R[384]={__typename:"TimelineTimelineItem",client_event_info:$R[385]={component:"tweet",details:$R[386]={conversation_details:$R[387]={conversation_section:"HighQuality"},timelines_details:$R[388]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiZNHAAAAAA=="}},element:"tweet"},content:$R[389]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[390]={id:"VHdlZXRSZXN1bHRzOjE4NjQ1NTMxOTU0Mjg4NjQyNDg=",rest_id:"1864553195428864248",result:$R[391]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[392]=[],core:$R[393]={user_results:$R[394]={id:"VXNlclJlc3VsdHM6MTQ1OTYxMDk3MjgxNDIxNzIxNg==",result:$R[395]={__typename:"User",avatar:$R[396]={image_url:"https://pbs.twimg.com/profile_images/1904882239265206272/Ll2DXpid_normal.jpg"},core:$R[397]={name:"Ghuhu",screen_name:"russwuwww"},id:"VXNlcjoxNDU5NjEwOTcyODE0MjE3MjE2",identity_profile_labels_highlighted_label:$R[398]={},privacy:$R[399]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[400]={followers:1732,following:970},rest_id:"1459610972814217216",super_follow_eligible:!1,tweet_counts:$R[401]={tweets:684},verification:$R[402]={is_blue_verified:!0}}}},counts:$R[403]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:0,retweet_count:0},details:$R[404]={cashtag_entities:$R[405]=[],created_at_ms:1733379098000,display_text_range:$R[406]=[9,13],full_text:"@ZTZZBTC 2017",hashtag_entities:$R[407]=[],smarttags:$R[408]=[],timestamp_entities:$R[409]=[]},edit_control:$R[410]={__typename:"EditControlInitial",edit_tweet_ids:$R[411]=["1864553195428864248"]},grok_translated_post_with_availability:$R[412]={is_available:!1},id:"VHdlZXQ6MTg2NDU1MzE5NTQyODg2NDI0OA==",legacy:$R[413]={lang:"und"},media_entities2:$R[414]=[],mention_entities:$R[415]=[$R[416]={id_str:"867227639416840192",indices:$R[417]=[0,8],screen_name:"ZTZZBTC"}],reply_to_results:$R[418]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NjQ1MjMxOTk2OTE4MDQ5MDU=",rest_id:"1864523199691804905"},reply_to_user_results:$R[419]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[420]={__typename:"User",core:$R[421]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1864553195428864248",url_entities:$R[422]=[],views:$R[423]={count:"223"}}}}}}],metadata:$R[424]={conversation_metadata:$R[425]={all_tweet_ids:$R[426]=["1864553195428864248"],enable_deduplication:!0}}},entry_id:"conversationthread-1864553195428864248",sort_index:"2103672663305093100"}]},$R[427]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[428]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[429]={id:"VHdlZXRSZXN1bHRzOjE4NjQ1MjMxOTk2OTE4MDQ5MDU=",rest_id:"1864523199691804905",result:$R[430]={__typename:"Tweet",core:$R[431]={user_results:$R[432]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[433]={__typename:"User",avatar:$R[434]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[435]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[436]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[437]={favorite_count:366,reply_count:128},details:$R[438]={full_text:"这文章是昨晚写的，结果今天BTC10万了。这个值得纪念的日子，写点干货给这轮币圈的新人用吧。其实我这个号一直是写给从业者看的。但现在发现，21年后进圈的从业者，也有点根基不牢。这些都是老前辈老庄家们的认知，每一条都是价值千金的经验总结。依然从二级、项目方、从业者三个角度给大家写吧： https://t.co/36Dp77Lnmk",smarttags:$R[439]=[]},id:"VHdlZXQ6MTg2NDUyMzE5OTY5MTgwNDkwNQ==",note_tweet:$R[440]={note_tweet_results:$R[441]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODY0NTIzMTk5MjI2MjM2OTI4",result:$R[442]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE4NjQ1MjMxOTkyMjYyMzY5Mjg=",text:"这文章是昨晚写的，结果今天BTC10万了。这个值得纪念的日子，写点干货给这轮币圈的新人用吧。其实我这个号一直是写给从业者看的。但现在发现，21年后进圈的从业者，也有点根基不牢。这些都是老前辈老庄家们的认知，每一条都是价值千金的经验总结。依然从二级、项目方、从业者三个角度给大家写吧：\n\n二级交易：\n1，不许碰合约，不许碰合约，不许碰合约！除非你的二级交易师父点头，或者你有一个完整牛熊的交易经验，不然不许碰合约。🚫\n\n2，知道为什么有1吗？所谓的牛市，就是你拿着现货，也能涨到让你怀疑人生的市场。💹\n\n3，周期是最伟大的力量，趋势是不可抵挡的浪潮。币圈很多暴富神话的本质是高流动性灌入低流动性资产。要顺着趋势去赚钱，要去挖掘这个圈子本质带来的钱。💯\n\n4，无论什么时候，你都应该有2成仓位不动，这是你的救命钱。剩下的八成仓位，满仓时BTC应该保持5到6成，只有2到3成可以是山寨币。这是必须遵守的币圈仓位管理法则。我们不妨再细一点，假设你的山寨币仓位是2.5，这2.5里，BNB,ETH,SOL这样大流通性又是金铲子的币，应该占据50%，剩下的是购买上交易所的VC币和上交易所的MEME币。❤️\n注意，建议在链上挖掘MEME的钱，不宜超过你总仓位的5%，且必须切割仓位。除非你是MEME或链上的超级专家，那可以扩大你的链上仓位。上交易所的MEME和链上MEME是两种完全不同的东西和玩法。这条我说的够细了，请阅读三次。❤️\n\n5，请不要相信任何“神奇指标”，这玩意不存在。也不要去大于10人的带单群。真正厉害的带单群，既不收费，人又很少。原因请自行思考。\n\n6，如果你被套住了，千万不要下跌加仓，尤其是山寨币，熊市是没有底的。如果你不能找到一个交易高手给你解套，那么正确的方法一定是下跌过程中多次反弹减仓，并且设计一个最低止损线。🈹就是跌倒这个位置，全部卖出止损。这条我说过了，以后推特上的散户别私聊我解套的事情了哈。\n\n7，散户不要老是去信一些什么“庄家内幕”，你的圈层不够高是接触不到这些内幕消息的。我以前给项目方做运营的时候我能变着花的给散户发内幕消息。🚫\n\n8，每年市场里都是有2-3次送钱行情的。哪怕你一波赚全仓的5%，三年也能赚55%。太多散户听了太多暴富神话，焦虑且浮躁，注定做不好交易。🤣\n\n9，交易的本质是寻找市场里错付的赔率。做交易之前想好盈亏比，在币圈干啥事儿都先想想盈亏比，我以前写过，不赘述了。💯\n\n10，真正重要的是拿捏大盘的节奏，知道什么时候哪些资产要涨从而提前布局，知道面对什么局面要用什么方法去最优解决。比如前一段时间BTC回调90700，不应该做空而应该全力接多。同时应该做多山寨币对BTC的汇率。这些经验的总结，对周期和趋势内进度的拿捏，才是老一辈人的真正强大之处。💯\n散户？散户知道个屁！散户只知道某某KOL又赚了多少，看着P出来的收益图高潮。但凡动脑子思考一秒都不行。\n币圈就是你越有逻辑，思考的越深，认知越底层，你就越能赚钱的地方。🔅\n\n二级交易展开讲就太多了。之后再说吧。\n项目方。这次从项目结构上，给项目方一点干货：\n\n11，别老天天想着上个大交易所，有那功夫去认真做做社区吧。社区是一切的基础，找个会社群运营方法论的运营总监很重要，找一些有活力有执行力的年轻社区运营也很重要。对运营人员好一点。不同量级的项目，要知道自己的钱从不同的地方来。✅\n\n12，很多社区的运营总监和CEO已经完全没有一点点舆论风险管理意识了。我以前做运营总监的时候都是设立这个工作负责人和工作流程的。比如项目方翻车后，散户拉维权群，这种事情就该由风控人员接管处理。要意识到这个风控的问题，上点有效果的手段。别天天让散户在推特上骂你，脸都是自己挣出来的。💢\n\n13，不论你是项目方老大还是运营总监，没事就去想想流量哪里来，币圈的流量入口是在不断更新换代的，哪些流量是符合你项目的，用哪些手法可以调动这些流量。一个项目的流量，一定是社区的基础流量，合作单位的渠道流量，事件营销带来的曝光流量。好的运营总监在立项之初就会把这个框架搭好。♨️\n\n14，关于项目方的市值。我现在意识到了，很多项目方，是完完全全，一点点市值都不懂的。很多MM公司其实真的是在利用项目方不懂市值，来抢劫项目方。请项目方想清楚一句话：如果你不打算割VC混一票就跑，那你做项目的钱一定是赚在散户身上。你与散户最直接的联系就是K线。💹\n你要拉盘有且只有两种方法：1，用嘴巴拉盘，靠营销拉盘。2，用金钱拉盘，靠市值拉盘。市值这种和钱直接挂钩的地方，你什么都不会，是不是对自己完全不负责？💢\n老说要讲市值，被一堆事情耽误。我下周就讲！\n\n15，一个项目方最重要的两个节点，其实是融资时，以及发币上市前后。融资时要多听VC们的反馈，结合自己的情况，梳理好最合适市场的项目打法，让运营总结设计运营框架。产品和技术在这一阶段并没有那么重要。这一阶段，路径和框架对了，以后能少走无数弯路。\n发币上币前后，项目方老板要处理的事情过多，对接的人事物也过多，经常会昏头。请按照市值>营销>重要人事对接>社区>产品的次序进行。开盘是从虚转实的那一步，是日后的根基，是对VC和社区的交代。很多项目开盘的刹那就已经死了。🈹\n\n16，对一个老项目方而言，找一个合适的班底，包括产品，运营，社区，市值等等，要么疯狂的迎着风口做项目，要么一轮牛市就搞一个大项目。💯\n\n17，对项目方而言，可以笼统的分为：攒局层，资源层，执行层。攒局层又叫坐庄层，指的是项目的老板和核心VC的高度。一个合格的项目方老板，应该只对自己的核心VC和核心执行层负责。攒局层决定项目这只箭的方向，这把弓力量的大小，从而精准且优雅的狙击市场热点，攒局最重要的是方向和退出路径。✅\n资源层是攒局层和执行层带来的一切可调动为项目所用的力量，合作单位，上哪家交易所，吸引更多VC投资，宣发，人力等等等等。执行层和资源层之间本来还有个决策层，但是2020年DEFI之夏后就被我去掉了。优秀的币圈项目方CEO和基层员工都是混成一团且高效沟通的，优秀的CEO，CMO等本身执行能力就更高，加上很少有项目方能大到上百号人，所以这里不聊传统互联网大厂的决策层的事情，也不值得聊。✅\n执行层真正负责的是，在有限的时间内，尽可能利用和扩大你的资源层，转化成买盘。执行层有很多职能，运营技术产品美术等等都算在这里面。优秀的执行层都是有复数能力，且精通某一领域的，这一类人越早加入项目，对项目的提升越大。其实很少从业者知道，有些复数能力叠加起来，能产生质变。这就和RPG游戏里的职业系统一样，战士和牧师职业技能点加满后，转职成了圣骑士。🔆\n啧，说多了，这条拎出来单发一条推特都能爆款。其实项目还有很多聊的，尤其是做项目的经验和细节，和项目方聊这些非常有意思。下次再说。\n\n我们来说说币圈从业者关心的事情吧：\n\n18：你们要相信行业，相信行业，相信行业！我从来不说自己是WEB3的人，我一直说我是币圈人或者区块链的人，因为在我眼里，WEB3也是一个营销的噱头罢了。现在的世界在走下坡路，进入一个摆烂的周期里。币圈的本质之一是赌场。币圈本来就不缺机会，越烂的环境里，赌场的生意只会越好。何况币圈还有技术的跟新和资本的注入。和金钱走的近的行业，发展绝对不会差。💹\n\n19，币圈很多老板都打算退休了，但是下面接班的人水平参差不齐。币圈其实是有非常多的人员缺口的，只要你够优秀，想找个好工作真的太简单了。想进入币圈工作的新人们，平时多注意积累自己的所思所想，币圈有很多橱窗可以给你展示你的能力，TG，推特，DISCORD，微信，甚至是TRADINGVIEW都行。🔅\n\n20，我做这个推特号以来，大家问我第二多的问题其实是个人的行业规划，未来发展。我基本都一一解答了。少走弯路是最好的。一个从业者想做大做好，最关键的两点是：1，自己够支棱，有一技之长，有高执行力。  2，有行业的前辈们带你。 顶层大佬们见过的人多了海里去了，聊几句就知道你靠不靠谱，看你的言谈举止就大概知道你值不值得带。但在此之前，你得够支棱，能从一堆散户里脱颖而出，先进入大佬的眼里。✅\n 隔几天写个某KOL的复盘吧，我家弟弟做的很好，就深度复盘他。\n\n21，币圈从业，最重要的点是认知深度和执行力。我建议大家多想想，XXX靠什么赚钱。你见到一个KOL就想他靠什么赚钱，见到项目方就想他靠什么赚钱。知道行业里的人靠什么赚钱，能帮你更好的梳理对币圈生态的认知。整个币圈从业的过程中，你需要一直做多你的生态位，把你从低生态位往高生态位去做。✅\n\n22，比如很多完全靠KOL吃饭的人，就是低生态位，因为他们必须要接广告。很多永赚党带单党是中低生态位，他们一方面可以吃社区返佣，一方面做交易赚钱，偶尔还能给项目方喊喊单。🈹\n以我举例。传统的MEME路径是项目方发币，让很多KOL上车，大家利益一致，发动各自的传播链进行传播，出货。当我洞悉到MEME社区和金狗猎手的关系，对比18年以来传统的币圈社区关系，发生了变化时，我会考虑项目方找金狗猎手合谋。✅\n如果我能洞悉交易所对MEME的诉求，是否我又可以在项目开始前就把交易所加在MEME项目的路径上？在此基础上，我如果还知道很多传统项目方有发MEME的诉求，我是否又可以把他们变成路径一环。✅\n最后环环相扣，完成攒局坐庄层。在散户眼里，可能最近1个月的MEME和三个月前的MEME没什么不同。但是很多最近1个月的MEME，是链路完全不同的产物。这是只有高生态位的人才能做出的降维打击。✅\n\n23，币圈是唯一一个不论你出身和学历，只看你能力的地方。而且很多时候，高学历的项目方人员容易眼高手低，在没有项目经验的情况下陷入传统路径依赖，做出一坨大便，反向收割VC。🈹\n很多高学历的朋友们，多去社区看看。你如果连你想从他们身上赚钱的散户都没有看过，你怎么赚他们的钱。不要因为自己学历很好，入门很高，被人捧起来就飘飘然。败光自己的声誉是很容易的事情，何况项目过程中总是有各种各样的意外情况发生。🤣\n我永远鼓励高学历的新人和优质新人进币圈，这样才能发展壮大行业。但请记住，这个行业本身，是老一辈的家伙们，在车库咖啡，在胡同里，在坐出租时不断宣传BTC，凝聚和发展共识，才能有今天的。抬起头看天，低下头走路。❤️\n这个行业里一直有优秀名声的人不多。因为很多时候动动歪脑筋就很容易赚钱，但那一定会翻车的。不要贪小利而作大死，你只要是个人才，三轮牛市一定能暴富发财。慢就是快。✅\n\n24，我永远建议新人，无论到哪里，都要去主动和人推荐BTC。你要去体验这个过程。2019年当我来到车库咖啡讲运营的时候，虽然大佬们早已经不在那里，但那是我第一次感受到，我在这个行业，我与他们同在！🔅\n今天正好BTC10万美金。这一路过来，感谢每一位BTC的建设者们。💹\n\n按传统惯例，文章写到这，我应该给散户或者韭菜们说点啥，举几点。今天我什么也不想多说了。我对散户已经够好了。我其实忙成猪头，身体也不好，写这些文章最近已经是牙缝里挤时间。\n\n 我有一个二级交易的师父，有一个市值的师父，有很多VC老板在我成长的路上拽了我一把，不嫌弃我菜，和我说了很多东西。我也试错过很多路径，慢慢摸索才有了今天。我没啥奇遇，到现在我依然只是一个执行层的顶层罢了。\n\n但是可以说，我是币圈没吃到17-18年早期红利，完全靠在币圈从业，靠本事混到今天的，我是从散户做起来的。🔆没有哪天我离开了市场，没有哪天我停止了思考。当去年铭文生态爆发，我成为铭文战神，反过来带朋友们爆杀市场时，我其实只对他们说了一句话：看，没给你们丢脸。投资我是正确的。🔆\n\n如果你看见这篇文章，歇歇脚，不要焦虑。太多币圈的从业者，听了太多的暴富神话，焦虑的连觉都睡不好。慢慢来。点开我的推特首页，那边有我对你最真挚的两句祝福：\n\nAll's right with the world! \nAll paths lead to BTC！\n\n老规矩，转发并且评论和点赞此文章，在评论区输入0-9999中的一个幸运数字，我会随机抽三个人，请第一名吃饭并给他做行业咨询，请第二名可以打电话做行业咨询或者简单点直接要个财富密码，第三名老规矩，送出满怀祝福的幸运骰子一套。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><link rel="preload" as="image" href="https://pbs.twimg.com/ext_tw_video_thumb/1850898488177070080/pu/img/-bBZqTCSbRCn-JV_?format=webp&amp;name=medium"/><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1864523199691804905:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@ZTZZBTC" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_mini.jpg 24w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg 48w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_x96.jpg 96w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">ZTZZ ฿</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1tim4timb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-brand flex items-center" aria-label="HertzFlow | Mainnet Arc🎲" href="/Hertzflow_xyz"><img src="https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_normal.jpg" alt="HertzFlow | Mainnet Arc🎲" class="border-normal block size-[1em] shrink-0 overflow-hidden rounded-xxs border object-cover" loading="lazy"/></a></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/ZTZZBTC" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@ZTZZBTC</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_dd64timb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">这文章是昨晚写的，结果今天BTC10万了。这个值得纪念的日子，写点干货给这轮币圈的新人用吧。其实我这个号一直是写给从业者看的。但现在发现，21年后进圈的从业者，也有点根基不牢。这些都是老前辈老庄家们的认知，每一条都是价值千金的经验总结。依然从二级、项目方、从业者三个角度给大家写吧：

二级交易：
1，不许碰合约，不许碰合约，不许碰合约！除非你的二级交易师父点头，或者你有一个完整牛熊的交易经验，不然不许碰合约。🚫

2，知道为什么有1吗？所谓的牛市，就是你拿着现货，也能涨到让你怀疑人生的市场。💹

3，周期是最伟大的力量，趋势是不可抵挡的浪潮。币圈很多暴富神话的本质是高流动性灌入低流动性资产。要顺着趋势去赚钱，要去挖掘这个圈子本质带来的钱。💯

4，无论什么时候，你都应该有2成仓位不动，这是你的救命钱。剩下的八成仓位，满仓时BTC应该保持5到6成，只有2到3成可以是山寨币。这是必须遵守的币圈仓位管理法则。我们不妨再细一点，假设你的山寨币仓位是2.5，这2.5里，BNB,ETH,SOL这样大流通性又是金铲子的币，应该占据50%，剩下的是购买上交易所的VC币和上交易所的MEME币。❤️
注意，建议在链上挖掘MEME的钱，不宜超过你总仓位的5%，且必须切割仓位。除非你是MEME或链上的超级专家，那可以扩大你的链上仓位。上交易所的MEME和链上MEME是两种完全不同的东西和玩法。这条我说的够细了，请阅读三次。❤️

5，请不要相信任何“神奇指标”，这玩意不存在。也不要去大于10人的带单群。真正厉害的带单群，既不收费，人又很少。原因请自行思考。

6，如果你被套住了，千万不要下跌加仓，尤其是山寨币，熊市是没有底的。如果你不能找到一个交易高手给你解套，那么正确的方法一定是下跌过程中多次反弹减仓，并且设计一个最低止损线。🈹就是跌倒这个位置，全部卖出止损。这条我说过了，以后推特上的散户别私聊我解套的事情了哈。

7，散户不要老是去信一些什么“庄家内幕”，你的圈层不够高是接触不到这些内幕消息的。我以前给项目方做运营的时候我能变着花的给散户发内幕消息。🚫

8，每年市场里都是有2-3次送钱行情的。哪怕你一波赚全仓的5%，三年也能赚55%。太多散户听了太多暴富神话，焦虑且浮躁，注定做不好交易。🤣

9，交易的本质是寻找市场里错付的赔率。做交易之前想好盈亏比，在币圈干啥事儿都先想想盈亏比，我以前写过，不赘述了。💯

10，真正重要的是拿捏大盘的节奏，知道什么时候哪些资产要涨从而提前布局，知道面对什么局面要用什么方法去最优解决。比如前一段时间BTC回调90700，不应该做空而应该全力接多。同时应该做多山寨币对BTC的汇率。这些经验的总结，对周期和趋势内进度的拿捏，才是老一辈人的真正强大之处。💯
散户？散户知道个屁！散户只知道某某KOL又赚了多少，看着P出来的收益图高潮。但凡动脑子思考一秒都不行。
币圈就是你越有逻辑，思考的越深，认知越底层，你就越能赚钱的地方。🔅

二级交易展开讲就太多了。之后再说吧。
项目方。这次从项目结构上，给项目方一点干货：

11，别老天天想着上个大交易所，有那功夫去认真做做社区吧。社区是一切的基础，找个会社群运营方法论的运营总监很重要，找一些有活力有执行力的年轻社区运营也很重要。对运营人员好一点。不同量级的项目，要知道自己的钱从不同的地方来。✅

12，很多社区的运营总监和CEO已经完全没有一点点舆论风险管理意识了。我以前做运营总监的时候都是设立这个工作负责人和工作流程的。比如项目方翻车后，散户拉维权群，这种事情就该由风控人员接管处理。要意识到这个风控的问题，上点有效果的手段。别天天让散户在推特上骂你，脸都是自己挣出来的。💢

13，不论你是项目方老大还是运营总监，没事就去想想流量哪里来，币圈的流量入口是在不断更新换代的，哪些流量是符合你项目的，用哪些手法可以调动这些流量。一个项目的流量，一定是社区的基础流量，合作单位的渠道流量，事件营销带来的曝光流量。好的运营总监在立项之初就会把这个框架搭好。♨️

14，关于项目方的市值。我现在意识到了，很多项目方，是完完全全，一点点市值都不懂的。很多MM公司其实真的是在利用项目方不懂市值，来抢劫项目方。请项目方想清楚一句话：如果你不打算割VC混一票就跑，那你做项目的钱一定是赚在散户身上。你与散户最直接的联系就是K线。💹
你要拉盘有且只有两种方法：1，用嘴巴拉盘，靠营销拉盘。2，用金钱拉盘，靠市值拉盘。市值这种和钱直接挂钩的地方，你什么都不会，是不是对自己完全不负责？💢
老说要讲市值，被一堆事情耽误。我下周就讲！

15，一个项目方最重要的两个节点，其实是融资时，以及发币上市前后。融资时要多听VC们的反馈，结合自己的情况，梳理好最合适市场的项目打法，让运营总结设计运营框架。产品和技术在这一阶段并没有那么重要。这一阶段，路径和框架对了，以后能少走无数弯路。
发币上币前后，项目方老板要处理的事情过多，对接的人事物也过多，经常会昏头。请按照市值&gt;营销&gt;重要人事对接&gt;社区&gt;产品的次序进行。开盘是从虚转实的那一步，是日后的根基，是对VC和社区的交代。很多项目开盘的刹那就已经死了。🈹

16，对一个老项目方而言，找一个合适的班底，包括产品，运营，社区，市值等等，要么疯狂的迎着风口做项目，要么一轮牛市就搞一个大项目。💯

17，对项目方而言，可以笼统的分为：攒局层，资源层，执行层。攒局层又叫坐庄层，指的是项目的老板和核心VC的高度。一个合格的项目方老板，应该只对自己的核心VC和核心执行层负责。攒局层决定项目这只箭的方向，这把弓力量的大小，从而精准且优雅的狙击市场热点，攒局最重要的是方向和退出路径。✅
资源层是攒局层和执行层带来的一切可调动为项目所用的力量，合作单位，上哪家交易所，吸引更多VC投资，宣发，人力等等等等。执行层和资源层之间本来还有个决策层，但是2020年DEFI之夏后就被我去掉了。优秀的币圈项目方CEO和基层员工都是混成一团且高效沟通的，优秀的CEO，CMO等本身执行能力就更高，加上很少有项目方能大到上百号人，所以这里不聊传统互联网大厂的决策层的事情，也不值得聊。✅
执行层真正负责的是，在有限的时间内，尽可能利用和扩大你的资源层，转化成买盘。执行层有很多职能，运营技术产品美术等等都算在这里面。优秀的执行层都是有复数能力，且精通某一领域的，这一类人越早加入项目，对项目的提升越大。其实很少从业者知道，有些复数能力叠加起来，能产生质变。这就和RPG游戏里的职业系统一样，战士和牧师职业技能点加满后，转职成了圣骑士。🔆
啧，说多了，这条拎出来单发一条推特都能爆款。其实项目还有很多聊的，尤其是做项目的经验和细节，和项目方聊这些非常有意思。下次再说。

我们来说说币圈从业者关心的事情吧：

18：你们要相信行业，相信行业，相信行业！我从来不说自己是WEB3的人，我一直说我是币圈人或者区块链的人，因为在我眼里，WEB3也是一个营销的噱头罢了。现在的世界在走下坡路，进入一个摆烂的周期里。币圈的本质之一是赌场。币圈本来就不缺机会，越烂的环境里，赌场的生意只会越好。何况币圈还有技术的跟新和资本的注入。和金钱走的近的行业，发展绝对不会差。💹

19，币圈很多老板都打算退休了，但是下面接班的人水平参差不齐。币圈其实是有非常多的人员缺口的，只要你够优秀，想找个好工作真的太简单了。想进入币圈工作的新人们，平时多注意积累自己的所思所想，币圈有很多橱窗可以给你展示你的能力，TG，推特，DISCORD，微信，甚至是TRADINGVIEW都行。🔅

20，我做这个推特号以来，大家问我第二多的问题其实是个人的行业规划，未来发展。我基本都一一解答了。少走弯路是最好的。一个从业者想做大做好，最关键的两点是：1，自己够支棱，有一技之长，有高执行力。  2，有行业的前辈们带你。 顶层大佬们见过的人多了海里去了，聊几句就知道你靠不靠谱，看你的言谈举止就大概知道你值不值得带。但在此之前，你得够支棱，能从一堆散户里脱颖而出，先进入大佬的眼里。✅
 隔几天写个某KOL的复盘吧，我家弟弟做的很好，就深度复盘他。

21，币圈从业，最重要的点是认知深度和执行力。我建议大家多想想，XXX靠什么赚钱。你见到一个KOL就想他靠什么赚钱，见到项目方就想他靠什么赚钱。知道行业里的人靠什么赚钱，能帮你更好的梳理对币圈生态的认知。整个币圈从业的过程中，你需要一直做多你的生态位，把你从低生态位往高生态位去做。✅

22，比如很多完全靠KOL吃饭的人，就是低生态位，因为他们必须要接广告。很多永赚党带单党是中低生态位，他们一方面可以吃社区返佣，一方面做交易赚钱，偶尔还能给项目方喊喊单。🈹
以我举例。传统的MEME路径是项目方发币，让很多KOL上车，大家利益一致，发动各自的传播链进行传播，出货。当我洞悉到MEME社区和金狗猎手的关系，对比18年以来传统的币圈社区关系，发生了变化时，我会考虑项目方找金狗猎手合谋。✅
如果我能洞悉交易所对MEME的诉求，是否我又可以在项目开始前就把交易所加在MEME项目的路径上？在此基础上，我如果还知道很多传统项目方有发MEME的诉求，我是否又可以把他们变成路径一环。✅
最后环环相扣，完成攒局坐庄层。在散户眼里，可能最近1个月的MEME和三个月前的MEME没什么不同。但是很多最近1个月的MEME，是链路完全不同的产物。这是只有高生态位的人才能做出的降维打击。✅

23，币圈是唯一一个不论你出身和学历，只看你能力的地方。而且很多时候，高学历的项目方人员容易眼高手低，在没有项目经验的情况下陷入传统路径依赖，做出一坨大便，反向收割VC。🈹
很多高学历的朋友们，多去社区看看。你如果连你想从他们身上赚钱的散户都没有看过，你怎么赚他们的钱。不要因为自己学历很好，入门很高，被人捧起来就飘飘然。败光自己的声誉是很容易的事情，何况项目过程中总是有各种各样的意外情况发生。🤣
我永远鼓励高学历的新人和优质新人进币圈，这样才能发展壮大行业。但请记住，这个行业本身，是老一辈的家伙们，在车库咖啡，在胡同里，在坐出租时不断宣传BTC，凝聚和发展共识，才能有今天的。抬起头看天，低下头走路。❤️
这个行业里一直有优秀名声的人不多。因为很多时候动动歪脑筋就很容易赚钱，但那一定会翻车的。不要贪小利而作大死，你只要是个人才，三轮牛市一定能暴富发财。慢就是快。✅

24，我永远建议新人，无论到哪里，都要去主动和人推荐BTC。你要去体验这个过程。2019年当我来到车库咖啡讲运营的时候，虽然大佬们早已经不在那里，但那是我第一次感受到，我在这个行业，我与他们同在！🔅
今天正好BTC10万美金。这一路过来，感谢每一位BTC的建设者们。💹

按传统惯例，文章写到这，我应该给散户或者韭菜们说点啥，举几点。今天我什么也不想多说了。我对散户已经够好了。我其实忙成猪头，身体也不好，写这些文章最近已经是牙缝里挤时间。

 我有一个二级交易的师父，有一个市值的师父，有很多VC老板在我成长的路上拽了我一把，不嫌弃我菜，和我说了很多东西。我也试错过很多路径，慢慢摸索才有了今天。我没啥奇遇，到现在我依然只是一个执行层的顶层罢了。

但是可以说，我是币圈没吃到17-18年早期红利，完全靠在币圈从业，靠本事混到今天的，我是从散户做起来的。🔆没有哪天我离开了市场，没有哪天我停止了思考。当去年铭文生态爆发，我成为铭文战神，反过来带朋友们爆杀市场时，我其实只对他们说了一句话：看，没给你们丢脸。投资我是正确的。🔆

如果你看见这篇文章，歇歇脚，不要焦虑。太多币圈的从业者，听了太多的暴富神话，焦虑的连觉都睡不好。慢慢来。点开我的推特首页，那边有我对你最真挚的两句祝福：

All&#x27;s right with the world! 
All paths lead to BTC！

老规矩，转发并且评论和点赞此文章，在评论区输入0-9999中的一个幸运数字，我会随机抽三个人，请第一名吃饭并给他做行业咨询，请第二名可以打电话做行业咨询或者简单点直接要个财富密码，第三名老规矩，送出满怀祝福的幸运骰子一套。</span></div><div class="flex flex-col gap-1 empty:hidden"><div class="relative overflow-hidden border border-gray-200 rounded-md" style="aspect-ratio:1.775"><div class="w-full" style="aspect-ratio:1.775"><!--$--><div class="group relative isolate z-0 flex aspect-video h-full w-full overflow-hidden bg-black tabular-nums"><video height="100%" width="100%" disablePictureInPicture="" poster="https://pbs.twimg.com/ext_tw_video_thumb/1864519540618780672/pu/img/IBP5yt7ra_MviDUC?format=webp&amp;name=medium" muted="" playsInline=""></video><div class="absolute inset-s-0 inset-e-0 top-0 bottom-0 flex w-full" style="-webkit-touch-callout:none" data-slot="xds-context-menu-trigger"><button type="button" aria-label="Play" class="absolute inset-s-0 inset-e-0 top-0 bottom-0 z-0 cursor-pointer appearance-none border-0 bg-transparent p-0"></button><div class="pointer-events-none absolute inset-0 z-10 flex items-center justify-center"><img alt="" class="absolute inset-0 z-0 h-full w-full object-cover" src="https://pbs.twimg.com/ext_tw_video_thumb/1864519540618780672/pu/img/IBP5yt7ra_MviDUC?format=webp&amp;name=medium"/><button data-slot="xds-button" aria-label="Play" id="base-ui-_R_fidsmb8timb6b5336_" data-base-ui-tooltip-trigger="" type="button" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-12 min-w-12 text-headline2 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-6 bg-black-40 text-on-color backdrop-blur-lg hover:bg-black-50 aria-expanded:bg-black-50 active:bg-black-60 w-12 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 pointer-events-auto z-10" 