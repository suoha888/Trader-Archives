d:!0},expanded_url:"https://x.com/ZTZZBTC/status/2045512144758989025/photo/1",ext_media_availability:$R[137]={status:"Available"},ext_playlists:$R[138]=[],features:$R[139]={},id_str:"2045511915527704576",indices:$R[140]=[112,135],media_url_https:"https://pbs.twimg.com/media/HGMeP-TbkAAjHPi.png",original_info:$R[141]={height:378,width:694},type:"photo"},$R[142]={allow_download_status:$R[143]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/2045512144758989025/photo/1",ext_media_availability:$R[144]={status:"Available"},ext_playlists:$R[145]=[],features:$R[146]={},id_str:"2045511932816588800",indices:$R[147]=[112,135],media_url_https:"https://pbs.twimg.com/media/HGMeQ-tbAAAPzpm.png",original_info:$R[148]={height:702,width:484},type:"photo"}],mention_entities:$R[149]=[],note_tweet:$R[150]={is_expandable:!0,note_tweet_results:$R[151]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ1NTEyMTQ0NjY2NzMwNDk2",result:$R[152]={__typename:"NoteTweet",entity_set:$R[153]={hashtags:$R[154]=[],smarttags:$R[155]=[],symbols:$R[156]=[],urls:$R[157]=[],user_mentions:$R[158]=[]},id:"Tm90ZVR3ZWV0OjIwNDU1MTIxNDQ2NjY3MzA0OTY=",rest_id:"2045512144666730496",text:"分享一件开心的事情。我的朋友应该是这次币安人生第一大获利者。\n他刚刚向我公布了他的胜利，以及盈利金额。在这个流动性不好的市场里，这个金额已经非常夸张了。\n他觉得我之前在下跌的时候，给了一些有用的建议，帮助他拿住了币安人生。\n\n非常惭愧。我只是普通分享了一下自己的看法。他能埋伏两个月，一直等到币安人生的大涨，更多的是他的坚毅。如果币安人生再跌一些，可能就是另一个故事了。\n我非常认真的告诉了他币安人生下面的走势看法，以及给了他几点实用建议。\n我相信他肯定会采纳。\n最后我向他要10U的币安人生，沾沾他的运气。因为我前一阵子，一直有点霉运。\n他给我打了188.88888888个币安人生。\n有心了，谢谢你。\n\n这是我这个月最开心的事情！我激动的把他分享给了我的几个大佬朋友，也分享到了群里。\n这个事情给我的启示只有两点：1，以后散户问我问题，要么就不回答，要回答就要尽量叮嘱清楚。要对提问的人负责。\n2，多分享。当他人因为你的分享，获得成功时，真的比自己赚钱还要开心。\n\n恭喜你，我的朋友！你才是今天最大的赢家。"}}},rest_id:"2045512144758989025",url_entities:$R[159]=[],views:$R[160]={count:"15716"}}}}},entry_id:"tweet-2045512144758989025",sort_index:"2103673427842826240"},$R[161]={content:$R[162]={__typename:"TimelineTimelineModule",client_event_info:$R[163]={component:"tweet"},display_type:"VerticalConversation",items:$R[164]=[$R[165]={entry_id:"conversationthread-204552128323692