AAA=="}},element:"tweet"},content:$R[267]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[268]={id:"VHdlZXRSZXN1bHRzOjIwNDU1MTM3ODA1NTAxNDQwNjA=",rest_id:"2045513780550144060",result:$R[269]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[270]=[],core:$R[271]={user_results:$R[272]={id:"VXNlclJlc3VsdHM6MTc3MjYzODU2MjE3MDgzOTA0MA==",result:$R[273]={__typename:"User",avatar:$R[274]={image_url:"https://pbs.twimg.com/profile_images/2034484635129020416/w6xVzV8R_normal.jpg"},core:$R[275]={name:"Yeshe Dorje",screen_name:"dorje_river"},id:"VXNlcjoxNzcyNjM4NTYyMTcwODM5MDQw",identity_profile_labels_highlighted_label:$R[276]={},privacy:$R[277]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[278]={followers:5482,following:5555},rest_id:"1772638562170839040",super_follow_eligible:!1,tweet_counts:$R[279]={tweets:14586},verification:$R[280]={is_blue_verified:!1}}}},counts:$R[281]={bookmark_count:0,favorite_count:0,quote_count:0,reply_count:0,retweet_count:1},details:$R[282]={cashtag_entities:$R[283]=[],created_at_ms:1776523463000,display_text_range:$R[284]=[9,150],full_text:"@ZTZZBTC 有时候你以为赚的是钱，其实赚的是“心不动”。\n市场流动性差，是外境；\n能不能拿住，是内心。\n你朋友赚到的，不只是这一笔盈利，\n而是在恐惧下没有交出筹码的定力。\n禅里讲：\n风动、幡动，其实是心动。\n大多数人亏，不是因为没机会，\n而是在下跌时，被业力牵着走——\n焦虑、恐惧、想马上解脱。",hashtag_entities:$R[285]=[],smarttags:$R[286]=[],timestamp_entities:$R[287]=[]},edit_control:$R[288]={__typename:"EditControlInitial",edit_tweet_ids:$R[289]=["2045513780550144060"]},grok_translated_post_with_availability:$R[290]={is_available:!1},id:"VHdlZXQ6MjA0NTUxMzc4MDU1MDE0NDA2MA==",legacy:$R[291]={lang:"zh"},media_entities2:$R[292]=[],mention_entities:$R[293]=[$R[294]={id_str:"867227639416840192",indices:$R[295]=[0,8],screen_name:"ZTZZBTC"}],note_tweet:$R[296]={is_expandable:!0,note_tweet_results:$R[297]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ1NTEzNzgwNTAzOTYxNjAw",result:$R[298]={__typename:"NoteTweet",entity_set:$R[299]={hashtags:$R[300]=[],smarttags:$R[301]=[],symbols:$R[302]=[],urls:$R[303]=[],user_mentions:$R[304]=[]},id:"Tm90ZVR3ZWV0OjIwNDU1MTM3ODA1MDM5NjE2MDA=",rest_id:"2045513780503961600",text:"有时候你以为赚的是钱，其实赚的是“心不动”。\n市场流动性差，是外境；\n能不能拿住，是内心。\n你朋友赚到的，不只是这一笔盈利，\n而是在恐惧下没有交出筹码的定力。\n禅里讲：\n风动、幡动，其实是心动。\n大多数人亏，不是因为没机会，\n而是在下跌时，被业力牵着走——\n焦虑、恐惧、想马上解脱。\n你当时给的不是建议，\n而是一点点“止观”：\n看清波动，但不随波动。\n真正的盈利逻辑很简单：\n不是你看对了多少次，\n而是你在该拿的时候，没有被自己吓跑。\n所以别太执着“谁赚了多少”，\n这一切只是果。\n更重要的是：\n他那一刻，守住了自己的心。\n这，才是币安人生里最值钱的一单。"}}},reply_to_results:$R[305]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwNDU1MTIxNDQ3NTg5ODkwMjU=",rest_id:"2045512144758989025"},reply_to_user_results:$R[306]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[307]={__typename:"User",core:$R[308]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"2045513780550144060",url_entities:$R[309]=[],views:$R[310]={count:"748"}}}}}}],metadata:$R[311]={conversation_metadata:$R[312]={all_tweet_ids:$R[313]=["2045513780550144060"],enable_deduplication:!0}}},entry_id:"conversationthread-2045513780550144060",sort_index:"2103673427842826210"}]},$R[314]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[315]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[316]={id:"VHdlZXRSZXN1bHRzOjIwNDU1MTIxNDQ3NTg5ODkwMjU=",rest_id:"2045512144758989025",result:$R[317]={__typename:"Tweet",core:$R[318]={user_results:$R[319]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[320]={__typename:"User",avatar:$R[321]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[322]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[323]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[324]={favorite_count:36,reply_count:9},details:$R[325]={full_text:"分享一件开心的事情。我的朋友应该是这次币安人生第一大获利者。\n他刚刚向我公布了他的胜利，以及盈利金额。在这个流动性不好的市场里，这个金额已经非常夸张了。\n他觉得我之前在下跌的时候，给了一些有用的建议，帮助他拿住了币安人生。 https://t.co/egd9oNLhtf",smarttags:$R[326]=[]},id:"VHdlZXQ6MjA0NTUxMjE0NDc1ODk4OTAyNQ==",note_tweet:$R[327]={note_tweet_results:$R[328]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ1NTEyMTQ0NjY2NzMwNDk2",result:$R[329]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjIwNDU1MTIxNDQ2NjY3MzA0OTY=",text:"分享一件开心的事情。我的朋友应该是这次币安人生第一大获利者。\n他刚刚向我公布了他的胜利，以及盈利金额。在这个流动性不好的市场里，这个金额已经非常夸张了。\n他觉得我之前在下跌的时候，给了一些有用的建议，帮助他拿住了币安人生。\n\n非常惭愧。我只是普通分享了一下自己的看法。他能埋伏两个月，一直等到币安人生的大涨，更多的是他的坚毅。如果币安人生再跌一些，可能就是另一个故事了。\n我非常认真的告诉了他币安人生下面的走势看法，以及给了他几点实用建议。\n我相信他肯定会采纳。\n最后我向他要10U的币安人生，沾沾他的运气。因为我前一阵子，一直有点霉运。\n他给我打了188.88888888个币安人生。\n有心了，谢谢你。\n\n这是我这个月最开心的事情！我激动的把他分享给了我的几个大佬朋友，也分享到了群里。\n这个事情给我的启示只有两点：1，以后散户问我问题，要么就不回答，要回答就要尽量叮嘱清楚。要对提问的人负责。\n2，多分享。当他人因为你的分享，获得成功时，真的比自己赚钱还要开心。\n\n恭喜你，我的朋友！你才是今天最大的赢家。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:2045512144758989025:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@ZTZZBTC" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/14913576