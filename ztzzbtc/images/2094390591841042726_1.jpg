:"867227639416840192"}},rest_id:"2094391263139364997",url_entities:$R[328]=[],views:$R[329]={count:"2605"}}}}}}],metadata:$R[330]={conversation_metadata:$R[331]={all_tweet_ids:$R[332]=["2094391263139364997"],enable_deduplication:!0}}},entry_id:"conversationthread-2094391263139364997",sort_index:"2103672623106883574"},$R[333]={content:$R[334]={__typename:"TimelineTimelineModule",client_event_info:$R[335]={component:"tweet"},display_type:"VerticalConversation",items:$R[336]=[$R[337]={entry_id:"conversationthread-2094392957915009229-tweet-2094392957915009229",item:$R[338]={__typename:"TimelineTimelineItem",client_event_info:$R[339]={component:"tweet",details:$R[340]={conversation_details:$R[341]={conversation_section:"HighQuality"},timelines_details:$R[342]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiW8JAAAAAA=="}},element:"tweet"},content:$R[343]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[344]={id:"VHdlZXRSZXN1bHRzOjIwOTQzOTI5NTc5MTUwMDkyMjk=",rest_id:"2094392957915009229",result:$R[345]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[346]=[],core:$R[347]={user_results:$R[348]={id:"VXNlclJlc3VsdHM6MTMyNTI4MjUx",result:$R[349]={__typename:"User",avatar:$R[350]={image_url:"https://pbs.twimg.com/profile_images/1971525728295591936/hczJKif7_normal.jpg"},core:$R[351]={name:"秋荣",screen_name:"joakja"},id:"VXNlcjoxMzI1MjgyNTE=",identity_profile_labels_highlighted_label:$R[352]={label:$R[353]={badge:$R[354]={url:"https://pbs.twimg.com/profile_images/2056416821532602368/8LZg8qeF_bigger.jpg"},description:"Trady",url:$R[355]={url:"https://twitter.com/tradyxyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[356]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[357]={followers:22706,following:3695},rest_id:"132528251",super_follow_eligible:!1,tweet_counts:$R[358]={tweets:27482},verification:$R[359]={is_blue_verified:!0}}}},counts:$R[360]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:0,retweet_count:0},details:$R[361]={cashtag_entities:$R[362]=[],created_at_ms:1788177167000,display_text_range:$R[363]=[9,30],full_text:"@ZTZZBTC 线下神秘嘉宾的那节记得带上单打独斗的弟弟😀",hashtag_entities:$R[364]=[],smarttags:$R[365]=[],timestamp_entities:$R[366]=[]},edit_control:$R[367]={__typename:"EditControlInitial",edit_tweet_ids:$R[368]=["2094392957915009229"]},grok_translated_post_with_availability:$R[369]={is_available:!1},id:"VHdlZXQ6MjA5NDM5Mjk1NzkxNTAwOTIyOQ==",legacy:$R[370]={lang:"zh"},media_entities2:$R[371]=[],mention_entities:$R[372]=[$R[373]={id_str:"867227639416840192",indices:$R[374]=[0,8],screen_name:"ZTZZBTC"}],reply_to_results:$R[375]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwOTQzOTA1OTE4NDEwNDI3MjY=",rest_id:"2094390591841042726"},reply_to_user_results:$R[376]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[377]={__typename:"User",core:$R[378]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"2094392957915009229",url_entities:$R[379]=[],views:$R[380]={count:"816"}}}}}}],metadata:$R[381]={conversation_metadata:$R[382]={all_tweet_ids:$R[383]=["2094392957915009229"],enable_deduplication:!0}}},entry_id:"conversationthread-2094392957915009229",sort_index:"2103672623106883564"}]},$R[384]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[385]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[386]={id:"VHdlZXRSZXN1bHRzOjIwOTQzOTA1OTE4NDEwNDI3MjY=",rest_id:"2094390591841042726",result:$R[387]={__typename:"Tweet",core:$R[388]={user_results:$R[389]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[390]={__typename:"User",avatar:$R[391]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[392]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[393]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[394]={favorite_count:94,reply_count:33},details:$R[395]={full_text:"《鹿鱼5——红》\n现在开始接受报名。\n在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。\n\n具体课程目录如图： https://t.co/v0FmSi5eQ5",smarttags:$R[396]=[]},id:"VHdlZXQ6MjA5NDM5MDU5MTg0MTA0MjcyNg==",note_tweet:$R[397]={note_tweet_results:$R[398]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDk0MzkwNTkxNjQ4MDYzNDg4",result:$R[399]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjIwOTQzOTA1OTE2NDgwNjM0ODg=",text:"《鹿鱼5——红》\n现在开始接受报名。\n在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。\n\n具体课程目录如图：\n包含了前三节公开课，和后14节闭门课，加上线下答疑两天，加上神秘嘉宾1节（啊对，他没想好要讲什么）一共17+2+1课程。\n\n作为币圈最受好评的课程，这次重写搞得我压力很大——好吧其实根本没有压力。我纯粹就是懒，出去玩多了，然后觉得自己总结自己的系统，落到纸面上非常的麻烦。\n所以拖了非常久。说好了一年一届就一年一届，坚持做正确的事情，结善缘，是一件重要的事情。\n本课是抱着，再修改修改一两个版本，就拿来留给我女儿和后人的目标去写的，所以不用担心我没有认真写。\n\n去年是1999U，根据我们的老规矩，今年2888U一位。只涨不跌。\n至于我是不是骗子，这课值不值，你们随意，随意。\n\n请认真阅读鹿鱼4和鹿鱼3报名里的那些老须知：https://t.co/S3Dfn4yM7V\n新须知如下：\n1，本课程适合人员：\nA  最适合币圈长期从业者\nB  其次适合想做币圈独立交易员的人\nC  然后非常适合年轻人，大学生。\nD  如果你是23年后进圈，只会玩链上的新人，你也很适合这节课。\n本课程对所有学员附送就业路径帮助。\n\nE   最后，如果你是上班党，你想靠币圈来改变命运的话，你不是非常适合我们的课，主要是您自己的时间问题，不过学了这个你不会在币圈亏大的，但我不保证你能学好交易。请谨慎考虑。\n\n2，本课程非常鼓励你们线上线下拉帮结伙，寻找在币圈共同进步的好友。所以本课程非常建议你 拽上你的币圈朋友一起来。\n\n3，今年由于是全新课件，课程变多了一倍，所以1234班的学长们都会过来重听，请5班学生自行勾搭和学习学长。你们的学长干啥玩意的都有，有好几位在自己的赛道都有光辉战绩。\n\n4，本课程虽然囊括了币圈的方方面面，但依然尽量以二级交易为中心。因为交易是所有金融市场不变的底层技术。\n\n5，本课程收入的20%将会捐献给动物保护机构。今年得换一家了，还没想好捐给谁。\n\n6，鹿鱼5这一年的最优秀学员，将会获得2份神秘大礼，将会在鹿鱼6线下课的时候揭晓。\n\n最后，本课程报名时间截止日期是9月30日。按道理来说，我应该写几篇凶残的干货文章，做做传播，给课程预热。但考虑到课程只收50人，过去报名的人过多，人贵在精不在多。加上我确实事情多，所以还是随缘吧。\n\n你们现在可以把我的推特设置成特别关注和小铃铛了，我从现在开始到9月末，不会乱发东西或者回复。\n前三节公开课的时间，请注意通知。\n\n确定报名的朋友，请下载下方的报名WORD，认真填写后，发送到邮箱： ztzzpanda777@gmail.com  （你发了我一定会回复，如果10天没回你就再发我一次）\n通过网盘分享的文件：鹿鱼5报名表格.docx\n链接: https://t.co/SMzPraxBST 提取码: ZTZZ\n\n谷歌文档链接：\nhttps://t.co/0OGdjAHyAY\n\n如果此分享链接被封，请去评论区通知我，我会补充新的链接。\n\n最后，祝大家都赚钱。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:2094390591841042726:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@ZTZZBTC" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_mini.jpg 24w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg 48w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_x96.jpg 96w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">ZTZZ ฿</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1tim4timb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-brand flex items-center" aria-label="HertzFlow | Mainnet Arc🎲" href="/Hertzflow_xyz"><img src="https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_normal.jpg" alt="HertzFlow | Mainnet Arc🎲" class="border-normal block size-[1em] shrink-0 overflow-hidden rounded-xxs border object-cover" loading="lazy"/></a></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/ZTZZBTC" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@ZTZZBTC</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_dd64timb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">《鹿鱼5——红》
现在开始接受报名。
在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。

具体课程目录如图：
包含了前三节公开课，和后14节闭门课，加上线下答疑两天，加上神秘嘉宾1节（啊对，他没想好要讲什么）一共17+2+1课程。

作为币圈最受好评的课程，这次重写搞得我压力很大——好吧其实根本没有压力。我纯粹就是懒，出去玩多了，然后觉得自己总结自己的系统，落到纸面上非常的麻烦。
所以拖了非常久。说好了一年一届就一年一届，坚持做正确的事情，结善缘，是一件重要的事情。
本课是抱着，再修改修改一两个版本，就拿来留给我女儿和后人的目标去写的，所以不用担心我没有认真写。

去年是1999U，根据我们的老规矩，今年2888U一位。只涨不跌。
至于我是不是骗子，这课值不值，你们随意，随意。

请认真阅读鹿鱼4和鹿鱼3报名里的那些老须知：</span><a class="font-chirp max-w-full whitespace-pre-wrap break-words text-brand text-[length:inherit] font-inherit hover:underline" href="https://x.com/ZTZZBTC/status/1882299585496052013" rel="noopener noreferrer" target="_blank">x.com/ZTZZBTC/status…</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">
新须知如下：
1，本课程适合人员：
A  最适合币圈长期从业者
B  其次适合想做币圈独立交易员的人
C  然后非常适合年轻人，大学生。
D  如果你是23年后进圈，只会玩链上的新人，你也很适合这节课。
本课程对所有学员附送就业路径帮助。

E   最后，如果你是上班党，你想靠币圈来改变命运的话，你不是非常适合我们的课，主要是您自己的时间问题，不过学了这个你不会在币圈亏大的，但我不保证你能学好交易。请谨慎考虑。

2，本课程非常鼓励你们线上线下拉帮结伙，寻找在币圈共同进步的好友。所以本课程非常建议你 拽上你的币圈朋友一起来。

3，今年由于是全新课件，课程变多了一倍，所以1234班的学长们都会过来重听，请5班学生自行勾搭和学习学长。你们的学长干啥玩意的都有，有好几位在自己的赛道都有光辉战绩。

4，本课程虽然囊括了币圈的方方面面，但依然尽量以二级交易为中心。因为交易是所有金融市场不变的底层技术。

5，本课程收入的20%将会捐献给动物保护机构。今年得换一家了，还没想好捐给谁。

6，鹿鱼5这一年的最优秀学员，将会获得2份神秘大礼，将会在鹿鱼6线下课的时候揭晓。

最后，本课程报名时间截止日期是9月30日。按道理来说，我应该写几篇凶残的干货文章，做做传播，给课程预热。但考虑到课程只收50人，过去报名的人过多，人贵在精不在多。加上我确实事情多，所以还是随缘吧。

你们现在可以把我的推特设置成特别关注和小铃铛了，我从现在开始到9月末，不会乱发东西或者回复。
前三节公开课的时间，请注意通知。

确定报名的朋友，请下载下方的报名WORD，认真填写后，发送到邮箱： <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="3a404e40404a5b545e5b0d0d0d7a5d575b535614595557">[email&#160;protected]</a>  （你发了我一定会回复，如果10天没回你就再发我一次）
