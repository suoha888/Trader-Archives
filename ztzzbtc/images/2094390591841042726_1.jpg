 129,209 h 113 s 236,129 187,87 C 175,84 98,10 213,9 h 198 s 234,78 64,180 C 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="lGpKwQ4dceHCt2+ePFOlPA==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="lGpKwQ4dceHCt2+ePFOlPA==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790389611569,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀ZTZZBTC",u:1790389611569,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀ZTZZBTC␀status␀2094390591841042726␀{}",u:1790389611964,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg",authorDescription:void 0,authorName:"ZTZZ ฿",focalTweetId:"2094390591841042726",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=2094390591841042726",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"ZTZZ ฿ profile picture",url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_400x400.jpg"},screenName:"ZTZZBTC",url:"https://x.com/ZTZZBTC"},bodyText:"《鹿鱼5——红》\n现在开始接受报名。\n在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。\n\n具体课程目录如图：\n包含了前三节公开课，和后14节闭门课，加上线下答疑两天，加上神秘嘉宾1节（啊对，他没想好要讲什么）一共17+2+1课程。\n\n作为币圈最受好评的课程，这次重写搞得我压力很大——好吧其实根本没有压力。我纯粹就是懒，出去玩多了，然后觉得自己总结自己的系统，落到纸面上非常的麻烦。\n所以拖了非常久。说好了一年一届就一年一届，坚持做正确的事情，结善缘，是一件重要的事情。\n本课是抱着，再修改修改一两个版本，就拿来留给我女儿和后人的目标去写的，所以不用担心我没有认真写。\n\n去年是1999U，根据我们的老规矩，今年2888U一位。只涨不跌。\n至于我是不是骗子，这课值不值，你们随意，随意。\n\n请认真阅读鹿鱼4和鹿鱼3报名里的那些老须知：https://t.co/S3Dfn4yM7V\n新须知如下：\n1，本课程适合人员：\nA  最适合币圈长期从业者\nB  其次适合想做币圈独立交易员的人\nC  然后非常适合年轻人，大学生。\nD  如果你是23年后进圈，只会玩链上的新人，你也很适合这节课。\n本课程对所有学员附送就业路径帮助。\n\nE   最后，如果你是上班党，你想靠币圈来改变命运的话，你不是非常适合我们的课，主要是您自己的时间问题，不过学了这个你不会在币圈亏大的，但我不保证你能学好交易。请谨慎考虑。\n\n2，本课程非常鼓励你们线上线下拉帮结伙，寻找在币圈共同进步的好友。所以本课程非常建议你 拽上你的币圈朋友一起来。\n\n3，今年由于是全新课件，课程变多了一倍，所以1234班的学长们都会过来重听，请5班学生自行勾搭和学习学长。你们的学长干啥玩意的都有，有好几位在自己的赛道都有光辉战绩。\n\n4，本课程虽然囊括了币圈的方方面面，但依然尽量以二级交易为中心。因为交易是所有金融市场不变的底层技术。\n\n5，本课程收入的20%将会捐献给动物保护机构。今年得换一家了，还没想好捐给谁。\n\n6，鹿鱼5这一年的最优秀学员，将会获得2份神秘大礼，将会在鹿鱼6线下课的时候揭晓。\n\n最后，本课程报名时间截止日期是9月30日。按道理来说，我应该写几篇凶残的干货文章，做做传播，给课程预热。但考虑到课程只收50人，过去报名的人过多，人贵在精不在多。加上我确实事情多，所以还是随缘吧。\n\n你们现在可以把我的推特设置成特别关注和小铃铛了，我从现在开始到9月末，不会乱发东西或者回复。\n前三节公开课的时间，请注意通知。\n\n确定报名的朋友，请下载下方的报名WORD，认真填写后，发送到邮箱： ztzzpanda777@gmail.com  （你发了我一定会回复，如果10天没回你就再发我一次）\n通过网盘分享的文件：鹿鱼5报名表格.docx\n链接: https://t.co/SMzPraxBST 提取码: ZTZZ\n\n谷歌文档链接：\nhttps://t.co/0OGdjAHyAY\n\n如果此分享链接被封，请去评论区通知我，我会补充新的链接。\n\n最后，祝大家都赚钱。",canonicalPath:"/ZTZZBTC/status/2094390591841042726",canonicalUrl:"https://x.com/ZTZZBTC/status/2094390591841042726",description:"《鹿鱼5——红》\n现在开始接受报名。\n在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。\n\n具体课程目录如图：\n包含了前三节公开课，和后14节闭门课，加上线下答疑两天，加上神秘嘉宾1节（啊对，他没想好要讲什么）一共17+2+1课程。\n\n作为币圈最受好评的课程，这次重写搞得我压力很大——好吧其实根本没有压力。我纯粹就是懒，出去玩多了，然后觉得自己总结自己的系统，落到纸面上非常的麻烦。\n所以拖了非常久。说好了一年一届就一年一届，坚持做正确的事情，结善缘，是一件重要的事情。\n本课是抱着，再修改修改一两个版本，就拿来留给我女儿和后人的目标去写的，所以不用担心我没有认真写。\n\n去年是1999U，根据我们的老规矩，今年2888U一位。只涨不跌。\n至于我是不是骗子，这课值不值，你们随意，随意。\n\n请认真阅读鹿鱼4和鹿鱼3报名里的那些老须知：https://t.co/S3Dfn4yM7V\n新须知如下：\n1，本课程适合人员：\nA  最适合币圈长期从业者\nB  其次适合想做币圈独立交易员的人\nC  然后非常适合年轻人，大学生。\nD  如果你是23年后进圈，只会玩链上的新人，你也很适合这节课。\n本课程对所有学员附送就业路径帮助。\n\nE   最后，如果你是上班党，你想靠币圈来改变命运的话，你不是非常适合我们的课，主要是您自己的时间问题，不过学了这个你不会在币圈亏大的，但我不保证你能学好交易。请谨慎考虑。\n\n2，本课程非常鼓励你们线上线下拉帮结伙，寻找在币圈共同进步的好友。所以本课程非常建议你 拽上你的币圈朋友一起来。\n\n3，今年由于是全新课件，课程变多了一倍，所以1234班的学长们都会过来重听，请5班学生自行勾搭和学习学长。你们的学长干啥玩意的都有，有好几位在自己的赛道都有光辉战绩。\n\n4，本课程虽然囊括了币圈的方方面面，但依然尽量以二级交易为中心。因为交易是所有金融市场不变的底层技术。\n\n5，本课程收入的20%将会捐献给动物保护机构。今年得换一家了，还没想好捐给谁。\n\n6，鹿鱼5这一年的最优秀学员，将会获得2份神秘大礼，将会在鹿鱼6线下课的时候揭晓。\n\n最后，本课程报名时间截止日期是9月30日。按道理来说，我应该写几篇凶残的干货文章，做做传播，给课程预热。但考虑到课程只收50人，过去报名的人过多，人贵在精不在多。加上我确实事情多，所以还是随缘吧。\n\n你们现在可以把我的推特设置成特别关注和小铃铛了，我从现在开始到9月末，不会乱发东西或者回复。\n前三节公开课的时间，请注意通知。\n\n确定报名的朋友，请下载下方的报名WORD，认真填写后，发送到邮箱： ztzzpanda777@gmail.com  （你发了我一定会回复，如果10天没回你就再发我一次）\n通过网盘分享的文件：鹿鱼5报名表格.docx\n链接: https://t.co/SMzPraxBST 提取码: ZTZZ\n\n谷歌文档链接：\nhttps://t.co/0OGdjAHyAY\n\n如果此分享链接被封，请去评论区通知我，我会补充新的链接。\n\n最后，祝大家都赚钱。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:695,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/HRCZlt7aEAAjbme?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/HRCZlt7aEAAjbme?format=webp&name=small 680w, https://pbs.twimg.com/media/HRCZlt7aEAAjbme?format=webp&name=medium 1200w, https://pbs.twimg.com/media/HRCZlt7aEAAjbme?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/HRCZlt7aEAAjbme?format=webp&name=large",width:781},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/2094390591841042726",publishedTime:"2026-08-31T11:43:23.000Z",replyCount:33,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/ZTZZBTC/status/1882299585496052013","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"ZTZZBTC",identifier:"867227639416840192",image:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_400x400.jpg",name:"ZTZZ ฿",url:"https://x.com/ZTZZBTC"},datePublished:"2025-01-23T05:29:27.000Z",identifier:"1882299585496052013",url:"https://x.com/ZTZZBTC/status/1882299585496052013",image:$R[17]=[$R[18]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/Gh9FZElaQAAxuAc?format=webp&name=large",description:"你们要的第四年度交易课来了。\n请耐心看完下面的东西决定是否参加（没错我又复制的去年的改了改）：\n一， 课程解释：这段有点长，建议看引用的去年的那段，贴在评论里了。\n我的课程是以二级交易为核心技能的，币圈综合式课程。\n\n二， 课程内容：首先，本课程适用于：对二级交易知识一窍不通，想入门的朋友。看了交易书籍还是一头乱麻一直在输的朋友。还没有形成自己的交易体系，天天开合约的朋友。\n本课程基础版本包含以下内容： \n1，币圈市场解析 \n2，K线基础入门 \n3，形态学讲解 \n4，仓位管理 \n以上为三天的课程。所讲的内容从形态学入门一直到你可以凝练出自己的交易体系。学完了你基本就不是二级交易的小白了，市场里每年稳定两三次的送钱行情你就能赚到。本课程，所有的核心都是让你在币圈稳定的赚钱，不含任何暴富秘籍\n其次是一年后会免费送升级课程，必须要一年后，因为一些东西提前讲出去就是误人子弟。这部分的课程包括： \n5，做空点位分析和逃顶指南 \n6，项目方和市值角度分析操盘 \n7，EMA的N种用法和指标回测 \n8，板块复盘和年度复盘。 \n还有想到的其他一些东西，随机发生。 吸取了去年的上课经验，我们今年做出了新的修改！！！！\n所有的课程全部线上，全部线上。因为线下课程过于紧密，所以对于学习来说体验并不好！\n但是我们线上课程结束后，会在上海举办两天的线下课程。因为去年线下的时候大家气氛非常热烈，并且问出了很多线上我不方便回答的干货问题，且都直接和大家的经济挂钩！\n所以今年采用的最终方案是：二级课程内容全部线上，部分币圈相关内容和答疑，全部线下！！\n\n线下的内容包括但不限于：\n9，币圈择业教学，你甚至可以点对点问我。\n10，任何，任何链上的问题。对，任何。\n11，土狗MEME的二级K线教学（如何做土狗的二级）\n12，为了让大家互相认识并且能相互帮助的自我介绍闲聊和团建。（你就当你是带着问题来玩的）\n12，期末考试（去年鸽了今年争取要有！！）\n\n今年还会有一个重大改动！\n介于去年和前年的反馈，大家反应在课程中“下苦工”的那一环节难度陡增，产生了迷茫。所以今年我们会请到隔壁某社区的交易员，让他给大家分享自己的交易学习过程。\n今年的课程里还会修改一次用了3年的教案，新增一些符合现在币圈的新知识。\n\n如果明后年课程有更新，对之前的同学都是终身免费的。\n\n三， 碎碎念的话： 学好二级交易是一件受益终身的事情。如果你想学的话我建议你认真学，然后多问多练。但去年的教学经验，和我自己的学习经验也告诉我：很多朋友哪怕学了，最后也不会成为一个成熟的交易员，这和个人自身有关。 \n所以本课程是直接包含跟单的，但次数不会多。 我吃过那种装逼KOL老师的大亏，把自己装成超级高手，一堆头衔，最后实际靠收群费过日子。天天带群友学TM的巴菲特，读TM的《滚雪球》，最后还带群友买A股，站在茅台最高价位。\n我对此深恶痛绝。\n我基本是实名上网冲浪，也不靠收学费卖课过日子。你交的学费我会带你赚回来，你要是能学会二级交易，那就是我的大成功。 \n所以本课程，是对学员有筛选的！ \n想交钱进来单纯跟单，门都没有！ \n\n请理解一下如下这段话： \n如果我社群里有10个人，我当可以随意带他们买ORDI这样的币，买在3块钱的底，或者买一些更小市值的币。当群友有50个以上，我就只能带大家买BTC，买SOL，ETH这样的大市值流通的币，确定性机会也更少。因为如果再买小盘币，就一定会发生某人重金砸进去后群友互相踩踏的事情。 哥们这里不是链上PVP社区。\n\n所以我建议你还是抱着学习的心来，别抱着跟单的心来。我习惯性把话都说在前面，外面任何一个KOL开课都不可能说的有我这么直接和详细。 \n我再举个例子：讲完了会有要求你们每天看盘，复盘。实际上几乎没啥人能做到，因为哪怕你学了，不去实践，不去花时间看K线，都是扯淡。 所以才加了跟单环节和热点环节。 就是知道你们报了班，大多数人最后也是学不会的，那我抱着至少让你们学费回本的心，去搞这个事。\n你们学不会，也还是好朋友，学会了，你我都赚。 我这个人很要脸，不会割你们。 \n\n四，学费和流程： 今年的学费是1999USDT（没错，熊市里的价格会便宜，牛市里的价格会贵，熊市里投资自己认真学习的人，理当花更低的钱赚到更多的认知和筹赏。第一年是8888人民币，第二年是1666U，去年是1777U） \n\n五，什么人适合报名本课程： \n没错前四点是我拿去年的文案改的。 真正重要的是第五点 \n\n在去年的交易课里，我成功帮群里的几个朋友，开启了他们的币圈新生活，一来是去年的选手质量很高，很多人其实只是方向不对，缺乏一点指引。二来是去年的课上他们问了我很多择业的问题，我结合自己的经验发现，很多时候，你需要的真的就是一个过来人，点对点给你指出你该走的路。 \n我很开心的看见去年课程里的学生，今年开始在币圈做自己的大项目，在币圈进了VC，还有人在做自己的私董会，这是他们应该走的方向。最牛的那个二班班长现在已经做量化基金去了，现在都能给我带项目方了🥲🥲🥲\n\n他们从我这里，作为一个散户而来，出去的时候已经告别了韭菜的身份。 \n\n我曾不止一次的在推特和SPACE里说，我们这种老玩家，要把币圈做大。 一如当年各位大佬，帮助我一样，我也会尽力去帮助新人，希望有一天，我能给我的学生孵化的项目，做营销和市值。 \n\n所以，本课程最合适的是那些，想进入币圈的朋友，或者在币圈发展遇见了瓶颈的人。 \n\n二级交易的课为什么是基础核心呢？因为你哪怕完全不适合币圈的任何职位，你回家努力做二级，也是能稳定赚钱的。二级是一辈子的修行和修心。 \n\n我们的课程，实际上就一句话：帮助你脱离韭菜，找到你自己的币圈定位。 我当全力去教，希望对各位有用。\n\n周日晚间会有一次腾讯会议，讲解大盘和回答问题。大家可以来听，熟悉一下，免得被忽悠，也确保自己想学。 \n\n邀请您参加腾讯会议\n会议主题：ZTZZ的币圈第一课\n会议时间：2025/01/25 20:00-23:00 (GMT+08:00) 中国标准时间 - 北京\n\n点击链接入会，或添加至会议列表：\nhttps://t.co/33ov6jM4ur\n\n#腾讯会议：337-674-816 \n\n确定报名的朋友，请发送您的简历到邮箱：\nztzzpanda777@gmail.com \n简历加一段文字，文字请注明：年龄，职业，城市，来币圈多少年。最成功的一次投资赚了多少，最多的一次亏损亏了多少。二级交易的水平如何。希望从课里学到哪些。\n没有简历也可以的，关键是需要一段详细的自我介绍和币圈经历介绍。\n\n本次报名将会持续一个星期。我将确定后 ，拉群进行交流。 \n本次课程会录像。 \n由于我实在是忙，且教案要改，所以尽量在2月份线上开课，线下会放到4月中旬。\n本次的学费百分之5将会捐献给全国各地的动物园。 \n百分之5将会请环卫工人吃爱心午餐。 \n百分之10将会支付线下讲课的场地费以及请学员吃饭。\n剩下的钱将会拿去投资币圈链上坐庄侧的基础设施建设。",height:1090,name:"你们要的第四年度交易课来了。\n请耐心看完下面的东西决定是否参加（没错我又复制的去年的改了改）：\n一， 课程解释：这段有点长，建议看引用的去年的那段，贴在评论里了。\n我的课程是以二级交易为核心技能的，币圈综合式课程。\n\n二， 课程内容：首先，本课程适用于：对二级交易知识一窍不通，想入门的朋友。看了交易书籍还是一头乱麻一直在输的朋友。还没有形成自己的交易体系，天天开合约的朋友。\n本课程基础版本包含以下内容： \n1，币圈市场解析 \n2，K线基础入门 \n3，形态学讲解 \n4，仓位管理 \n以上为三天的课程。所讲的内容从形态学入门一直到你可以凝练出自己的交易体系。学完了你基本就不是二级交易的小白了，市场里每年稳定两三次的送钱行情你就能赚到。本课程，所有的核心都是让你在币圈稳定的赚钱，不含任何暴富秘籍\n其次是一年后会免费送升级课程，必须要一年后，因为一些东西提前讲出去就是误人子弟。这部分的课程包括： \n5，做空点位分析和逃顶指南 \n6，项目方和市值角度分析操盘 \n7，EMA的N种用法和指标回测 \n8，板块复盘和年度复盘。 \n还有想到的其他一些东西，随机发生。 吸取了去年的上课经验，我们今年做出了新的修改！！！！\n所有的课程全部线上，全部线上。因为线下课程过于紧密，所以对于学习来说体验并不好！\n但是我们线上课程结束后，会在上海举办两天的线下课程。因为去年线下的时候大家气氛非常热烈，并且问出了很多线上我不方便回答的干货问题，且都直接和大家的经济挂钩！\n所以今年采用的最终方案是：二级课程内容全部线上，部分币圈相关内容和答疑，全部线下！！\n\n线下的内容包括但不限于：\n9，币圈择业教学，你甚至可以点对点问我。\n10，任何，任何链上的问题。对，任何。\n11，土狗MEME的二级K线教学（如何做土狗的二级）\n12，为了让大家互相认识并且能相互帮助的自我介绍闲聊和团建。（你就当你是带着问题来玩的）\n12，期末考试（去年鸽了今年争取要有！！）\n\n今年还会有一个重大改动！\n介于去年和前年的反馈，大家反应在课程中“下苦工”的那一环节难度陡增，产生了迷茫。所以今年我们会请到隔壁某社区的交易员，让他给大家分享自己的交易学习过程。\n今年的课程里还会修改一次用了3年的教案，新增一些符合现在币圈的新知识。\n\n如果明后年课程有更新，对之前的同学都是终身免费的。\n\n三， 碎碎念的话： 学好二级交易是一件受益终身的事情。如果你想学的话我建议你认真学，然后多问多练。但去年的教学经验，和我自己的学习经验也告诉我：很多朋友哪怕学了，最后也不会成为一个成熟的交易员，这和个人自身有关。 \n所以本课程是直接包含跟单的，但次数不会多。 我吃过那种装逼KOL老师的大亏，把自己装成超级高手，一堆头衔，最后实际靠收群费过日子。天天带群友学TM的巴菲特，读TM的《滚雪球》，最后还带群友买A股，站在茅台最高价位。\n我对此深恶痛绝。\n我基本是实名上网冲浪，也不靠收学费卖课过日子。你交的学费我会带你赚回来，你要是能学会二级交易，那就是我的大成功。 \n所以本课程，是对学员有筛选的！ \n想交钱进来单纯跟单，门都没有！ \n\n请理解一下如下这段话： \n如果我社群里有10个人，我当可以随意带他们买ORDI这样的币，买在3块钱的底，或者买一些更小市值的币。当群友有50个以上，我就只能带大家买BTC，买SOL，ETH这样的大市值流通的币，确定性机会也更少。因为如果再买小盘币，就一定会发生某人重金砸进去后群友互相踩踏的事情。 哥们这里不是链上PVP社区。\n\n所以我建议你还是抱着学习的心来，别抱着跟单的心来。我习惯性把话都说在前面，外面任何一个KOL开课都不可能说的有我这么直接和详细。 \n我再举个例子：讲完了会有要求你们每天看盘，复盘。实际上几乎没啥人能做到，因为哪怕你学了，不去实践，不去花时间看K线，都是扯淡。 所以才加了跟单环节和热点环节。 就是知道你们报了班，大多数人最后也是学不会的，那我抱着至少让你们学费回本的心，去搞这个事。\n你们学不会，也还是好朋友，学会了，你我都赚。 我这个人很要脸，不会割你们。 \n\n四，学费和流程： 今年的学费是1999USDT（没错，熊市里的价格会便宜，牛市里的价格会贵，熊市里投资自己认真学习的人，理当花更低的钱赚到更多的认知和筹赏。第一年是8888人民币，第二年是1666U，去年是1777U） \n\n五，什么人适合报名本课程： \n没错前四点是我拿去年的文案改的。 真正重要的是第五点 \n\n在去年的交易课里，我成功帮群里的几个朋友，开启了他们的币圈新生活，一来是去年的选手质量很高，很多人其实只是方向不对，缺乏一点指引。二来是去年的课上他们问了我很多择业的问题，我结合自己的经验发现，很多时候，你需要的真的就是一个过来人，点对点给你指出你该走的路。 \n我很开心的看见去年课程里的学生，今年开始在币圈做自己的大项目，在币圈进了VC，还有人在做自己的私董会，这是他们应该走的方向。最牛的那个二班班长现在已经做量化基金去了，现在都能给我带项目方了🥲🥲🥲\n\n他们从我这里，作为一个散户而来，出去的时候已经告别了韭菜的身份。 \n\n我曾不止一次的在推特和SPACE里说，我们这种老玩家，要把币圈做大。 一如当年各位大佬，帮助我一样，我也会尽力去帮助新人，希望有一天，我能给我的学生孵化的项目，做营销和市值。 \n\n所以，本课程最合适的是那些，想进入币圈的朋友，或者在币圈发展遇见了瓶颈的人。 \n\n二级交易的课为什么是基础核心呢？因为你哪怕完全不适合币圈的任何职位，你回家努力做二级，也是能稳定赚钱的。二级是一辈子的修行和修心。 \n\n我们的课程，实际上就一句话：帮助你脱离韭菜，找到你自己的币圈定位。 我当全力去教，希望对各位有用。\n\n周日晚间会有一次腾讯会议，讲解大盘和回答问题。大家可以来听，熟悉一下，免得被忽悠，也确保自己想学。 \n\n邀请您参加腾讯会议\n会议主题：ZTZZ的币圈第一课\n会议时间：2025/01/25 20:00-23:00 (GMT+08:00) 中国标准时间 - 北京\n\n点击链接入会，或添加至会议列表：\nhttps://t.co/33ov6jM4ur\n\n#腾讯会议：337-674-816 \n\n确定报名的朋友，请发送您的简历到邮箱：\nztzzpanda777@gmail.com \n简历加一段文字，文字请注明：年龄，职业，城市，来币圈多少年。最成功的一次投资赚了多少，最多的一次亏损亏了多少。二级交易的水平如何。希望从课里学到哪些。\n没有简历也可以的，关键是需要一段详细的自我介绍和币圈经历介绍。\n\n本次报名将会持续一个星期。我将确定后 ，拉群进行交流。 \n本次课程会录像。 \n由于我实在是忙，且教案要改，所以尽量在2月份线上开课，线下会放到4月中旬。\n本次的学费百分之5将会捐献给全国各地的动物园。 \n百分之5将会请环卫工人吃爱心午餐。 \n百分之10将会支付线下讲课的场地费以及请学员吃饭。\n剩下的钱将会拿去投资币圈链上坐庄侧的基础设施建设。 (1)",thumbnailUrl:"https://pbs.twimg.com/media/Gh9FZElaQAAxuAc?format=webp&name=small",uploadDate:"2025-01-23T05:29:27.000Z",url:"https://pbs.twimg.com/media/Gh9FZElaQAAxuAc?format=webp&name=large",width:686},$R[19]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/Gh9FahnbYAAwR0U?format=webp&name=large",description:"你们要的第四年度交易课来了。\n请耐心看完下面的东西决定是否参加（没错我又复制的去年的改了改）：\n一， 课程解释：这段有点长，建议看引用的去年的那段，贴在评论里了。\n我的课程是以二级交易为核心技能的，币圈综合式课程。\n\n二， 课程内容：首先，本课程适用于：对二级交易知识一窍不通，想入门的朋友。看了交易书籍还是一头乱麻一直在输的朋友。还没有形成自己的交易体系，天天开合约的朋友。\n本课程基础版本包含以下内容： \n1，币圈市场解析 \n2，K线基础入门 \n3，形态学讲解 \n4，仓位管理 \n以上为三天的课程。所讲的内容从形态学入门一直到你可以凝练出自己的交易体系。学完了你基本就不是二级交易的小白了，市场里每年稳定两三次的送钱行情你就能赚到。本课程，所有的核心都是让你在币圈稳定的赚钱，不含任何暴富秘籍\n其次是一年后会免费送升级课程，必须要一年后，因为一些东西提前讲出去就是误人子弟。这部分的课程包括： \n5，做空点位分析和逃顶指南 \n6，项目方和市值角度分析操盘 \n7，EMA的N种用法和指标回测 \n8，板块复盘和年度复盘。 \n还有想到的其他一些东西，随机发生。 吸取了去年的上课经验，我们今年做出了新的修改！！！！\n所有的课程全部线上，全部线上。因为线下课程过于紧密，所以对于学习来说体验并不好！\n但是我们线上课程结束后，会在上海举办两天的线下课程。因为去年线下的时候大家气氛非常热烈，并且问出了很多线上我不方便回答的干货问题，且都直接和大家的经济挂钩！\n所以今年采用的最终方案是：二级课程内容全部线上，部分币圈相关内容和答疑，全部线下！！\n\n线下的内容包括但不限于：\n9，币圈择业教学，你甚至可以点对点问我。\n10，任何，任何链上的问题。对，任何。\n11，土狗MEME的二级K线教学（如何做土狗的二级）\n12，为了让大家互相认识并且能相互帮助的自我介绍闲聊和团建。（你就当你是带着问题来玩的）\n12，期末考试（去年鸽了今年争取要有！！）\n\n今年还会有一个重大改动！\n介于去年和前年的反馈，大家反应在课程中“下苦工”的那一环节难度陡增，产生了迷茫。所以今年我们会请到隔壁某社区的交易员，让他给大家分享自己的交易学习过程。\n今年的课程里还会修改一次用了3年的教案，新增一些符合现在币圈的新知识。\n\n如果明后年课程有更新，对之前的同学都是终身免费的。\n\n三， 碎碎念的话： 学好二级交易是一件受益终身的事情。如果你想学的话我建议你认真学，然后多问多练。但去年的教学经验，和我自己的学习经验也告诉我：很多朋友哪怕学了，最后也不会成为一个成熟的交易员，这和个人自身有关。 \n所以本课程是直接包含跟单的，但次数不会多。 我吃过那种装逼KOL老师的大亏，把自己装成超级高手，一堆头衔，最后实际靠收群费过日子。天天带群友学TM的巴菲特，读TM的《滚雪球》，最后还带群友买A股，站在茅台最高价位。\n我对此深恶痛绝。\n我基本是实名上网冲浪，也不靠收学费卖课过日子。你交的学费我会带你赚回来，你要是能学会二级交易，那就是我的大成功。 \n所以本课程，是对学员有筛选的！ \n想交钱进来单纯跟单，门都没有！ \n\n请理解一下如下这段话： \n如果我社群里有10个人，我当可以随意带他们买ORDI这样的币，买在3块钱的底，或者买一些更小市值的币。当群友有50个以上，我就只能带大家买BTC，买SOL，ETH这样的大市值流通的币，确定性机会也更少。因为如果再买小盘币，就一定会发生某人重金砸进去后群友互相踩踏的事情。 哥们这里不是链上PVP社区。\n\n所以我建议你还是抱着学习的心来，别抱着跟单的心来。我习惯性把话都说在前面，外面任何一个KOL开课都不可能说的有我这么直接和详细。 \n我再举个例子：讲完了会有要求你们每天看盘，复盘。实际上几乎没啥人能做到，因为哪怕你学了，不去实践，不去花时间看K线，都是扯淡。 所以才加了跟单环节和热点环节。 就是知道你们报了班，大多数人最后也是学不会的，那我抱着至少让你们学费回本的心，去搞这个事。\n你们学不会，也还是好朋友，学会了，你我都赚。 我这个人很要脸，不会割你们。 \n\n四，学费和流程： 今年的学费是1999USDT（没错，熊市里的价格会便宜，牛市里的价格会贵，熊市里投资自己认真学习的人，理当花更低的钱赚到更多的认知和筹赏。第一年是8888人民币，第二年是1666U，去年是1777U） \n\n五，什么人适合报名本课程： \n没错前四点是我拿去年的文案改的。 真正重要的是第五点 \n\n在去年的交易课里，我成功帮群里的几个朋友，开启了他们的币圈新生活，一来是去年的选手质量很高，很多人其实只是方向不对，缺乏一点指引。二来是去年的课上他们问了我很多择业的问题，我结合自己的经验发现，很多时候，你需要的真的就是一个过来人，点对点给你指出你该走的路。 \n我很开心的看见去年课程里的学生，今年开始在币圈做自己的大项目，在币圈进了VC，还有人在做自己的私董会，这是他们应该走的方向。最牛的那个二班班长现在已经做量化基金去了，现在都能给我带项目方了🥲🥲🥲\n\n他们从我这里，作为一个散户而来，出去的时候已经告别了韭菜的身份。 \n\n我曾不止一次的在推特和SPACE里说，我们这种老玩家，要把币圈做大。 一如当年各位大佬，帮助我一样，我也会尽力去帮助新人，希望有一天，我能给我的学生孵化的项目，做营销和市值。 \n\n所以，本课程最合适的是那些，想进入币圈的朋友，或者在币圈发展遇见了瓶颈的人。 \n\n二级交易的课为什么是基础核心呢？因为你哪怕完全不适合币圈的任何职位，你回家努力做二级，也是能稳定赚钱的。二级是一辈子的修行和修心。 \n\n我们的课程，实际上就一句话：帮助你脱离韭菜，找到你自己的币圈定位。 我当全力去教，希望对各位有用。\n\n周日晚间会有一次腾讯会议，讲解大盘和回答问题。大家可以来听，熟悉一下，免得被忽悠，也确保自己想学。 \n\n邀请您参加腾讯会议\n会议主题：ZTZZ的币圈第一课\n会议时间：2025/01/25 20:00-23:00 (GMT+08:00) 中国标准时间 - 北京\n\n点击链接入会，或添加至会议列表：\nhttps://t.co/33ov6jM4ur\n\n#腾讯会议：337-674-816 \n\n确定报名的朋友，请发送您的简历到邮箱：\nztzzpanda777@gmail.com \n简历加一段文字，文字请注明：年龄，职业，城市，来币圈多少年。最成功的一次投资赚了多少，最多的一次亏损亏了多少。二级交易的水平如何。希望从课里学到哪些。\n没有简历也可以的，关键是需要一段详细的自我介绍和币圈经历介绍。\n\n本次报名将会持续一个星期。我将确定后 ，拉群进行交流。 \n本次课程会录像。 \n由于我实在是忙，且教案要改，所以尽量在2月份线上开课，线下会放到4月中旬。\n本次的学费百分之5将会捐献给全国各地的动物园。 \n百分之5将会请环卫工人吃爱心午餐。 \n百分之10将会支付线下讲课的场地费以及请学员吃饭。\n剩下的钱将会拿去投资币圈链上坐庄侧的基础设施建设。",height:255,name:"你们要的第四年度交易课来了。\n请耐心看完下面的东西决定是否参加（没错我又复制的去年的改了改）：\n一， 课程解释：这段有点长，建议看引用的去年的那段，贴在评论里了。\n我的课程是以二级交易为核心技能的，币圈综合式课程。\n\n二， 课程内容：首先，本课程适用于：对二级交易知识一窍不通，想入门的朋友。看了交易书籍还是一头乱麻一直在输的朋友。还没有形成自己的交易体系，天天开合约的朋友。\n本课程基础版本包含以下内容： \n1，币圈市场解析 \n2，K线基础入门 \n3，形态学讲解 \n4，仓位管理 \n以上为三天的课程。所讲的内容从形态学入门一直到你可以凝练出自己的交易体系。学完了你基本就不是二级交易的小白了，市场里每年稳定两三次的送钱行情你就能赚到。本课程，所有的核心都是让你在币圈稳定的赚钱，不含任何暴富秘籍\n其次是一年后会免费送升级课程，必须要一年后，因为一些东西提前讲出去就是误人子弟。这部分的课程包括： \n5，做空点位分析和逃顶指南 \n6，项目方和市值角度分析操盘 \n7，EMA的N种用法和指标回测 \n8，板块复盘和年度复盘。 \n还有想到的其他一些东西，随机发生。 吸取了去年的上课经验，我们今年做出了新的修改！！！！\n所有的课程全部线上，全部线上。因为线下课程过于紧密，所以对于学习来说体验并不好！\n但是我们线上课程结束后，会在上海举办两天的线下课程。因为去年线下的时候大家气氛非常热烈，并且问出了很多线上我不方便回答的干货问题，且都直接和大家的经济挂钩！\n所以今年采用的最终方案是：二级课程内容全部线上，部分币圈相关内容和答疑，全部线下！！\n\n线下的内容包括但不限于：\n9，币圈择业教学，你甚至可以点对点问我。\n10，任何，任何链上的问题。对，任何。\n11，土狗MEME的二级K线教学（如何做土狗的二级）\n12，为了让大家互相认识并且能相互帮助的自我介绍闲聊和团建。（你就当你是带着问题来玩的）\n12，期末考试（去年鸽了今年争取要有！！）\n\n今年还会有一个重大改动！\n介于去年和前年的反馈，大家反应在课程中“下苦工”的那一环节难度陡增，产生了迷茫。所以今年我们会请到隔壁某社区的交易员，让他给大家分享自己的交易学习过程。\n今年的课程里还会修改一次用了3年的教案，新增一些符合现在币圈的新知识。\n\n如果明后年课程有更新，对之前的同学都是终身免费的。\n\n三， 碎碎念的话： 学好二级交易是一件受益终身的事情。如果你想学的话我建议你认真学，然后多问多练。但去年的教学经验，和我自己的学习经验也告诉我：很多朋友哪怕学了，最后也不会成为一个成熟的交易员，这和个人自身有关。 \n所以本课程是直接包含跟单的，但次数不会多。 我吃过那种装逼KOL老师的大亏，把自己装成超级高手，一堆头衔，最后实际靠收群费过日子。天天带群友学TM的巴菲特，读TM的《滚雪球》，最后还带群友买A股，站在茅台最高价位。\n我对此深恶痛绝。\n我基本是实名上网冲浪，也不靠收学费卖课过日子。你交的学费我会带你赚回来，你要是能学会二级交易，那就是我的大成功。 \n所以本课程，是对学员有筛选的！ \n想交钱进来单纯跟单，门都没有！ \n\n请理解一下如下这段话： \n如果我社群里有10个人，我当可以随意带他们买ORDI这样的币，买在3块钱的底，或者买一些更小市值的币。当群友有50个以上，我就只能带大家买BTC，买SOL，ETH这样的大市值流通的币，确定性机会也更少。因为如果再买小盘币，就一定会发生某人重金砸进去后群友互相踩踏的事情。 哥们这里不是链上PVP社区。\n\n所以我建议你还是抱着学习的心来，别抱着跟单的心来。我习惯性把话都说在前面，外面任何一个KOL开课都不可能说的有我这么直接和详细。 \n我再举个例子：讲完了会有要求你们每天看盘，复盘。实际上几乎没啥人能做到，因为哪怕你学了，不去实践，不去花时间看K线，都是扯淡。 所以才加了跟单环节和热点环节。 就是知道你们报了班，大多数人最后也是学不会的，那我抱着至少让你们学费回本的心，去搞这个事。\n你们学不会，也还是好朋友，学会了，你我都赚。 我这个人很要脸，不会割你们。 \n\n四，学费和流程： 今年的学费是1999USDT（没错，熊市里的价格会便宜，牛市里的价格会贵，熊市里投资自己认真学习的人，理当花更低的钱赚到更多的认知和筹赏。第一年是8888人民币，第二年是1666U，去年是1777U） \n\n五，什么人适合报名本课程： \n没错前四点是我拿去年的文案改的。 真正重要的是第五点 \n\n在去年的交易课里，我成功帮群里的几个朋友，开启了他们的币圈新生活，一来是去年的选手质量很高，很多人其实只是方向不对，缺乏一点指引。二来是去年的课上他们问了我很多择业的问题，我结合自己的经验发现，很多时候，你需要的真的就是一个过来人，点对点给你指出你该走的路。 \n我很开心的看见去年课程里的学生，今年开始在币圈做自己的大项目，在币圈进了VC，还有人在做自己的私董会，这是他们应该走的方向。最牛的那个二班班长现在已经做量化基金去了，现在都能给我带项目方了🥲🥲🥲\n\n他们从我这里，作为一个散户而来，出去的时候已经告别了韭菜的身份。 \n\n我曾不止一次的在推特和SPACE里说，我们这种老玩家，要把币圈做大。 一如当年各位大佬，帮助我一样，我也会尽力去帮助新人，希望有一天，我能给我的学生孵化的项目，做营销和市值。 \n\n所以，本课程最合适的是那些，想进入币圈的朋友，或者在币圈发展遇见了瓶颈的人。 \n\n二级交易的课为什么是基础核心呢？因为你哪怕完全不适合币圈的任何职位，你回家努力做二级，也是能稳定赚钱的。二级是一辈子的修行和修心。 \n\n我们的课程，实际上就一句话：帮助你脱离韭菜，找到你自己的币圈定位。 我当全力去教，希望对各位有用。\n\n周日晚间会有一次腾讯会议，讲解大盘和回答问题。大家可以来听，熟悉一下，免得被忽悠，也确保自己想学。 \n\n邀请您参加腾讯会议\n会议主题：ZTZZ的币圈第一课\n会议时间：2025/01/25 20:00-23:00 (GMT+08:00) 中国标准时间 - 北京\n\n点击链接入会，或添加至会议列表：\nhttps://t.co/33ov6jM4ur\n\n#腾讯会议：337-674-816 \n\n确定报名的朋友，请发送您的简历到邮箱：\nztzzpanda777@gmail.com \n简历加一段文字，文字请注明：年龄，职业，城市，来币圈多少年。最成功的一次投资赚了多少，最多的一次亏损亏了多少。二级交易的水平如何。希望从课里学到哪些。\n没有简历也可以的，关键是需要一段详细的自我介绍和币圈经历介绍。\n\n本次报名将会持续一个星期。我将确定后 ，拉群进行交流。 \n本次课程会录像。 \n由于我实在是忙，且教案要改，所以尽量在2月份线上开课，线下会放到4月中旬。\n本次的学费百分之5将会捐献给全国各地的动物园。 \n百分之5将会请环卫工人吃爱心午餐。 \n百分之10将会支付线下讲课的场地费以及请学员吃饭。\n剩下的钱将会拿去投资币圈链上坐庄侧的基础设施建设。 (2)",thumbnailUrl:"https://pbs.twimg.com/media/Gh9FahnbYAAwR0U?format=webp&name=small",uploadDate:"2025-01-23T05:29:27.000Z",url:"https://pbs.twimg.com/media/Gh9FahnbYAAwR0U?format=webp&name=large",width:255}],engagement:$R[20]=[$R[21]={action:"LikeAction",name:"Likes",url:"https://x.com/ZTZZBTC/status/1882299585496052013/likes",count:88},$R[22]={action:"ShareAction",name:"Retweets",url:"https://x.com/ZTZZBTC/status/1882299585496052013/retweets",count:12},$R[23]={action:"ReplyAction",name:"Replies",url:null,count:14},$R[24]={action:"ViewAction",name:"Views",count:82244}],text:"你们要的第四年度交易课来了。\n请耐心看完下面的东西决定是否参加（没错我又复制的去年的改了改）：\n一， 课程解释：这段有点长，建议看引用的去年的那段，贴在评论里了。\n我的课程是以二级交易为核心技能的，币圈综合式课程。\n\n二， 课程内容：首先，本课程适用于：对二级交易知识一窍不通，想入门的朋友。看了交易书籍还是一头乱麻一直在输的朋友。还没有形成自己的交易体系，天天开合约的朋友。\n本课程基础版本包含以下内容： \n1，币圈市场解析 \n2，K线基础入门 \n3，形态学讲解 \n4，仓位管理 \n以上为三天的课程。所讲的内容从形态学入门一直到你可以凝练出自己的交易体系。学完了你基本就不是二级交易的小白了，市场里每年稳定两三次的送钱行情你就能赚到。本课程，所有的核心都是让你在币圈稳定的赚钱，不含任何暴富秘籍\n其次是一年后会免费送升级课程，必须要一年后，因为一些东西提前讲出去就是误人子弟。这部分的课程包括： \n5，做空点位分析和逃顶指南 \n6，项目方和市值角度分析操盘 \n7，EMA的N种用法和指标回测 \n8，板块复盘和年度复盘。 \n还有想到的其他一些东西，随机发生。 吸取了去年的上课经验，我们今年做出了新的修改！！！！\n所有的课程全部线上，全部线上。因为线下课程过于紧密，所以对于学习来说体验并不好！\n但是我们线上课程结束后，会在上海举办两天的线下课程。因为去年线下的时候大家气氛非常热烈，并且问出了很多线上我不方便回答的干货问题，且都直接和大家的经济挂钩！\n所以今年采用的最终方案是：二级课程内容全部线上，部分币圈相关内容和答疑，全部线下！！\n\n线下的内容包括但不限于：\n9，币圈择业教学，你甚至可以点对点问我。\n10，任何，任何链上的问题。对，任何。\n11，土狗MEME的二级K线教学（如何做土狗的二级）\n12，为了让大家互相认识并且能相互帮助的自我介绍闲聊和团建。（你就当你是带着问题来玩的）\n12，期末考试（去年鸽了今年争取要有！！）\n\n今年还会有一个重大改动！\n介于去年和前年的反馈，大家反应在课程中“下苦工”的那一环节难度陡增，产生了迷茫。所以今年我们会请到隔壁某社区的交易员，让他给大家分享自己的交易学习过程。\n今年的课程里还会修改一次用了3年的教案，新增一些符合现在币圈的新知识。\n\n如果明后年课程有更新，对之前的同学都是终身免费的。\n\n三， 碎碎念的话： 学好二级交易是一件受益终身的事情。如果你想学的话我建议你认真学，然后多问多练。但去年的教学经验，和我自己的学习经验也告诉我：很多朋友哪怕学了，最后也不会成为一个成熟的交易员，这和个人自身有关。 \n所以本课程是直接包含跟单的，但次数不会多。 我吃过那种装逼KOL老师的大亏，把自己装成超级高手，一堆头衔，最后实际靠收群费过日子。天天带群友学TM的巴菲特，读TM的《滚雪球》，最后还带群友买A股，站在茅台最高价位。\n我对此深恶痛绝。\n我基本是实名上网冲浪，也不靠收学费卖课过日子。你交的学费我会带你赚回来，你要是能学会二级交易，那就是我的大成功。 \n所以本课程，是对学员有筛选的！ \n想交钱进来单纯跟单，门都没有！ \n\n请理解一下如下这段话： \n如果我社群里有10个人，我当可以随意带他们买ORDI这样的币，买在3块钱的底，或者买一些更小市值的币。当群友有50个以上，我就只能带大家买BTC，买SOL，ETH这样的大市值流通的币，确定性机会也更少。因为如果再买小盘币，就一定会发生某人重金砸进去后群友互相踩踏的事情。 哥们这里不是链上PVP社区。\n\n所以我建议你还是抱着学习的心来，别抱着跟单的心来。我习惯性把话都说在前面，外面任何一个KOL开课都不可能说的有我这么直接和详细。 \n我再举个例子：讲完了会有要求你们每天看盘，复盘。实际上几乎没啥人能做到，因为哪怕你学了，不去实践，不去花时间看K线，都是扯淡。 所以才加了跟单环节和热点环节。 就是知道你们报了班，大多数人最后也是学不会的，那我抱着至少让你们学费回本的心，去搞这个事。\n你们学不会，也还是好朋友，学会了，你我都赚。 我这个人很要脸，不会割你们。 \n\n四，学费和流程： 今年的学费是1999USDT（没错，熊市里的价格会便宜，牛市里的价格会贵，熊市里投资自己认真学习的人，理当花更低的钱赚到更多的认知和筹赏。第一年是8888人民币，第二年是1666U，去年是1777U） \n\n五，什么人适合报名本课程： \n没错前四点是我拿去年的文案改的。 真正重要的是第五点 \n\n在去年的交易课里，我成功帮群里的几个朋友，开启了他们的币圈新生活，一来是去年的选手质量很高，很多人其实只是方向不对，缺乏一点指引。二来是去年的课上他们问了我很多择业的问题，我结合自己的经验发现，很多时候，你需要的真的就是一个过来人，点对点给你指出你该走的路。 \n我很开心的看见去年课程里的学生，今年开始在币圈做自己的大项目，在币圈进了VC，还有人在做自己的私董会，这是他们应该走的方向。最牛的那个二班班长现在已经做量化基金去了，现在都能给我带项目方了🥲🥲🥲\n\n他们从我这里，作为一个散户而来，出去的时候已经告别了韭菜的身份。 \n\n我曾不止一次的在推特和SPACE里说，我们这种老玩家，要把币圈做大。 一如当年各位大佬，帮助我一样，我也会尽力去帮助新人，希望有一天，我能给我的学生孵化的项目，做营销和市值。 \n\n所以，本课程最合适的是那些，想进入币圈的朋友，或者在币圈发展遇见了瓶颈的人。 \n\n二级交易的课为什么是基础核心呢？因为你哪怕完全不适合币圈的任何职位，你回家努力做二级，也是能稳定赚钱的。二级是一辈子的修行和修心。 \n\n我们的课程，实际上就一句话：帮助你脱离韭菜，找到你自己的币圈定位。 我当全力去教，希望对各位有用。\n\n周日晚间会有一次腾讯会议，讲解大盘和回答问题。大家可以来听，熟悉一下，免得被忽悠，也确保自己想学。 \n\n邀请您参加腾讯会议\n会议主题：ZTZZ的币圈第一课\n会议时间：2025/01/25 20:00-23:00 (GMT+08:00) 中国标准时间 - 北京\n\n点击链接入会，或添加至会议列表：\nhttps://t.co/33ov6jM4ur\n\n#腾讯会议：337-674-816 \n\n确定报名的朋友，请发送您的简历到邮箱：\nztzzpanda777@gmail.com \n简历加一段文字，文字请注明：年龄，职业，城市，来币圈多少年。最成功的一次投资赚了多少，最多的一次亏损亏了多少。二级交易的水平如何。希望从课里学到哪些。\n没有简历也可以的，关键是需要一段详细的自我介绍和币圈经历介绍。\n\n本次报名将会持续一个星期。我将确定后 ，拉群进行交流。 \n本次课程会录像。 \n由于我实在是忙，且教案要改，所以尽量在2月份线上开课，线下会放到4月中旬。\n本次的学费百分之5将会捐献给全国各地的动物园。 \n百分之5将会请环卫工人吃爱心午餐。 \n百分之10将会支付线下讲课的场地费以及请学员吃饭。\n剩下的钱将会拿去投资币圈链上坐庄侧的基础设施建设。"}},socialTitle:"ZTZZ ฿ (@ZTZZBTC) on X",title:"ZTZZ ฿ on X: \"《鹿鱼5——红》\n现在开始接受报名。\n在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。\n\n具体课程目录如图：\n包含了前三节公开课，和后14节闭门课，加上线下答疑两天，加上神秘嘉宾1节（啊对，他没想好要讲什么）一共17+2+1课程。\n\n作为币圈最受好评的课程，这次重写搞得我压力很大——好吧其实根本没有压力。我纯粹就是懒，出去玩多了，然后觉得自己总结自己的系统，落到纸面上非常的麻烦。\n所以拖了非常久。说好了一年一届就一年一届，坚持做正确的事情，结善缘，是一件重要的事情。\n本课是抱着，再修改修改一两个版本，就拿来留给我女儿和后人的目标去写的，所以不用担心我没有认真写。\n\n去年是1999U，根据我们的老规矩，今年2888U一位。只涨不跌。\n至于我是不是骗子，这课值不值，你们随意，随意。\n\n请认真阅读鹿鱼4和鹿鱼3报名里的那些老须知：https://t.co/S3Dfn4yM7V\n新须知如下：\n1，本课程适合人员：\nA  最适合币圈长期从业者\nB  其次适合想做币圈独立交易员的人\nC  然后非常适合年轻人，大学生。\nD  如果你是23年后进圈，只会玩链上的新人，你也很适合这节课。\n本课程对所有学员附送就业路径帮助。\n\nE   最后，如果你是上班党，你想靠币圈来改变命运的话，你不是非常适合我们的课，主要是您自己的时间问题，不过学了这个你不会在币圈亏大的，但我不保证你能学好交易。请谨慎考虑。\n\n2，本课程非常鼓励你们线上线下拉帮结伙，寻找在币圈共同进步的好友。所以本课程非常建议你 拽上你的币圈朋友一起来。\n\n3，今年由于是全新课件，课程变多了一倍，所以1234班的学长们都会过来重听，请5班学生自行勾搭和学习学长。你们的学长干啥玩意的都有，有好几位在自己的赛道都有光辉战绩。\n\n4，本课程虽然囊括了币圈的方方面面，但依然尽量以二级交易为中心。因为交易是所有金融市场不变的底层技术。\n\n5，本课程收入的20%将会捐献给动物保护机构。今年得换一家了，还没想好捐给谁。\n\n6，鹿鱼5这一年的最优秀学员，将会获得2份神秘大礼，将会在鹿鱼6线下课的时候揭晓。\n\n最后，本课程报名时间截止日期是9月30日。按道理来说，我应该写几篇凶残的干货文章，做做传播，给课程预热。但考虑到课程只收50人，过去报名的人过多，人贵在精不在多。加上我确实事情多，所以还是随缘吧。\n\n你们现在可以把我的推特设置成特别关注和小铃铛了，我从现在开始到9月末，不会乱发东西或者回复。\n前三节公开课的时间，请注意通知。\n\n确定报名的朋友，请下载下方的报名WORD，认真填写后，发送到邮箱： ztzzpanda777@gmail.com  （你发了我一定会回复，如果10天没回你就再发我一次）\n通过网盘分享的文件：鹿鱼5报名表格.docx\n链接: https://t.co/SMzPraxBST 提取码: ZTZZ\n\n谷歌文档链接：\nhttps://t.co/0OGdjAHyAY\n\n如果此分享链接被封，请去评论区通知我，我会补充新的链接。\n\n最后，祝大家都赚钱。\""},replyCount:33,screenName:"ZTZZBTC",status:"available",text:"《鹿鱼5——红》\n现在开始接受报名。\n在四班非常成功之后，我吸取了几位朋友的建议，把课件完全重写了一遍。现在这玩意已经不算是个交易课了，涵盖的面几乎覆盖了币圈的方方面面，把所有你们会犯错输掉裤子的地方都写了进去。\n\n具体课程目录如图：\n包含了前三节公开课，和后14节闭门课，加上线下答疑两天，加上神秘嘉宾1节（啊对，他没想好要讲什么）一共17+2+1课程。\n\n作为币圈最受好评的课程，这次重写搞得我压力很大——好吧其实根本没有压力。我纯粹就是懒，出去玩多了，然后觉得自己总结自己的系统，落到纸面上非常的麻烦。\n所以拖了非常久。说好了一年一届就一年一届，坚持做正确的事情，结善缘，是一件重要的事情。\n本课是抱着，再修改修改一两个版本，就拿来留给我女儿和后人的目标去写的，所以不用担心我没有认真写。\n\n去年是1999U，根据我们的老规矩，今年2888U一位。只涨不跌。\n至于我是不是骗子，这课值不值，你们随意，随意。\n\n请认真阅读鹿鱼4和鹿鱼3报名里的那些老须知：https://t.co/S3Dfn4yM7V\n新须知如下：\n1，本课程适合人员：\nA  最适合币圈长期从业者\nB  其次适合想做币圈独立交易员的人\nC  然后非常适合年轻人，大学生。\nD  如果你是23年后进圈，只会玩链上的新人，你也很适合这节课。\n本课程对所有学员附送就业路径帮助。\n\nE   最后，如果你是上班党，你想靠币圈来改变命运的话，你不是非常适合我们的课，主要是您自己的时间问题，不过学了这个你不会在币圈亏大的，但我不保证你能学好交易。请谨慎考虑。\n\n2，本课程非常鼓励你们线上线下拉帮结伙，寻找在币圈共同进步的好友。所以本课程非常建议你 拽上你的币圈朋友一起来。\n\n3，今年由于是全新课件，课程变多了一倍，所以1234班的学长们都会过来重听，请5班学生自行勾搭和学习学长。你们的学长干啥玩意的都有，有好几位在自己的赛道都有光辉战绩。\n\n4，本课程虽然囊括了币圈的方方面面，但依然尽量以二级交易为中心。因为交易是所有金融市场不变的底层技术。\n\n5，本课程收入的20%将会捐献给动物保护机构。今年得换一家了，还没想好捐给谁。\n\n6，鹿鱼5这一年的最优秀学员，将会获得2份神秘大礼，将会在鹿鱼6线下课的时候揭晓。\n\n最后，本课程报名时间截止日期是9月30日。按道理来说，我应该写几篇凶残的干货文章，做做传播，给课程预热。但考虑到课程只收50人，过去报名的人过多，人贵在精不在多。加上我确实事情多，所以还是随缘吧。\n\n你们现在可以把我的推特设置成特别关注和小铃铛了，我从现在开始到9月末，不会乱发东西或者回复。\n前三节公开课的时间，请注意通知。\n\n确定报名的朋友，请下载下方的报名WORD，认真填写后，发送到邮箱： ztzzpanda777@gmail.com  （你发了我一定会回复，如果10天没回你就再发我一次）\n通过网盘分享的文件：鹿鱼5报名表格.docx\n链接: https://t.co/SMzPraxBST 提取码: ZTZZ\n\n谷歌文档链接：\nhttps://t.co/0OGdjAHyAY\n\n如果此分享链接被封，请去评论区通知我，我会补充新的链接。\n\n最后，祝大家都赚钱。"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[25]={messagesBeforeDehydration:$R[26]=[$R[27]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"2094390591841042726\"}",name:"TweetResultByRestId"},$R[28]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"2094390591841042726\"}",result:$R[29]={kind:"Result.Ok",value:$R[30]={data:$R[31]={tweet_result_by_rest_id:$R[32]={id:"VHdlZXRSZXN1bHRzOjIwOTQzOTA1OTE4NDEwNDI3MjY=",rest_id:"2094390591841042726",result:$R[33]={__typename:"Tweet",cashtag_attachments:$R[34]=[],core:$R[35]={user_results:$R[36]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[37]={__typename:"User",avatar:$R[38]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[39]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[40]={label:$R[41]={badge:$R[42]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[43]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[44]={protected:!1},profile_image_shape:"Circle",relati