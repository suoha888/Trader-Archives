I1NDE4NTYxNTI=",rest_id:"2046595112541856152",result:$R[301]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[302]=[],core:$R[303]={user_results:$R[304]={id:"VXNlclJlc3VsdHM6MTQ0OTIzNjAyOTkyMDIyMzIzNQ==",result:$R[305]={__typename:"User",avatar:$R[306]={image_url:"https://pbs.twimg.com/profile_images/1552164829221101568/7o5e7qER_normal.jpg"},core:$R[307]={name:"Hikigaya｜HZGB🚀（PVP AI AGENT）",screen_name:"Hiki17Zz"},id:"VXNlcjoxNDQ5MjM2MDI5OTIwMjIzMjM1",identity_profile_labels_highlighted_label:$R[308]={},privacy:$R[309]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[310]={followers:4558,following:897},rest_id:"1449236029920223235",super_follow_eligible:!1,tweet_counts:$R[311]={tweets:2956},verification:$R[312]={is_blue_verified:!0}}}},counts:$R[313]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:1,retweet_count:0},details:$R[314]={cashtag_entities:$R[315]=[],created_at_ms:1776781273000,display_text_range:$R[316]=[9,24],full_text:"@ZTZZBTC 牛逼！期待RAVE流动性分析！",hashtag_entities:$R[317]=[],smarttags:$R[318]=[],timestamp_entities:$R[319]=[]},edit_control:$R[320]={__typename:"EditControlInitial",edit_tweet_ids:$R[321]=["2046595112541856152"]},grok_translated_post_with_availability:$R[322]={is_available:!1},id:"VHdlZXQ6MjA0NjU5NTExMjU0MTg1NjE1Mg==",legacy:$R[323]={lang:"zh"},media_entities2:$R[324]=[],mention_entities:$R[325]=[$R[326]={id_str:"867227639416840192",indices:$R[327]=[0,8],screen_name:"ZTZZBTC"}],reply_to_results:$R[328]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjIwNDY1OTA1MjIxNTI1OTk3NjY=",rest_id:"2046590522152599766"},reply_to_user_results:$R[329]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[330]={__typename:"User",core:$R[331]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"2046595112541856152",url_entities:$R[332]=[],views:$R[333]={count:"471"}}}}}}],metadata:$R[334]={conversation_metadata:$R[335]={all_tweet_ids:$R[336]=["2046595112541856152"],enable_deduplication:!0}}},entry_id:"conversationthread-2046595112541856152",sort_index:"2103672791977951212"}]},$R[337]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[338]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[339]={id:"VHdlZXRSZXN1bHRzOjIwNDY1OTA1MjIxNTI1OTk3NjY=",rest_id:"2046590522152599766",result:$R[340]={__typename:"Tweet",core:$R[341]={user_results:$R[342]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[343]={__typename:"User",avatar:$R[344]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[345]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[346]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[347]={favorite_count:124,reply_count:12},details:$R[348]={full_text:"《从项目方出货浅谈如何正确抉择来赋予山寨币价值》本文需要阅读时间10分钟/50分钟。\n我来给昨天的问题正确解答：\n如果你观察当时的BTC的K线，你可以得出结论：市场严重过热，极大概率是519之后的次顶（得不出这个结论也不重要）。你最重要的是知道，自己的K线也挺不住了。 https://t.co/otDPQgwgsR",smarttags:$R[349]=[]},id:"VHdlZXQ6MjA0NjU5MDUyMjE1MjU5OTc2Ng==",note_tweet:$R[350]={note_tweet_results:$R[351]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDQ2NTkwNTIxODYzMjQxNzI4",result:$R[352]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjIwNDY1OTA1MjE4NjMyNDE3Mjg=",text:"《从项目方出货浅谈如何正确抉择来赋予山寨币价值》本文需要阅读时间10分钟/50分钟。\n我来给昨天的问题正确解答：\n如果你观察当时的BTC的K线，你可以得出结论：市场严重过热，极大概率是519之后的次顶（得不出这个结论也不重要）。你最重要的是知道，自己的K线也挺不住了。\n在此情况下，作为项目方老板的你面临的其实是熊市降临前如何抉择。\n首先要明确的是：你的第一要务是切换成USDT本位。把所有你的币，尽可能的换成USDT。\n项目方在熊市来临前的第一要务是赚钱，第二要务是活下来。第三要务是重复第一要务。\n\n如果直接砸盘，其实并非最优解。最优解是抓紧高位横盘时间OTC。\n所以本题的最精简答案来自@LeotheHorseman  的解答。如图所示。\n然后才是配合营销或者自然流量，从盘面缓慢出货，直到OTC完成。\n这里其实还有一些细小的可行方案，比如延迟VC解锁（本质是增加时间窗口），质押（降低盘面卖出侧流动性），都是可行的。\n本题目考察的核心点是：你对项目方、散户、VC三者生态关系的了解程度，以及项目方一些常见手段的实际原理。\n如果你平时不沉下心思考，是不会得出这些看似简单，实则化繁为简的答案的。\n\n在此基础上，我们进入衍生困难模式，以下内容不适合散户阅读。不适合散户阅读。没有完整经过一轮牛市的散户请不要试着理解，有害无利，谢谢合作。\n\n我们探讨的核心是：项目方的币到底值不值钱？！为什么要在熊市来临前/VC解锁前尽可能的抛出币。\n首先请试着理解如下话语：\n真正成功的项目方，是把自己的筹码尽可能多的，合理的散发给不同的参与者（不同的生态层级）\n\nOK，我们回到问题本身来：\nvc的解锁，本质上是长时间，不可逆转的抛压。\n所以，你现在疯狂的otc，等于在vc解锁的时间内，消耗了更多的抛压。\n回到21年10月的K线，你作为项目方老大，你会知道要跌到哪里吗？\n其实不知道。\n但你知道的是一旦解锁，币一定会跌。跌了就要洗盘。洗盘就要时间。\n\n现在假设你有两种选项：1，就解锁36%给VC\n2，我现在在这个10月横盘的位置，出去OTC卖10%，盘面砸10%，加上解锁36%，一共砸56%\n\n价格会在什么位置跌停？这个问题我们会放在过几天的RAVE流动性分析里进行讲解。\n总之，你在池子里砸出去的筹码越多，他一定跌的更深一点。\n关键是从时间角度来说：你一次洗盘，洗了更多的筹码。\n\n只要你散播筹码出去，想再次拉升，就一定要洗盘。1你发了36%，你可能接回来20%，2你发了56%，你可能接回来30%\n有一些剩下的筹码永远也不会回来了，变成了沉默筹码/沉寂筹码/死筹码。\n这也是为什么22年XRP熊市的底部比20年牛市起点上涨了20%\n这段话里还有一个知识点：如果你有丰富的项目经验或者MM经验，你最后会发现，12两个选项，最终跌幅的相对偏差不大，可能也就多跌10%。\n原因我们不做赘述，分析起来很麻烦，也不符合我们的题目。\n\n现在，恭喜你，用你在暴跌前/VC解锁前OTC的钱和砸盘的钱，熬过了这个熊市。牛市来了。\n让我们继续这个问题的衍生！\n你要拉盘了！\n正常情况下，第二个牛市的高点，会低于第一个牛市。原因简单，不做赘述。\n我们假设此时的拉盘分为两种情况：\nA：拉盘不超过原高度（大多数山寨币的两个牛市的情况）\n那对比方案1和2，2中你砸的更多，跌的更多，你拉起盘来越轻松。\n因为散户关注的其实是相对涨幅。你从0.001拉10倍和你从0.1拉十倍，在散户眼里是一样的，但是你花的钱可是天上地下。\n此时假设你不超过原高度原来的价格，那你反过来看，你之前多OTC20%，是不是就是高点？？？？？？？？？？？？？？？？？？？？所以你当时是不是应该疯狂OTC？？？？？？？?？？？？？选择方案2？\n\nB：盘超过原来的高度（参照XRP，一轮牛市高于一轮）\n那对比方案1和2，2中你砸的更多，跌的更多，你拉起盘来越轻松。\n因为散户关注的其实是相对涨幅。你从0.001拉10倍和你从0.1拉十倍，在散户眼里是一样的，但是你花的钱可是天上地下。\n没错，这句话又出现了一遍。\n相比方案1，你要配资更多，你拉到前高时候，假设熊市相比前高价格跌90%，你想拉回来，涨幅是900%。是绝对高位了，这个位置从做市角度，你是不可能一次性拉到这个位置的，必然吃中途抛压，而且前高位置你百分百要停下来，等这个位置的抛压化解后再拉盘。如果拉不过去，就是双顶。\n总之这个位置出货没问题。\n那么你是不是等于又回到了这个位置出货？那你在1和2方案里选2有什么问题吗？\n\n所以最关键的几个点是：\n1，洗筹时间固定。一旦出货就必须有洗筹，有时间成本。多出货有利于节约时间成本。\n2，以后的价格不一定回来，除非你花更多的钱。\n3，由2可知，现在应该多赚钱，\n4，由2可知，拉不回来的话，现在比起未来就是高位，更要出。\n5，散户吃的是相对涨幅。跌更深，相对涨幅越高。\n\n问题完结。除非你能解决VC抛压，不然对项目方而言，在暴跌之前，应该使用一切手段出货。\n\n让我们把话题回到那句话，请再次理解：真正成功的项目方，是把自己的筹码尽可能多的，合理的散发给不同的参与者（不同的生态层级）\n\n你是否注意到我们忽略了一个问题：项目方的筹码，价值几何？\n其实答案我已经给了，就是上面那句话。\n你的筹码在面对不可回避的暴跌时，一文不值。那时候U才值钱。\n只有你正确的把筹码散发给了不同的参与者，市场才会出现你的代币的公允价格。你手里剩下来的代币，才真正值钱。\n他还有一种说法，叫货币的本质是一般等价物。我刚刚其实演示给你看的是，从实操上，山寨币是如何从空气变成一般等价物的。\n\n很神奇吧，金融。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation: