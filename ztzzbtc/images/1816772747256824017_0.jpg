0OjE4MTY3NzgwNjg3OTY4MDEwMjY=",rest_id:"1816778068796801026",text:"9，感觉跑偏了，上面那个已经不算是RUG算是诈骗了。其实市值搞砸了也是RUG的重要原因之一。有很多项目方根本不知道要做市，以为就是上所后就可以数钱了。今天讲的已经够多了，就不展开讲了，留着到第三期吧，这玩意还真能做成一个长期吐槽节目，但可惜的是，有很多话是不可以说的，我嘴边算是很严的。\n实际上做项目并不容易，有一句常常挂在嘴边的话就是：“你永远不知道自己的项目会出什么问题。”但我依然鼓励大家去了解一些做项目的基础步骤，因为项目方是整个币圈生态的核心，你越多的了解他们，你就会越能鉴别好的项目。"}}},reply_to_results:$R[729]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4MTY3Nzc1NzY0NTY4MDY1NDQ=",rest_id:"1816777576456806544"},reply_to_user_results:$R[730]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[731]={__typename:"User",core:$R[732]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1816778068880687460",url_entities:$R[733]=[],views:$R[734]={count:"3084"}}}}}},$R[735]={entry_id:"conversationthread-1816773384706871300-tweet-1816778933578400216",item:$R[736]={__typename:"TimelineTimelineItem",client_event_info:$R[737]={component:"tweet",details:$R[738]={conversation_details:$R[739]={conversation_section:"HighQuality"},timelines_details:$R[740]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbjH8DAAAAAA=="}},element:"tweet"},content:$R[741]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[742]={id:"VHdlZXRSZXN1bHRzOjE4MTY3Nzg5MzM1Nzg0MDAyMTY=",rest_id:"1816778933578400216",result:$R[743]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[744]=[],core:$R[745]={user_results:$R[746]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[747]={__typename:"User",avatar:$R[748]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[749]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[750]={label:$R[751]={badge:$R[752]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Ar