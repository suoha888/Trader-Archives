XNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[305]={__typename:"User",avatar:$R[306]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[307]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[308]={label:$R[309]={badge:$R[310]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[311]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[312]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[313]={followers:23909,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[314]={tweets:3544},verification:$R[315]={is_blue_verified:!0}}}},counts:$R[316]={bookmark_count:2,favorite_count:6,quote_count:0,reply_count:1,retweet_count:0},details:$R[317]={cashtag_entities:$R[318]=[],created_at_ms:1721987629000,display_text_range:$R[319]=[0,142],full_text:"2，某项目老板卖算力的，弄了个落后时代20年的产品，给我朋友一帮运营和市场上课吹自己的产品牛逼，他的营销理念是“不用多营销，是金子总会发光的”。实际上我朋友所有人都知道他那产品卖不出去，就去和他的合伙人谈，合伙人笑了笑给我朋友来了句：你们尽力就行。产品卖不出去，他坚持不改产品，嘲讽社 https://t.co/fB4sdGhxx7",hashtag_entities:$R[320]=[],smarttags:$R[321]=[],timestamp_entities:$R[322]=[]},edit_control:$R[323]={__typename:"EditControlInitial",edit_tweet_ids:$R[324]=["1816773914007339413"]},grok_translated_post_with_availability:$R[325]={is_available:!1},id:"VHdlZXQ6MTgxNjc3MzkxNDAwNzMzOTQxMw==",legacy:$R[326]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[327]=[$R[328]={allow_download_status:$R[329]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1816773914007339413/photo/1",ext_media_availability:$R[330]={status:"Available"},ext_playlists:$R[331]=[],features:$R[332]={},id_str:"1816773842662227968",indices:$R[333]=[143,166],media_url_https:"https://pbs.twimg.com/media/GTZ6LykagAA18H9.jpg",original_info:$R[334]={height:664,width:1435},type:"photo"}],mention_entities:$R[335]=[],note_tweet:$R[336]={is_expandable:!0,note_tweet_results:$R[337]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODE2NzczOTEzOTI3NjY3NzEy",result:$R[338]={__typename:"NoteTweet",entity_set:$R[339]={hashtags:$R[340]=[],symbols:$R[341]=[],urls:$R[342]=[],user_mentions:$R[343]=[]},id:"Tm90ZVR3ZWV0OjE4MTY3NzM5MTM5Mjc2Njc3MTI=",rest_id:"1816773913927667712",text:"2，某项目老板卖算力的，弄了个落后时代20年的产品，给我朋友一帮运营和市场上课吹自己的产品牛逼，他的营销理念是“不用多营销，是金子总会发光的”。实际上我朋友所有人都知道他那产品卖不出去，就去和他的合伙人谈，合伙人笑了笑给我朋友来了句：你们尽力就行。产品卖不出去，他坚持不改产品，嘲讽社区和KOL都是不识货的傻逼。三个月拖下来项目要黄了，有个做市场的赚不到钱，就带了个社区负责人去和老板现场聊。结果30分钟后，就听见办公室里传来：“滚出去，你个不识货的傻逼！”我们一帮做运营的也不知道为什么做算力的产品也能高人一等。项目散货后，财务告知市场人员：男合伙人好像和男老板有一腿。"}}},reply_to_results:$R[344]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4MTY3NzMzODQ3MDY4NzEzMDA=",rest_id:"1816773384706871300"},reply_to_user_results:$R[345]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[346]={__typename:"User",core:$R[347]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1816773914007339413",url_entities:$R[348]=[],views:$R[349]={count:"3287"}}}}}},$R[350]={entry_id:"conversationthread-1816773384706871300-tweet-1816774647339487685",item:$R[351]={__typename:"TimelineTimelineItem",client_event_info:$R[352]={component:"tweet",details:$R[353]={conversation_details:$R[354]={conversation_section:"HighQuality"},timelines_details:$R[355]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbjH8DAAAAAA=="}},element:"tweet"},content:$R[356]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[357]={id:"VHdlZXRSZXN1bHRzOjE4MTY3NzQ2NDczMzk0ODc2ODU=",rest_id:"1816774647339487685",result:$R[358]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[359]=[],core:$R[360]={user_results:$R[361]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[362]={__typename:"User",avatar:$R[363]={image_url:"https://pbs.twimg.com/pr