3162828189926",result:$R[205]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[206]=[],core:$R[207]={user_results:$R[208]={id:"VXNlclJlc3VsdHM6MTg2MzI0MzUyMzgyNDQyNzAwOA==",result:$R[209]={__typename:"User",avatar:$R[210]={image_url:"https://pbs.twimg.com/profile_images/2094074237434908672/dYz4Qqec_normal.jpg"},core:$R[211]={name:"普普",screen_name:"pupubtc"},id:"VXNlcjoxODYzMjQzNTIzODI0NDI3MDA4",identity_profile_labels_highlighted_label:$R[212]={label:$R[213]={badge:$R[214]={url:"https://pbs.twimg.com/profile_images/1885153504291102720/R7usrJag_bigger.jpg"},description:"UniversalX",url:$R[215]={url:"https://twitter.com/UseUniversalX"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[216]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[217]={followers:662,following:369},rest_id:"1863243523824427008",super_follow_eligible:!1,tweet_counts:$R[218]={tweets:5985},verification:$R[219]={is_blue_verified:!0}}}},counts:$R[220]={bookmark_count:0,favorite_count:2,quote_count:0,reply_count:0,retweet_count:0},details:$R[221]={cashtag_entities:$R[222]=[],created_at_ms:1744792187000,display_text_range:$R[223]=[9,140],full_text:"@ZTZZBTC 识人，其实不是看这个人有多大能力，而是看他有没有成事之才，像我对自己的评价就是三分钟热度，无自律性。\n所以我这样的人就是没有成事之才的，我会因为一时的成就或者失败而影响整体进度。识别人和识自己一样，优秀的成功者身上都会有一个共同点：自驱力。这个很重要，非常重要。",hashtag_entities:$R[224]=[],smarttags:$R[225]=[],timestamp_entities:$R[226]=[]},edit_control:$R[227]={__typename:"EditControlInitial",edit_tweet_ids:$R[228]=["1912423162828189926"]},grok_translated_post_with_availability:$R[229]={is_available:!1},id:"VHdlZXQ6MTkxMjQyMzE2MjgyODE4OTkyNg==",legacy:$R[230]={lang:"zh"},media_entities2:$R[231]=[],mention_entities:$R[232]=[$R[233]={id_str:"867227639416840192",indices:$R[234]=[0,8],screen_name:"ZTZZBTC"}],reply_to_results:$R[235]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MTIxNjQ2OTM3NzY3NzcyNDg=",rest_id:"1912164693776777248"},reply_to_user_results:$R[236]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",r