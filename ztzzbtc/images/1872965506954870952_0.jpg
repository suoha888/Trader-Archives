    const formatters = {"formatFullTimestamp": (function formatFullTimestamp({ timestamp, lang, timeZone }) {
	const date = new Date(timestamp);
	return `${date.toLocaleTimeString(lang, {
		hour: "numeric",
		minute: "2-digit",
		timeZone
	})} · ${date.toLocaleDateString(lang, {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone
	})}`;
}),
"formatRelativePastTimestamp": (function formatRelativePastTimestamp({ timestamp, lang, timeZone, nowLabel }) {
	const date = new Date(timestamp);
	const now = /* @__PURE__ */ new Date();
	const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1e3);
	if (diffInSeconds <= 0) return nowLabel ?? new Intl.RelativeTimeFormat(lang, { numeric: "auto" }).format(0, "second");
	if (diffInSeconds < 60) return new Intl.NumberFormat(lang, {
		style: "unit",
		unit: "second",
		unitDisplay: "narrow"
	}).format(diffInSeconds);
	if (diffInSeconds < 3600) return new Intl.NumberFormat(lang, {
		style: "unit",
		unit: "minute",
		unitDisplay: "narrow"
	}).format(Math.floor(diffInSeconds / 60));
	if (diffInSeconds < 86400) return new Intl.NumberFormat(lang, {
		style: "unit",
		unit: "hour",
		unitDisplay: "narrow"
	}).format(Math.floor(diffInSeconds / 3600));
	if (date.toLocaleDateString(lang, {
		year: "numeric",
		timeZone
	}) === now.toLocaleDateString(lang, {
		year: "numeric",
		timeZone
	})) return date.toLocaleDateString(lang, {
		month: "short",
		day: "numeric",
		timeZone
	});
	return date.toLocaleDateString(lang, {
