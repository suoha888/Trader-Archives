:852},type:"video",video_info:$R[127]={duration_millis:343005,variants:$R[128]=[$R[129]={content_type:"application/x-mpegURL",url:"https://video.twimg.com/ext_tw_video/1870143728322801664/pu/pl/qhPE94lF0YWnBVfT.m3u8?tag=12"},$R[130]={bitrate:256000,content_type:"video/mp4",url:"https://video.twimg.com/ext_tw_video/1870143728322801664/pu/vid/avc1/478x270/cqlYJDHCsb9PM0cR.mp4?tag=12"},$R[131]={bitrate:832000,content_type:"video/mp4",url:"https://video.twimg.com/ext_tw_video/1870143728322801664/pu/vid/avc1/638x360/hYFft8mTL043OYTt.mp4?tag=12"},$R[132]={bitrate:2176000,content_type:"video/mp4",url:"https://video.twimg.com/ext_tw_video/1870143728322801664/pu/vid/avc1/852x480/QpmCGGgkMc1BGxEA.mp4?tag=12"}]}}],mention_entities:$R[133]=[],note_tweet:$R[134]={is_expandable:!0,note_tweet_results:$R[135]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODcwMTQ0MTY1MjYwMTY1MTIw",result:$R[136]={__typename:"NoteTweet",entity_set:$R[137]={hashtags:$R[138]=[],symbols:$R[139]=[],timestamps:$R[140]=[],urls:$R[141]=[],user_mentions:$R[142]=[]},id:"Tm90ZVR3ZWV0OjE4NzAxNDQxNjUyNjAxNjUxMjA=",rest_id:"1870144165260165120",text:"这两天爆杀了市场，完成了我从业以来最短时间内最高的收益，2天之内大金额账户，只动用5成仓，低杠杆，全仓收益53%以上。\n散户可能不知道这是什么个概念，觉得没有万倍收益，没有暴富神话，啥都不算。\n正经基金经理就知道这是个什么战斗力了。\n本来明天提最贵的SUV的，现在明天提完车直接去再提阿仕顿马丁加法拉利了。\n这一切，都是当着学生群、VC朋友、推特二级交易大V、阿里巴巴的ADAO500人群的面完成的。战绩可查。\n\n先是一周前把BTC的剧本写好了，做空在107357点，缺点是我没来得及加仓空，仓位不够大。\n\n然后选择做空了一揽子MEME币，PNUT和NEIRO是我做空最大的币。\n\n再之后，我选中了市场里今天涨幅榜前二的币，MOVE。公开喊了所有人上车。MOVE这个币我第一轮的建仓成本是0.627左右，实盘逃顶在0.86附近，中间还做了一次波段。今天币安大跌时最低点是0.6774，我挂单接到了0.6777，然后随着放量加仓。现在是0.81。MOVE我是纯现货。具体见推特。\n\n昨天凌晨和VC的朋友说：92100点是我好几天前测算出的下跌极限值。\n今天BTC的下跌实际值是92232.54.\n\n在BTC接近底部的时候，我还在三个群全部喊了一遍这里是最重要的位置，如果跌破则超出我的预期，可能发生黑天鹅。\n\n就是说，我公开完成了预测，逃顶，做空，找到市场里没启动的最优质币，波段，抄底。几乎二级交易的每一个环节。\n全部可查，我把图都放在评论区。\n\n这些，都不是我想说的。\n我这两天不在电脑前，我在海南租了个别墅，接妈妈来过年，我明天一早还要赶回上海。这几天大多数是手机盯盘，不然操作还能更细。\n在19日晚上下楼吃晚饭的时候，我突然福至心灵，有一瞬间，我感觉这几年所有的辛苦都烟消云散，世界变得甜美而明亮。\n我耳机里放着《真夜中のドア/stay with me》，在街头直接跳起了舞。\n我并不知道自己为什么起舞，我感觉K线在我指尖，所爱的人就在我怀里，我感觉自己，无所不能。\n\n之前我一直受各位老板提携，我时常告诉自己要努力，不能给他们丢人。\n现在我不会再这样想了，至少在二级交易领域，我不用再去证明什么了。\n我想，在别人眼中的我，应该已经成为他们。\n\n道德菩提非正果，今日方证我是我。"}}},rest_id:"1870144165402816825",url_entities:$R[143]=[],views:$R[144]={count:"124491"}}}}},entry_id:"tweet-1870144165402816825",sort_index:"2103672720330850304"},$R[145]={content:$R[146]={__typename:"TimelineTimelineModule",client_event_info:$R[147]={component:"tweet"},display_type:"VerticalConversation",items:$R[148]=[$R[149]={entry_id:"conversationthread-1870144941047091678-tweet-1870144941047091678",item:$R[150]={__typename:"TimelineTimelineItem",client_event_info:$R[151]={component:"tweet",details:$R[152]={conversation_details:$R[153]={conversation_section:"HighQuality"},timelines_details:$R[154]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbicjzAAAAAA=="}},element:"tweet"},content:$R[155]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[156]={id:"VHdlZXRSZXN1bHRzOjE4NzAxNDQ5NDEwNDcwOTE2Nzg=",rest_id:"1870144941047091678",result:$R[157]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[158]=[],core:$R[159]={user_results:$R[160]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[161]={__typename:"User",avatar:$R[162]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[163]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[164]={label:$R[165]={badge:$R[166]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[167]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[168]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[169]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[170]={tweets:3544},verification:$R[171]={is_blue_verified:!0}}}},counts:$