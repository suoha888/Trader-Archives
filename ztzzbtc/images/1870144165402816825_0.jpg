_results:$R[803]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[804]={__typename:"User",core:$R[805]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1870144538083504332",url_entities:$R[806]=[],views:$R[807]={count:"385"}}}}}}],metadata:$R[808]={conversation_metadata:$R[809]={all_tweet_ids:$R[810]=["1870144538083504332"],enable_deduplication:!0}}},entry_id:"conversationthread-1870144538083504332",sort_index:"2103672720330850274"}]},$R[811]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[812]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[813]={id:"VHdlZXRSZXN1bHRzOjE4NzAxNDQxNjU0MDI4MTY4MjU=",rest_id:"1870144165402816825",result:$R[814]={__typename:"Tweet",core:$R[815]={user_results:$R[816]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[817]={__typename:"User",avatar:$R[818]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[819]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",profile_bio:$R[820]={description:"区块链最早的一批运营总监，主观做市商，独立交易员，空军司令，推特只发干货，面向币圈从业人员。\n\nAll's right with the world!\nAll paths lead to BTC！\nAll for Love!"}}}},counts:$R[821]={favorite_count:278,reply_count:98},details:$R[822]={full_text:"这两天爆杀了市场，完成了我从业以来最短时间内最高的收益，2天之内大金额账户，只动用5成仓，低杠杆，全仓收益53%以上。\n散户可能不知道这是什么个概念，觉得没有万倍收益，没有暴富神话，啥都不算。\n正经基金经理就知道这是个什么战斗力了。 https://t.co/s8IHWX8g0k",smarttags:$R[823]=[]},id:"VHdlZXQ6MTg3MDE0NDE2NTQwMjgxNjgyNQ==",note_tweet:$R[824]={note_tweet_results:$R[825]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODcwMTQ0MTY1MjYwMTY1MTIw",result:$R[826]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE4NzAxNDQxNjUyNjAxNjUxMjA=",text:"这两天爆杀了市场，完成了我从业以来最短时间内最高的收益，2天之内大金额账户，只动用5成仓，低杠杆，全仓收益53%以上。\n散户可能不知道这是什么个概念，觉得没有万倍收益，没有暴富神话，啥都不算。\n正经基金经理就知道这是个什么战斗力了。\n本来明天提最贵的SUV的，现在明天提完车直接去再提阿仕顿马丁加法拉利了。\n这一切，都是当着学生群、VC朋友、推特二级交易大V、阿里巴巴的ADAO500人群的面完成的。战绩可查。\n\n先是一周前把BTC的剧本写好了，做空在107357点，缺点是我没来得及加仓空，仓位不够大。\n\n然后选择做空了一揽子MEME币，PNUT和NEIRO是我做空最大的币。\n\n再之后，我选中了市场里今天涨幅榜前二的币，MOVE。公开喊了所有人上车。MOVE这个币我第一轮的建仓成本是0.627左右，实盘逃顶在0.86附近，中间还做了一次波段。今天币安大跌时最低点是0.6774，我挂单接到了0.6777，然后随着放量加仓。现在是0.81。MOVE我是纯现货。具体见推特。\n\n昨天凌晨和VC的朋友说：92100点是我好几天前测算出的下跌极限值。\n今天BTC的下跌实际值是92232.54.\n\n在BTC接近底部的时候，我还在三个群全部喊了一遍这里是最重要的位置，如果跌破则超出我的预期，可能发生黑天鹅。\n\n就是说，我公开完成了预测，逃顶，做空，找到市场里没启动的最优质币，波段，抄底。几乎二级交易的每一个环节。\n全部可查，我把图都放在评论区。\n\n这些，都不是我想说的。\n我这两天不在电脑前，我在海南租了个别墅，接妈妈来过年，我明天一早还要赶回上海。这几天大多数是手机盯盘，不然操作还能更细。\n在19日晚上下楼吃晚饭的时候，我突然福至心灵，有一瞬间，我感觉这几年所有的辛苦都烟消云散，世界变得甜美而明亮。\n我耳机里放着《真夜中のドア/stay with me》，在街头直接跳起了舞。\n我并不知道自己为什么起舞，我感觉K线在我指尖，所爱的人就在我怀里，我感觉自己，无所不能。\n\n之前我一直受各位老板提携，我时常告诉自己要努力，不能给他们丢人。\n现在我不会再这样想了，至少在二级交易领域，我不用再去证明什么了。\n我想，在别人眼中的我，应该已经成为他们。\n\n道德菩提非正果，今日方证我是我。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1870144165402816825:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/ZTZZBTC" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@ZTZZBTC" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/14913576772927119