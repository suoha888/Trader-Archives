photo"},$R[142]={allow_download_status:$R[143]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/2014993622031344095/photo/1",ext_media_availability:$R[144]={status:"Available"},ext_playlists:$R[145]=[],features:$R[146]={},id_str:"2014972872205418497",indices:$R[147]=[163,186],media_url_https:"https://pbs.twimg.com/media/G_afJsfaQAEgVq_.jpg",original_info:$R[148]={height:1969,width:3673},type:"photo"},$R[149]={allow_download_status:$R[150]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/2014993622031344095/photo/1",ext_media_availability:$R[151]={status:"Available"},ext_playlists:$R[152]=[],features:$R[153]={},id_str:"2014972872222281728",indices:$R[154]=[163,186],media_url_https:"https://pbs.twimg.com/media/G_afJsjbkAATtns.jpg",original_info:$R[155]={height:1895,width:3639},type:"photo"}],mention_entities:$R[156]=[$R[157]={id_str:"28754022",indices:$R[158]=[2,10],screen_name:"coolish"},$R[159]={id_str:"1056818658",indices:$R[160]=[13,27],screen_name:"CryptoPainter"}],note_tweet:$R[161]={is_expandable:!0,note_tweet_results:$R[162]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDE0OTkzNjIxODU5MzAzNDI0",result:$R[163]={__typename:"NoteTweet",entity_set:$R[164]={hashtags:$R[165]=[],symbols:$R[166]=[],urls:$R[167]=[],user_mentions:$R[168]=[$R[169]={id_str:"28754022",indices:$R[170]=[2,10],screen_name:"coolish"},$R[171]={id_str:"1056818658",indices:$R[172]=[13,27],screen_name:"CryptoPainter"}]},id:"Tm90ZVR3ZWV0OjIwMTQ5OTM2MjE4NTkzMDM0MjQ=",rest_id:"2014993621859303424",text:"玩了@coolish 和 @CryptoPainter  推荐的Insider trading《内幕交易》\n我在最后一周天天拉1.5倍起步，过关要求3200美金，我打了个33715美金。\n这游戏还是很有意思的，把K线涨跌和特殊事件，结合了ROUGELIKE，分成涨和跌两种牌，以及不同的牌种类。需要合理安排牌序，来完成目标。\n我到觉得这个游戏不是庄家模拟器，因为庄家实际操盘过程中的一些麻烦，并没有完全提现出来。他真的很像名字：内幕交易。\n你知道一些内幕，但是不多，你比韭菜强一点，但也只能猜测庄家的衣角。\n我严正声明：我们做市的比这个难多啦哈哈哈。\n这个游戏最有意思的一点，其实是把市场涨跌和随机事件给安排到牌里。你的牌里如果花了太多的拉盘牌，之后出现下跌牌的概率就会变大。这其实就是拉盘之后，抛压变大。\n如果你把上涨和下跌牌，连续排列，就会触发连击！上涨和下跌的幅度就会更大，这其实是暗示了趋势出现时，连续的单边趋势会放大人们的情绪！造成更大的波动。\n牌库里还有各种黑天鹅牌，以及宏观市场的随机事件。\n\n我作为一个半吊子的桌游设计师，一直想有空的时候设计一款自己的，和交易有关的游戏，我很清楚其中的设计难度。不论怎么说，这都是我目前玩到的非常好的交易游戏了。\n我向大家再推荐一款桌游——《并购ACQUIRE》。同样是金融模仿领域游戏的巅峰作品。"}}},rest_id:"2014993622031344095",url_entities:$R[173]=[],views:$R[174]={count:"10571"}}}}},entry_id:"tweet-2014993622031344095",sort_index:"2103672932696850432"},$R[175]={content:$R[176]={__typename:"TimelineTimelineModule",client_event_info:$R[177]={component:"tweet"},display_type:"VerticalConversation",items:$R[178]=[$R[179]={entry_id:"conversationthread-2017061478642385374-tweet-2017061478642385374",item:$R[180]={__typename:"TimelineTimelineItem",client_event_info:$R[181]={component:"tweet",details:$R[182]={conversation_details:$R[183]={conversation_section:"HighQuality"},timelines_details:$R[184]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbio9xAAAAAA=="}},element:"tweet"},content:$R[185]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[186]={id:"VHdlZXRSZXN1bHRzOjIwMTcwNjE0Nzg2NDIzODUzNzQ=",rest_id:"2017061478642385374",result:$R[187]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[188]=[],core:$R[189]={user_results:$R[190]={id:"VXNlclJlc3VsdHM6Mjg2MTI4NDMwNg==",result:$R[191]={__typename:"User",avatar:$R[192]={image_url:"https://pbs.twimg.com/profile_images/1735786462560559105/ZxhW4Z0u_normal.jpg"},core:$R[193]={name:"星玥Zen",screen_name:"yangyanupe213"},id:"VXNlcjoyODYxMjg0MzA2",identity_profile_labels_highlighted_label:$R[194]={},privacy:$R[195]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[196]={followers:64,following:464},rest_id:"2861284306",super_follow_eligible:!1,tweet_counts:$R[197]={tweets:1416},verification:$R[198]={is_blue_verified:!1}}}},counts:$R[199]={bookmark_count:0,favorite_count:0,quote_count:0,reply_count:0,retweet_count:0},details:$R[200]={cashtag_entities:$R[201]=[],created_at_ms:1769739906000,display_text_range:$R[202]=[33,44],full_text:"@ZTZZBTC @coolish @CryptoPainter 这份小胜利，暖心又治愈",hashtag_entities:$R[203]=[],smarttags