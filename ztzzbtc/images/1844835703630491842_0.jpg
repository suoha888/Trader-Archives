jnxDlSxM",hashtag_entities:$R[447]=[],smarttags:$R[448]=[],timestamp_entities:$R[449]=[]},edit_control:$R[450]={__typename:"EditControlInitial",edit_tweet_ids:$R[451]=["1844839445163573402"]},grok_translated_post_with_availability:$R[452]={is_available:!1},id:"VHdlZXQ6MTg0NDgzOTQ0NTE2MzU3MzQwMg==",legacy:$R[453]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[454]=[$R[455]={allow_download_status:$R[456]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844839445163573402/photo/1",ext_media_availability:$R[457]={status:"Available"},ext_playlists:$R[458]=[],features:$R[459]={},id_str:"1844839429225201664",indices:$R[460]=[59,82],media_url_https:"https://pbs.twimg.com/media/GZovr76aQAAq3GT.jpg",original_info:$R[461]={height:392,width:608},type:"photo"}],mention_entities:$R[462]=[],note_tweet:$R[463]={is_expandable:!0,note_tweet_results:$R[464]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODM5NDQ1MTAwNjU4Njg4",result:$R[465]={__typename:"NoteTweet",entity_set:$R[466]={hashtags:$R[467]=[],symbols:$R[468]=[],urls:$R[469]=[],user_mentions:$R[470]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4Mzk0NDUxMDA2NTg2ODg=",rest_id:"1844839445100658688",text:"6。我对机构的朋友有一句话语：“上升的时候不用看我，你们随意发挥。摸顶和抄底看我即可。”我在推特上也一直是这么说的。\n10月7日向上冲顶的时候过于明显，选择了抛掉部分山寨，然后右侧开空并逐步加仓的方式再次做空。为什么敢在这里做空。原因我后来在三个小群里直播都讲过：从分形学角度出发，我赞同我朋友阿夏找到的分形剧本，这里只不过是因为4号的利好，多了一段向上冲的短期能量。把这段行情擦掉，就会衔接原来的剧本。在63800点完成二号账户中等仓位空单后。我在等最后的下跌。"}}},reply_to_results:$R[471]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4MzkwNDg3MjYzNjg0Mzg=",rest_id:"1844839048726368438"},reply_to_user_results:$R[472]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[473]={__typename:"User",core:$R[474]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844839445163573402",url_entities:$R[475]=[],views:$R[476]={count:"1225"}}}}}},$R[477]={entry_id:"conversationthread-1844836496811131255-tweet-1844840270573305974",item:$R[478]={__typename:"TimelineTimelineItem",client_event_info:$R[479]={component:"tweet",details:$R[480]={conversation_details:$R[481]={conversation_section:"HighQuality"},timelines_details:$R[482]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[483]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[484]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDAyNzA1NzMzMDU5NzQ=",rest_id:"1844840270573305974",result:$R[485]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[486]=[],core:$R[487]={user_results:$R[488]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[489]={__typename:"User",avatar:$R[490]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[491]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[492]={label:$R[493]={badge:$R[494]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[495]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[496]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[497]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[498]={tweets:3544},verification:$R[499]={is_blue_verified:!0}}}},counts:$R[500]={bookmark_count:0,favorite_count:0,quote_count:0,reply_count:1,retweet_count:0},details:$R[501]={cashtag_entities:$R[502]=[],created_at_ms:1728679170000,display_text_range:$R[503]=[0,60],full_text:"7。然后我就翻车了。我决定用第三个账户，小仓位账户，去博一个下跌前的50倍X空单做空。完成大中小三位一体的另类趋势空单。 https://t.co/qvgl37PZ1U",hashtag_entities:$R[504]=[],smarttags:$R[505]=[],timestamp_entities:$R[506]=[]},edit_control:$R[507]={__typename:"EditControlInitial",edit_tweet_ids:$R[508]=["1844840270573305974"]},grok_translated_post_with_availability:$R[509]={is_available:!1},id:"VHdlZXQ6MTg0NDg0MDI3MDU3MzMwNTk3NA==",legacy:$R[510]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[511]=[$R[512]={allow_download_status:$R[513]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844840270573305974/photo/1",ext_media_availability:$R[514]={status:"Available"},ext_playlists:$R[515]=[],features:$R[516]={},id_str:"1844840257759637504",indices:$R[517]=[61,84],media_url_https:"https://pbs.twimg.com/media/GZowcKcacAAyItk.jpg",original_info:$R[518]={height:1123,width:2023},type:"photo"}],mention_entities:$R[519]=[],note_tweet:$R[520]={is_expandable:!0,note_tweet_results:$R[521]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQwMjcwMzY3NzI3NjE2",result:$R[522]={__typename:"NoteTweet",entity_set:$R[523]={hashtags:$R[524]=[],symbols:$R[525]=[],urls:$R[526]=[],user_mentions:$R[527]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDAyNzAzNjc3Mjc2MTY=",rest_id:"1844840270367727616",text:"7。然后我就翻车了。我决定用第三个账户，小仓位账户，去博一个下跌前的50倍X空单做空。完成大中小三位一体的另类趋势空单。\n这个空单的博弈点是建立在66000是这波行情的最高点的前提下。一般的趋势空单要等趋势确立后建仓，而如果建立在趋势的起点，则几乎坚不可摧。9号晚上八点半，各个主要群吼了一嗓子要破位了，然后开始带群友盯盘。期间已经被VC在群里骂了一句啰嗦。大概是觉得前两天还看多，这里又做空，很烦，怕磨损。\n小仓位的这个单子是追跌破的单子，完成时均价61965。结果晚上11点强烈反弹画了个门。由于我当时在给学生们直播，这一下打到了我的止损线，并且比正常的跌破确认要高了一点，我怀疑跌破失效。\n所以我做出了一个错误的决策：平掉70%的小仓位和中仓位单子。平完后隔壁交易员小群有人说了一句再等一小时看看，但我还是手快了。万幸是还有30%的中仓位单子。跌到59000本来是赚两辆法拉利，现在少了一台。"}}},reply_to_results:$R[528]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4Mzk0NDUxNjM1NzM0MDI=",rest_id:"1844839445163573402"},reply_to_user_results:$R[529]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[530]={__typename:"User",core:$R[531]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844840270573305974",url_entities:$R[532]=[],views:$R[533]={count:"1257"}}}}}},$R[534]={entry_id:"conversationthread-1844836496811131255-tweet-1844840781275938879",item:$R[535]={__typename:"TimelineTimelineItem",client_event_info:$R[536]={component:"tweet",details:$R[537]={conversation_details:$R[538]={conversation_section:"HighQuality"},timelines_details:$R[539]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[540]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[541]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDA3ODEyNzU5Mzg4Nzk=",rest_id:"1844840781275938879",result:$R[542]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[543]=[],core:$R[544]={user_results:$R[545]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[546]={__typename:"User",avatar:$R[547]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[548]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[549]={label:$R[550]={badge:$R[551]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[552]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[553]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[554]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[555]={tweets:3544},verification:$R[556]={is_blue_verified:!0}}}},counts:$R[557]={bookmark_count:1,favorite_count:0,quote_count:0,reply_count:1,retweet_count:0},details:$R[558]={cashtag_entities:$R[559]=[],created_at_ms:1728679292000,display_text_range:$R[560]=[0,136],full_text:"8。这里就要提到，为什么要平掉这个单子，做出了错误决策。如果你们观察的话，会发现最近的BTC一直在走之前几年很少出现的一个走势：\n在关键位置出一个下跌通道，每次都出一个新低点，诱空，然后在尽头直接V反突破下跌通道的起始点。请记住这个方式。我们也会在做市商的理论里再次讲到。 https://t.co/8jVTZ0Swu9",hashtag_entities:$R[561]=[],smarttags:$R[562]=[],timestamp_entities:$R[563]=[]},edit_control:$R[564]={__typename:"EditControlInitial",edit_tweet_ids:$R[565]=["1844840781275938879"]},grok_translated_post_with_availability:$R[566]={is_available:!1},id:"VHdlZXQ6MTg0NDg0MDc4MTI3NTkzODg3OQ==",legacy:$R[567]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[568]=[$R[569]={allow_download_status:$R[570]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844840781275938879/photo/1",ext_media_availability:$R[571]={status:"Available"},ext_playlists:$R[572]=[],features:$R[573]={},id_str:"1844840772497297408",indices:$R[574]=[137,160],media_url_https:"https://pbs.twimg.com/media/GZow6H_b0AAbRxN.jpg",original_info:$R[575]={height:316,width:336},type:"photo"}],mention_entities:$R[576]=[],note_tweet:$R[577]={is_expandable:!0,note_tweet_results:$R[578]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQwNzgxMjEyOTgzMjk2",result:$R[579]={__typename:"NoteTweet",entity_set:$R[580]={hashtags:$R[581]=[],symbols:$R[582]=[],urls:$R[583]=[],user_mentions:$R[584]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDA3ODEyMTI5ODMyOTY=",rest_id:"1844840781212983296",text:"8。这里就要提到，为什么要平掉这个单子，做出了错误决策。如果你们观察的话，会发现最近的BTC一直在走之前几年很少出现的一个走势：\n在关键位置出一个下跌通道，每次都出一个新低点，诱空，然后在尽头直接V反突破下跌通道的起始点。请记住这个方式。我们也会在做市商的理论里再次讲到。\n是这个走势骗了我。因为仅仅1小时，就走出了一个吞没形态画门，随后开始下跌。我只好在更低的位置重新建立小仓位的空单。这个失误的反思是：\n1，一些经典形态手法永远有用，哪怕知道也不一定避得开。\n2，非流动性高的关键位置，越小级别的形态不确定性越强，欺骗性越高。结合1就可以得出尽量不要做追突破，在流动性不好的市场里很容易被折磨。\n3，中仓位的止盈过于草率，其实是受到了小仓位失利的影响做出了临时决策，不该做临时决策。"}}},reply_to_results:$R[585]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDAyNzA1NzMzMDU5NzQ=",rest_id:"1844840270573305974"},reply_to_user_results:$R[586]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[587]={__typename:"User",core:$R[588]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844840781275938879",url_entities:$R[589]=[],views:$R[590]={count:"1315"}}}}}},$R[591]={entry_id:"conversationthread-1844836496811131255-tweet-1844841707705454628",item:$R[592]={__typename:"TimelineTimelineItem",client_event_info:$R[593]={component:"tweet",details:$R[594]={conversation_details:$R[595]={conversation_section:"HighQuality"},timelines_details:$R[596]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[597]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[598]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDE3MDc3MDU0NTQ2Mjg=",rest_id:"1844841707705454628",result:$R[599]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[600]=[],core:$R[601]={user_results:$R[602]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[603]={__typename:"User",avatar:$R[604]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[605]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[606]={label:$R[607]={badge:$R[608]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[609]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[610]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[611]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[612]={tweets:3544},verification:$R[613]={is_blue_verified:!0}}}},counts:$R[614]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:1,retweet_count:0},details:$R[615]={cashtag_entities:$R[616]=[],created_at_ms:1728679513000,display_text_range:$R[617]=[0,88],full_text:"9。跌完之后我在59346的位置平掉了小仓位的空单，并且在11日早上9点60100附近平掉了65900附近的大仓位空单的35%。这个操作的原因很复杂，一部分我会放在第三部分讲。 https://t.co/47W10Spwap",hashtag_entities:$R[618]=[],smarttags:$R[619]=[],timestamp_entities:$R[620]=[]},edit_control:$R[621]={__typename:"EditControlInitial",edit_tweet_ids:$R[622]=["1844841707705454628"]},grok_translated_post_with_availability:$R[623]={is_available:!1},id:"VHdlZXQ6MTg0NDg0MTcwNzcwNTQ1NDYyOA==",legacy:$R[624]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[625]=[$R[626]={allow_download_status:$R[627]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844841707705454628/photo/1",ext_media_availability:$R[628]={status:"Available"},ext_playlists:$R[629]=[],features:$R[630]={},id_str:"1844841697525862400",indices:$R[631]=[89,112],media_url_https:"https://pbs.twimg.com/media/GZoxv9_bkAA2P3M.jpg",original_info:$R[632]={height:1005,width:1999},type:"photo"}],mention_entities:$R[633]=[],note_tweet:$R[634]={is_expandable:!0,note_tweet_results:$R[635]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQxNzA3NTU0MzczNjMy",result:$R[636]={__typename:"NoteTweet",entity_set:$R[637]={hashtags:$R[638]=[],symbols:$R[639]=[],urls:$R[640]=[],user_mentions:$R[641]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDE3MDc1NTQzNzM2MzI=",rest_id:"1844841707554373632",text:"9。跌完之后我在59346的位置平掉了小仓位的空单，并且在11日早上9点60100附近平掉了65900附近的大仓位空单的35%。这个操作的原因很复杂，一部分我会放在第三部分讲。\n简单来说我观测到了短时间的不正常放量。我是可以接受今天日线收一根针的，但是当我发现今天日线可能要至少回到61300点附近时，从盈亏比和趋势的角度考虑，我选择减掉上方的大仓位的35%。\n所谓的不正常放量，就是你盯盘时间长之后出现的一些盘感。你会对时间，空间和量能有一个感受，结合阻力位支撑位，你知道什么地方怎么走是正常的，什么地方突然爆拉一下是可以接受的，什么地方突然爆拉一下是有问题的，是不正常的，是会导致后来出现你不想看见的走势的。\n为什么反复强调指标并不重要，强调要下苦工盯盘，原因就在这里。什么都会骗你，量能不会。"}}},reply_to_results:$R[642]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDA3ODEyNzU5Mzg4Nzk=",rest_id:"1844840781275938879"},reply_to_user_results:$R[643]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[644]={__typename:"User",core:$R[645]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844841707705454628",url_entities:$R[646]=[],views:$R[647]={count:"1133"}}}}}},$R[648]={entry_id:"conversationthread-1844836496811131255-tweet-1844842171167621364",item:$R[649]={__typename:"TimelineTimelineItem",client_event_info:$R[650]={component:"tweet",details:$R[651]={conversation_details:$R[652]={conversation_section:"HighQuality"},timelines_details:$R[653]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[654]={__isTimelineTimeli