:$R[151]={badge:$R[152]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[153]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[154]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[155]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[156]={tweets:3544},verification:$R[157]={is_blue_verified:!0}}}},counts:$R[158]={bookmark_count:2,favorite_count:2,quote_count:0,reply_count:1,retweet_count:2},details:$R[159]={cashtag_entities:$R[160]=[],created_at_ms:1728678270000,display_text_range:$R[161]=[0,141],full_text:"1。一：从九月中至今日的实盘交易复盘，建议配合我的推特时间线和SPACE看。首先是9月13日那波上涨，当时预估的是一定过不去60500。这个没啥技术含量。就是个看点位和支撑位准不准的活儿，属于基本功。整体的判断依据是自六月8日下跌至九月中，高点下移，低点下移，处于一个中期下跌趋势。 https://t.co/NPloPSx0EW",hashtag_entities:$R[162]=[],smarttags:$R[163]=[],timestamp_entities:$R[164]=[]},edit_control:$R[165]={__typename:"EditControlInitial",edit_tweet_ids:$R[166]=["1844836496811131255"]},grok_translated_post_with_availability:$R[167]={is_available:!1},id:"VHdlZXQ6MTg0NDgzNjQ5NjgxMTEzMTI1NQ==",legacy:$R[168]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[169]=[$R[170]={allow_download_status:$R[171]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844836496811131255/photo/1",ext_media_availability:$R[172]={status:"Available"},ext_playlists:$R[173]=[],features:$R[174]={},id_str:"1844836483775262721",indices:$R[175]=[142,165],media_url_https:"https://pbs.twimg.com/media/GZotAfQa8AE2t01.jpg",original_info:$R[176]={height:1146,width:2007},type:"photo"}],mention_entities:$R[177]=[],note_tweet:$R[178]={is_expandable:!0,note_tweet_results:$R[179]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODM2NDk2NzM1NjA4ODMy",result:$R[180]={__typename:"NoteTweet",entity_set:$R[181]={hashtags:$R[182]=[],symbols:$R[183]=[],urls:$R[184]=[],user_mentions:$R[185]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4MzY0OTY3MzU2MDg4MzI=",rest_id:"1844836496735608832",text:"1。一：从九月中至今日的实盘交易复盘，建议配合我的推特时间线和SPACE看。首先是9月13日那波上涨，当时预估的是一定过不去60500。这个没啥技术含量。就是个看点位和支撑位准不准的活儿，属于基本功。整体的判断依据是自六月8日下跌至九月中，高点下移，低点下移，处于一个中期下跌趋势。\n这里存在的问题是九月7日的低点并没有超过前低。存在趋势破坏的可能。所以16日下跌后，绝不可以再回到60500的位置，不然就极大概率下跌趋势破坏。\n结果17日反弹高度不正常，并且出现了和昨天早上一样的上涨方式，一个非常狭长的小碎步上升通道上涨，尽头放量突破。这样的上涨方式能如同推土机一样不给人上车的机会，并迅速打掉关键位置的空单。请记住这个方式。我们会在做市商的理论里再次讲到。"}}},reply_to_results:$R[186]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4MzU3MDM2MzA0OTE4NDI=",rest_id:"1844835703630491842"},reply_to_user_results:$R[187]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[188]={__typename:"User",core:$R[189]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844836496811131255",url_entities:$R[190]=[],views:$R[191]={count:"2168"}}}}}},$R[192]={entry_id:"conversationthread-1844836496811131255-tweet-1844837035338776824",item:$R[193]={__typename:"TimelineTimelineItem",client_event_info:$R[194]={component:"tweet",details:$R[195]={conversation_details:$R[196]={conversation_section:"HighQuality"},timelines_details:$R[197]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[198]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[199]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4MzcwMzUzMzg3NzY4MjQ=",rest_id:"1844837035338776824",result:$R[200]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[201]=[],core:$R[202]={user_results:$R[203]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[204]={__typename:"User",avatar:$R[205]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[206]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[207]={label:$R[208]={badge:$R[209]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[210]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[211]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[212]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[213]={tweets:3544},verification:$R[214]={is_blue_verified:!0}}}},counts:$R[215]={bookmark_count:1,favorite_count:4,quote_count:0,reply_count:1,retweet_count:2},details:$R[216]={cashtag_entities:$R[217]=[],created_at_ms:1728678399000,display_text_range:$R[218]=[0,44],full_text:"2。市场和你的预测相反，第一情况是去做错就立正挨打，然后赶快思考发生了什么，要怎么应对。 https://t.co/zVCcuonWWw",hashtag_entities:$R[219]=[],smarttags:$R[220]=[],timestamp_entities:$R[221]=[]},edit_control:$R[222]={__typename:"EditControlInitial",edit_tweet_ids:$R[223]=["1844837035338776824"]},grok_translated_post_with_availability:$R[224]={is_available:!1},id:"VHdlZXQ6MTg0NDgzNzAzNTMzODc3NjgyNA==",legacy:$R[225]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[226]=[$R[227]={allow_download_status:$R[228]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844837035338776824/photo/1",ext_media_availability:$R[229]={status:"Available"},ext_playlists:$R[230]=[],features:$R[231]={},id_str:"1844837025045938176",indices:$R[232]=[45,68],media_url_https:"https://pbs.twimg.com/media/GZotf_paAAAU9_9.png",original_info:$R[233]={height:460,width:892},type:"photo"}],mention_entities:$R[234]=[],note_tweet:$R[235]={is_expandable:!0,note_tweet_results:$R[236]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODM3MDM1MjYzMzc3NDA4",result:$R[237]={__typename:"NoteTweet",entity_set:$R[238]={hashtags:$R[239]=[],symbols:$R[240]=[],urls:$R[241]=[],user_mentions:$R[242]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4MzcwMzUyNjMzNzc0MDg=",rest_id:"1844837035263377408",text:"2。市场和你的预测相反，第一情况是去做错就立正挨打，然后赶快思考发生了什么，要怎么应对。\n19日晚间的SPACE已经预言了63500有80%的概率是挡不住的，还要再往上走，让大家买山寨币，会有山寨普涨的行情。当时特意强调了，不要怕某些币已经拉了20%，要果断追进去。你那天如果买了我提到的SUI，将会吃到50%收益。\n 一个合格的交易员，能分析出每一段行情，山寨币都是什么状态。这需要的是常年做交易和伴随行业热点，积累整个币圈的经验。这也是我为什么说，不要轻易把钱给非行业原生交易员的原因之一。其他圈子来币圈的交易员，缺乏对行业的理解和尊重，做的好的万中无一，往往会因为过去圈子的经验主义，亏一笔大的学费，然后骂骂咧咧的离场。"}}},reply_to_results:$R[243]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4MzY0OTY4MTExMzEyNTU=",rest_id:"1844836496811131255"},reply_to_user_results:$R[244]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[245]={__typename:"User",core:$R[246]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844837035338776824",url_entities:$R[247]=[],views:$R[248]={count:"1600"}}}}}},$R[249]={entry_id:"conversationthread-1844836496811131255-tweet-1844837760760455295",item:$R[250]={__typename:"TimelineTimelineItem",client_event_info:$R[251]={component:"tweet",details:$R[252]={conversation_details:$R[253]={conversation_section:"HighQuality"},timelines_details:$R[254]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[255]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[256]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4Mzc3NjA3NjA0NTUyOTU=",rest_id:"1844837760760455295",result:$R[257]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[258]=[],core:$R[259]={user_results:$R[260]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[261]={__typename:"User",avatar:$R[262]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[263]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[264]={label:$R[265]={badge:$R[266]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[267]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R