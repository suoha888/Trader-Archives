eet:$R[805]={is_expandable:!0,note_tweet_results:$R[806]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQzNTY0MzkzODA3ODcy",result:$R[807]={__typename:"NoteTweet",entity_set:$R[808]={hashtags:$R[809]=[],symbols:$R[810]=[],urls:$R[811]=[],user_mentions:$R[812]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDM1NjQzOTM4MDc4NzI=",rest_id:"1844843564393807872",text:"12.   我和好多交易员聊过，也教了不少想学交易的人。\n和交易员聊天真的是很有意思的事情。聊的多了我现在能很快的给交易员归类，甚至知道他们以后的发展路径。\n真正做的好的交易员寥寥无几。但每一个好的交易员，都有其独当一面的地方，这是由他的人生经历和性格共同决定的。我喜欢和交易员聊天喝酒。他们虽然各不一样，但都有一些共性，比如逻辑思维强，自信甚至自负，对金钱的渴望强，自我反思能力强等等等等。"}}},reply_to_results:$R[813]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDI5MjkyOTIzMDA3NDM=",rest_id:"1844842929292300743"},reply_to_user_results:$R[814]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[815]={__typename:"User",core:$R[816]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844843564469223625",url_entities:$R[817]=[],views:$R[818]={count:"1194"}}}}}},$R[819]={entry_id:"conversationthread-1844836496811131255-tweet-1844844171917688987",item:$R[820]={__typename:"TimelineTimelineItem",client_event_info:$R[821]={component:"tweet",details:$R[822]={conversation_details:$R[823]={conversation_section:"HighQuality"},timelines_details:$R[824]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[825]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[826]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDQxNzE5MTc2ODg5ODc=",rest_id:"1844844171917688987",result:$R[827]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[828]=[],core:$R[829]={user_results:$R[830]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[831]={__typename:"User",avatar:$R[832]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[833]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[834]={label:$R[835]={badge:$R[836]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[837]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[838]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[839]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[840]={tweets:3544},verification:$R[841]={is_blue_verified:!0}}}},counts:$R[842]={bookmark_count:1,favorite_count:3,quote_count:0,reply_count:1,retweet_count:0},details:$R[843]={cashtag_entities:$R[844]=[],created_at_ms:1728680100000,display_text_range:$R[845]=[0,114],full_text:"13. 但当我教学生的时候，并不是按照这些共性去筛选人的。\n我会乐意教三方面的人：以大学生为代表的年轻人，行业深度从业者，别的行业发展受限想来币圈赚钱改善家境的人。\n分别对应了：前途无限的未来，助力行业发展，救人于苦难这三方面。 https://t.co/FMGBus0Jwt",hashtag_entities:$R[846]=[],smarttags:$R[847]=[],timestamp_entities:$R[848]=[]},edit_control:$R[849]={__typename:"EditControlInitial",edit_tweet_ids:$R[850]=["1844844171917688987"]},grok_translated_post_with_availability:$R[851]={is_available:!1},id:"VHdlZXQ6MTg0NDg0NDE3MTkxNzY4ODk4Nw==",legacy:$R[852]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[853]=[$R[854]={allow_download_status:$R[855]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844844171917688987/photo/1",ext_media_availability:$R[856]={status:"Available"},ext_playlists:$R[857]=[],features:$R[858]={},id_str:"1844844163147448320",indices:$R[859]=[115,138],media_url_https:"https://pbs.twimg.com/media/GZoz_fJbQAAf9_x.jpg",original_info:$R[860]={height:1080,width:1088},type:"photo"}],mention_entities:$R[861]=[],note_tweet:$R[862]={is_expandable:!0,note_tweet_results:$R[863]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQ0MTcxODMzNzkwNDY0",result:$R[864]={__typename:"NoteTweet",entity_set:$R[865]={hashtags:$R[866]=[],symbols:$R[867]=[],urls:$R[868]=[],user_mentions:$R[869]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDQxNzE4MzM3OTA0NjQ=",rest_id:"1844844171833790464",text:"13. 但当我教学生的时候，并不是按照这些共性去筛选人的。\n我会乐意教三方面的人：以大学生为代表的年轻人，行业深度从业者，别的行业发展受限想来币圈赚钱改善家境的人。\n分别对应了：前途无限的未来，助力行业发展，救人于苦难这三方面。\n交易是一个非常难学的东西，不仅是因为他对人的要求极高，而且路上有太多错误等着你去跳去试错去交“学费”，有太多想学交易的人连真正的交易员是什么样的都没看见就死在错误的路上。\n以前我是不喜欢他们叫我老师的，是我的好朋友郑皓升在群里一直这么开玩笑叫我，群友就跟着叫我。我当时觉得我一个做交易的又不靠卖课吃饭，一直老师老师的叫，把我一个好好的交易员叫歪了。\n但现在我也愿意接受这个称呼，因为我接受我自己干的事情，本质上和我的老师们，我的前辈们干的是一样的。"}}},reply_to_results:$R[870]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDM1NjQ0NjkyMjM2MjU=",rest_id:"1844843564469223625"},reply_to_user_results:$R[871]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[872]={__typename:"User",core:$R[873]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844844171917688987",url_entities:$R[874]=[],views:$R[875]={count:"1374"}}}}}},$R[876]={entry_id:"conversationthread-1844836496811131255-tweet-1844844561992171824",item:$R[877]={__typename:"TimelineTimelineItem",client_event_info:$R[878]={component:"tweet",details:$R[879]={conversation_details:$R[880]={conversation_section:"HighQuality"},timelines_details:$R[881]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[882]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[883]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDQ1NjE5OTIxNzE4MjQ=",rest_id:"1844844561992171824",result:$R[884]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[885]=[],core:$R[886]={user_results:$R[887]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[888]={__typename:"User",avatar:$R[889]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[890]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[891]={label:$R[892]={badge:$R[893]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[894]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[895]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[896]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[897]={tweets:3544},verification:$R[898]={is_blue_verified:!0}}}},counts:$R[899]={bookmark_count:1,favorite_count:0,quote_count:0,reply_count:1,retweet_count:0},details:$R[900]={cashtag_entities:$R[901]=[],created_at_ms:1728680193000,display_text_range:$R[902]=[0,142],full_text:"14. 我运气很好，一进圈就认识了很多大佬，偷师了不少东西，少走了很多弯路。\n我常常喝酒的时候和朋友们说：我的孩子小学三年级就必须给我滚过去背K线，初中就给我做交易，大学毕业正好神功大成。我给他存一笔钱，预防他成年之后年少轻狂，在交易里犯经验主义错误，让他能东山再起，别的我就不管了。 https://t.co/MQxCjXfZtd",hashtag_entities:$R[903]=[],smarttags:$R[904]=[],timestamp_entities:$R[905]=[]},edit_control:$R[906]={__typename:"EditControlInitial",edit_tweet_ids:$R[907]=["1844844561992171824"]},grok_translated_post_with_availability:$R[908]={is_available:!1},id:"VHdlZXQ6MTg0NDg0NDU2MTk5MjE3MTgyNA==",legacy:$R[909]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[910]=[$R[911]={allow_download_status:$R[912]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844844561992171824/photo/1",ext_media_availability:$R[913]={status:"Available"},ext_playlists:$R[914]=[],features:$R[915]={},id_str:"1844844552668258304",indices:$R[916]=[143,166],media_url_https:"https://pbs.twimg.com/media/GZo0WKObIAAWyEt.jpg",original_info:$R[917]={height:2048,width:2048},type:"photo"}],mention_entities:$R[918]=[],note_tweet:$R[919]={is_expandable:!0,note_tweet_results:$R[920]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQ0NTYxOTA0MDgyOTQ0",result:$R[921]={__typename:"NoteTweet",entity_set:$R[922]={hashtags:$R[923]=[],symbols:$R[924]=[],urls:$R[925]=[],user_mentions:$R[926]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDQ1NjE5MDQwODI5NDQ=",rest_id:"1844844561904082944",text:"14. 我运气很好，一进圈就认识了很多大佬，偷师了不少东西，少走了很多弯路。\n我常常喝酒的时候和朋友们说：我的孩子小学三年级就必须给我滚过去背K线，初中就给我做交易，大学毕业正好神功大成。我给他存一笔钱，预防他成年之后年少轻狂，在交易里犯经验主义错误，让他能东山再起，别的我就不管了。\n楼老板知道后笑着纠正了我：你现在是这么说的，但到时候你就会发现，你的孩子并不一定能成为交易员，还是随他们自由发展吧。 我听楼老板的。\n扯远了，回到正题。"}}},reply_to_results:$R[927]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDQxNzE5MTc2ODg5ODc=",rest_id:"1844844171917688987"},reply_to_user_results:$R[928]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[929]={__typename:"User",core:$R[930]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844844561992171824",url_entities:$R[931]=[],views:$R[932]={count:"1307"}}}}}},$R[933]={entry_id:"conversationthread-1844836496811131255-tweet-1844845456247107754",item:$R[934]={__typename:"TimelineTimelineItem",client_event_info:$R[935]={component:"tweet",details:$R[936]={conversation_details:$R[937]={conversation_section:"HighQuality"},timelines_details:$R[938]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[939]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[940]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDU0NTYyNDcxMDc3NTQ=",rest_id:"1844845456247107754",result:$R[941]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[942]=[],core:$R[943]={user_results:$R[944]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[945]={__typename:"User",avatar:$R[946]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[947]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[948]={label:$R[949]={badge:$R[950]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[951]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[952]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[953]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[954]={tweets:3544},verification:$R[955]={is_blue_verified:!0}}}},counts:$R[956]={bookmark_count:2,favorite_count:5,quote_count:0,reply_count:1,retweet_count:0},details:$R[957]={cashtag_entities:$R[958]=[],created_at_ms:1728680406000,display_text_range:$R[959]=[0,36],full_text:"15.整个全球金融市场由三块理解构成，分别是交易方法，流动性，周期理解。 https://t.co/5DWOIW3jvk",hashtag_entities:$R[960]=[],smarttags:$R[961]=[],timestamp_entities:$R[962]=[]},edit_control:$R[963]={__typename:"EditControlInitial",edit_tweet_ids:$R[964]=["1844845456247107754"]},grok_translated_post_with_availability:$R[965]={is_available:!1},id:"VHdlZXQ6MTg0NDg0NTQ1NjI0NzEwNzc1NA==",legacy:$R[966]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[967]=[$R[968]={allow_download_status:$R[969]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844845456247107754/photo/1",ext_media_availability:$R[970]={status:"Available"},ext_playlists:$R[971]=[],features:$R[972]={},id_str:"1844845246401875968",indices:$R[973]=[37,60],media_url_https:"https://pbs.twimg.com/media/GZo0-ilaEAAWo9a.jpg",original_info:$R[974]={height:1920,width:1280},type:"photo"}],mention_entities:$R[975]=[],note_tweet:$R[976]={is_expandable:!0,note_tweet_results:$R[977]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQ1NDU2MTU5MDk2ODMy",result:$R[978]={__typename:"NoteTweet",entity_set:$R[979]={hashtags:$R[980]=[],symbols:$R[981]=[],urls:$R[982]=[],user_mentions:$R[983]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDU0NTYxNTkwOTY4MzI=",rest_id:"1844845456159096832",text:"15.整个全球金融市场由三块理解构成，分别是交易方法，流动性，周期理解。\n交易方法对应的是最常见的交易者，他们有的用形态学，有的用多因子模型，有的用缠论，有的用海龟，各种交易方法，就好像修仙里的各种门派，都由一代交易天才创立并发扬光大，只要交易者努力锻炼，走在正确的路子上，就可以最终赚钱证道，只是成就大小不同罢了。随着时代发展会诞生越来越多的门派。\n\n流动性对应的是庄家，他们的资本达到了一定体量，有的在大市场里搏杀，有的自立项目操弄市场，最终都是加深对流动性三个字的理解，如何合理的运用手里的筹码和资本去设计项目，进一步组局和调动各方力量，撬动杠杆，吸引散户和更多人入局，最终收割证道。\n\n周期对应的是宏观经济，洞察世界的趋势，对政治有很深刻的理解，能看懂庄家组的局子，也能知晓散户为哪些因素所驱使，研究和理解各种博弈，最终随潮流证道。"}}},reply_to_results:$R[984]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDQ1NjE5OTIxNzE4MjQ=",rest_id:"1844844561992171824"},reply_to_user_results:$R[985]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[986]={__typename:"User",core:$R[987]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844845456247107754",url_entities:$R[988]=[],views:$R[989]={count:"1379"}}}}}},$R[990]={entry_id:"conversationthread-1844836496811131255-tweet-1844845858074112256",item:$R[991]={__typename:"TimelineTimelineItem",client_event_info:$R[992]={component:"tweet",details:$R[993]={conversation_details:$R[994]={conversation_section:"HighQuality"},timelines_details:$R[995]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[996]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[997]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDU4NTgwNzQxMTIyNTY=",rest_id:"1844845858074112256",result:$R[998]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[999]=[],core:$R[1000]={user_results:$R[1001]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[1002]={__typename:"User",avatar:$R[1003]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[1004]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[1005]={label:$R[1006]={badge:$R[1007]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[1008]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[1009]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[1010]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[1011]={tweets:3544},verification:$R[1012]={is_blue_verified:!0}}}},counts:$R[1013]={bookmark_count:3,favorite_count:6,quote_count:0,reply_count:2,retweet_count:0},details:$R[1014]={cashtag_entities:$R[1015]=[],created_at_ms:1728680502000,display_text_range:$R[1016]=[0,96],full_text:"16.可以理解成诡秘之主里的“序列”方式，有不同的职业进化路径，又可以相互穿插。\n交易是一条序列途径，从序列9“偷盗者”一路到序列0的“错误”真神。本质是用各种交易方式，寻找市场里错付的赔率。 https://t.co/A0mVqwTbAk",hashtag_entities:$R[1017]=[],smarttags:$R[1018]=[],timestamp_entities:$R[1019]=[]},edit_control:$R[1020]={__typename:"EditControlInitial",edit_tweet_ids:$R[1021]=["1844845858074112256"]},grok_translated_post_with_availability:$R[1022]={is_available:!1},id:"VHdlZXQ6MTg0NDg0NTg1ODA3NDExMjI1Ng==",legacy:$R[1023]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[1024]=[$R[1025]={allow_download_status:$R[1026]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844845858074112256/photo/1",ext_media_availability:$R[1027]={status:"Available"},ext_playlists:$R[1028]=[],features:$R[1029]={},id_str:"1844845648312770560",indices:$R[1030]=[97,120],media_url_https:"https://pbs.twimg.com/media/GZo1V70boAA_EQW.jpg",original_info:$R[1031]={height:1386,width:1518},type:"photo"}],mention_entities:$R[1032]=[],note_tweet:$R[1033]={is_expandable:!0,note_tweet_results:$R[1034]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQ1ODU3OTc3NTg5NzYw",result:$R[1035]={__typename:"NoteTweet",entity_set:$R[1036]={hashtags:$R[1037]=[],symbols:$R[1038]=[],urls:$R[1039]=[],user_mentions:$R[1040]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDU4NTc5Nzc1ODk3NjA=",rest_id:"1844845857977589760",text:"16.可以理解成诡秘之主里的“序列”方式，有不同的职业进化路径，又可以相互穿插。\n交易是一条序列途径，从序列9“偷盗者”一路到序列0的“错误”真神。本质是用各种交易方式，寻找市场里错付的赔率。\n流动性是一条途径，从序列9“学徒”一路到序列0的“门”真神，要学习各种庄家技巧，周游各种资产，理解流动性的大河，可以撬开任何板块的大门，调动流动性，浩浩汤汤。\n周期是一条途径，从序列9“占卜家”一路到序列0是“愚者”真神，一路上要学习人类的各种行为，资本的各种行为，感受世界的脉络，那种不可违抗的，由一条条小河小溪的流动性汇聚成的庞博巨力，无人可挡，形成周期。大智若愚。"}}},reply_to_results:$R[1041]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDU0NTYyNDcxMDc3NTQ=",rest_id:"1844845456247107754"},reply_to_user_results:$R[1042]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[1043]={__typename:"User",core:$R[1044]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844845858074112256",url_entities:$R[1045]=[],views:$R[1046]={count:"1664"}}}}}},$R[1047]={entry_id:"conversationthread-1844836496811131255-tweet-1844847104952533079",item:$R[1048]={__typename:"TimelineTimelineItem",client_event_info:$R[1049]={component:"tweet",details:$R[1050]={conversation_details:$R[1051]={conversation_section:"HighQuality"},timelines_details:$R[1052]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[1053]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[1054]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDcxMDQ5NTI1MzMwNzk=",rest_id:"1844847104952533079",result:$R[1055]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[1056]=[],core:$R[1057]={user_results:$R[1058]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[1059]={__typename:"User",avatar:$R[1060]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[1061]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[1062]={label:$R[1063]={badge:$R[1064]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[1065]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[1066]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[1067]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,tweet_counts:$R[1068]={tweets:3544},verification:$R[1069]={is_blue_verified:!0}}}},counts:$R[1070]={bookmark_count:2,favorite_count:10,quote_count:0,reply_count:2,retweet_count:2},details:$R[1071]={cashtag_entities:$R[1072]=[],created_at_ms:1728680800000,display_text_range:$R[1073]=[0,123],full_text:"17.  任何真正的金融从业者，都走在这三条道路上，而决定了他们成就大小的，其实是一个人的执行力，想象力和阅历。\n分别对应了，对自己的了解和掌控，对时间空间和筹码组合成的K线的理解，对组成市场的最小单位——“人”本身的理解以及整个市场构成的理解。 https://t.co/zx8fQ3M9xh",hashtag_entities:$R[1074]=[],smarttags:$R[1075]=[],timestamp_entities:$R[1076]=[]},edit_control:$R[1077]={__typename:"EditControlInitial",edit_tweet_ids:$R[1078]=["1844847104952533079"]},grok_translated_post_with_availability:$R[1079]={is_available:!1},id:"VHdlZXQ6MTg0NDg0NzEwNDk1MjUzMzA3OQ==",legacy:$R[1080]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[1081]=[$R[1082]={allow_download_status:$R[1083]={allow_download:!0},expanded_url:"https://x.com/ZTZZBTC/status/1844847104952533079/photo/1",ext_media_availability:$R[1084]={status:"Available"},ext_playlists:$R[1085]=[],features:$R[1086]={},id_str:"1844846938728157184",indices:$R[1087]=[124,147],media_url_https:"https://pbs.twimg.com/media/GZo2hC_b0AA6KWy.jpg",original_info:$R[1088]={height:954,width:1606},type:"photo"}],mention_entities:$R[1089]=[],note_tweet:$R[1090]={is_expandable:!0,note_tweet_results:$R[1091]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQ3MTA0ODY4NjY3Mzky",result:$R[1092]={__typename:"NoteTweet",entity_set:$R[1093]={hashtags:$R[1094]=[],symbols:$R[1095]=[],urls:$R[1096]=[],user_mentions:$R[1097]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDcxMDQ4Njg2NjczOTI=",rest_id:"1844847104868667392",text:"17.  任何真正的金融从业者，都走在这三条道路上，而决定了他们成就大小的，其实是一个人的执行力，想象力和阅历。\n分别对应了，对自己的了解和掌控，对时间空间和筹码组合成的K线的理解，对组成市场的最小单位——“人”本身的理解以及整个市场构成的理解。\n\n这绝不是村口大爷大妈对宏观的吹牛逼，对神奇指标的吹捧，对庄家的神话，对K线的无尽分析。\n更像是一条河流，每个人都是这条大河的一滴水，这条大河有很多支流汇聚而成，有缓速的地带，也有只是转了一个弯就开始迅速加速，最终波涛汹涌的地段。这就是交易者，流动性，周期。\n不论你是哪一个序列的人，一生都是在增加自己的认知和可调用的力量，最终形成一个你对这条大河的全部感悟。\n 一即全，全即一。\n你是大河的一份子，你能感受到大河的流动，你能用自己的力量撬动大河的一部分，甚至是在某一瞬间，市场这条大河被你这滴水滴，改变了走向。"}}},reply_to_results:$R[1098]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDU4NTgwNzQxMTIyNTY=",rest_id:"1844845858074112256"},reply_to_user_results:$R[1099]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[1100]={__typename:"User",core:$R[1101]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844847104952533079",url_entities:$R[1102]=[],views:$R[1103]={count:"3530"}}}}}},$R[1104]={entry_id:"conversationthread-1844836496811131255-tweet-1844848002386784741",item:$R[1105]={__typename:"TimelineTimelineItem",client_event_info:$R[1106]={component:"tweet",details:$R[1107]={conversation_details:$R[1108]={conversation_section:"HighQuality"},timelines_details:$R[1109]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[1110]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[1111]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDgwMDIzODY3ODQ3NDE=",rest_id:"1844848002386784741",result:$R[1112]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[1113]=[],core:$R[1114]={user_results:$R[1115]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",result:$R[1116]={__typename:"User",avatar:$R[1117]={image_url:"https://pbs.twimg.com/profile_images/1491357677292711936/6UEZ2Qpv_normal.jpg"},core:$R[1118]={name:"ZTZZ ฿",screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",identity_profile_labels_highlighted_label:$R[1119]={label:$R[1120]={badge:$R[1121]={url:"https://pbs.twimg.com/profile_images/2055004533370310656/DUar6DMy_bigger.jpg"},description:"HertzFlow | Mainnet Arc🎲",url:$R[1122]={url:"https://twitter.com/Hertzflow_xyz"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[1123]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[1124]={followers:23910,following:1247},rest_id:"867227639416840192",super_follow_eligible:!1,t