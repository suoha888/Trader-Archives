/ZTZZBTC/status/1844842171167621364/photo/1",ext_media_availability:$R[685]={status:"Available"},ext_playlists:$R[686]=[],features:$R[687]={},id_str:"1844842160920944640",indices:$R[688]=[145,168],media_url_https:"https://pbs.twimg.com/media/GZoyK8RbYAALLXD.jpg",original_info:$R[689]={height:360,width:360},type:"photo"}],mention_entities:$R[690]=[],note_tweet:$R[691]={is_expandable:!0,note_tweet_results:$R[692]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODQ0ODQyMTcxMDg3OTA0NzY4",result:$R[693]={__typename:"NoteTweet",entity_set:$R[694]={hashtags:$R[695]=[],symbols:$R[696]=[],urls:$R[697]=[],user_mentions:$R[698]=[]},id:"Tm90ZVR3ZWV0OjE4NDQ4NDIxNzEwODc5MDQ3Njg=",rest_id:"1844842171087904768",text:"10.最后，我写这篇文章的时间是12日凌晨4点，大盘短期超涨，我做了一个小仓位的空单，吃一个回踩可能就会减仓。这个位置暂时不能很好的预测下面的走势情况。我写文章前仔细复盘了一些想法，具体的猜测会在3和4里写出来。写的时候估计也已经回踩完毕了，这不是事后诸葛亮，我会细化到庄家可能的做市手法。\n这么长3000字，是这一个月的关键节点的操作，请结合BTC的K线，以及我的SPACE和推文复盘。\n 我相信整个推特，也不会有第二个人给你说这些细节的思路和操作的复盘的。当然，我以后也尽量少说。写这个能看出名堂，并且反哺于自身的交易者，实在太少了。"}}},reply_to_results:$R[699]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDE3MDc3MDU0NTQ2Mjg=",rest_id:"1844841707705454628"},reply_to_user_results:$R[700]={id:"VXNlclJlc3VsdHM6ODY3MjI3NjM5NDE2ODQwMTky",rest_id:"867227639416840192",result:$R[701]={__typename:"User",core:$R[702]={screen_name:"ZTZZBTC"},id:"VXNlcjo4NjcyMjc2Mzk0MTY4NDAxOTI=",rest_id:"867227639416840192"}},rest_id:"1844842171167621364",url_entities:$R[703]=[],views:$R[704]={count:"1397"}}}}}},$R[705]={entry_id:"conversationthread-1844836496811131255-tweet-1844842929292300743",item:$R[706]={__typename:"TimelineTimelineItem",client_event_info:$R[707]={component:"tweet",details:$R[708]={conversation_details:$R[709]={conversation_section:"HighQuality"},timelines_details:$R[710]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDbiz0wAAAAAA=="}},element:"tweet"},content:$R[711]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[712]={id:"VHdlZXRSZXN1bHRzOjE4NDQ4NDI5Mj