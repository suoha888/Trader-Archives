ank"},id:"VXNlcjoxMzgxMDk4NDMxNTMyMzcxOTY5",identity_profile_labels_highlighted_label:$R[413]={},privacy:$R[414]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[415]={followers:306,following:994},rest_id:"1381098431532371969",super_follow_eligible:!1,tweet_counts:$R[416]={tweets:1900},verification:$R[417]={is_blue_verified:!1}}}},counts:$R[418]={bookmark_count:0,favorite_count:9,quote_count:0,reply_count:0,retweet_count:0},details:$R[419]={cashtag_entities:$R[420]=[],created_at_ms:1765255693000,display_text_range:$R[421]=[8,41],full_text:"@KuiGas 天天喊build的赵四去哪呢？respect老徐@star_okx",hashtag_entities:$R[422]=[],smarttags:$R[423]=[],timestamp_entities:$R[424]=[]},edit_control:$R[425]={__typename:"EditControlInitial",edit_tweet_ids:$R[426]=["1998253327130468373"]},grok_translated_post_with_availability:$R[427]={is_available:!1},id:"VHdlZXQ6MTk5ODI1MzMyNzEzMDQ2ODM3Mw==",legacy:$R[428]={lang:"zh"},media_entities2:$R[429]=[],mention_entities:$R[430]=[$R[431]={id_str:"1372876871990272000",indices:$R[432]=[0,7],screen_name:"KuiGas"},$R[433]={id_str:"2985599460",indices:$R[434]=[32,41],screen_name:"star_okx"}],reply_to_results:$R[435]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5OTgyMTM5NzIzMTU3NTkxMDk=",rest_id:"1998213972315759109"},reply_to_user_results:$R[436]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[437]={__typename:"User",core:$R[438]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1998253327130468373",url_entities:$R[439]=[],views:$R[440]={count:"1188"}}}}}}],metadata:$R[441]={conversation_metadata:$R[442]={all_tweet_ids:$R[443]=["1998253327130468373"],enable_deduplication:!0}}},entry_id:"conversationthread-1998253327130468373",sort_index:"2103760877227343842"}]},$R[444]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[445]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[446]={id:"VHdlZXRSZXN1bHRzOjE5OTgyMTM5NzIzMTU3NTkxMDk=",rest_id:"1998213972315759109",result:$R[447]={__typename:"Tweet",core:$R[448]={user_results:$R[449]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[450]={__typename:"User",avatar:$R[451]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[452]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[453]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[454]={favorite_count:565,reply_count:177},details:$R[455]={full_text:"如果一定要用一些词来评价这个事\n我只能说：卧槽    牛逼\n\n市值 2 万亿美金的BTC，Bitcoin Core 核心开发者只有 41 人，真正有权将代码合并进主网的维护者只有 5 位，过去 10 年，也只有 13 个人站上过这个位置。\n\n传统科技公司动辄上万名开发者 + https://t.co/B3TMYDkOPK",smarttags:$R[456]=[]},id:"VHdlZXQ6MTk5ODIxMzk3MjMxNTc1OTEwOQ==",note_tweet:$R[457]={note_tweet_results:$R[458]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk4MjEzOTcyMTQ4MDY4MzUy",result:$R[459]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5OTgyMTM5NzIxNDgwNjgzNTI=",text:"如果一定要用一些词来评价这个事\n我只能说：卧槽    牛逼\n\n市值 2 万亿美金的BTC，Bitcoin Core 核心开发者只有 41 人，真正有权将代码合并进主网的维护者只有 5 位，过去 10 年，也只有 13 个人站上过这个位置。\n\n传统科技公司动辄上万名开发者 + 每年几十亿美金研发成本，而比特币的年度协议层预算，只有几百万美金级别。\n\n没有基金会、没有统一金库，谁在养活 Bitcoin Core？\n没错，靠资助，比特币靠的是一堆松散的组织、个人和企业捐赠，每一分钱都花在刀刃上。\n\n文章盘点了 13 个主要资助组织，\n令人意外的是，唯一来自交易所体系、并且持续多年提供资助的，只有OKX，真的，没看错，只有OKX @okx\n\n从 OKCoin 时代开始，OKX 就持续资助比特币核心开发，在大多数交易所只关心上币、交易量、手续费的时候，OKX 是少数真正为比特币的“底层安全”和“长期可持续性”掏真金白银的机构。\n\n真正为协议层长期安全买单的机构，屈指可数。\n\n并且之前我从未在任何地方看到OKX宣传过。\n\n为OKX点赞，为老徐点赞 @okx @star_okx \n\n@Haiteng_okx \n\nhttps://t.co/6PZXtEgO29"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1998213972315759109:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-vi