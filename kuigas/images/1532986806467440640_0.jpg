6552",super_follow_eligible:!1,tweet_counts:$R[687]={tweets:55},verification:$R[688]={is_blue_verified:!1}}}},counts:$R[689]={bookmark_count:0,favorite_count:0,quote_count:0,reply_count:3,retweet_count:0},details:$R[690]={cashtag_entities:$R[691]=[],created_at_ms:1654396874000,display_text_range:$R[692]=[15,241],full_text:"@duokongcrypto 我操作时一直提示：Only addresses affiliated with an open letter signature are eligible at this time.\n\nWider access will be rolled out soon. In the\nmeantime, take a walk through the garden and see what's been built on Lens.\n\n新人不知道怎么弄，谢谢",hashtag_entities:$R[693]=[],smarttags:$R[694]=[],timestamp_entities:$R[695]=[]},edit_control:$R[696]={__typename:"EditControlInitial",edit_tweet_ids:$R[697]=["1533277740735995904"]},grok_translated_post_with_availability:$R[698]={is_available:!1},id:"VHdlZXQ6MTUzMzI3Nzc0MDczNTk5NTkwNA==",legacy:$R[699]={lang:"en"},media_entities2:$R[700]=[],mention_entities:$R[701]=[$R[702]={id_str:"904032910617006080",indices:$R[703]=[0,14],screen_name:"duokongcrypto"}],reply_to_results:$R[704]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE1MzI5ODY4MDY0Njc0NDA2NDA=",rest_id:"1532986806467440640"},reply_to_user_results:$R[705]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[706]={__typename:"User",core:$R[707]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1533277740735995904",url_entities:$R[708]=[],views:$R[709]={}}}}}}],metadata:$R[710]={conversation_metadata:$R[711]={all_tweet_ids:$R[712]=["1533277740735995904"],enable_deduplication:!0}}},entry_id:"conversationthread-1533277740735995904",sort_index:"2103761169129930682"}]},$R[713]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[714]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[715]={id:"VHdlZXRSZXN1bHRzOjE1MzI5ODY4MDY0Njc0NDA2NDA=",rest_id:"1532986806467440640",result:$R[716]={__typename:"Tweet",core:$R[717]={us