https://video.twimg.com/amplify_video/1977759583230889984/pl/B9Chb-V-K93fQfHa.m3u8?tag=21"},$R[190]={bitrate:256000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/1977759583230889984/vid/avc1/480x270/QIFa5VoVW4UAkfnC.mp4?tag=21"},$R[191]={bitrate:832000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/1977759583230889984/vid/avc1/640x360/3rpve5un79hVBsbK.mp4?tag=21"},$R[192]={bitrate:2176000,content_type:"video/mp4",url:"https://video.twimg.com/amplify_video/1977759583230889984/vid/avc1/1280x720/p9EQHoFDYkYa6eAH.mp4?tag=21"}]}}],mention_entities:$R[193]=[$R[194]={id_str:"1332033418088099843",indices:$R[195]=[11,20],screen_name:"arbitrum"}],note_tweet:$R[196]={is_expandable:!0,note_tweet_results:$R[197]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc3NzY1NjA5MTQ5NzAyMTQ2",result:$R[198]={__typename:"NoteTweet",entity_set:$R[199]={hashtags:$R[200]=[$R[201]={indices:$R[202]=[613,622],text:"Arbitrum"},$R[203]={indices:$R[204]=[623,627],text:"ARB"}],symbols:$R[205]=[],timestamps:$R[206]=[],urls:$R[207]=[$R[208]={display_url:"yaps.kaito.ai/arbitrum",expanded_url:"https://yaps.kaito.ai/arbitrum",indices:$R[209]=[168,191],url:"https://t.co/1hLflSQRLS"},$R[210]={display_url:"arbitrumdrip.com",expanded_url:"https://arbitrumdrip.com/",indices:$R[211]=[325,348],url:"https://t.co/n1oKuzDDkB"}],user_mentions:$R[212]=[$R[213]={id_str:"1332033418088099843",indices:$R[214]=[11,20],screen_name:"arbitrum"}]},id:"Tm90ZVR3ZWV0OjE5Nzc3NjU2MDkxNDk3MDIxNDY=",rest_id:"1977765609149702146",text:"2023年3月16日\n@arbitrum发布的这个1分32秒视频，总能让人感受到一股强大的肾上腺素飙升，简简单单 一问一答，让无数人沸腾\n\nWen? Now. 🧑‍🚀\n\n那一刻点燃了全网情绪，无数人转发、卧槽，那一刻的ARB是L2 历史上的高光时刻。\n\n1、如今，Yapping Arbitrum第 2 季合计70万ARB 的激励来了。https://t.co/1hLflSQRLS\n\n2、如今，Arbitrum 上的 DeFi 复兴激励计划DRIP依然在进行中，2026年1月20日结束，20 周，Arbitrum 凭借先发优势 + DeFi 原生生态，真正建立了长期稳固的流动性，是为数不多发币后TVL依然维持高位并创新高的L2。\nDRIP活动：https://t.co/n1oKuzDDkB\n\n3、在当下的市场环境里，大格局项目越来越稀缺，很多协议一开始就背负了大量的 VC 筹码、交易所资源和市场预期，上所需要流动性和市值支撑，往往意味着团队必须在 TGE 之前留出很大比例的代币做上市市场协调，于是很多项目到了 TGE 最后只能选择牺牲社区筹码，来保证大盘市值和交易所关系，项目短期看似成功，但长期社区黏性不足，失去群众基础，留下一地鸡毛。之后基本上都是核心团队离职，核心员工离职，后续做的所有市场激励活动都基本无人参加············\n\n写那么多干啥，我只想说，\n\nWen来个像ARB一样的大格局项目！\n\n#Arbitrum #ARB"}}},quoted_tweet_results:$R[215]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5NzU1NjIyNDk4Mzk1MTc4Mjk=",rest_id:"1975562249839517829",result:$R[216]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[217]=[],core:$R[218]={user_results:$R[219]={id:"VXNlclJlc3VsdHM6MTMzMjAzMzQxODA4ODA5OTg0Mw==",result:$R[220]={__typename:"User",avatar:$R[221]={image_url:"https://pbs.twimg.com/profile_images/1952411676621295616/KUOmiy3l_normal.jpg"},core:$R[222]={name:"Arbitrum",screen_name:"arbitrum"},id:"VXNlcjoxMzMyMDMzNDE4MDg4MDk5ODQz",identity_profile_labels_highlighted_label:$R[223]={},privacy:$R[224]={protected:!1},profile_image_shape:"Square",relationship_counts:$R[225]={followers:1149351,following:444},rest_id:"1332033418088099843",super_follow_eligible:!1,tweet_counts:$R[226]={tweets:15056},verification:$R[227]={is_blue_verified:!0,verified_type:"Business"}}}},counts:$R[228]={bookmark_count:256,favorite_count:2880,quote_count:520,reply_count:898,retweet_count:407},details:$R[229]={cashtag_entities:$R[230]=[],created_at_ms:1759845719000,display_text_range:$R[231]=[0,117],full_text:"Don't stop yapping.\n\nSeason 2 is here with 700,000 ARB up for grabs through @KaitoAI.\n\nSincerely, The Marketing Dept. https://t.co/KhJDsnSaWG",hashtag_entities:$R[232]=[],smarttags:$R[233]=[],timestamp_entities:$R[234]=[]},edit_control:$R[235]={__typename:"EditControlInitial",edit_tweet_ids:$R[236]=["1975562249839517829"]},grok_translated_post_with_availability:$R[237]={is_available:!1},id:"VHdlZXQ6MTk3NTU2MjI0OTgzOTUxNzgyOQ==",legacy:$R[238]={possibly_sensitive:!1},media_entities2:$R[239]=[$R[240]={additional_media_info:$R[241]={monetizable:!1},expanded_url:"https://x.com/arbitrum/status/1975562249839517829/video/1",ext_media_availability:$R[242]={status:"Available"},ext_playlists:$R[243]=[],id_str:"1975562122