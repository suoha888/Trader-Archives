05]={__typename:"User",core:$R[406]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1977765750623646005",url_entities:$R[407]=[],views:$R[408]={count:"539"}}}}}}],metadata:$R[409]={conversation_metadata:$R[410]={all_tweet_ids:$R[411]=["1977765750623646005"],enable_deduplication:!0}}},entry_id:"conversationthread-1977765750623646005",sort_index:"2103761839501344738"}]},$R[412]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[413]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[414]={id:"VHdlZXRSZXN1bHRzOjE5Nzc3NjU2MDkzNjM2ODk2MzQ=",rest_id:"1977765609363689634",result:$R[415]={__typename:"Tweet",core:$R[416]={user_results:$R[417]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[418]={__typename:"User",avatar:$R[419]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[420]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[421]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[422]={favorite_count:182,reply_count:66},details:$R[423]={full_text:"2023年3月16日\n@arbitrum发布的这个1分32秒视频，总能让人感受到一股强大的肾上腺素飙升，简简单单 一问一答，让无数人沸腾\n\nWen? Now. 🧑‍🚀\n\n那一刻点燃了全网情绪，无数人转发、卧槽，那一刻的ARB是L2 历史上的高光时刻。\n\n1、如今，Yapping Arbitrum第 2 季合计70万ARB https://t.co/juDaKJFE9u",smarttags:$R[424]=[]},id:"VHdlZXQ6MTk3Nzc2NTYwOTM2MzY4OTYzNA==",note_tweet:$R[425]={note_tweet_results:$R[426]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc3NzY1NjA5MTQ5NzAyMTQ2",result:$R[427]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5Nzc3NjU2MDkxNDk3MDIxNDY=",text:"2023年3月16日\n@arbitrum发布的这个1分32秒视频，总能让人感受到一股强大的肾上腺素飙升，简简单单 一问一答，让无数人沸腾\n\nWen? Now. 🧑‍🚀\n\n那一刻点燃了全网情绪，无数人转发、卧槽，那一刻的ARB是L2 历史上的高光时刻。\n\n1、如今，Yapping Arbitrum第 2 季合计70万ARB 的激励来了。https://t.co/1hLflSQRLS\n\n2、如今，Arbitrum 上的 DeFi 复兴激励计划DRIP依然在进行中，2026年1月20日结束，20 周，Arbitrum 凭借先发优势 + DeFi 原生生态，真正建立了长期稳固的流动性，是为数不多发币后TVL依然维持高位并创新高的L2。\nDRIP活动：https://t.co/n1oKuzDDkB\n\n3、在当下的市场环境里，大格局项目越来越稀缺，很多协议一开始就背负了大量的 VC 筹码、交易所资源和市场预期，上所需要流动性和市值支撑，往往意味着团队必须在 TGE 之前留出很大比例的代币做上市市场协调，于是很多项目到了 TGE 最后只能选择牺牲社区筹码，来保证大盘市值和交易所关系，项目短期看似成功，但长期社区黏性不足，失去群众基础，留下一地鸡毛。之后基本上都是核心团队离职，核心员工离职，后续做的所有市场激励活动都基本无人参加············\n\n写那么多干啥，我只想说，\n\nWen来个像ARB一样的大格局项目！\n\n#Arbitrum #ARB"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1977765609363689634:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg 48w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_x96.jpg 96w, https://pbs.twimg.com/profile_images/195151035776