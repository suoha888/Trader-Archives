cover_media_results:$R[220]={id:"QXBpTWVkaWFSZXN1bHRzOgwABQoAARuRB8xDWvAACgACAAAAAATkLs8AAA==",result:$R[221]={__typename:"ApiMedia",id:"QXBpTWVkaWE6DAAFCgABG5EHzENa8AAKAAIAAAAABOQuzwAA",media_info:$R[222]={__typename:"ApiImage",original_img_height:647,original_img_url:"https://pbs.twimg.com/media/G5EHzENa8AAYwLy.jpg",original_img_width:1618}}},id:"QXJ0aWNsZUVudGl0eToxOTg2Mzc1MDY1ODkwNjYwMzYw",preview_text:"目前已知 @SentientAGI 第一轮的估值是12亿美金，从一众投资人手中融资了8500万美金，让我来盘算一下他们的前景：\n \n \n⏰TGE时间：\n▶︎ 最可能时间是2026年Q1（2-3月）。\n \n💰是否还有ICO？\n▶︎",rest_id:"1986375065890660360",title:"Sentient的命运是理想主义在现实面前的悲歌"}}},card:$R[223]={id:"Q2FyZDpodHRwczovL3QuY28vdnZ0QVVoam0yVg=="},cashtag_attachments:$R[224]=[],core:$R[225]={user_results:$R[226]={id:"VXNlclJlc3VsdHM6ODIwNjMwNTU=",result:$R[227]={__typename:"User",avatar:$R[228]={image_url:"https://pbs.twimg.com/profile_images/2082716032888975360/5a5uphO9_normal.jpg"},core:$R[229]={name:"BruceBlue 🌊",screen_name:"BruceBlue"},id:"VXNlcjo4MjA2MzA1NQ==",identity_profile_labels_highlighted_label:$R[230]={},privacy:$R[231]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[232]={followers:10520,following:4965},rest_id:"82063055",super_follow_eligible:!1,tweet_counts:$R[233]={tweets:16650},verification:$R[234]={is_blue_verified:!0}}}},counts:$R[235]={bookmark_count:0,favorite_count:11,quote_count:2,reply_count:4,retweet_count:1},details:$R[236]={cashtag_entities:$R[237]=[],created_at_ms:1762424280000,display_text_range:$R[238]=[0,23],full_text:"https://t.co/vvtAUhjm2V",hashtag_entities:$R[239]=[],smarttags:$R[240]=[],timestamp_entities:$R[241]=[]},edit_control:$R[242]={__typename:"EditControlInitial",edit_tweet_ids:$R[243]=["1986377521697595759"]},grok_translated_post_with_availability:$R[244]={is_available:!1},id:"VHdlZXQ6MTk4NjM3NzUyMTY5NzU5NTc1OQ==",legacy:$R[245]={possibly_sensitive:!1},media_entities2:$R[246]=[],mention_entities:$R[247]=[],rest_id:"1986377521697595759",url_entities:$R[248]=[$R[249]={display_url:"x.com/i/article/19