9 h 113 s 236,129 187,87 C 175,84 98,10 213,9 h 198 s 234,78 64,180 C 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="MJMYqdXJxNTzBwLf9GJBWQ==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410901718,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410901718,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1938990953660064207␀{}",u:1790410902076,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1938990953660064207",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1938990953660064207",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"顺着「问密2」的思路，预测市场的另一位巨头现身：Kalshi \n\nParadigm 领投了@Kalshi 1.85亿美金，红杉 Multicoin 跟投，估值20亿美金。\n\nhttps://t.co/WeGpbLijvl\n\n这与 Polymarket @Polymarket 的格局形成鲜明对比：\n\nhttps://t.co/6vfPqvdOkT\n\nUI 界面几乎一样，但路线完全不同👇\n\n一个是监管合规代表（Kalshi）打穿华尔街，\n另一个去中心化代表（Polymarket）野性开荒 Web3\n但都是围绕「下注现实世界」的核心路线。\n\n这些大哥们什么时候发币？你更看好谁先发？",canonicalPath:"/KuiGas/status/1938990953660064207",canonicalUrl:"https://x.com/KuiGas/status/1938990953660064207",description:"顺着「问密2」的思路，预测市场的另一位巨头现身：Kalshi \n\nParadigm 领投了@Kalshi 1.85亿美金，红杉 Multicoin 跟投，估值20亿美金。\n\nhttps://t.co/WeGpbLijvl\n\n这与 Polymarket @Polymarket 的格局形成鲜明对比：\n\nhttps://t.co/6vfPqvdOkT\n\nUI 界面几乎一样，但路线完全不同👇\n\n一个是监管合规代表（Kalshi）打穿华尔街，\n另一个去中心化代表（Polymarket）野性开荒 Web3\n但都是围绕「下注现实世界」的核心路线。\n\n这些大哥们什么时候发币？你更看好谁先发？",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:854,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/GuiqmBaXoAAAk4G?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/GuiqmBaXoAAAk4G?format=webp&name=small 680w, https://pbs.twimg.com/media/GuiqmBaXoAAAk4G?format=webp&name=medium 1200w, https://pbs.twimg.com/media/GuiqmBaXoAAAk4G?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/GuiqmBaXoAAAk4G?format=webp&name=large",width:2234},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/1938990953660064207",publishedTime:"2025-06-28T16:00:42.000Z",replyCount:37,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/KuiGas/status/1928081135147569420","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"KuiGas",identifier:"1372876871990272000",image:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg",name:"丰密",url:"https://x.com/KuiGas"},datePublished:"2025-05-29T13:28:59.000Z",identifier:"1928081135147569420",url:"https://x.com/KuiGas/status/1928081135147569420",image:$R[17]=[$R[18]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/GsHq-cmaAAAFuIm?format=webp&name=large",description:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还是投研。\n\n比如我最近我看paradigm @paradigm投的所有项目。每一个未发币的协议扒开来细看\n1、打开https://t.co/rwRzvAr02B\n2、选择未发币，运营中。\n3、一个个扫，备注登记，找蛛丝马迹。\n4、不得不说P哥投的很多项目很屌。\n5、撸猫人要做到下面的每一个项目如数家珍，比你女朋友还懂你的那种。",height:1496,name:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还是投研。\n\n比如我最近我看paradigm @paradigm投的所有项目。每一个未发币的协议扒开来细看\n1、打开https://t.co/rwRzvAr02B\n2、选择未发币，运营中。\n3、一个个扫，备注登记，找蛛丝马迹。\n4、不得不说P哥投的很多项目很屌。\n5、撸猫人要做到下面的每一个项目如数家珍，比你女朋友还懂你的那种。 (1)",thumbnailUrl:"https://pbs.twimg.com/media/GsHq-cmaAAAFuIm?format=webp&name=small",uploadDate:"2025-05-29T13:28:59.000Z",url:"https://pbs.twimg.com/media/GsHq-cmaAAAFuIm?format=webp&name=large",width:2222},$R[19]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/GsHrACQaUAcAwSU?format=webp&name=large",description:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还是投研。\n\n比如我最近我看paradigm @paradigm投的所有项目。每一个未发币的协议扒开来细看\n1、打开https://t.co/rwRzvAr02B\n2、选择未发币，运营中。\n3、一个个扫，备注登记，找蛛丝马迹。\n4、不得不说P哥投的很多项目很屌。\n5、撸猫人要做到下面的每一个项目如数家珍，比你女朋友还懂你的那种。",height:1490,name:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还是投研。\n\n比如我最近我看paradigm @paradigm投的所有项目。每一个未发币的协议扒开来细看\n1、打开https://t.co/rwRzvAr02B\n2、选择未发币，运营中。\n3、一个个扫，备注登记，找蛛丝马迹。\n4、不得不说P哥投的很多项目很屌。\n5、撸猫人要做到下面的每一个项目如数家珍，比你女朋友还懂你的那种。 (2)",thumbnailUrl:"https://pbs.twimg.com/media/GsHrACQaUAcAwSU?format=webp&name=small",uploadDate:"2025-05-29T13:28:59.000Z",url:"https://pbs.twimg.com/media/GsHrACQaUAcAwSU?format=webp&name=large",width:2250}],engagement:$R[20]=[$R[21]={action:"LikeAction",name:"Likes",url:"https://x.com/KuiGas/status/1928081135147569420/likes",count:159},$R[22]={action:"ShareAction",name:"Retweets",url:"https://x.com/KuiGas/status/1928081135147569420/retweets",count:39},$R[23]={action:"ReplyAction",name:"Replies",url:null,count:47},$R[24]={action:"ViewAction",name:"Views",count:58029}],text:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还