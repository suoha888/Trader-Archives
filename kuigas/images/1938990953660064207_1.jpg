	};
})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="MJMYqdXJxNTzBwLf9GJBWQ==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="MJMYqdXJxNTzBwLf9GJBWQ==">($R=>$R[154].next($R[156]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1938990953660064207\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="MJMYqdXJxNTzBwLf9GJBWQ==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="MJMYqdXJxNTzBwLf9GJBWQ==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="MJMYqdXJxNTzBwLf9GJBWQ==">($R=>$R[154].next($R[157]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1938990953660064207\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[158]={kind:"Result.Ok",value:$R[159]={data:$R[160]={threaded_conversation_with_injections_v2:$R[161]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[162]=[$R[163]={__typename:"TimelineClearCache"},$R[164]={__typename:"TimelineAddEntries",entries:$R[165]=[$R[166]={content:$R[167]={__typename:"TimelineTimelineItem",client_event_info:$R[168]={component:"tweet",element:"tweet"},content:$R[169]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[170]={id:"VHdlZXRSZXN1bHRzOjE5Mzg5OTA5NTM2NjAwNjQyMDc=",rest_id:"1938990953660064207",result:$R[171]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[172]=[],core:$R[173]={user_results:$R[174]={id:"VXNlclJlc3VsdH