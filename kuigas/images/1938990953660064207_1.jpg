s:$R[206]={},id_str:"1938989868727635968",indices:$R[207]=[194,217],media_url_https:"https://pbs.twimg.com/media/GuitAyyXkAA2o9m.jpg",original_info:$R[208]={height:1374,width:1948},type:"photo"}],mention_entities:$R[209]=[$R[210]={id_str:"1071484733543079936",indices:$R[211]=[45,52],screen_name:"Kalshi"},$R[212]={id_str:"1261335549215989760",indices:$R[213]=[126,137],screen_name:"Polymarket"}],note_tweet:$R[214]={is_expandable:!0,note_tweet_results:$R[215]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTM4OTkwOTUzNTA0ODU4MTEy",result:$R[216]={__typename:"NoteTweet",entity_set:$R[217]={hashtags:$R[218]=[],symbols:$R[219]=[],urls:$R[220]=[$R[221]={display_url:"kalshi.com",expanded_url:"https://kalshi.com/",indices:$R[222]=[87,110],url:"https://t.co/WeGpbLijvl"},$R[223]={display_url:"polymarket.com",expanded_url:"https://polymarket.com/",indices:$R[224]=[150,173],url:"https://t.co/6vfPqvdOkT"}],user_mentions:$R[225]=[$R[226]={id_str:"1071484733543079936",indices:$R[227]=[45,52],screen_name:"Kalshi"},$R[228]={id_str:"1261335549215989760",indices:$R[229]=[126,137],screen_name:"Polymarket"}]},id:"Tm90ZVR3ZWV0OjE5Mzg5OTA5NTM1MDQ4NTgxMTI=",rest_id:"1938990953504858112",text:"顺着「问密2」的思路，预测市场的另一位巨头现身：Kalshi \n\nParadigm 领投了@Kalshi 1.85亿美金，红杉 Multicoin 跟投，估值20亿美金。\n\nhttps://t.co/WeGpbLijvl\n\n这与 Polymarket @Polymarket 的格局形成鲜明对比：\n\nhttps://t.co/6vfPqvdOkT\n\nUI 界面几乎一样，但路线完全不同👇\n\n一个是监管合规代表（Kalshi）打穿华尔街，\n另一个去中心化代表（Polymarket）野性开荒 Web3\n但都是围绕「下注现实世界」的核心路线。\n\n这些大哥们什么时候发币？你更看好谁先发？"}}},quoted_tweet_results:$R[230]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MjgwODExMzUxNDc1Njk0MjA=",rest_id:"1928081135147569420",result:$R[231]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[232]=[],core:$R[233]={user_results:$R[234]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[235]={__typename:"User",avatar:$R[236]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[237]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[238]={},privacy:$R[239]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[240]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[241]={tweets:9451},verification:$R[242]={is_blue_verified:!0}}}},counts:$R[243]={bookmark_count:139,favorite_count:159,quote_count:2,reply_count:47,retweet_count:39},details:$R[244]={cashtag_entities:$R[245]=[],created_at_ms:1748525339000,display_text_range:$R[246]=[0,146],full_text:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还是投研。\n\n比如我最近我看paradigm https://t.co/PPC8dTYdDA",hashtag_entities:$R[247]=[],smarttags:$R[248]=[],timestamp_entities:$R[249]=[]},edit_control:$R[250]={__typename:"EditControlInitial",edit_tweet_ids:$R[251]=["1928081135147569420"]},grok_translated_post_with_availability:$R[252]={is_available:!1},id:"VHdlZXQ6MTkyODA4MTEzNTE0NzU2OTQyMA==",legacy:$R[253]={possibly_sensitive:!1},media_entities2:$R[254]=[$R[255]={allow_download_status:$R[256]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1928081135147569420/photo/1",ext_media_availability:$R[257]={status:"Available"},ext_playlists:$R[258]=[],features:$R[259]={},id_str:"1928080474041352192",indices:$R[260]=[147,170],media_url_https:"https://pbs.twimg.com/media/GsHq-cmaAAAFuIm.jpg",original_info:$R[261]={height:1496,width:2222},type:"photo"},$R[262]={allow_download_status:$R[263]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1928081135147569420/photo/1",ext_media_availability:$R[264]={status:"Available"},ext_playlists:$R[265]=[],features:$R[266]={},id_str:"1928080501329514503",indices:$R[267]=[147,170],media_url_https:"https://pbs.twimg.com/media/GsHrACQaUAcAwSU.jpg",original_info:$R[268]={height:1490,width:2250},type:"photo"}],mention_entities:$R[269]=[],note_tweet:$R[270]={is_expandable:!0,note_tweet_results:$R[271]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTI4MDgxMTM0OTg4MTg1NjAx",result:$R[272]={__typename:"NoteTweet",entity_set:$R[273]={hashtags:$R[274]=[],symbols:$R[275]=[],urls:$R[276]=[$R[277]={display_url:"cn.rootdata.com/Investors/deta…",expanded_url:"https://cn.rootdata.com/Investors/detail/Paradigm?k=MTQ5",indices:$R[278]=[182,205],url:"https://t.co/rwRzvAr02B"}],user_mentions:$R[279]=[$R[280]={id_str:"166765173",indices:$R[281]=[147,156],screen_name:"paradigm"}]},id:"Tm90ZVR3ZWV0OjE5MjgwODExMzQ5ODgxODU2MDE=",rest_id:"1928081134988185601",text:"问密系列-问密2\n\n🎙️当下在重点撸啥，什么项目值得撸？\n\n丰密：\n\n整理帐号+投研\n\n1️⃣整理资金，减帐号：之前撸了太多项目、铺了太多链，链上资金太分散。最近集中精力梳理资产、合并仓位，顺便“减点肥”，用最核心最精品的号继续冲。\n\n2️⃣投研，还是投研。\n\n比如我最近我看paradigm @paradigm投的所有项目。每一个未发币的协议扒开来细看\n1、打开https://t.co/rwRzvAr02B\n2、选择未发币，运营中。\n3、一个个扫，备注登记，找蛛丝马迹。\n4、不得不说P哥投的很多项目很屌。\n5、撸猫人要做到下面的每一个项目如数家珍，比你女朋友还懂你的那种。"}}},rest_id:"1928081135147569420",url_entities:$R[282]=[],views:$R[283]={count:"58029"}}},rest_id:"1938990953660064207",url_entities:$R[284]=[$R[285]={display_url:"kalshi.com",expanded_url:"https://kalshi.com/",indices:$R[286]=[87,110],url:"https://t.co/FkjBaRV5Cc"},$R[287]={display_url:"polymarket.com",expanded_url:"https://polymarket.com/",indices:$R[288]=[150,173],url:"https://t.co/uAxcslGKIl"}],views:$R[289]={count:"55362"}}}}},entry_id:"tweet-1938990953660064207",sort_index:"2103761920350748672"},$R[290]={content:$R[291]={__typename:"TimelineTimelineModule",client_event_info:$R[292]={component:"tweet"},display_type:"VerticalConversation",items:$R[293]=[$R[294]={entry_id:"conversationthread-1939202534301933652-tweet-1939202534301933652",item:$R[295]={__typename:"TimelineTimelineItem",client_event_info:$R[296]={component:"tweet",details:$R[297]={conversation_details:$R[298]={conversation_section:"HighQuality"},timelines_details:$R[299]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczktzAAAAAA=="}},element:"tweet"},content:$R[300]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type