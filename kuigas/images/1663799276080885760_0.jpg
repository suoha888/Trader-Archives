!1},profile_image_shape:"Circle",relationship_counts:$R[369]={followers:3909,following:239},rest_id:"1530108585169911808",super_follow_eligible:!1,tweet_counts:$R[370]={tweets:1107},verification:$R[371]={is_blue_verified:!0}}}},counts:$R[372]={bookmark_count:8,favorite_count:12,quote_count:2,reply_count:1,retweet_count:0},details:$R[373]={cashtag_entities:$R[374]=[],created_at_ms:1685526163000,display_text_range:$R[375]=[8,153],full_text:"@KuiGas 补充一些如何报案的细节：\n\n1）绝大部分丢币事件的唯一挽损方法是报警；\n2）案发地、户籍所在地执法单位均有管辖权；\n3）不管是侵财类还是计算机犯罪，都可以按照购买成本定损；\n4）提前做好给基层警务人员“上课”的准备；\n5）找@SlowMist_Team这类安全公司开分析报告对立案大有帮助。",hashtag_entities:$R[376]=[],smarttags:$R[377]=[],timestamp_entities:$R[378]=[]},edit_control:$R[379]={__typename:"EditControlInitial",edit_tweet_ids:$R[380]=["1663843438712991746"]},grok_translated_post_with_availability:$R[381]={is_available:!1},id:"VHdlZXQ6MTY2Mzg0MzQzODcxMjk5MTc0Ng==",legacy:$R[382]={lang:"zh"},media_entities2:$R[383]=[],mention_entities:$R[384]=[$R[385]={id_str:"1372876871990272000",indices:$R[386]=[0,7],screen_name:"KuiGas"},$R[387]={id_str:"988385053800517632",indices:$R[388]=[120,134],screen_name:"SlowMist_Team"}],reply_to_results:$R[389]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE2NjM3OTkyNzYwODA4ODU3NjA=",rest_id:"1663799276080885760"},reply_to_user_results:$R[390]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[391]={__typename:"User",core:$R[392]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1663843438712991746",url_entities:$R[393]=[],views:$R[394]={count:"12417"}}}}}}],metadata:$R[395]={conversation_metadata:$R[396]={all_tweet_ids:$R[397]=["1663843438712991746"],enable_deduplication:!0}}},entry_id:"conversationthread-1663843438712991746",sort_index:"2103761706655154156"}]},$R[398]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[399]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[400]={id