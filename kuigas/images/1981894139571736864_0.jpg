2OTQ1NTEyNzUzMTY2NA==",legacy:$R[384]={lang:"zh"},media_entities2:$R[385]=[],mention_entities:$R[386]=[$R[387]={id_str:"1372876871990272000",indices:$R[388]=[0,7],screen_name:"KuiGas"}],reply_to_results:$R[389]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5ODE4OTQxMzk1NzE3MzY4NjQ=",rest_id:"1981894139571736864"},reply_to_user_results:$R[390]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[391]={__typename:"User",core:$R[392]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"2001769455127531664",url_entities:$R[393]=[],views:$R[394]={count:"17"}}}}}}],metadata:$R[395]={conversation_metadata:$R[396]={all_tweet_ids:$R[397]=["2001769455127531664"],enable_deduplication:!0}}},entry_id:"conversationthread-2001769455127531664",sort_index:"2103761733876187106"}]},$R[398]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[399]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[400]={id:"VHdlZXRSZXN1bHRzOjE5ODE4OTQxMzk1NzE3MzY4NjQ=",rest_id:"1981894139571736864",result:$R[401]={__typename:"Tweet",core:$R[402]={user_results:$R[403]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[404]={__typename:"User",avatar:$R[405]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[406]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[407]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[408]={favorite_count:192,reply_count:68},details:$R[409]={full_text:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！ https://t.co/xODoOnqjwm",smarttags:$R[410]=[]},id:"VHdlZXQ6MTk4MTg5NDEzOTU3MTczNjg2NA==",note_tweet:$R[411]={note_tweet_results:$R[412]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTgxODk0MTM5NDk2MjY3Nzc2",result:$R[413]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5ODE4OTQxMzk0OTYyNjc3NzY=",text:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！\n\n钱包地址格式虽然相似，但不能通用！地址不兼容。\n\n🔺 不能通用！不能通用！不能通用！\n\n千万别把 Aptos 的 xBTC /USDT/USDC/转到 Sui 地址（反过来也不行），\n转错 = 烧币 = 永久丢失！资金无法追回！\n\n❗ 为什么不能通用？\n虽然 Aptos 和 Sui 都用 Move 编写，地址也都是 0x 开头的 64 位字符，但它们是两条完全不同的链，钱包地址只是长得像，本质却不同。\n私钥结构、签名规则、账户模型全都不一样，互相无法识别交易或接收资产。\n同一个助记词，在两条链生成的地址并不是同一个账户，只是巧合外观类似。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1981894139571736864:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oi