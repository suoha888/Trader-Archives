			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[135]=($R[136]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="g0SOyxtr/hE6nOYqw/n9wA==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="g0SOyxtr/hE6nOYqw/n9wA==">($R=>$R[135].next($R[137]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1981894139571736864\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="g0SOyxtr/hE6nOYqw/n9wA==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="g0SOyxtr/hE6nOYqw/n9wA==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="g0SOyxtr/hE6nOYqw/n9wA==">($R=>$R[135].next($R[138]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1981894139571736864\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[139]={kind:"Result.Ok",value:$R[140]={data:$R[141]={threaded_conversation_with_injections_v2:$R[142]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[143]=[$R[144]={__typename:"TimelineClearCache"},$R[145]={__typename:"TimelineAddEntries",entries:$R[146]=[$R[147]={content:$R[148]={__typename:"TimelineTimelineItem",client_event_info:$R[149]={component:"tweet",element:"tweet"},content:$R[150]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[151]={id:"VHdlZXRSZXN1bHRzOjE5ODE4OTQxMzk1NzE3MzY4NjQ=",rest_id:"1981894139571736864",result:$R[152]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[153]=[],core:$R[154]={user_results:$R[155]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[156]={__typename:"User",avatar:$R[157]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[158]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[159]={},privacy:$R[160]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[161]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[162]={tweets:9451},verification:$R[163]={is_blue_verified:!0}}}},counts:$R[164]={bookmark_count:55,favorite_count:192,quote_count:9,reply_count:68,retweet_count:13},details:$R[165]={cashtag_entities:$R[166]=[],created_at_ms:1761355359000,display_text_range:$R[167]=[0,152],full_text:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！ https://t.co/xODoOnqjwm",hashtag_entities:$R[168]=[],smarttags:$R[169]=[],timestamp_entities:$R[170]=[]},edit_control:$R[171]={__typename:"EditControlEdit",edit_control_initial:$R[172]={edit_tweet_ids:$R[173]=["1981893895618445504","1981894139571736864"]}},grok_translated_post_with_availability:$R[174]={is_available:!1},id:"VHdlZXQ6MTk4MTg5NDEzOTU3MTczNjg2NA==",legacy:$R[175]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[176]=[$R[177]={expanded_url:"https://x.com/KuiGas/status/1981894139571736864/photo/1",ext_media_availability:$R[178]={status:"Available"},ext_playlists:$R[179]=[],features:$R[180]={},id_str:"1981893887762239488",indices:$R[181]=[153,176],media_url_https:"https://pbs.twimg.com/media/G4EZ_YqWEAAukhp.jpg",original_info:$R[182]={height:962,width:1278},type:"photo"}],mention_entities:$R[183]=[],note_tweet:$R[184]={is_expandable:!0,note_tweet_results:$R[185]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTgxODk0MTM5NDk2MjY3Nzc2",result:$R[186]={__typename:"NoteTweet",entity_set:$R[187]={hashtags:$R[188]=[],symbols:$R[189]=[],timestamps:$R[190]=[],urls:$R[191]=[],user_mentions:$R[192]=[]},id:"Tm90ZVR3ZWV0OjE5ODE4OTQxMzk0OTYyNjc3NzY=",rest_id:"1981894139496267776",text:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！\n\n钱包地址格式虽然相似，但不能通用！地址不兼容。\n\n🔺 不能通用！不能通用！不能通用！\n\n千万别把 Aptos 的 xBTC /USDT/USDC/转到 Sui 地址（反过来也不行），\n转错 = 烧币 = 永久丢失！资金无法追回！\n\n❗ 为什么不能通用？\n虽然 Aptos 和 Sui 都用 Move 编写，地址也都是 0x 开头的 64 位字符，但它们是两条完全不同的链，钱包地址只是长得像，本质却不同。\n私钥结构、签名规则、账户模型全都不一样，互相无法识别交易或接收资产。\n同一个助记词，在两条链生成的地址并不是同一个账户，只是巧合外观类似。"}}},quoted_tweet_results:$R[193]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5ODE3Mzk0NTQyNTI2MDU5NDg=",rest_id:"1981739454252605948",result:$R[194]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[195]=[],core:$R[196]={user_results:$R[197]={id:"VXNlclJlc3VsdHM6MTkyOTU0NDczMTY1MjIzMTE2OA==",result:$R[198]={__typename:"User",avatar:$R[199]={image_url:"https://pbs.twimg.com/profile_images/1951962474301034496/Cn-YriFv_normal.jpg"},core:$R[200]={name:"EFO_xx",screen_name:"efo_xx"},id:"VXNlcjoxOTI5NTQ0NzMxNjUyMjMxMTY4",identity_profile_labels_highlighted_label:$R[201]={},privacy:$R[202]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[203]={followers:14725,following:1564},rest_id:"1929544731652231168",super_follow_eligible:!1,tweet_counts:$R[204]={tweets:10031},verification:$R[205]={is_blue_verified:!0}}}},counts:$R[206]={bookmark_count:16,favorite_count:64,quote_count:6,reply_count:88,retweet_count:2},details:$R[207]={cashtag_entities:$R[208]=[],created_at_ms:1761318479000,display_text_range:$R[209]=[0,148],full_text:"天塌了呀😭 mmt打新的钱没赚到，直接先亏掉本金3000u。今天本来想去buidlpad组mmt的3000u LP拿Tier 1的额度，结果阴差阳错在币安用sui链提币到了我的aptos地址，研究了一个多小时，最后x上搜到@KuiGas和@evilcos的帖子也讲过这个，最终还是只能当作归0了😥 https://t.co/dPuWW9I0NL",hashtag_entities:$R[210]=[],smarttags:$R[211]=[],timestamp_entities:$R[212]=[]},edit_control:$R[213]={__typename:"EditControlInitial",edit_tweet_ids:$R[214]=["1981739454252605948"]},grok_translated_post_with_availability:$R[215]={is_available:!1},id:"VHdlZXQ6MTk4MTczOTQ1NDI1MjYwNTk0OA==",legacy:$R[216]={possibly_sensitive:!1},media_entities2:$R[217]=[$R[218]={expanded_url:"https://x.com/efo_xx/status/1981739454252605948/photo/1",ext_media_availability:$R[219]={status:"Available"},ext_playlists:$R[220]=[],features:$R[221]={},id_str:"1981736389625487360",indices:$R[222]=[149,172],media_url_https:"https://pbs.twimg.com/media/G4CKvyYXoAAwq7N.jpg",original_info:$R[223]={height:2532,width:1170},type:"photo"}],mention_entities:$R[224]=[$R[225]={id_str:"1372876871990272000",indices:$R[226]=[111,118],screen_name:"KuiGas"},$R[227]={id_str:"17552210",indices:$R[228]=[119,127],screen_name:"evilcos"}],note_tweet:$R[229]={is_expandable:!0,note_tweet_results:$R[230]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTgxNzM5NDU0MTY4NzE1MjY0",result:$R[231]={__typename:"NoteTweet",entity_set:$R[232]={hashtags:$R[233]=[],symbols:$R[234]=[$R[235]={indices:$R[236]=[331,336],tag:$R[237]={id:"U21hcnRUYWc6SFVNQQ==",info:$R[238]={info:$R[239]={ticker:"HUMA"}}},text:"HUMA"}],urls:$R[240]=[],user_mentions:$R[241]=[$R[242]={id_str:"1372876871990272000",indices:$R[243]=[111,118],screen_name:"KuiGas"},$R[244]={id_str:"17552210",indices:$R[245]=[119,127],screen_name:"evilcos"},$R[246]={id_str:"1504853869397905408",indices:$R[247]=[340,352],screen_name:"humafinance"},$R[248]={id_str:"1504853869397905408",indices:$R[249]=[382,394],screen_name:"humafinance"}]},id:"Tm90ZVR3ZWV0OjE5ODE3Mzk0NTQxNjg3MTUyNjQ=",rest_id:"1981739454168715264",text:"天塌了呀😭 mmt打新的钱没赚到，直接先亏掉本金3000u。今天本来想去buidlpad组mmt的3000u LP拿Tier 1的额度，结果阴差阳错在币安用sui链提币到了我的aptos地址，研究了一个多小时，最后x上搜到@KuiGas和@evilcos的帖子也讲过这个，最终还是只能当作归0了😥\n\n大家在提币转账的时候一定要再三注意地址和提币方式。我这次其实还先打了10u试试水，第一波10u用aptos链提到sui就失败了，结果第二次试的时候我mac上复制的aptos地址同步到了手机，手机复制地址的时候没有double check直接用sui链提到了我aptos的地址上去，3000u直接没了。\n\n这3000u本来是我准备用来打新完mmt买100,000 $HUMA 去搞 @humafinance 的vanguard徽章的，这下只能靠嘴撸回血了。\n\n没想到@humafinance 部署在SOL上还有这样的好处，至少提币不会提错。不过吃一堑长一智吧。大家以后转账的时候真得把链和地址搞清楚，如果遇到自己不熟悉的链，一定要小额转账确认到账后再进行大额的操作！\n\n币圈资金安全无小事！幸苦这次只是3000u，希望以后都能注意避免类似的事情发生！"}}},rest_id:"1981739454252605948",url_entities:$R[250]=[],views:$R[251]={count:"105194"}}},rest_id:"1981894139571736864",url_entities:$R[252]=[],views:$R[253]={count:"132642"}}}}},entry_id:"tweet-1981894139571736864",sort_index:"2103761733876187136"},$R[254]={content:$R[255]={__typename:"TimelineTimelineModule",client_event_info:$R[256]={component:"tweet"},display_type:"VerticalConversation",items:$R[257]=[$R[258]={entry_id:"conversationthread-1981899709343260760-tweet-1981899709343260760",item:$R[259]={__typename:"TimelineTimelineItem",client_event_info:$R[260]={component:"tweet",details:$R[261]={conversation_details:$R[262]={conversation_section:"HighQuality"},timelines_details:$R[263]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczZ3HAAAAAA=="}},element:"tweet"},content:$R[264]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[265]={id:"VHdlZXRSZXN1bHRzOjE5ODE4OTk3MDkzNDMyNjA3NjA=",rest_id:"1981899709343260760",result:$R[266]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[267]=[],core:$R[268]={user_results:$R[269]={id:"VXNlclJlc3VsdHM6MTcyMDgwODczNDcyMzg3ODkxMg==",result:$R[270]={__typename:"User",avatar:$R[271]={image_url:"https://pbs.twimg.com/profile_images/2083541840406708225/Un_gQnPz_normal.jpg"},core:$R[272]={name:"chongxian 🔥🦖",screen_name:"chongxian"},id:"VXNlcjoxNzIwODA4NzM0NzIzODc4OTEy",identity_profile_labels_highlighted_label:$R[273]={},privacy:$R[274]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[275]={followers:12448,following:2686},rest_id:"1720808734723878912",super_follow_eligible:!1,tweet_counts:$R[276]={tweets:22649},verification:$R[277]={is_blue_verified:!0}}}},counts:$R[278]={bookmark_count:0,favorite_count:2,quote_count:0,reply_count:2,retweet_count:0},details:$R[279]={cashtag_entities:$R[280]=[],created_at_ms:1761356687000,display_text_r