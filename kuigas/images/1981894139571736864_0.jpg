r.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410857234,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410857234,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1981894139571736864␀{}",u:1790410857653,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1981894139571736864",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1981894139571736864",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！\n\n钱包地址格式虽然相似，但不能通用！地址不兼容。\n\n🔺 不能通用！不能通用！不能通用！\n\n千万别把 Aptos 的 xBTC /USDT/USDC/转到 Sui 地址（反过来也不行），\n转错 = 烧币 = 永久丢失！资金无法追回！\n\n❗ 为什么不能通用？\n虽然 Aptos 和 Sui 都用 Move 编写，地址也都是 0x 开头的 64 位字符，但它们是两条完全不同的链，钱包地址只是长得像，本质却不同。\n私钥结构、签名规则、账户模型全都不一样，互相无法识别交易或接收资产。\n同一个助记词，在两条链生成的地址并不是同一个账户，只是巧合外观类似。",canonicalPath:"/KuiGas/status/1981894139571736864",canonicalUrl:"https://x.com/KuiGas/status/1981894139571736864",description:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！\n\n钱包地址格式虽然相似，但不能通用！地址不兼容。\n\n🔺 不能通用！不能通用！不能通用！\n\n千万别把 Aptos 的 xBTC /USDT/USDC/转到 Sui 地址（反过来也不行），\n转错 = 烧币 = 永久丢失！资金无法追回！\n\n❗ 为什么不能通用？\n虽然 Aptos 和 Sui 都用 Move 编写，地址也都是 0x 开头的 64 位字符，但它们是两条完全不同的链，钱包地址只是长得像，本质却不同。\n私钥结构、签名规则、账户模型全都不一样，互相无法识别交易或接收资产。\n同一个助记词，在两条链生成的地址并不是同一个账户，只是巧合外观类似。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:962,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/G4EZ_YqWEAAukhp?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/G4EZ_YqWEAAukhp?format=webp&name=small 680w, https://pbs.twimg.com/media/G4EZ_YqWEAAukhp?format=webp&name=medium 1200w, https://pbs.twimg.com/media/G4EZ_YqWEAAukhp?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/G4EZ_YqWEAAukhp?format=webp&name=large",width:1278},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2025-10-25T01:22:39.000Z",replyCount:68,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/efo_xx/status/1981739454252605948","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"efo_xx",identifier:"1929544731652231168",image:"https://pbs.twimg.com/profile_images/1951962474301034496/Cn-YriFv_400x400.jpg",name:"EFO_xx",url:"https://x.com/efo_xx"},datePublished:"2025-10-24T15:07:59.000Z",identifier:"1981739454252605948",url:"https://x.com/efo_xx/status/1981739454252605948",image:$R[17]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/G4CKvyYXoAAwq7N?format=webp&name=large",description:"天塌了呀😭 mmt打新的钱没赚到，直接先亏掉本金3000u。今天本来想去buidlpad组mmt的3000u LP拿Tier 1的额度，结果阴差阳错在币安用sui链提币到了我的aptos地址，研究了一个多小时，最后x上搜到@KuiGas和@evilcos的帖子也讲过这个，最终还是只能当作归0了😥\n\n大家在提币转账的时候一定要再三注意地址和提币方式。我这次其实还先打了10u试试水，第一波10u用aptos链提到sui就失败了，结果第二次试的时候我mac上复制的aptos地址同步到了手机，手机复制地址的时候没有double check直接用sui链提到了我aptos的地址上去，3000u直接没了。\n\n这3000u本来是我准备用来打新完mmt买100,000 $HUMA 去搞 @humafinance 的vanguard徽章的，这下只能靠嘴撸回血了。\n\n没想到@humafinance 部署在SOL上还有这样的好处，至少提币不会提错。不过吃一堑长一智吧。大家以后转账的时候真得把链和地址搞清楚，如果遇到自己不熟悉的链，一定要小额转账确认到账后再进行大额的操作！\n\n币圈资金安全无小事！幸苦这次只是3000u，希望以后都能注意避免类似的事情发生！",height:2532,name:"天塌了呀😭 mmt打新的钱没赚到，直接先亏掉本金3000u。今天本来想去buidlpad组mmt的3000u LP拿Tier 1的额度，结果阴差阳错在币安用sui链提币到了我的aptos地址，研究了一个多小时，最后x上搜到@KuiGas和@evilcos的帖子也讲过这个，最终还是只能当作归0了😥\n\n大家在提币转账的时候一定要再三注意地址和提币方式。我这次其实还先打了10u试试水，第一波10u用aptos链提到sui就失败了，结果第二次试的时候我mac上复制的aptos地址同步到了手机，手机复制地址的时候没有double check直接用sui链提到了我aptos的地址上去，3000u直接没了。\n\n这3000u本来是我准备用来打新完mmt买100,000 $HUMA 去搞 @humafinance 的vanguard徽章的，这下只能靠嘴撸回血了。\n\n没想到@humafinance 部署在SOL上还有这样的好处，至少提币不会提错。不过吃一堑长一智吧。大家以后转账的时候真得把链和地址搞清楚，如果遇到自己不熟悉的链，一定要小额转账确认到账后再进行大额的操作！\n\n币圈资金安全无小事！幸苦这次只是3000u，希望以后都能注意避免类似的事情发生！",thumbnailUrl:"https://pbs.twimg.com/media/G4CKvyYXoAAwq7N?format=webp&name=small",uploadDate:"2025-10-24T15:07:59.000Z",url:"https://pbs.twimg.com/media/G4CKvyYXoAAwq7N?format=webp&name=large",width:1170},engagement:$R[18]=[$R[19]={action:"LikeAction",name:"Likes",url:"https://x.com/efo_xx/status/1981739454252605948/likes",count:64},$R[20]={action:"ShareAction",name:"Retweets",url:"https://x.com/efo_xx/status/1981739454252605948/retweets",count:2},$R[21]={action:"ReplyAction",name:"Replies",url:null,count:88},$R[22]={action:"ViewAction",name:"Views",count:105194}],text:"天塌了呀😭 mmt打新的钱没赚到，直接先亏掉本金3000u。今天本来想去buidlpad组mmt的3000u LP拿Tier 1的额度，结果阴差阳错在币安用sui链提币到了我的aptos地址，研究了一个多小时，最后x上搜到@KuiGas和@evilcos的帖子也讲过这个，最终还是只能当作归0了😥\n\n大家在提币转账的时候一定要再三注意地址和提币方式。我这次其实还先打了10u试试水，第一波10u用aptos链提到sui就失败了，结果第二次试的时候我mac上复制的aptos地址同步到了手机，手机复制地址的时候没有double check直接用sui链提到了我aptos的地址上去，3000u直接没了。\n\n这3000u本来是我准备用来打新完mmt买100,000 $HUMA 去搞 @humafinance 的vanguard徽章的，这下只能靠嘴撸回血了。\n\n没想到@humafinance 部署在SOL上还有这样的好处，至少提币不会提错。不过吃一堑长一智吧。大家以后转账的时候真得把链和地址搞清楚，如果遇到自己不熟悉的链，一定要小额转账确认到账后再进行大额的操作！\n\n币圈资金安全无小事！幸苦这次只是3000u，希望以后都能注意避免类似的事情发生！"}},socialTitle:"丰密 (@KuiGas) on X",title:"丰密 on X: \"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！\n\n钱包地址格式虽然相似，但不能通用！地址不兼容。\n\n🔺 不能通用！不能通用！不能通用！\n\n千万别把 Aptos 的 xBTC /USDT/USDC/转到 Sui 地址（反过来也不行），\n转错 = 烧币 = 永久丢失！资金无法追回！\n\n❗ 为什么不能通用？\n虽然 Aptos 和 Sui 都用 Move 编写，地址也都是 0x 开头的 64 位字符，但它们是两条完全不同的链，钱包地址只是长得像，本质却不同。\n私钥结构、签名规则、账户模型全都不一样，互相无法识别交易或接收资产。\n同一个助记词，在两条链生成的地址并不是同一个账户，只是巧合外观类似。\""},replyCount:68,screenName:"KuiGas",status:"available",text:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用SUI或者Aptos链提USDT/USDC，主要是非常便宜且确认速度賊快，但是务必要注意上述情况。\n\n✅除了下面这个转错案例，昨天还有个亏友转错9000刀，血淋淋的教训。\n\n你必须要知道\n\n🚫 注意：Aptos ≠ Sui，两条链完全不同，地址不兼容！\n\n钱包地址格式虽然相似，但不能通用！地址不兼容。\n\n🔺 不能通用！不能通用！不能通用！\n\n千万别把 Aptos 的 xBTC /USDT/USDC/转到 Sui 地址（反过来也不行），\n转错 = 烧币 = 永久丢失！资金无法追回！\n\n❗ 为什么不能通用？\n虽然 Aptos 和 Sui 都用 Move 编写，地址也都是 0x 开头的 64 位字符，但它们是两条完全不同的链，钱包地址只是长得像，本质却不同。\n私钥结构、签名规则、账户模型全都不一样，互相无法识别交易或接收资产。\n同一个助记词，在两条链生成的地址并不是同一个账户，只是巧合外观类似。"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[23]={messagesBeforeDehydration:$R[24]=[$R[25]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1981894139571736864\"}",name:"TweetResultByRestId"},$R[26]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1981894139571736864\"}",result:$R[27]={kind:"Result.Ok",value:$R[28]={data:$R[29]={tweet_result_by_rest_id:$R[30]={id:"VHdlZXRSZXN1bHRzOjE5ODE4OTQxMzk1NzE3MzY4NjQ=",rest_id:"1981894139571736864",result:$R[31]={__typename:"Tweet",cashtag_attachments:$R[32]=[],core:$R[33]={user_results:$R[34]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[35]={__typename:"User",avatar:$R[36]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[37]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[38]={},privacy:$R[39]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[40]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[41]={tweets:9451},verification:$R[42]={is_blue_verified:!0}}}},counts:$R[43]={bookmark_count:55,favorite_count:192,quote_count:9,reply_count:68,retweet_count:13},details:$R[44]={cashtag_entities:$R[45]=[],created_at_ms:1761355359000,display_text_range:$R[46]=[0,152],full_text:"你一定要收藏这条推文！\n\n很多亏友在交易所提币，都用S