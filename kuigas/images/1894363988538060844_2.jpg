})())}})($R["tsr"])</script><script nonce="K12pFFJOslTg9YrQLu9XUg==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="K12pFFJOslTg9YrQLu9XUg==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="K12pFFJOslTg9YrQLu9XUg==">($R=>$R[140].next($R[142]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1894363988538060844\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="K12pFFJOslTg9YrQLu9XUg==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="K12pFFJOslTg9YrQLu9XUg==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="K12pFFJOslTg9YrQLu9XUg==">($R=>$R[140].next($R[143]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1894363988538060844\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[144]={kind:"Result.Ok",value:$R[145]={data:$R[146]={threaded_conversation_with_injections_v2:$R[147]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[148]=[$R[149]={__typename:"TimelineClearCache"},$R[150]={__typename:"TimelineAddEntries",entries:$R[151]=[$R[152]={content:$R[153]={__typename:"TimelineTimelineItem",client_event_info:$R[154]={component:"tweet",element:"tweet"},content:$R[155]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[156]={id:"VHdlZXRSZXN1bHRzOjE4OTQzNjM5ODg1MzgwNjA4NDQ=",rest_id:"1894363988538060844",result:$R[157]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag