screen_name:"Mercy_okx"},$R[214]={id_str:"1372876871990272000",indices:$R[215]=[304,311],screen_name:"KuiGas"}]},id:"Tm90ZVR3ZWV0OjE4OTQ2NjUyNDYzMTg3NTk5NDE=",rest_id:"1894665246318759941",text:"答应了 OKX @Mercy_okx 做一期关于空投的 Space，已经拖了很久了，现在正好借着 Gas 低迷、市场冷清的时候，和那些依然深耕 Web3链上交互的的伙伴们，一起聊聊空投的道与术。\n一个人讲可能会有点紧张，到时候磕巴了肯定是正常😂。\n\n先说观点：我依然相信这个行业存在巨大的机会。\n\n但这个“相信”不是空谈，而是建立在深度认知、长期趋势和市场轮动的理解之上。专注空投本质上是风险“期权”，认知套利，不是所有项目都值得撸，策略才是关键，如何筛选项目？如何精准交互？如何判断 ROI？如何避免避免做无意义的交互。\n到底怎么玩，才能最大化收益？\n这些，我可能说的都是错的，\n但是，我知道，得亏GAS @KuiGas"}}},quoted_tweet_results:$R[216]={id:"VHdlZXRSZXN1bHRzOjE4OTQ2MzA1NDE4NzU3MTIyMjk=",rest_id:"1894630541875712229",result:$R[217]={__typename:"Tweet",core:$R[218]={user_results:$R[219]={id:"VXNlclJlc3VsdHM6MTQ2MTIyNDk5NDcwNTY0OTY3MQ==",result:$R[220]={__typename:"User",id:"VXNlcjoxNDYxMjI0OTk0NzA1NjQ5Njcx",rest_id:"1461224994705649671"}}},id:"VHdlZXQ6MTg5NDYzMDU0MTg3NTcxMjIyOQ==",rest_id:"1894630541875712229"}},rest_id:"1894665246385868831",url_entities:$R[221]=[],views:$R[222]={count:"156957"}}},rest_id:"1895505719107154134",url_entities:$R[223]=[$R[224]={display_url:"x.com/KuiGas/status/…",expanded_url:"https://x.com/KuiGas/status/1894665246385868831",indices:$R[225]=[110,133],url:"https://t.co/EMoWtdr3EA"}],views:$R[226]={count:"171404"}}}}},entry_id:"tweet-1895505719107154134",sort_index:"2103760943509929984"},$R[227]={content:$R[228]={__typename:"TimelineTimelineModule",client_event_info:$R[229]={component:"tweet"},display_type:"VerticalConversation",items:$R[230]=[$R[231]={entry_id:"conversationthread-1895505722563268919-tweet-1895505722563268919",item:$R[232]={__typename:"TimelineTimelineItem",client_event_info:$R[233]={component:"tweet",details:$R[234]={conversation_details:$R[235]={conversation_section:"HighQuality"},timelines_details:$R[236]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[237]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[238]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MjI1NjMyNjg5MTk=",rest_id:"1895505722563268919",result:$R[239]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[240]=[],core:$R[241]={user_results:$R[242]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[243]={__typename:"User",avatar:$R[244]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[245]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[246]={},privacy:$R[247]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[248]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[249]={tweets:9451},verification:$R[250]={is_blue_verified:!0}}}},counts:$R[251]={bookmark_count:6,favorite_count:11,quote_count:1,reply_count:2,retweet_count:0},details:$R[252]={cashtag_entities:$R[253]=[],created_at_ms:1740758755000,display_text_range:$R[254]=[0,99],full_text:"1、自我介绍\n\n大家好，我是丰密，我是专注链上撸空投的，常年混迹 Web3，一直在探索这个行业的机会和玩法。 很高兴 OKX 和 Mercy 邀请我来做这期 Space，聊聊撸空投的“道”与“术”。",hashtag_entities:$R[255]=[],smarttags:$R[256]=[],timestamp_entities:$R[257]=[]},edit_control:$R[258]={__typename:"EditControlInitial",edit_tweet_ids:$R[259]=["1895505722563268919"]},grok_translated_post_with_availability:$R[260]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTcyMjU2MzI2ODkxOQ==",legacy:$R[261]={lang:"zh"},media_entities2:$R[262]=[],mention_entities:$R[263]=[],note_tweet:$R[264]={is_expandable:!0,note_tweet_results:$R[265]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzIyNTAwMzYyMjQx",result:$R[266]={__typename:"NoteTweet",entity_set:$R[267]={hashtags:$R[268]=[],symbols:$R[269]=[],urls:$R[270]=[],user_mentions:$R[271]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3MjI1MDAzNjIyNDE=",rest_id:"1895505722500362241",text:"1、自我介绍\n\n大家好，我是丰密，我是专注链上撸空投的，常年混迹 Web3，一直在探索这个行业的机会和玩法。 很高兴 OKX 和 Mercy 邀请我来做这期 Space，聊聊撸空投的“道”与“术”。\n我呢，在这几年看过、也拿到过不少空投红利，也踩过不少坑，今天和大家一起探讨，感谢大家来参与。说的不好，还请大家多多指正。 \n\n我是学金融出身，专业是证券投资与管理，在传统金融历练了十几年时间，做过对冲交易，做过投行，2017年参加ico进入了加密货币这个圈子，2020年玩“DeFi Summer”顺势发现了撸空投赛道，在撸空投的过程中发现，原来，这个行业非常赚钱，在一个项目当中拿到的空投奖励就可以超过我原来1整年、甚至好几年的工资，从此打工人变成黑奴。"}}},reply_to_results:$R[272]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MTkxMDcxNTQxMzQ=",rest_id:"1895505719107154134"},reply_to_user_results:$R[273]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[274]={__typename:"User",core:$R[275]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505722563268919",url_entities:$R[276]=[],views:$R[277]={count:"5399"}}}}}},$R[278]={entry_id:"conversationthread-1895505722563268919-tweet-1895505725549670738",item:$R[279]={__typename:"TimelineTimelineItem",client_event_info:$R[280]={component:"tweet",details:$R[281]={conversation_details:$R[282]={conversation_section:"HighQuality"},timelines_details:$R[283]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[284]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[285]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MjU1NDk2NzA3Mzg=",rest_id:"1895505725549670738",result:$R[286]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[287]=[],core:$R[288]={user_results:$R[289]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[290]={__typename:"User",avatar:$R[291]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[292]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[293]={},privacy:$R[294]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[295]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[296]={tweets:9451},verification:$R[297]={is_blue_verified:!0}}}},counts:$R[298]={bookmark_count:3,favorite_count:2,quote_count:0,reply_count:1,retweet_count:0},details:$R[299]={cashtag_entities:$R[300]=[],created_at_ms:1740758756000,display_text_range:$R[301]=[0,72],full_text:"1、你是如何接触到加密货币领域的？\n最初的动机是什么？是否有某个特定的项目或事件让你意识到“撸毛”是一个可行的策略？\n\n丰密：我其实接触 BTC",hashtag_entities:$R[302]=[],smarttags:$R[303]=[],timestamp_entities:$R[304]=[]},edit_control:$R[305]={__typename:"EditControlInitial",edit_tweet_ids:$R[306]=["1895505725549670738"]},grok_translated_post_with_availability:$R[307]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTcyNTU0OTY3MDczOA==",legacy:$R[308]={lang:"zh"},media_entities2:$R[309]=[],mention_entities:$R[310]=[],note_tweet:$R[311]={is_expandable:!0,note_tweet_results:$R[312]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzI1NDc0MTgxMTIw",result:$R[313]={__typename:"NoteTweet",entity_set:$R[314]={hashtags:$R[315]=[],symbols:$R[316]=[],urls:$R[317]=[],user_mentions:$R[318]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3MjU0NzQxODExMjA=",rest_id:"1895505725474181120",text:"1、你是如何接触到加密货币领域的？\n最初的动机是什么？是否有某个特定的项目或事件让你意识到“撸毛”是一个可行的策略？\n\n丰密：我其实接触 BTC 很早，09年当时不值钱，刚出来的时候我还用笔记本挖过，但对技术也不太懂，主要还是当时认知低、完全没看明白这个东西的价值，结果就错过了。后来真正开始认真参与是在2017 年 ICO 那波狂热，被暴涨吸引进来的。想赚大钱，这就是当初最纯粹的动机吧\n\n那时候我参与了不少 ICO项目投资，才真正意识到，这个市场的游戏规则跟我们传统金融完全不一样，在ico的时候也会看各类项目，慢慢在18-19年接触了defi，比如MakerDAO、Compound、Uniswap这类协议\n\n2020年的“DeFi Summer” ，我发现Defi挖矿与撸空投可以结合起来，并且复利效应非常明显！\n\n而我，真正意识到“撸毛”是一个可行的策略的项目阶段是uni跟sushi发币的时候，所以我找了特别多我看好的协议，其中就有ens与paraswap。并且从那个时候开始多号重仓的，之后，ens与paraswap发空投，ENS发空投的单号奖励超过10w人民币，PSP单号1万美金起，这也算是我在这个赛道拿到的第一笔大奖金，验证了空投赚钱这条路是可行的，并且希望非常大，机会特别多，像找到了金矿的感觉。"}}},reply_to_results:$R[319]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MjI1NjMyNjg5MTk=",rest_id:"1895505722563268919"},reply_to_user_results:$R[320]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[321]={__typename:"User",core:$R[322]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505725549670738",url_entities:$R[323]=[],views:$R[324]={count:"5236"}}}}}},$R[325]={entry_id:"conversationthread-1895505722563268919-tweet-1895505727957123240",item:$R[326]={__typename:"TimelineTimelineItem",client_event_info:$R[327]={component:"tweet",details:$R[328]={conversation_details:$R[329]={conversation_section:"HighQuality"},timelines_details:$R[330]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[331]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[332]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Mjc5NTcxMjMyNDA=",rest_id:"1895505727957123240",result:$R[333]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[334]=[],core:$R[335]={user_results:$R[336]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[337]={__typename:"User",avatar:$R[338]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[339]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[340]={},privacy:$R[341]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[342]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[343]={tweets:9451},verification:$R[344]={is_blue_verified:!0}}}},counts:$R[345]={bookmark_count:0,favorite_count:1,quote_count:0,reply_count:1,retweet_count:0},details:$R[346]={cashtag_entities:$R[347]=[],created_at_ms:1740758756000,display_text_range:$R[348]=[0,162],full_text:"2、为何会想要创建发起33DAO，初心是什么？成立到现在对于自己有什么影响？\n\n丰密：33DAO 是一个共创、共建、共享的 DAO 组织，我只是其中的发起人之一。33DAO 运行到现在已经有 4 年，目前分布在全球有35个人，33dao每周必须开会，全员必须参加，我简单算了下33dao过去4年，应该开了不下于200次周会。",hashtag_entities:$R[349]=[],smarttags:$R[350]=[],timestamp_entities:$R[351]=[]},edit_control:$R[352]={__typename:"EditControlInitial",edit_tweet_ids:$R[353]=["1895505727957123240"]},grok_translated_post_with_availability:$R[354]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTcyNzk1NzEyMzI0MA==",legacy:$R[355]={lang:"zh"},media_entities2:$R[356]=[],mention_entities:$R[357]=[],note_tweet:$R[358]={is_expandable:!0,note_tweet_results:$R[359]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzI3ODUyMjU3Mjgw",result:$R[360]={__typename:"NoteTweet",entity_set:$R[361]={hashtags:$R[362]=[],symbols:$R[363]=[],urls:$R[364]=[],user_mentions:$R[365]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3Mjc4NTIyNTcyODA=",rest_id:"1895505727852257280",text:"2、为何会想要创建发起33DAO，初心是什么？成立到现在对于自己有什么影响？\n\n丰密：33DAO 是一个共创、共建、共享的 DAO 组织，我只是其中的发起人之一。33DAO 运行到现在已经有 4 年，目前分布在全球有35个人，33dao每周必须开会，全员必须参加，我简单算了下33dao过去4年，应该开了不下于200次周会。\n\n当初的初心很简单——希望把一群有能力、有想法的个体聚集在一起，通过定期交流、深度探讨、观点碰撞，形成一个真正能提供价值的社区。同时，我们也在不断对外输出，比如：教程、市场观点、Space 讨论等，帮助撸空投的伙伴更快上手、更好理解 Web3 。"}}},reply_to_results:$R[366]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MjU1NDk2NzA3Mzg=",rest_id:"1895505725549670738"},reply_to_user_results:$R[367]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[368]={__typename:"User",core:$R[369]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505727957123240",url_entities:$R[370]=[],views:$R[371]={count:"5512"}}}}}},$R[372]={entry_id:"conversationthread-1895505722563268919-tweet-1895505730519900309",item:$R[373]={__typename:"TimelineTimelineItem",client_event_info:$R[374]={component:"tweet",details:$R[375]={conversation_details:$R[376]={conversation_section:"HighQuality"},timelines_details:$R[377]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[378]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[379]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MzA1MTk5MDAzMDk=",rest_id:"1895505730519900309",result:$R[380]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[381]=[],core:$R[382]={user_results:$R[383]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[384]={__typename:"User",avatar:$R[385]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[386]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[387]={},privacy:$R[388]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[389]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[390]={tweets:9451},verification:$R[391]={is_blue_verified:!0}}}},counts:$R[392]={bookmark_count:1,favorite_count:1,quote_count:1,reply_count:1,retweet_count:0},details:$R[393]={cashtag_entities:$R[394]=[],created_at_ms:1740758757000,display_text_range:$R[395]=[0,126],full_text:"3、33dao成立到现在对于自己有什么影响？\n\n丰密：\n1、首先，我觉得最直接的就是认识了一批牛逼的人，并且大家都通过这个拿到了非常大的结果，而这些成员相互鼓励，相互影响，提升认知，最终变现，我觉得这是一个很好的过程。比如，最近过年期间特朗普这个代币，",hashtag_entities:$R[396]=[],smarttags:$R[397]=[],timestamp_entities:$R[398]=[]},edit_control:$R[399]={__typename:"EditControlInitial",edit_tweet_ids:$R[400]=["1895505730519900309"]},grok_translated_post_with_availability:$R[401]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTczMDUxOTkwMDMwOQ==",legacy:$R[402]={lang:"zh"},media_entities2:$R[403]=[],mention_entities:$R[404]=[],note_tweet:$R[405]={is_expandable:!0,note_tweet_results:$R[406]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzMwMzU2MzQ2ODgw",result:$R[407]={__typename:"NoteTweet",entity_set:$R[408]={hashtags:$R[409]=[],symbols:$R[410]=[],urls:$R[411]=[],user_mentions:$R[412]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3MzAzNTYzNDY4ODA=",rest_id:"1895505730356346880",text:"3、33dao成立到现在对于自己有什么影响？\n\n丰密：\n1、首先，我觉得最直接的就是认识了一批牛逼的人，并且大家都通过这个拿到了非常大的结果，而这些成员相互鼓励，相互影响，提升认知，最终变现，我觉得这是一个很好的过程。比如，最近过年期间特朗普这个代币， 在刚出来的十几分钟，就有成员发出来ca，最开始大家的觉得是被盗，但是通过成员相互扒数据，确认这个信息是真的，然后大家在最短的时间立马明牌上仓位，我记得好像当时就0.5-1美金左右吧。2天时间大概涨了100x。最后，很多人拿到非常非常大的结果。可惜我当时在国外，自己买少了。拍断大腿啊。同时我也深刻的理解到小圈子的重要性，且与什么样的人交流很重要\n\n2、其次，33DAO的存在，倒逼自己不断输出：意味着要持续做研究、分享观点，很多认知并不是天生具备的，而是通过持续学习、深度思考、与社区成员的讨论中不断进化的。这种倒逼自己成长的机制，对我的影响很大。比如我们曾经专注的ARB，Strk等很多项目，大家在熊市的时候相互交流鼓励，最终拿到非常不错的结果。\n\n3.最后， 资源与人脉的积累\n\n33DAO 让我们有机会直接对话海外顶级项目，很多项目都是通过社区的力量第一时间挖掘出来的。通过很多项目交流会有更广阔的视角，同时成员之间通过项目互动，紧密性更强，算是屌丝真正融入了 Web3 生态。"}}},reply_to_results:$R[413]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Mjc5NTcxMjMyNDA=",rest_id:"1895505727957123240"},reply_to_user_results:$R[414]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[415]={__typename:"User",core:$R[416]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505730519900309",url_entities:$R[417]=[],views:$R[418]={count:"5502"}}}}}},$R[419]={entry_id:"conversationthread-1895505722563268919-tweet-1895505735179698252",item:$R[420]={__typename:"TimelineTimelineItem",client_event_info:$R[421]={component:"tweet",details:$R[422]={conversation_details:$R[423]={conversation_section:"HighQuality"},timelines_details:$R[424]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[425]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[426]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MzUxNzk2OTgyNTI=",rest_id:"1895505735179698252",result:$R[427]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[428]=[],core:$R[429]={user_results:$R[430]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[431]={__typename:"User",avatar:$R[432]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[433]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[434]={},privacy:$R[435]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[436]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[437]={tweets:9451},verification:$R[438]={is_blue_verified:!0}}}},counts:$R[439]={bookmark_count:20,favorite_count:13,quote_count:0,reply_count:1,retweet_count:2},details:$R[440]={cashtag_entities:$R[441]=[],created_at_ms:1740758758000,display_text_range:$R[442]=[0,129],full_text:"4、撸毛的核心策略：如何筛选优质空投项目，你如何筛选优质的空投项目？ 最关注哪些指标？（如团队背景、代币经济模型、社区活跃度等）\n\n丰密：优质项目的关注的指标：赛道、融资背景、生态布局、团队背景、链上数据、技术创新点等，当然还有市场能力，搞事能力，组局能力。",hashtag_entities:$R[443]=[],smarttags:$R[444]=[],timestamp_entities:$R[445]=[]},edit_control:$R[446]={__typename:"EditControlInitial",edit_tweet_ids:$R[447]=["1895505735179698252"]},grok_translated_post_with_availability:$R[448]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTczNTE3OTY5ODI1Mg==",legacy:$R[449]={lang:"zh"},media_entities2:$R[450]=[],mention_entities:$R[451]=[],note_tweet:$R[452]={is_expandable:!0,note_tweet_results:$R[453]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzM1MDk1OTIyNjg4",result:$R[454]={__typename:"NoteTweet",entity_set:$R[455]={hashtags:$R[456]=[],symbols:$R[457]=[],urls:$R[458]=[],user_mentions:$R[459]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3MzUwOTU5MjI2ODg=",rest_id:"1895505735095922688",text:"4、撸毛的核心策略：如何筛选优质空投项目，你如何筛选优质的空投项目？ 最关注哪些指标？（如团队背景、代币经济模型、社区活跃度等）\n\n丰密：优质项目的关注的指标：赛道、融资背景、生态布局、团队背景、链上数据、技术创新点等，当然还有市场能力，搞事能力，组局能力。\n\n筛选分析项目，我个人关注项目的赔率与概率，成本。\n\n我个人觉得这事一个非常复杂的过程，每一环都是我这么多年总结下来的实用方法论，不知道大家有没有耐心听👂·········\n\n1、 归类赛道，聚焦主流\n\n赛道就那么几大类，看多了自然能分辨。先把主流赛道过一遍，形成基本认知，比如L1/L2 、ZK DeFi、LSD、Restaking、BTCFi、Move语言等各个叙事都看。我一般把生态的项目排序，然后单独分析赔率与概率。\n\n2、找亮点还有协议技术创新、协议特性。\n\n我看完很多内容之后，我会聚焦项目的核心优势是什么？相比同赛道竞品有什么不同？有时间可以看白皮书与官方文档，但初期建议先形成赛道认知，看到一个项目能迅速判断它是干嘛的，再深入研究。我印象比较深刻的是mavrick，·······在zksync上，高APR，发现了巨大的机会。\n\n3、 关注机构和投资人以及多维度视角\n\n有机构加持可信度更高，特别是明星级基本不会跑路，更容易上大所，天花板更高。\n\n机构融资+投资人，VC视角。机构已经帮忙筛选过，能有效过滤掉普通项目，提高胜率，我个人比较喜欢盯我自己钟意的机构，比如Hack vc。\n\n核心思路： 先看赛道，快速判断定位，再看项目亮点，最后看机构投资，找项目的alpha，分析项目的市场活动思路，特别是要有项目方视角。多角度多维度探索。\n\n我把这个过程当成现实相亲的自我介绍过程，你干啥的，你全家干啥的，你有没有钱，有没有房有没有车，有没有工作，有没有·········，说白了，我为什么要撸这个项目要非常清晰。"}}},reply_to_results:$R[460]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MzA1MTk5MDAzMDk=",rest_id:"1895505730519900309"},reply_to_user_results:$R[461]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[462]={__typename:"User",core:$R[463]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505735179698252",url_entities:$R[464]=[],views:$R[465]={count:"5420"}}}}}},$R[466]={entry_id:"conversationthread-1895505722563268919-tweet-1895505739977994702",item:$R[467]={__typename:"TimelineTimelineItem",client_event_info:$R[468]={component:"tweet",details:$R[469]={conversation_details:$R[470]={conversation_section:"HighQuality"},timelines_details:$R[471]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[472]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[473]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Mzk5Nzc5OTQ3MDI=",rest_id:"1895505739977994702",result:$R[474]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[475]=[],core:$R[476]={user_results:$R[477]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[478]={__typename:"User",avatar:$R[479]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[480]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[481]={},privacy:$R[482]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[483]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[484]={tweets:9451},verification:$R[485]={is_blue_verified:!0}}}},counts:$R[486]={bookmark_count:13,favorite_count:11,quote_count:0,reply_count:2,retweet_count:2},details:$R[487]={cashtag_entities:$R[488]=[],created_at_ms:1740758759000,display_text_range:$R[489]=[0,98],full_text:"5、项目方通常会通过技术手段识别女巫攻击，在不被识别为“女巫攻击”的情况下，您如何合理使用多账号策略？怎么理解“精品账号”？\n\n丰密：这个问题好，时间关系我尽量说的全一点，\n\n先说几个概念的东西，",hashtag_entities:$R[490]=[],smarttags:$R[491]=[],timestamp_entities:$R[492]=[]},edit_control:$R[493]={__typename:"EditControlInitial",edit_tweet_ids:$R[494]=["1895505739977994702"]},grok_translated_post_with_availability:$R[495]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTczOTk3Nzk5NDcwMg==",legacy:$R[496]={lang:"zh"},media_entities2:$R[497]=[],mention_entities:$R[498]=[],note_tweet:$R[499]={is_expandable:!0,note_tweet_results:$R[500]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzM5ODM5NjM1NDU2",result:$R[501]={__typename:"NoteTweet",entity_set:$R[502]={hashtags:$R[503]=[],symbols:$R[504]=[],urls:$R[505]=[],user_mentions:$R[506]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3Mzk4Mzk2MzU0NTY=",rest_id:"1895505739839635456",text:"5、项目方通常会通过技术手段识别女巫攻击，在不被识别为“女巫攻击”的情况下，您如何合理使用多账号策略？怎么理解“精品账号”？\n\n丰密：这个问题好，时间关系我尽量说的全一点，\n\n先说几个概念的东西，\n\n1、先说女巫攻击是什么：一个人或团队创建大量账号，以操纵网络、协议资源分配的虚假行为，典型的批量化操作，程序化操作，机器人操作····\n\n2、项目方怎么想怎么做的：项目方与生态希望是真实的用户来参与网络，奖励也希望给到真实用户，项目方会使用链上数据分析、地址关联、行为模式检测等技术手段来识别，比较典型的是nansen的AI聚类分析。\n\n3、女巫的本质： 并不是用多个账号就一定是女巫，而是批量生成无贡献的垃圾账号，滥用规则获取空投的才是女巫。项目方查女巫的核心是“去脚本化、去批量化”\n\n4、回答你的问题：如何合理使用多账号策略？\n\n我的观点是：做“精品账号”，精品账号的意思是每个账号都有“独立的 + 真实的”。我过去曾经经常跟亏友分享：精品帐号就是印钞机！前段时间的pengu，过去的tia很多这样的经典案例，一个地址500-2000美金不等。\n\n精品账号意思是高质量帐号，每个号具备真实用户的链上记录、独立行为、合理的链上资产分布。多帐号本身也是风险分散原则，多账号 ≠ 女巫，\n\n用多号策略无非是概数法则，广覆盖原则，堆一个号的收益可能没有多号收益的赔率高。\n\n具体的做法：\n\n起号阶段-基本原则：\n\n✅ 1. 资金流转合理，起号的时间开始就尽量实现差异化。包括资金来源。\n✅ 2. 资金流转合理，避免集中出入金\n✅ 3. 交互时间、金额随机化，不机械操作，\n✅ 4. 多链布局，真实用户痕迹让账号更自然。\n\n养号交互阶段：\n\n✅ 1.不批量操作，每个账号有独立行为\n✅ 2. 交互时间、避免流水线式操作，比如交互时随机化金额、交易顺序、组合多类协议\n✅ 3. 多链布局，让账号更自然，交互路径尽量独立\n✅ 4.做高质量用户画像与行为，持有不同资产，增加账号权重\n✅ 5.参与真实活动，增加账号权重。如 DAO 投票、NFT Mint、DeFi Staking，\n✅ 6.组合交互，嵌入式交互，结合defi策略，Gas消耗在刀刃上。"}}},reply_to_results:$R[507]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3MzUxNzk2OTgyNTI=",rest_id:"1895505735179698252"},reply_to_user_results:$R[508]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[509]={__typename:"User",core:$R[510]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505739977994702",url_entities:$R[511]=[],views:$R[512]={count:"5188"}}}}}},$R[513]={entry_id:"conversationthread-1895505722563268919-tweet-1895505743664845095",item:$R[514]={__typename:"TimelineTimelineItem",client_event_info:$R[515]={component:"tweet",details:$R[516]={conversation_details:$R[517]={conversation_section:"HighQuality"},timelines_details:$R[518]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[519]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[520]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NDM2NjQ4NDUwOTU=",rest_id:"1895505743664845095",result:$R[521]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[522]=[],core:$R[523]={user_results:$R[524]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[525]={__typename:"User",avatar:$R[526]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[527]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[528]={},privacy:$R[529]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[530]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[531]={tweets:9451},verification:$R[532]={is_blue_verified:!0}}}},counts:$R[533]={bookmark_count:3,favorite_count:5,quote_count:0,reply_count:1,retweet_count:0},details:$R[534]={cashtag_entities:$R[535]=[],created_at_ms:1740758760000,display_text_range:$R[536]=[0,18],full_text:"6、怎么理解“精品账号”？\n\n丰密：",hashtag_entities:$R[537]=[],smarttags:$R[538]=[],timestamp_entities:$R[539]=[]},edit_control:$R[540]={__typename:"EditControlInitial",edit_tweet_ids:$R[541]=["1895505743664845095"]},grok_translated_post_with_availability:$R[542]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc0MzY2NDg0NTA5NQ==",legacy:$R[543]={lang:"zh"},media_entities2:$R[544]=[],mention_entities:$R[545]=[],note_tweet:$R[546]={is_expandable:!0,note_tweet_results:$R[547]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzQzNTk3NzY0NjA4",result:$R[548]={__typename:"NoteTweet",entity_set:$R[549]={hashtags:$R[550]=[],symbols:$R[551]=[],urls:$R[552]=[],user_mentions:$R[553]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NDM1OTc3NjQ2MDg=",rest_id:"1895505743597764608",text:"6、怎么理解“精品账号”？\n\n丰密：\n精品账号意思是高质量帐号，每个号具备真实用户的链上记录、独立行为、合理的链上资产分布，当然每个人对精品帐号的理解不一，项目方分发给奖励的地址也希望是真实且高质量，有些是给自己项目的权益型NFT，也有关注链上交互画像，那么关注的点，很多会是资金，活跃度，多样性，链上身份，忠诚度，主网数据（gas消耗，时间，tx，活跃时间），持仓NFT等。怎么真实怎么来。\n\n概括关注点：钱包历史、交互行为、资金流动、资产持有（token nft）、余额留存，多链活跃、部分社交绑定······"}}},reply_to_results:$R[554]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Mzk5Nzc5OTQ3MDI=",rest_id:"1895505739977994702"},reply_to_user_results:$R[555]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[556]={__typename:"User",core:$R[557]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505743664845095",url_entities:$R[558]=[],views:$R[559]={count:"4960"}}}}}},$R[560]={entry_id:"conversationthread-1895505722563268919-tweet-1895505748857401386",item:$R[561]={__typename:"TimelineTimelineItem",client_event_info:$R[562]={component:"tweet",details:$R[563]={conversation_details:$R[564]={conversation_section:"HighQuality"},timelines_details:$R[565]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[566]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[567]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NDg4NTc0MDEzODY=",rest_id:"1895505748857401386",result:$R[568]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[569]=[],core:$R[570]={user_results:$R[571]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[572]={__typename:"User",avatar:$R[573]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[574]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[575]={},privacy:$R[576]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[577]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[578]={tweets:9451},verification:$R[579]={is_blue_verified:!0}}}},counts:$R[580]={bookmark_count:5,favorite_count:4,quote_count:0,reply_count:1,retweet_count:0},details:$R[581]={cashtag_entities:$R[582]=[],created_at_ms:1740758761000,display_text_range:$R[583]=[0,140],full_text:"7、如何控制撸毛的成本？ 在高Gas费的链上（如以太坊），你有哪些优化交互策略的建议？\n\n丰密：\n1、我个人不用很多人提及的IP，ADS，等各类程序话的东西，主要是我不会，我更多专注在帐号本身的亏gas所形成的链上画像。\n\n2、我自己交互帐号的成本就是：资金成本，还有gas成本。",hashtag_entities:$R[584]=[],smarttags:$R[585]=[],timestamp_entities:$R[586]=[]},edit_control:$R[587]={__typename:"EditControlInitial",edit_tweet_ids:$R[588]=["1895505748857401386"]},grok_translated_post_with_availability:$R[589]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc0ODg1NzQwMTM4Ng==",legacy:$R[590]={lang:"zh"},media_entities2:$R[591]=[],mention_entities:$R[592]=[],note_tweet:$R[593]={is_expandable:!0,note_tweet_results:$R[594]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzQ4NzYwODcwOTEy",result:$R[595]={__typename:"NoteTweet",entity_set:$R[596]={hashtags:$R[597]=[],symbols:$R[598]=[],urls:$R[599]=[],user_mentions:$R[600]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NDg3NjA4NzA5MTI=",rest_id:"1895505748760870912",text:"7、如何控制撸毛的成本？ 在高Gas费的链上（如以太坊），你有哪些优化交互策略的建议？\n\n丰密：\n1、我个人不用很多人提及的IP，ADS，等各类程序话的东西，主要是我不会，我更多专注在帐号本身的亏gas所形成的链上画像。\n\n2、我自己交互帐号的成本就是：资金成本，还有gas成本。\n\n3、所以我关心的核心要点是Gas消耗在哪里，要么增加权重，要么增加链上画像。这2点是最核心的能狙击项目方的空投视角范围。\n\n4、具体的策略上，是尽可能通过defi，或套利，或交易，或mint或项目的权重tx上。尽可能收回kui掉的gas成本，同时完善提高帐号画像。这具有非常大的反身性，得先学会亏钱，亏gas。\n\n5、你说的高Gas费的链上（如以太坊），你有哪些优化交互策略的建议？这里视情况而定，在过去几年只有第一年gas费很贵，之后的gas费都很低。比如现在gas1，无人问津，就是打磨新号的好时机。可以结合具体项目来顺便交互主网数据。"}}},reply_to_results:$R[601]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NDM2NjQ4NDUwOTU=",rest_id:"1895505743664845095"},reply_to_user_results:$R[602]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[603]={__typename:"User",core:$R[604]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505748857401386",url_entities:$R[605]=[],views:$R[606]={count:"5313"}}}}}},$R[607]={entry_id:"conversationthread-1895505722563268919-tweet-1895505755182412115",item:$R[608]={__typename:"TimelineTimelineItem",client_event_info:$R[609]={component:"tweet",details:$R[610]={conversation_details:$R[611]={conversation_section:"HighQuality"},timelines_details:$R[612]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[613]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[614]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NTUxODI0MTIxMTU=",rest_id:"1895505755182412115",result:$R[615]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[616]=[],core:$R[617]={user_results:$R[618]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[619]={__typename:"User",avatar:$R[620]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[621]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[622]={},privacy:$R[623]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[624]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[625]={tweets:9451},verification:$R[626]={is_blue_verified:!0}}}},counts:$R[627]={bookmark_count:5,favorite_count:4,quote_count:0,reply_count:1,retweet_count:0},details:$R[628]={cashtag_entities:$R[629]=[],created_at_ms:1740758763000,display_text_range:$R[630]=[0,143],full_text:"8、不同的项目对交互的要求不同，你如何根据项目的特点调整策略？\n\n丰密：\n不同的项目对空投交互的要求各不相同，盲目参考教程的意义现阶段已经不是很大，大家都希望能做到精准交互 + 最小成本 + 最高收益，这个是非常非常难得，这种不确定性与反身性需要长期践行，跟踪。也是这个赛道最难的地方。",hashtag_entities:$R[631]=[],smarttags:$R[632]=[],timestamp_entities:$R[633]=[]},edit_control:$R[634]={__typename:"EditControlInitial",edit_tweet_ids:$R[635]=["1895505755182412115"]},grok_translated_post_with_availability:$R[636]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc1NTE4MjQxMjExNQ==",legacy:$R[637]={lang:"zh"},media_entities2:$R[638]=[],mention_entities:$R[639]=[],note_tweet:$R[640]={is_expandable:!0,note_tweet_results:$R[641]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzU1MDkwMTQ5Mzc4",result:$R[642]={__typename:"NoteTweet",entity_set:$R[643]={hashtags:$R[644]=[],symbols:$R[645]=[],urls:$R[646]=[],user_mentions:$R[647]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NTUwOTAxNDkzNzg=",rest_id:"1895505755090149378",text:"8、不同的项目对交互的要求不同，你如何根据项目的特点调整策略？\n\n丰密：\n不同的项目对空投交互的要求各不相同，盲目参考教程的意义现阶段已经不是很大，大家都希望能做到精准交互 + 最小成本 + 最高收益，这个是非常非常难得，这种不确定性与反身性需要长期践行，跟踪。也是这个赛道最难的地方。\n\n我简单说说\n\n1、我的策略一直是精品帐号+权重交互+计算高 投入产出比+控制风险。用高质量帐号狙击高质量协议的策略来组合交易协议。不同的项目有不同的空投分配逻辑，不能一刀切地批量操作，而要针对性布局。我的经验撸毛不是单纯的“量大取胜”，而是找到符合项目预期的正确交互策略，并且符合自己性格的项目，\n\n2、举个例子\n\n比如 L1 / L2 ，得兼顾TVL，真实，优选原生DApp，多样性组合。真实视角玩转生态。\n\nDeFi协议，项目方视角是重点考虑深度用户，优先奖励长期提供流动性和交易的用户，比如存款时常，金额，LP等。根据单个协议的链上数据具体分析。\n\n跨链桥，质押类也是根据协议背景来看，质押类的可能会着重看协议的tge时间，安全性，赛道位置，投入产出比。\nEigenLayer与Babylon案例。\n另外，交互也能增加帐号的质量与权重。这里我可以阐述下我参与W虫洞的逻辑，单号1万美金以上的收益，时间关系如果大家想听我就讲讲········此处我讲了但不想写了\n\n社区型项目：鼓励做贡献，且项目有 NFT 相关玩法，可以着重看生态NFT，持有 权益型OG NFT\n\n“撸得精”比“撸得多”更重要，尤其是当前市场越来越重视真实用户，所以精准交互、合理分配资金、长线布局养号是当下的重点，当下空投赛道，拼的不是钱包数量，而是对项目的研究，对规则的理解和执行力！"}}},reply_to_results:$R[648]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NDg4NTc0MDEzODY=",rest_id:"1895505748857401386"},reply_to_user_results:$R[649]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[650]={__typename:"User",core:$R[651]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505755182412115",url_entities:$R[652]=[],views:$R[653]={count:"4633"}}}}}},$R[654]={entry_id:"conversationthread-1895505722563268919-tweet-1895505758940446904",item:$R[655]={__typename:"TimelineTimelineItem",client_event_info:$R[656]={component:"tweet",details:$R[657]={conversation_details:$R[658]={conversation_section:"HighQuality"},timelines_details:$R[659]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[660]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[661]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NTg5NDA0NDY5MDQ=",rest_id:"1895505758940446904",result:$R[662]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[663]=[],core:$R[664]={user_results:$R[665]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[666]={__typename:"User",avatar:$R[667]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[668]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[669]={},privacy:$R[670]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[671]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[672]={tweets:9451},verification:$R[673]={is_blue_verified:!0}}}},counts:$R[674]={bookmark_count:1,favorite_count:3,quote_count:0,reply_count:1,retweet_count:0},details:$R[675]={cashtag_entities:$R[676]=[],created_at_ms:1740758764000,display_text_range:$R[677]=[0,35],full_text:"9、很多项目空投之后，大家会选择抛售所获得的代币，您如何判断出售时机？",hashtag_entities:$R[678]=[],smarttags:$R[679]=[],timestamp_entities:$R[680]=[]},edit_control:$R[681]={__typename:"EditControlInitial",edit_tweet_ids:$R[682]=["1895505758940446904"]},grok_translated_post_with_availability:$R[683]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc1ODk0MDQ0NjkwNA==",legacy:$R[684]={lang:"zh"},media_entities2:$R[685]=[],mention_entities:$R[686]=[],note_tweet:$R[687]={is_expandable:!0,note_tweet_results:$R[688]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzU4ODYwNzg3NzEz",result:$R[689]={__typename:"NoteTweet",entity_set:$R[690]={hashtags:$R[691]=[],symbols:$R[692]=[],urls:$R[693]=[],user_mentions:$R[694]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NTg4NjA3ODc3MTM=",rest_id:"1895505758860787713",text:"9、很多项目空投之后，大家会选择抛售所获得的代币，您如何判断出售时机？\n\n丰密：这一点我做的不好，现在满手的山寨币，我就是那个典型的会撸不会卖的代表，我觉得原因也很多，一方面是市场发生了转变，上个周期holder就暴富，这一轮是hold就亏麻。我之前的OP，ARB都拿了超过1年时间。还有一些项目拿到之后去质押，跌掉90%，大毛变小毛的也很多，有些项目空投，我目前是真的没卖，比如EigenLayer。如果实在碰到跌的很惨的项目，我就装死等归零，按照上线价格列入成本价，计提损失。\n我一直以来是不追求绝对值，追求相对值的心态。\n\n我是吃了很多亏之后，根据我个人的情况，现阶段拿到空投之后，会大概卖1/3，后续根据项目与市场情况判断，大部分撸到的项目都是vc币，我关注的点主要是项目最后一轮的估值，以及上线市值，解锁情况，最重要的是市场情况。\n\n我们这类人其实不能作为参考，主要是撸空投能撸出感情，舍不得卖是核心原因！"}}},reply_to_results:$R[695]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NTUxODI0MTIxMTU=",rest_id:"1895505755182412115"},reply_to_user_results:$R[696]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[697]={__typename:"User",core:$R[698]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505758940446904",url_entities:$R[699]=[],views:$R[700]={count:"4225"}}}}}},$R[701]={entry_id:"conversationthread-1895505722563268919-tweet-1895505763583598665",item:$R[702]={__typename:"TimelineTimelineItem",client_event_info:$R[703]={component:"tweet",details:$R[704]={conversation_details:$R[705]={conversation_section:"HighQuality"},timelines_details:$R[706]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[707]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[708]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NjM1ODM1OTg2NjU=",rest_id:"1895505763583598665",result:$R[709]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[710]=[],core:$R[711]={user_results:$R[712]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[713]={__typename:"User",avatar:$R[714]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[715]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[716]={},privacy:$R[717]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[718]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[719]={tweets:9451},verification:$R[720]={is_blue_verified:!0}}}},counts:$R[721]={bookmark_count:2,favorite_count:1,quote_count:0,reply_count:1,retweet_count:0},details:$R[722]={cashtag_entities:$R[723]=[],created_at_ms:1740758765000,display_text_range:$R[724]=[0,109],full_text:"10、空投的未来，您如何看待Pump等meme发射平台的出现，这会对撸毛产生什么样的影响？空投的未来\n\n丰密：\nPump.这类 Meme 发射平台，降低了代币发行门槛，任何人都可以在采用一键发币模式几秒内发币，自动创建",hashtag_entities:$R[725]=[],smarttags:$R[726]=[],timestamp_entities:$R[727]=[]},edit_control:$R[728]={__typename:"EditControlInitial",edit_tweet_ids:$R[729]=["1895505763583598665"]},grok_translated_post_with_availability:$R[730]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc2MzU4MzU5ODY2NQ==",legacy:$R[731]={lang:"zh"},media_entities2:$R[732]=[],mention_entities:$R[733]=[],note_tweet:$R[734]={is_expandable:!0,note_tweet_results:$R[735]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzYzNDQwOTQzMTA0",result:$R[736]={__typename:"NoteTweet",entity_set:$R[737]={hashtags:$R[738]=[],symbols:$R[739]=[],urls:$R[740]=[],user_mentions:$R[741]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NjM0NDA5NDMxMDQ=",rest_id:"1895505763440943104",text:"10、空投的未来，您如何看待Pump等meme发射平台的出现，这会对撸毛产生什么样的影响？空投的未来\n\n丰密：\nPump.这类 Meme 发射平台，降低了代币发行门槛，任何人都可以在采用一键发币模式几秒内发币，自动创建 LP，实际上这是一种新的、极端自由的资产发行模式的演化。它的出现相当于从早期的ico，ieo模式转到空投模式，演变到现在的自发行模式。它降低了发币门槛，同时也改变了 Web3 参与者（特别是撸毛者） 的心态和策略，\n\n1️⃣对项目分发代币的影响\n\n这种自由的资产发行模式，降低了代币发行门槛，一键发币 + 自动创建 LP，无需技术、无需融资，直接进入市场，这种新模式不仅影响了 Meme 赛道，也对传统 Web3 项目分发代币的方式带来改变，很多项目会选择先不上交易所，直接在DEX上线。项目方不再需要依赖传统融资或代币锁仓，而是直接让市场决定代币的价值。\n\n2️⃣对撸Sir产生的影响\n\n1、影响 1-心态：撸毛周期被极度缩短，对人性的是个巨大的考验，投机心态加重，以前撸空投，大家习惯于 3-24 个月的交互 ， 长期等待 TGE。现在 Pump 的 Meme 币，几分钟内就能拉升百倍，也可能几分钟归零，反观撸毛的时间，收益不确定，反撸等各种特点，相比meme毫无爽点。\n\n2、影响2-利益：撸Sir的“信仰体系”崩塌，投机玩法被无限放大，过去撸空投，讲究的是交互深度、链上贡献、技术特点及价值，撸Sir希望项目方长期发展。在 Meme 模式下，代币的核心驱动力是“情绪 + 叙事 + 资金 FOMO”，很多撸毛者不再撸空投，而是转向meme，不再关心项目本身，只在乎短线波动，因为更爽，更快，更具财富效应。都希望是版本之子。\n\n3、影响3-赌性，撸Sir心态更加 FOMO，容易陷入赌性，传统撸毛讲究稳扎稳打，但 Meme 生态让市场进入极端投机模式，赌性越来越重。"}}},reply_to_results:$R[742]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NTg5NDA0NDY5MDQ=",rest_id:"1895505758940446904"},reply_to_user_results:$R[743]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[744]={__typename:"User",core:$R[745]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505763583598665",url_entities:$R[746]=[],views:$R[747]={count:"4435"}}}}}},$R[748]={entry_id:"conversationthread-1895505722563268919-tweet-1895505766938992879",item:$R[749]={__typename:"TimelineTimelineItem",client_event_info:$R[750]={component:"tweet",details:$R[751]={conversation_details:$R[752]={conversation_section:"HighQuality"},timelines_details:$R[753]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[754]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[755]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NjY5Mzg5OTI4Nzk=",rest_id:"1895505766938992879",result:$R[756]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[757]=[],core:$R[758]={user_results:$R[759]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[760]={__typename:"User",avatar:$R[761]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[762]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[763]={},privacy:$R[764]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[765]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[766]={tweets:9451},verification:$R[767]={is_blue_verified:!0}}}},counts:$R[768]={bookmark_count:4,favorite_count:7,quote_count:0,reply_count:1,retweet_count:0},details:$R[769]={cashtag_entities:$R[770]=[],created_at_ms:1740758766000,display_text_range:$R[771]=[0,136],full_text:"11、未来撸毛的演变趋势：多号亏 Gas 还有机会吗？\n\n丰密：我认为有，不多号永远不可能发财，不可能有超额收益。\n但是需要平衡个人资金以及帐号资金流转与分配。多号亏 Gas可以，但是不要烧gas。这里是有区分的，未来撸毛的核心是 “精品号”，真实交互 + 资金流自然 +",hashtag_entities:$R[772]=[],smarttags:$R[773]=[],timestamp_entities:$R[774]=[]},edit_control:$R[775]={__typename:"EditControlInitial",edit_tweet_ids:$R[776]=["1895505766938992879"]},grok_translated_post_with_availability:$R[777]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc2NjkzODk5Mjg3OQ==",legacy:$R[778]={lang:"zh"},media_entities2:$R[779]=[],mention_entities:$R[780]=[],note_tweet:$R[781]={is_expandable:!0,note_tweet_results:$R[782]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzY2ODc2MTE0OTQ0",result:$R[783]={__typename:"NoteTweet",entity_set:$R[784]={hashtags:$R[785]=[],symbols:$R[786]=[],urls:$R[787]=[],user_mentions:$R[788]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NjY4NzYxMTQ5NDQ=",rest_id:"1895505766876114944",text:"11、未来撸毛的演变趋势：多号亏 Gas 还有机会吗？\n\n丰密：我认为有，不多号永远不可能发财，不可能有超额收益。\n但是需要平衡个人资金以及帐号资金流转与分配。多号亏 Gas可以，但是不要烧gas。这里是有区分的，未来撸毛的核心是 “精品号”，真实交互 + 资金流自然 + 长期活跃是最优策略，撸毛不再只是“堆量”，而是考验“策略+执行+信息差”！执行能力强的依然可以堆精品号，堆更多的精品号。"}}},reply_to_results:$R[789]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NjM1ODM1OTg2NjU=",rest_id:"1895505763583598665"},reply_to_user_results:$R[790]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[791]={__typename:"User",core:$R[792]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505766938992879",url_entities:$R[793]=[],views:$R[794]={count:"4275"}}}}}},$R[795]={entry_id:"conversationthread-1895505722563268919-tweet-1895505769870868890",item:$R[796]={__typename:"TimelineTimelineItem",client_event_info:$R[797]={component:"tweet",details:$R[798]={conversation_details:$R[799]={conversation_section:"HighQuality"},timelines_details:$R[800]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[801]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[802]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Njk4NzA4Njg4OTA=",rest_id:"1895505769870868890",result:$R[803]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[804]=[],core:$R[805]={user_results:$R[806]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[807]={__typename:"User",avatar:$R[808]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[809]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[810]={},privacy:$R[811]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[812]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[813]={tweets:9451},verification:$R[814]={is_blue_verified:!0}}}},counts:$R[815]={bookmark_count:5,favorite_count:1,quote_count:0,reply_count:1,retweet_count:0},details:$R[816]={cashtag_entities:$R[817]=[],created_at_ms:1740758766000,display_text_range:$R[818]=[0,105],full_text:"12、对于有些项目既烧 Gas 又需要社交账号做任务，该如何处理？\n\n丰密：\n一部分的项目在设计活动的时候是双重筛选机制，既要链上交互（Kui Gas），又要社交互动（Twitter、Discord、Galxe",hashtag_entities:$R[819]=[],smarttags:$R[820]=[],timestamp_entities:$R[821]=[]},edit_control:$R[822]={__typename:"EditControlInitial",edit_tweet_ids:$R[823]=["1895505769870868890"]},grok_translated_post_with_availability:$R[824]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc2OTg3MDg2ODg5MA==",legacy:$R[825]={lang:"zh"},media_entities2:$R[826]=[],mention_entities:$R[827]=[],note_tweet:$R[828]={is_expandable:!0,note_tweet_results:$R[829]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzY5NzkxMTIzNDU3",result:$R[830]={__typename:"NoteTweet",entity_set:$R[831]={hashtags:$R[832]=[],symbols:$R[833]=[],urls:$R[834]=[],user_mentions:$R[835]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3Njk3OTExMjM0NTc=",rest_id:"1895505769791123457",text:"12、对于有些项目既烧 Gas 又需要社交账号做任务，该如何处理？\n\n丰密：\n一部分的项目在设计活动的时候是双重筛选机制，既要链上交互（Kui Gas），又要社交互动（Twitter、Discord、Galxe 任务等），这种模式对亏友提出了更高要求，如果处理不好，可能会投入过多成本，时间，最终收益不匹配，就骂，我的建议与策略是\n\n1、 先判断项目是否值得“又KuiGas又社交”，在这之前要有自己的逻辑判断与思考，同时看项目是否符合自己的性格，制定差异性化的交互策略。\n\n2、这里区分工作室还是个人，这里的策略应该不一致，作为超级个体，我个人有养一批3件套，都是早期海外手机一个个注册，都是长期养下来的帐号，在我个人的能力范围以内，分电脑养护，这里养3件套更多看你的行为，偶尔需要差异性活跃下，3件套也会查关联性，活跃度等帐号质量，时间关系不多说，反正这是基建，得有，但无需求多。\n\n3、对应的1精品号，可以配置3件套，做个人力所能及的帐号数量。比如100个。\n\n4、更多专注链上画像与高质量tx，大量无效的web3交互任务无意义的放弃，这里对项目方设计的活动判断是个重点。"}}},reply_to_results:$R[836]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NjY5Mzg5OTI4Nzk=",rest_id:"1895505766938992879"},reply_to_user_results:$R[837]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[838]={__typename:"User",core:$R[839]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505769870868890",url_entities:$R[840]=[],views:$R[841]={count:"4150"}}}}}},$R[842]={entry_id:"conversationthread-1895505722563268919-tweet-1895505772370706757",item:$R[843]={__typename:"TimelineTimelineItem",client_event_info:$R[844]={component:"tweet",details:$R[845]={conversation_details:$R[846]={conversation_section:"HighQuality"},timelines_details:$R[847]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[848]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[849]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NzIzNzA3MDY3NTc=",rest_id:"1895505772370706757",result:$R[850]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[851]=[],core:$R[852]={user_results:$R[853]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[854]={__typename:"User",avatar:$R[855]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[856]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[857]={},privacy:$R[858]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[859]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[860]={tweets:9451},verification:$R[861]={is_blue_verified:!0}}}},counts:$R[862]={bookmark_count:4,favorite_count:2,quote_count:0,reply_count:2,retweet_count:0},details:$R[863]={cashtag_entities:$R[864]=[],created_at_ms:1740758767000,display_text_range:$R[865]=[0,105],full_text:"13、TX是否会有用，交易量在撸毛中的作用，是否还有效？\n\n丰密：\n随着项目方的筛选标准和反女巫机制不断升级，这种简单粗暴的核算方法已经不再是最佳策略，现在撸毛更强调“交互质量 + 交易真实性”，\n 但是，TX",hashtag_entities:$R[866]=[],smarttags:$R[867]=[],timestamp_entities:$R[868]=[]},edit_control:$R[869]={__typename:"EditControlInitial",edit_tweet_ids:$R[870]=["1895505772370706757"]},grok_translated_post_with_availability:$R[871]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc3MjM3MDcwNjc1Nw==",legacy:$R[872]={lang:"zh"},media_entities2:$R[873]=[],mention_entities:$R[874]=[],note_tweet:$R[875]={is_expandable:!0,note_tweet_results:$R[876]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzcyMzA3NzA5OTUy",result:$R[877]={__typename:"NoteTweet",entity_set:$R[878]={hashtags:$R[879]=[],symbols:$R[880]=[],urls:$R[881]=[],user_mentions:$R[882]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NzIzMDc3MDk5NTI=",rest_id:"1895505772307709952",text:"13、TX是否会有用，交易量在撸毛中的作用，是否还有效？\n\n丰密：\n随着项目方的筛选标准和反女巫机制不断升级，这种简单粗暴的核算方法已经不再是最佳策略，现在撸毛更强调“交互质量 + 交易真实性”，\n 但是，TX 和交易量需要结合“交互深度”，打个不恰当的比方，你以前去银行多几次，银行的行长都可能认识你，偶尔还能请你喝杯咖啡，现阶段是你光存款也不一定有用，你得是VIP，得是长期购买他们理财及推销的银保产品客户。\n\n我不知道这样表达能否理解我表达的意思！"}}},reply_to_results:$R[883]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Njk4NzA4Njg4OTA=",rest_id:"1895505769870868890"},reply_to_user_results:$R[884]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[885]={__typename:"User",core:$R[886]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505772370706757",url_entities:$R[887]=[],views:$R[888]={count:"3950"}}}}}},$R[889]={entry_id:"conversationthread-1895505722563268919-tweet-1895505775193460838",item:$R[890]={__typename:"TimelineTimelineItem",client_event_info:$R[891]={component:"tweet",details:$R[892]={conversation_details:$R[893]={conversation_section:"HighQuality"},timelines_details:$R[894]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[895]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[896]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NzUxOTM0NjA4Mzg=",rest_id:"1895505775193460838",result:$R[897]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[898]=[],core:$R[899]={user_results:$R[900]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[901]={__typename:"User",avatar:$R[902]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[903]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[904]={},privacy:$R[905]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[906]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[907]={tweets:9451},verification:$R[908]={is_blue_verified:!0}}}},counts:$R[909]={bookmark_count:1,favorite_count:0,quote_count:0,reply_count:1,retweet_count:0},details:$R[910]={cashtag_entities:$R[911]=[],created_at_ms:1740758768000,display_text_range:$R[912]=[0,111],full_text:"14、未来什么样创新的空投设计，对于社区、项目方，以至于整个生态都能共赢？\n\n丰密：这个话题有点大，有点宽，如何分发号空投对项目方来说做好了是门艺术，搞砸了就是卖拐。\n\n简单说说我的理解：\n\n1、空投已经被证实是 Web3",hashtag_entities:$R[913]=[],smarttags:$R[914]=[],timestamp_entities:$R[915]=[]},edit_control:$R[916]={__typename:"EditControlInitial",edit_tweet_ids:$R[917]=["1895505775193460838"]},grok_translated_post_with_availability:$R[918]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc3NTE5MzQ2MDgzOA==",legacy:$R[919]={lang:"zh"},media_entities2:$R[920]=[],mention_entities:$R[921]=[],note_tweet:$R[922]={is_expandable:!0,note_tweet_results:$R[923]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1Nzc1MTAxMTUzMjgw",result:$R[924]={__typename:"NoteTweet",entity_set:$R[925]={hashtags:$R[926]=[],symbols:$R[927]=[],urls:$R[928]=[],user_mentions:$R[929]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3NzUxMDExNTMyODA=",rest_id:"1895505775101153280",text:"14、未来什么样创新的空投设计，对于社区、项目方，以至于整个生态都能共赢？\n\n丰密：这个话题有点大，有点宽，如何分发号空投对项目方来说做好了是门艺术，搞砸了就是卖拐。\n\n简单说说我的理解：\n\n1、空投已经被证实是 Web3 项目早期增长和用户获取的重要方式，但传统的空投模式确实存在大量问题，导致项目掏出大量代币，却未能真正吸引长期用户，低质量用户”占比过高，代币经济模型受损····\n\n2、好的空投是吸引新用户，奖励早期用户、留住更多用户来设计的，同时围绕项目及生态的经济飞轮做增长。更创新、更公平、更可持续的空投设计，应该实现项目方、社区用户、生态系统的“3赢”\n\n未来的空投模式及方式必须具备以下核心原则：\n\n1- 长期激励机制（避免短期抛售，鼓励用户持续交互，长期贡献）\n\n2- 结合链上数据、链下社区贡献，筛选真实用户，实在的贡献用户\n\n3-3方利益一致（用户增长 = 生态增长）\n\n4-公开透明（说清楚每一项规则及缘由），别老鼠仓\n\n具体方法多样，可以随便举个列子，\n\n“逐步释放”机制，参考OP的空投，连续多轮空投，大而全且持续性奖励长期贡献，再次基础上可以叠加更多元素，空投策略与设计更完善。\n没有完美的方案，只能尽可能的照顾中小散户，以及更多的真实用户。"}}},reply_to_results:$R[930]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NzIzNzA3MDY3NTc=",rest_id:"1895505772370706757"},reply_to_user_results:$R[931]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[932]={__typename:"User",core:$R[933]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505775193460838",url_entities:$R[934]=[],views:$R[935]={count:"4130"}}}}}},$R[936]={entry_id:"conversationthread-1895505722563268919-tweet-1895505777907110311",item:$R[937]={__typename:"TimelineTimelineItem",client_event_info:$R[938]={component:"tweet",details:$R[939]={conversation_details:$R[940]={conversation_section:"HighQuality"},timelines_details:$R[941]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[942]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[943]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3Nzc5MDcxMTAzMTE=",rest_id:"1895505777907110311",result:$R[944]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[945]=[],core:$R[946]={user_results:$R[947]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[948]={__typename:"User",avatar:$R[949]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[950]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[951]={},privacy:$R[952]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[953]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[954]={tweets:9451},verification:$R[955]={is_blue_verified:!0}}}},counts:$R[956]={bookmark_count:10,favorite_count:7,quote_count:0,reply_count:1,retweet_count:1},details:$R[957]={cashtag_entities:$R[958]=[],created_at_ms:1740758768000,display_text_range:$R[959]=[0,114],full_text:"15、对新手的建议：如何从零开始撸毛，对于刚开始撸毛的新手，资金量很少，可能就几百U，应该如何入手？\n\n丰密：\n撸毛是一种低成本进入Web3 并能赚些的的路径与策略，但并不是简单的免费送钱游戏，应该是一个认知、策略、执行力的组合",hashtag_entities:$R[960]=[],smarttags:$R[961]=[],timestamp_entities:$R[962]=[]},edit_control:$R[963]={__typename:"EditControlInitial",edit_tweet_ids:$R[964]=["1895505777907110311"]},grok_translated_post_with_availability:$R[965]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc3NzkwNzExMDMxMQ==",legacy:$R[966]={lang:"zh"},media_entities2:$R[967]=[],mention_entities:$R[968]=[],note_tweet:$R[969]={is_expandable:!0,note_tweet_results:$R[970]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1Nzc3ODAyMzAxNDQw",result:$R[971]={__typename:"NoteTweet",entity_set:$R[972]={hashtags:$R[973]=[],symbols:$R[974]=[],urls:$R[975]=[],user_mentions:$R[976]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3Nzc4MDIzMDE0NDA=",rest_id:"1895505777802301440",text:"15、对新手的建议：如何从零开始撸毛，对于刚开始撸毛的新手，资金量很少，可能就几百U，应该如何入手？\n\n丰密：\n撸毛是一种低成本进入Web3 并能赚些的的路径与策略，但并不是简单的免费送钱游戏，应该是一个认知、策略、执行力的组合\n\n不同人在不同的阶段的交互策略与打法是不一样的，并且有技术背景与非技术背景都有区别，针对刚开始的且不会技术的新人，我的建议\n\n1、道方面（理念层面）：正确认知\n\n学习：了解行业赚钱的一些方式，空投方面的模式，学着探索生态及协议，前期看哪些点有适合自己的项目\n原则：有自己的项目判断后，明确不是所有项目都值得撸，撸之前要有选择标准，撸毛的本质是”低成本投资”，时间、Gas 费、机会成本都是你的“投入”，不Fomo。\n\n方向：选择正确的赛道，方向比努力更重要，撸毛要选未来确定性强、资金量大、可能有长期激励的赛道，\n\n投研：建立项目库，学会看项目，跟进项目，算ROI，看风险点，赔率点，权重点等。\n\n2、术方（执行层面）：具体方法\n\n学会正确交互：比如如何swap，桥资金，如何找token，如何用3件套完成项目任务等，核心是提高交互技能。\n\n提高帐号权重：学会做深度交互，成为生态协议的活跃真实高质量用户。\n\n控制成本：撸毛的姿势很多，不仅仅是kuigas，质押，市场上也有非常优质的测试网项目，\n\n多角度参与：比如用户视角是深度参与生态，创作者视角是帮助项目写内容，等等。\n\n总结：以慢至快，以少胜多。"}}},reply_to_results:$R[977]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3NzUxOTM0NjA4Mzg=",rest_id:"1895505775193460838"},reply_to_user_results:$R[978]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[979]={__typename:"User",core:$R[980]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505777907110311",url_entities:$R[981]=[],views:$R[982]={count:"3856"}}}}}},$R[983]={entry_id:"conversationthread-1895505722563268919-tweet-1895505780243317197",item:$R[984]={__typename:"TimelineTimelineItem",client_event_info:$R[985]={component:"tweet",details:$R[986]={conversation_details:$R[987]={conversation_section:"HighQuality"},timelines_details:$R[988]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[989]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[990]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3ODAyNDMzMTcxOTc=",rest_id:"1895505780243317197",result:$R[991]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[992]=[],core:$R[993]={user_results:$R[994]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjA