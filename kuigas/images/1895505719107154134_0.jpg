et",entity_set:$R[1060]={hashtags:$R[1061]=[],symbols:$R[1062]=[],urls:$R[1063]=[],user_mentions:$R[1064]=[$R[1065]={id_str:"970928919556706304",indices:$R[1066]=[83,98],screen_name:"RootDataCrypto"}]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3ODY4NzAzODI1OTQ=",rest_id:"1895505786870382594",text:"17、新手应该如何获取优质信息源？你有哪些推荐的信息渠道或工具？\n\n丰密：\n1、比较简单的是跟随优质的KOL，推特，youtube等，\n\n2、可以从rootdata @RootDataCrypto里找项目，找到对应的X帐号及团队成员，以及融资等情况。 \n\n3、学习的话，okx的web3钱包@OKXWeb3_CN里也有很多基础的一些项目任务，可以当练手。"}}},reply_to_results:$R[1067]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3ODAyNDMzMTcxOTc=",rest_id:"1895505780243317197"},reply_to_user_results:$R[1068]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[1069]={__typename:"User",core:$R[1070]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505786933240161",url_entities:$R[1071]=[],views:$R[1072]={count:"4017"}}}}}},$R[1073]={entry_id:"conversationthread-1895505722563268919-tweet-1895505791366664269",item:$R[1074]={__typename:"TimelineTimelineItem",client_event_info:$R[1075]={component:"tweet",details:$R[1076]={conversation_details:$R[1077]={conversation_section:"HighQuality"},timelines_details:$R[1078]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcyr2VAAAAAA=="}},element:"tweet"},content:$R[1079]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[1080]={id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3OTEzNjY2NjQyNjk=",rest_id:"1895505791366664269",result:$R[1081]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[1082]=[],core:$R[1083]={user_results:$R[1084]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[1085]={__typename:"User",avatar:$R[1086]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[1087]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[1088]={},privacy:$R[1089]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[1090]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[1091]={tweets:9451},verification:$R[1092]={is_blue_verified:!0}}}},counts:$R[1093]={bookmark_count:1,favorite_count:0,quote_count:0,reply_count:1,retweet_count:0},details:$R[1094]={cashtag_entities:$R[1095]=[],created_at_ms:1740758772000,display_text_range:$R[1096]=[0,147],full_text:"18、对于OKX的建议，okx在各个生态发展中起到了什么作用和影响力？\n\n丰密：OKX的钱包支持的生态与链特别多，剧我所知目前支持122条链，我个人是在交互钱包中，会把okx作为我的常用钱包，我一般跟小狐狸与okx共用同一套助记词。\n特点：安全 及时 顺滑，太多了，不写了，反正好用。\n\n案例：",hashtag_entities:$R[1097]=[],smarttags:$R[1098]=[],timestamp_entities:$R[1099]=[]},edit_control:$R[1100]={__typename:"EditControlInitial",edit_tweet_ids:$R[1101]=["1895505791366664269"]},grok_translated_post_with_availability:$R[1102]={is_available:!1},id:"VHdlZXQ6MTg5NTUwNTc5MTM2NjY2NDI2OQ==",legacy:$R[1103]={lang:"zh"},media_entities2:$R[1104]=[],mention_entities:$R[1105]=[],note_tweet:$R[1106]={is_expandable:!0,note_tweet_results:$R[1107]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk1NTA1NzkxMzA3OTM1NzQ1",result:$R[1108]={__typename:"NoteTweet",entity_set:$R[1109]={hashtags:$R[1110]=[],symbols:$R[1111]=[],urls:$R[1112]=[],user_mentions:$R[1113]=[]},id:"Tm90ZVR3ZWV0OjE4OTU1MDU3OTEzMDc5MzU3NDU=",rest_id:"1895505791307935745",text:"18、对于OKX的建议，okx在各个生态发展中起到了什么作用和影响力？\n\n丰密：OKX的钱包支持的生态与链特别多，剧我所知目前支持122条链，我个人是在交互钱包中，会把okx作为我的常用钱包，我一般跟小狐狸与okx共用同一套助记词。\n特点：安全 及时 顺滑，太多了，不写了，反正好用。\n\n案例： Movement+okxweb3钱包的支持，这里省略800字。"}}},reply_to_results:$R[1114]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTU1MDU3ODY5MzMyNDAxNjE=",rest_id:"1895505786933240161"},reply_to_user_results:$R[1115]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[1116]={__typename:"User",core:$R[1117]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1895505791366664269"