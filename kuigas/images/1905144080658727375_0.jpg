uiGas 我感觉是18-19年XMEX之类的一币一合约一所盘的升级版，机制什么其实真的都差不多，只是模型更复杂，充分体现出了高学历精英和深圳山大王的表面差异",hashtag_entities:$R[224]=[],smarttags:$R[225]=[],timestamp_entities:$R[226]=[]},edit_control:$R[227]={__typename:"EditControlInitial",edit_tweet_ids:$R[228]=["1905146522427347190"]},grok_translated_post_with_availability:$R[229]={is_available:!1},id:"VHdlZXQ6MTkwNTE0NjUyMjQyNzM0NzE5MA==",legacy:$R[230]={lang:"zh"},media_entities2:$R[231]=[],mention_entities:$R[232]=[$R[233]={id_str:"1372876871990272000",indices:$R[234]=[0,7],screen_name:"KuiGas"}],reply_to_results:$R[235]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MDUxNDQwODA2NTg3MjczNzU=",rest_id:"1905144080658727375"},reply_to_user_results:$R[236]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[237]={__typename:"User",core:$R[238]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1905146522427347190",url_entities:$R[239]=[],views:$R[240]={count:"4289"}}}}}}],metadata:$R[241]={conversation_metadata:$R[242]={all_tweet_ids:$R[243]=["1905146522427347190"],enable_deduplication:!0}}},entry_id:"conversationthread-1905146522427347190",sort_index:"2103762158402666476"},$R[244]={content:$R[245]={__typename:"TimelineTimelineModule",client_event_info:$R[246]={component:"tweet"},display_type:"VerticalConversation",items:$R[247]=[$R[248]={entry_id:"conversationthread-1905163577444442546-tweet-1905163577444442546",item:$R[249]={__typename:"TimelineTimelineItem",client_event_info:$R[250]={component:"tweet",details:$R[251]={conversation_details:$R[252]={conversation_section:"HighQuality"},timelines_details:$R[253]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczykEAAAAAA=="}},element:"tweet"},content:$R[254]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[255]={id:"VHdlZXRSZXN1bHRzOjE5MDUxNjM1Nzc0NDQ0NDI1NDY=",rest_id:"1905163577444442546",result:$R[256]={__isTwe