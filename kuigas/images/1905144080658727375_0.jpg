1905163577444442546"],enable_deduplication:!0}}},entry_id:"conversationthread-1905163577444442546",sort_index:"2103762158402666466"}]},$R[292]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[293]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[294]={id:"VHdlZXRSZXN1bHRzOjE5MDUxNDQwODA2NTg3MjczNzU=",rest_id:"1905144080658727375",result:$R[295]={__typename:"Tweet",core:$R[296]={user_results:$R[297]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[298]={__typename:"User",avatar:$R[299]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[300]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[301]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[302]={favorite_count:153,reply_count:40},details:$R[303]={full_text:"你不是没撸到，是根本没资格拿\n\n$HYPE\n年初看过去1年的大毛项目，9号Hyperliquid 从蛋糕上来看确实是一波“超级大毛”，无论从机制设计、空投估值，还是后续价格表现，都算是顶级项目范本之一。\n\n1、难撸 是 Hyperliquid 的核心特色：\n赛季制 + 滚动权重，\n积分动态调整 + 难度拉满， https://t.co/hM0a8KCkIY",smarttags:$R[304]=[]},id:"VHdlZXQ6MTkwNTE0NDA4MDY1ODcyNzM3NQ==",note_tweet:$R[305]={note_tweet_results:$R[306]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTA1MTQ0MDgwNTg3NTAxNTY5",result:$R[307]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5MDUxNDQwODA1ODc1MDE1Njk=",text:"你不是没撸到，是根本没资格拿\n\n$HYPE\n年初看过去1年的大毛项目，9号Hyperliquid 从蛋糕上来看确实是一波“超级大毛”，无论从机制设计、空投估值，还是后续价格表现，都算是顶级项目范本之一。\n\n1、难撸 是 Hyperliquid 的核心特色：\n赛季制 + 滚动权重，\n积分动态调整 + 难度拉满，\n\n它不像传统那种“挂单/交互就能拿”的机制，而是有复杂的行为评分模型来给积分，比如提供LP做市、交易、活跃度、资金使用率等。\n其实关注的算早，参与了点，后期积分非常难拿，动态调整，每周都变化，空投的时候价值13～14亿美金，之后不断拉盘，热度很高。\n但是据我所知，身边很少有人拿到超过33w刀以上的收益，如果有，真心很想请教当初如何拿到的，比如损益比等。\n\n2、再强的项目、再漂亮的拉盘，都逃不开一个现实——得有人不断买单，才能维持币价。\n强叙事，做市强，做事强，激励到位，不断有人卷，有新人卷，核心在于：项目能不能“讲新故事”+“开新入口”\n\n3、现在的空投市场挺难，难在哪\n-积分花样多，营销痕迹非常明显，大部分项目用人朝前，甩人在后。\n-从“全民撸毛”变成了“精英内卷”\n-查女巫越来越严，人为刀俎，我为鱼肉，谁是女巫🧙‍♀️，不是自己说了算，不是技术说了算。\n-社区的往往是最容易被忽视的，但其实最重要。\n-流动性减弱，市场大部分项目都估值很低"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1905144080658727375:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg 48w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_x96.jpg 96w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/KuiGas" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">丰密</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1v5c9pimb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/KuiGas" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@KuiGas</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qqc9pimb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">你不是没撸到，是根本没资格拿

</span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-[length:inherit] font-[inherit] text-brand" data-state="closed" data-slot="hover-card-trigger" href="/search?q=%24HYPE">$<!-- -->HYPE</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">
年初看过去1年的大毛项目，9号Hyperliquid 从蛋糕上来看确实是一波“超级大毛”，无论从机制设计、空投估值，还是后续价格表现，都算是顶级项目范本之一。

1、难撸 是 Hyperliquid 的核心特色：
赛季制 + 滚动权重，
积分动态调整 + 难度拉满，

它不像传统那种“挂单/交互就能拿”的机制，而是有复杂的行为评分模型来给积分，比如提供LP做市、交易、活跃度、资金使用率等。
其实关注的算早，参与了点，后期积分非常难拿，动态调整，每周都变化，空投的时候价值13～14亿美金，之后不断拉盘，热度很高。
但是据我所知，身边很少有人拿到超过33w刀以上的收益，如果有，真心很想请教当初如何拿到的，比如损益比等。

2、再强的项目、再漂亮的拉盘，都逃不开一个现实——得有人不断买单，才能维持币价。
强叙事，做市强，做事强，激励到位，不断有人卷，有新人卷，核心在于：项目能不能“讲新故事”+“开新入口”

3、现在的空投市场挺难，难在哪
-积分花样多，营销痕迹非常明显，大部分项目用人朝前，甩人在后。
-从“全民撸毛”变成了“精英内卷”
-查女巫越来越严，人为刀俎，我为鱼肉，谁是女巫🧙‍♀️，不是自己说了算，不是技术说了算。
-社区的往往是最容易被忽视的，但其实最重要。
-流动性减弱，市场大部分项目都估值很低</span></div><div class="flex flex-col gap-1 empty:hidden"><div class="relative overflow-hidden border border-gray-200 rounded-md" style="aspect-ratio:1.833815028901734"><div class="relative h-full w-full"><div inert="" class="h-full w-full"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] block h-full w-full cursor-zoom-in appearance-none border-none bg-transparent p-0 text-inherit" aria-label="Image" href="/KuiGas/status/1905144080658727375/photo/1"><img fetchPriority="high" height="1384" width="2538" alt="" class="w-full" decoding="async" loading="eager" sizes="(max-width: 600px) calc(100vw - 80px), 600px" src="https://pbs.twimg.com/media/GnAk1e6aMAA3pbq?format=webp&amp;name=large" srcSet="https://pbs.twimg.com/media/GnAk1e6aMAA3pbq?format=webp&amp;name=small 680w, https://pbs.twimg.com/media/GnAk1e6aMAA3pbq?format=webp&amp;name=medium 1200w, https://pbs.twimg.com/media/GnAk1e6aMAA3pbq?format=webp&amp;name=large 2048w"/></a></div><a aria-label="View media" class="absolute inset-0 z-10" href="/KuiGas/status/1905144080658727375/photo/1"></a></div></div></div><div class="flex shrink items-center text-gray-700"><span class="inline-flex w-fit"><a id="_R_bqppimb6b5336_" data-base-ui-tooltip-trigger="" class="font-chirp max-w-full whitespace-pre-wrap break-words text-gray-700 text-body font-normal hover:underline inline-flex w-fit" href="/KuiGas/status/1905144080658727375">6:25 AM · Mar 27, 2025</a><script nonce="Ij/ecFwTISLltek6rk3PbA==">window.__xClientTextFormatters?.run("_R_bqppimb6b5336_", "formatFullTimestamp", {"timestamp":1743056719000,"lang":"en","nowLabel":"Now"});</script></span><span aria-hidden="true" class="shrink-0 px-1 last:hidden">·</span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-subtext1 font-[inherit] font-chirp inline-flex items-center gap-1 text-gray-700 