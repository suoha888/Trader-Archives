	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[76]=($R[77]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="Ij/ecFwTISLltek6rk3PbA==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="Ij/ecFwTISLltek6rk3PbA==">($R=>$R[76].next($R[78]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1905144080658727375\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="Ij/ecFwTISLltek6rk3PbA==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="Ij/ecFwTISLltek6rk3PbA==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="Ij/ecFwTISLltek6rk3PbA==">($R=>$R[76].next($R[79]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1905144080658727375\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[80]={kind:"Result.Ok",value:$R[81]={data:$R[82]={threaded_conversation_with_injections_v2:$R[83]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[84]=[$R[85]={__typename:"TimelineClearCache"},$R[86]={__typename:"TimelineAddEntries",entries:$R[87]=[$R[88]={content:$R[89]={__typename:"TimelineTimelineItem",client_event_info:$R[90]={component:"tweet",element:"tweet"},content:$R[91]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[92]={id:"VHdlZXRSZXN1bHRzOjE5MDUxNDQwODA2NTg3MjczNzU=",rest_id:"1905144080658727375",result:$R[93]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[94]=[],core:$R[95]={user_results:$R[96]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[97]={__typename:"User",avatar:$R[98]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[99]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[100]={},privacy:$R[101]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[102]={followers:107779,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[103]={tweets:9451},verification:$R[104]={is_blue_verified:!0}}}},counts:$R[105]={bookmark_count:75,favorite_count:153,quote_count:1,reply_count:40,retweet_count:13},details:$R[106]={cashtag_entities:$R[107]=[$R[108]={indices:$R[109]=[16,21],tag:$R[110]={id:"U21hcnRUYWc6SFlQRQ==",info:$R[111]={info:$R[112]={ticker:"HYPE"}}},text:"HYPE"}],created_at_ms:1743056719000,display_text_range:$R[113]=[0,155],full_text:"你不是没撸到，是根本没资格拿\n\n$HYPE\n年初看过去1年的大毛项目，9号Hyperliquid 从蛋糕上来看确实是一波“超级大毛”，无论从机制设计、空投估值，还是后续价格表现，都算是顶级项目范本之一。\n\n1、难撸 是 Hyperliquid 的核心特色：\n赛季制 + 滚动权重，\n积分动态调整 + 难度拉满， https://t.co/hM0a8KCkIY",hashtag_entities:$R[114]=[],smarttags:$R[115]=[],timestamp_entities:$R[116]=[]},edit_control:$R[117]={__typename:"EditControlInitial",edit_tweet_ids:$R[118]=["1905144080658727375"]},grok_translated_post_with_availability:$R[119]={is_available:!1},id:"VHdlZXQ6MTkwNTE0NDA4MDY1ODcyNzM3NQ==",legacy:$R[120]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[121]=[$R[122]={allow_download_status:$R[123]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1905144080658727375/photo/1",ext_media_availability:$R[124]={status:"Available"},ext_playlists:$R[125]=[],features:$R[126]={},id_str:"1905063143627436032",indices:$R[127]=[156,179],media_url_https:"https://pbs.twimg.com/media/GnAk1e6aMAA3pbq.jpg",original_info:$R[128]={height:1384,width:2538},type:"photo"}],mention_entities:$R[129]=[],note_tweet:$R[130]={is_expandable:!0,note_tweet_results:$R[131]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTA1MTQ0MDgwNTg3NTAxNTY5",result:$R[132]={__typename:"NoteTweet",entity_set:$R[133]={hashtags:$R[134]=[],symbols:$R[135]=[$R[136]={indices:$R[137]=[16,21],tag:$R[138]={id:"U21hcnRUYWc6SFlQRQ==",info:$R[139]={info:$R[140]={ticker:"HYPE"}}},text:"HYPE"}],urls:$R[141]=[],user_mentions:$R[142]=[]},id:"Tm90ZVR3ZWV0OjE5MDUxNDQwODA1ODc1MDE1Njk=",rest_id:"1905144080587501569",text:"你不是没撸到，是根本没资格拿\n\n$HYPE\n年初看过去1年的大毛项目，9号Hyperliquid 从蛋糕上来看确实是一波“超级大毛”，无论从机制设计、空投估值，还是后续价格表现，都算是顶级项目范本之一。\n\n1、难撸 是 Hyperliquid 的核心特色：\n赛季制 + 滚动权重，\n积分动态调整 + 难度拉满，\n\n它不像传统那种“挂单/交互就能拿”的机制，而是有复杂的行为评分模型来给积分，比如提供LP做市、交易、活跃度、资金使用率等。\n其实关注的算早，参与了点，后期积分非常难拿，动态调整，每周都变化，空投的时候价值13～14亿美金，之后不断拉盘，热度很高。\n但是据我所知，身边很少有人拿到超过33w刀以上的收益，如果有，真心很想请教当初如何拿到的，比如损益比等。\n\n2、再强的项目、再漂亮的拉盘，都逃不开一个现实——得有人不断买单，才能维持币价。\n强叙事，做市强，做事强，激励到位，不断有人卷，有新人卷，核心在于：项目能不能“讲新故事”+“开新入口”\n\n3、现在的空投市场挺难，难在哪\n-积分花样多，营销痕迹非常明显，大部分项目用人朝前，甩人在后。\n-从“全民撸毛”变成了“精英内卷”\n-查女巫越来越严，人为刀俎，我为鱼肉，谁是女巫🧙‍♀️，不是自己说了算，不是技术说了算。\n-社区的往往是最容易被忽视的，但其实最重要。\n-流动性减弱，市场大部分项目都估值很低"}}},rest_id:"1905144080658727375",url_entities:$R[143]=[],views:$R[144]={count:"54848"}}}}},entry_id:"tweet-1905144080658727375",sort_index:"2103762158402666496"},$R[145]={content:$R[146]={__typename:"TimelineTimelineModule",client_event_info:$R[147]={component:"tweet"},display_type:"VerticalConversation",items:$R[148]=[$R[149]={entry_id:"conversationthread-1905154499096068495-tweet-1905154499096068495",item:$R[150]={__typename:"TimelineTimelineItem",client_event_info:$R[151]={component:"tweet",details:$R[152]={conversation_details:$R[153]={conversation_section:"HighQuality"},timelines_details:$R[154]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczykEAAAAAA=="}},element:"tweet"},content:$R[155]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[156]={id:"VHdlZXRSZXN1bHRzOjE5MDUxNTQ0OTkwOTYwNjg0OTU=",rest_id:"1905154499096068495",result:$R[157]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[158]=[],core:$R[159]={user_results:$