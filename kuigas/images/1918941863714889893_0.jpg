nt_event_info:$R[470]={component:"tweet",details:$R[471]={conversation_details:$R[472]={conversation_section:"HighQuality"},timelines_details:$R[473]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcznyRAAAAAA=="}},element:"tweet"},content:$R[474]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[475]={id:"VHdlZXRSZXN1bHRzOjE5MTg5NjY0MDQ0NTc2NDAyODg=",rest_id:"1918966404457640288",result:$R[476]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[477]=[],core:$R[478]={user_results:$R[479]={id:"VXNlclJlc3VsdHM6MTM5MDYwOTg4MDk5ODc2NDU0Nw==",result:$R[480]={__typename:"User",avatar:$R[481]={image_url:"https://pbs.twimg.com/profile_images/2047381554507485184/UJNkWoY5_normal.jpg"},core:$R[482]={name:"雪见💗（🌸，🌿）",screen_name:"KekeiiLabs"},id:"VXNlcjoxMzkwNjA5ODgwOTk4NzY0NTQ3",identity_profile_labels_highlighted_label:$R[483]={},privacy:$R[484]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[485]={followers:3867,following:2280},rest_id:"1390609880998764547",super_follow_eligible:!1,tweet_counts:$R[486]={tweets:4812},verification:$R[487]={is_blue_verified:!0}}}},counts:$R[488]={bookmark_count:0,favorite_count:3,quote_count:0,reply_count:1,retweet_count:0},details:$R[489]={cashtag_entities:$R[490]=[],created_at_ms:1746352218000,display_text_range:$R[491]=[19,43],full_text:"@KuiGas @jager_BSC 确实很像aidoge，一出来的时候我就有这种感觉",hashtag_entities:$R[492]=[],smarttags:$R[493]=[],timestamp_entities:$R[494]=[]},edit_control:$R[495]={__typename:"EditControlInitial",edit_tweet_ids:$R[496]=["1918966404457640288"]},grok_translated_post_with_availability:$R[497]={is_available:!1},id:"VHdlZXQ6MTkxODk2NjQwNDQ1NzY0MDI4OA==",legacy:$R[498]={lang:"zh"},media_entities2:$R[499]=[],mention_entities:$R[500]=[$R[501]={id_str:"1372876871990272000",indices:$R[502]=[0,7],screen_name:"KuiGas"},$R[503]={id_str:"1913662389339500544",indices:$R[504]=[8,18],screen_name:"jager_BSC"}],reply_to_results:$R[505]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MTg5NDE4NjM3MTQ4ODk4OTM=",rest_id:"1918941863714889893"},reply_to_user_results:$R[506]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[507]={__typename:"User",core:$R[508]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1918966404457640288",url_entities:$R[509]=[],views:$R[510]={count:"1982"}}}}}}],metadata:$R[511]={conversation_metadata:$R[512]={all_tweet_ids:$R[513]=["1918966404457640288"],enable_deduplication:!0}}},entry_id:"conversationthread-1918966404457640288",sort_index:"2103761973194784748"}]},$R[514]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[515]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[516]={id:"VHdlZXRSZXN1bHRzOjE5MTg5NDE4NjM3MTQ4ODk4OTM=",rest_id:"1918941863714889893",result:$R[517]={__typename:"Tweet",core:$R[518]={user_results:$R[519]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[520]={__typename:"User",avatar:$R[521]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[522]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[523]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[524]={favorite_count:100,reply_count:40},details:$R[525]={full_text:"Jager空投速查领取\n\nBSC 上 MeMe $JAGER @jager_BSC 正在进行大规模空投，要求不高，广覆盖原则，博弈玩法多样。\n\n机制是动态减产，每增长 2.5%，空投自动减产 20%。领取越晚，拿得越少。\n\n⚠️7 天空投期，剩余          未在此期限内领取的代币将自动重新分配至流动性奖励池。 https://t.co/hQID6XHsYu",smarttags:$R[526]=[]},id:"VHdlZXQ6MTkxODk0MTg2MzcxNDg4OTg5Mw==",note_tweet:$R[527]={note_tweet_results:$R[528]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTE4OTQxODYzMzkxOTU2OTky",result:$R[529]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5MTg5NDE4NjMzOTE5NTY5OTI=",text:"Jager空投速查领取\n\nBSC 上 MeMe $JAGER @jager_BSC 正在进行大规模空投，要求不高，广覆盖原则，博弈玩法多样。\n\n机制是动态减产，每增长 2.5%，空投自动减产 20%。领取越晚，拿得越少。\n\n⚠️7 天空投期，剩余          未在此期限内领取的代币将自动重新分配至流动性奖励池。\n\n查询Claim链接：https://t.co/mkDGaPFrzM\n👆领取网址及合约已经让科学家看过了，没问题！\n另外，okx web3钱包、ba web3钱包、UX也记得扫一扫\n\n1、资格：\n\n过去快照资格👇\nBNB 链 (BSC)、Solana (SOL) 或以太坊 (ETH) 上满足以下任意一项条件，即可获得基础空投配额，快照时间3月26日。\n\n未来4天\n激励https://t.co/5bXOvpGf4c用户\n原本预留给 CEX 的 3% 代币，现在将全部奖励给真正的链上用户。需要根据地址的在5月4日至7日的交易情况给予分发。\n\n活动时间：5月4日 10:00 - 5月7日 10:00（UTC）\n奖励将于活动结束后48小时内发放。\n\n💥参与条件：\n1️⃣ 新用户：交易 > 0.01 BNB\n2️⃣ 老用户：交易量 > 0.1 BNB\n\n2、代币情况\n\n$JAGER 仅存在于 BNB Chain 上\n\n名称：Jager Hunter\n代币符号：Jager\n区块链：BNB智能链\n合约地址：0x74836cC0E821A6bE18e407E6388E430B689C66e9\n总供应量：1460万亿\n\n3、代币分配要点：\n\n90.5% - 社区空投：大规模空投奖励币安生态系统和其他公链的 meme 爱好者。\n7 天空投期结束后，任何未领取的 $JAGER 代币将自动添加到 $JAGER-BNB 流动池（LP）作为奖励。\n\n4% - CEX 上市储备金：用于提供初始流动性、支付上市费用以及支持未来 CEX 上市的营销。\n\n5.4% - 合作伙伴和营销基金：用于项目推广、品牌建设、社区活动以及与有影响力的人/KOL的合作等项目。\n\n0.1% - 初始流动性池 (ILP)：用于在 DEX（例如 PancakeSwap）上创建初始交易对。\n\n4、交易税\n\n每笔交易都会产生交易税，刚开始10%，后续5%\n\n5、空投领取\n\n1、打开官方空投领取页面：https://t.co/mkDGaPFrzM\n\n连接 EVM 钱包（如 MetaMask、Trust Wallet），也可绑定 Solana 钱包（如 Phantom）查看是否符合空投条件。\n\n2、系统会自动检测并显示你的基础空投额度。\n\n3、两种领取方式，差距极大！\n\n✅ 选项1：立即领取\n只拿 65%，剩下的代币将：\n40% 奖励给愿意等待的用户\n60% 用于 LP 奖励池\n\n✅ 选项2：等待72小时\n领取 100% 分配\n再额外获得“即时领取者让利”的奖励分红\n\n4、推荐计划：获得直接邀请人索取的空投金额的 9%。\n\n获得间接邀请人（即被邀请人的邀请人）领取空投金额的 3%。\n\n目前进度5.32%\n\n6、玩法博弈机制\n\n大狮兄@broleon介绍了他认为值得玩法，可以参考。\n\n🦁一看就是曾经的defi老鸟，玩过各种盘子的老og，大狮兄大观点是若空投参与率低，94.7% 的代币将变成 LP 奖励\n当前 APR 已达 1100%，到时或许能冲到几十万年化，\n真正的博弈点在第8天之后的 2 池飞轮期。\n\n官方设计了\n1、空投动态递减机制\n2、交易税分红机制\n3、持有奖励 \n3、持有奖励 \n5、LP质押奖励\n\n持有奖励：谁卖就被扣10%，不卖就能分这10%里的部分税，变相建立了持仓用户的联盟，这是典型的DeFi式“软锁仓机制”，不靠协议锁，而是靠你心疼收益不愿动。\n\n LP质押奖励 ： 锁币，90%供应用于LP挖矿，配上“未领取空投转入LP奖励池”这个机制，让你不仅想持币，还忍不住拉BNB进池子博高APR，像极了DeFi Summer时期那种“做市即信仰”的2池结构。这里大狮兄分享了他的策略，是延迟3天领取，另外博二池机会+挖卖提\n\n丰密认为这波确实是“会玩的官方”：空投只是开胃菜，真正的设计是一套连环激励机制，目的是把用户留住、卷起来，还顺便拱高TVL和币价。\n卖出相当于给别人分红，不卖领分红，加lp相当于吃奖励还可能价格上涨，空投延迟锁3天相当于拿更多初始空投及多拿奖励。\n\n每一个选择都对“卖出”设置了心理障碍，而对“继续参与”开了层层激励，把用户一步步卷入博弈闭环，相当于把撸毛党变成流动性贡献者的艺术，后期看飞轮能否飞起。适合DeFi老玩家和策略型用户，\n\n风险在于后续是否有人持续接盘、LP激励周期能否维持热度、团队是否具备长线运营能力等。\n\n官方推特@jager_BSC\nhttps://t.co/iWW2e1AvuP\n\n现在是早期，后面每涨2.5%，奖励就减产20%，早鸟优势非常大，别只当它是个几刀 meme，先领为敬4\n\n有部分人知道我想说啥，遥想当年的Aidoge+cheems，刚开始领取的时候也就几美金，疯狂的领取了几天几夜，之后暴涨500x，上百倍，每一个都是千刀大毛。不知何时能复相见。\n\nClaim链接：\nhttps://t.co/mkDGaPFrzM"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1918941863714889893:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg 48w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_x96.jpg 96w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/195151035776959