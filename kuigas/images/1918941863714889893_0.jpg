={ticker:"BNB"}}},text:"BNB"},$R[199]={indices:$R[200]=[1006,1010],tag:$R[201]={id:"U21hcnRUYWc6Qk5C",info:$R[202]={info:$R[203]={ticker:"BNB"}}},text:"BNB"},$R[204]={indices:$R[205]=[1025,1031],tag:$R[206]={id:"U21hcnRUYWc6SmFnZXI=",info:$R[207]={}},text:"Jager"}],urls:$R[208]=[],user_mentions:$R[209]=[$R[210]={id_str:"877807935493033984",indices:$R[211]=[249,257],screen_name:"Binance"}]},id:"Tm90ZVR3ZWV0OjE5MTcyMzMxOTQ1NTYxNDE1Njg=",rest_id:"1917233194556141568",text:"The smallest unit of Bitcoin is called a Satoshi (Sats), named in honor of Satoshi Nakamoto.\n\nBut do you know what the smallest unit of $BNB is?\n\nCrypto is full of interesting stories.\n\nThe early days of any startup are often marked by struggle — \n\n@Binance was no exception.\n\nMuch of Binance’s rapid rise in its early days — and its continued leadership in the crypto industry today — can be attributed to one core principle: Community First.\n\nIn the early stages of Binance’s community building, the founders frequently communicated directly with users via Twitter and Telegram groups, listening to their needs and solving problems firsthand. This earned them a lot of praise.\n\nTheir passion and commitment to the community inspired the broader ecosystem — and together, they built something remarkable.\n\nOne of Binance’s early Telegram community managers was a person named Jager.\n\nTo recognize the value of “Community First” as a collective effort, Binance named the smallest unit of BNB after him.\n\n1 $BNB = 100,000,000 $Jager"}}},rest_id:"1917233194715472011",url_entities:$R[212]=[],views:$R[213]={count:"825855"}}},rest_id:"1918941863714889893",url_entities:$R[214]=[],views:$R[215]={count:"110990"}}}}}}}],graphqlRequestStream:$R[216]=($R[217]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[218]=($R[219]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="9/LEP3neNLEmEffj63NUWQ==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="9/LEP3neNLEmEffj63NUWQ==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="9/LEP3neNLEmEffj63NUWQ==">($R=>$R[218].next($R[220]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1918941863714889893\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="9/LEP3neNLEmEffj63NUWQ==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="9/LEP3neNLEmEffj63NUWQ==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="9/LEP3neNLEmEffj63NUWQ==">($R=>$R[218].next($R[221]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1918941863714889893\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[222]={kind:"Result.Ok",value:$R[223]={data:$R[224]={threaded_conversation_with_injections_v2:$R[225]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[226]=[$R[227]={__typename:"TimelineClearCache"},$R[228]={__typename:"TimelineAddEntries",entries:$R[229]=[$R[230]={content:$R[231]={__typename:"TimelineTimelineItem",client_event_info:$R[232]={component:"tweet",element:"tweet"},content:$R[233]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[234]={id:"VHdlZXRSZXN1bHRzOjE5MTg5NDE4NjM3MTQ4ODk4OTM=",rest_id:"1918941863714889893",result:$R[235]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[236]=[],core:$R[237]={user_results:$R[238]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[239]={__typename:"User",avatar:$R[240]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[241]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[242]={},privacy:$R[243]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[244]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[245]={tweets:9451},verification:$R[246]={is_blue_verified:!0}}}},counts:$R[247]={bookmark_count:62,favorite_count:100,quote_count:6,reply_count:40,retweet_count:46},details:$R[248]={cashtag_entities:$R[249]=[$R[250]={indices:$R[251]=[24,30],tag:$R[252]={id:"U21hcnRUYWc6SkFHRVI=",info:$R[253]={}},text:"JAGER"}],created_at_ms:1746346367000,display_text_range:$R[254]=[0,159],full_text:"Jager空投速查领取\n\nBSC 上 MeMe $JAGER @jager_BSC 正在进行大规模空投，要求不高，广覆盖原则，博弈玩法多样。\n\n机制是动态减产，每增长 2.5%，空投自动减产 20%。领取越晚，拿得越少。\n\n⚠️7 天空投期，剩余          未在此期限内领取的代币将自动重新分配至流动性奖励池。 https://t.co/hQID6XHsYu",hashtag_entities:$R[255]=[],smarttags:$R[256]=[],timestamp_entities:$R[257]=[]},edit_control:$R[258]={__typename:"EditControlEdit",edit_control_initial:$R[259]={edit_tweet_ids:$R[260]=["1918940247229902919","1918941176209821872","1918941863714889893"]}},grok_translated_post_with_availability:$R[261]={is_available:!1},id:"VHdlZXQ6MTkxODk0MTg2MzcxNDg4OTg5Mw==",legacy:$R[262]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[263]=[$R[264]={allow_download_status:$R[265]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1918941863714889893/photo/1",ext_media_availability:$R[266]={status:"Available"},ext_playlists:$R[267]=[],features:$R[268]={},id_str:"1918931681115058176",indices:$R[269]=[160,183],media_url_https:"https://pbs.twimg.com/media/GqFqMnEbMAAiZ6V.jpg",original_info:$R[270]={height:842,width:1706},type:"photo"},$R[271]={allow_download_status:$R[272]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1918941863714889893/photo/1",ext_media_availability:$R[273]={status:"Available"},ext_playlists:$R[274]=[],features:$R[275]={},id_str:"1918932045956513792",indices:$R[276]=[160,183],media_url_https:"https://pbs.twimg.com/media/GqFqh2NaAAAMnCG.jpg",original_info:$R[277]={height:1528,width:1712},type:"photo"},$R[278]={allow_download_status:$R[279]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1918941863714889893/photo/1",ext_media_availability:$R[280]={status:"Available"},ext_playlists:$R[281]=[],features:$R[282]={},id_str:"1918936092008697856",indices:$R[283]=[160,183],media_url_https:"https://pbs.twimg.com/media/GqFuNW7a0AABV6u.jpg",original_info:$R[284]={height:462,width:2934},type:"photo"}],mention_entities:$R[285]=[$R[286]={id_str:"1913662389339500544",indices:$R[287]=[31,41],screen_name:"jager_BSC"}],note_tweet:$R[288]={is_expandable:!0,note_tweet_results:$R[289]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTE4OTQxODYzMzkxOTU2OTky",result:$R[290]={__typename:"NoteTweet",entity_set:$R[291]={symbols:$R[292]=[$R[293]={indices:$R[294]=[24,30],tag:$R[295]={id:"U21hcnRUYWc6SkFHRVI=",info:$R[296]={}},text:"JAGER"},$R[297]={indices:$R[298]=[545,551],tag:$R[299]={id:"U21hcnRUYWc6SkFHRVI=",info:$R[300]={}},text:"JAGER"},$R[301]={indices:$R[302]=[740,746],tag:$R[303]={id:"U21hcnRUYWc6SkFHRVI=",info:$R[304]={}},text:"JAGER"},$R[305]={indices:$R[306]=[756,762],tag:$R[307]={id:"U21hcnRUYWc6SkFHRVI=",info:$R[308]={}},text:"JAGER"}],urls:$R[309]=[$R[310]={display_url:"jager.meme/?invitor=0xf3F…",expanded_url:"https://jager.meme?invitor=0xf3FE8c6c75bE4afB2F8200Fc77339abE4D7CFF33",indices:$R[311]=[171,194],url:"https://t.co/mkDGaPFrzM"},$R[312]={display_url:"Four.Meme",expanded_url:"http://Four.Meme",indices:$R[313]=[345,368],url:"https://t.co/5bXOvpGf4c"},$R[314]={display_url:"jager.meme/?invitor=0xf3F…",expanded_url:"https://jager.meme?invitor=0xf3FE8c6c75bE4afB2F8200Fc77339abE4D7CFF33",indices:$R[315]=[993,1016],url:"https://t.co/mkDGaPFrzM"},$R[316]={display_url:"x.com/jager_BSC/stat…",expanded_url:"https://x.com/jager_BSC/status/1917233194715472011",indices:$R[317]=[2000,2023],url:"https://t.co/iWW2e1AvuP"},$R[318]={display_url:"jager.meme/?invitor=0xf3F…",expanded_url:"https://jager.meme?invitor=0xf3FE8c6c75bE4afB2F8200Fc77339abE4D7CFF33",indices:$R[319]=[2176,2199],url:"https://t.co/mkDGaPFrzM"}],user_mentions:$R[320]=[$R[321]={id_str:"1913662389339500544",indices:$R[322]=[31,41],screen_name:"jager_BSC"},$R[323]={id_str:"1362967156825018369",indices:$R[324]=[1314,1322],screen_name:"broleon"},$R[325]={id_str:"1913662389339500544",indices:$R[326]=[1989,1999],screen_name:"jager_BSC"}]},id:"Tm90ZVR3ZWV0OjE5MTg5NDE4NjMzOTE5NTY5OTI=",rest_id:"1918941863391956992",text:"Jager空投速查领取\n\nBSC 上 MeMe $JAGER @jager_BSC 正在进行大规模空投，要求不高，广覆盖原则，博弈玩法多样。\n\n机制是动态减产，每增长 2.5%，空投自动减产 20%。领取越晚，拿得越少。\n\n⚠️7 天空投期，剩余          未在此期限内领取的代币将自动重新分配至流动性奖励池。\n\n查询Claim链接：https://t.co/mkDGaPFrzM\n👆领取网址及合约已经让科学家看过了，没问题！\n另外，okx web3钱包、ba web3钱包、UX也记得扫一扫\n\n1、资格：\n\n过去快照资格👇\nBNB 链 (BSC)、Solana (SOL) 或以太坊 (ETH) 上满足以下任意一项条件，即可获得基础空投配额，快照时间3月26日。\n\n未来4天\n激励https://t.co/5bXOvpGf4c用户\n原本预留给 CEX 的 3% 代币，现在将全部奖励给真正的链上用户。需要根据地址的在5月4日至7日的交易情况给予分发。\n\n活动时间：5月4日 10:00 - 5月7日 10:00（UTC）\n奖励将于活动结束后48小时内发放。\n\n💥参与条件：\n1️⃣ 新用户：交易 > 0.01 BNB\n2️⃣ 老用户：交易量 > 0.1 BNB\n\n2、代币情况\n\n$JAGER 仅存在于 BNB Chain 上\n\n名称：Jager Hunter\n代币符号：Jager\n区块链：BNB智能链\n合约地址：0x74836cC0E821A6bE18e407E6388E430B689C66e9\n总供应量：1460万亿\n\n3、代币分配要点：\n\n90.5% - 社区空投：大规模空投奖励币安生态系统和其他公链的 meme 爱好者。\n7 天空投期结束后，任何未领取的 $JAGER 代币将自动添加到 $JAGER-BNB 流动池（LP）作为奖励。\n\n4% - CEX 上市储备金：用于提供初始流动性、支付上市费用以及支持未来 CEX 上市的营销。\n\n5.4% - 合作伙伴和营销基金：用于项目推广、品牌建设、社区活动以及与有影响力的人/KOL的合作等项目。\n\n0.1% - 初始流动性池 (ILP)：用于在 DEX（例如 PancakeSwap）上创建初始交易对。\n\n4、交易税\n\n每笔交易都会产生交易税，刚开始10%，后续5%\n\n5、空投领取\n\n1、打开官方空投领取页面：https://t.co/mkDGaPFrzM\n\n连接 EVM 钱包（如 MetaMask、Trust Wallet），也可绑定 Solana 钱包（如 Phantom）查看是否符合空投条件。\n\n2、系统会自动检测并显示你的基础空投额度。\n\n3、两种领取方式，差距极大！\n\n✅ 选项1：立即领取\n只拿 65%，剩下的代币将：\n40% 奖励给愿意等待的用户\n60% 用于 LP 奖励池\n\n✅ 选项2：等待72小时\n领取 100% 分配\n再额外获得“即时领取者让利”的奖励分红\n\n4、推荐计划：获得直接邀请人索取的空投金额的 9%。\n\n获得间接邀请人（即被邀请人的邀请人）领取空投金额的 3%。\n\n目前进度5.32%\n\n6、玩法博弈机制\n\n大狮兄@broleon介绍了他认为值得玩法，可以参考。\n\n🦁一看就是曾经的defi老鸟，玩过各种盘子的老og，大狮兄大观点是若空投参与率低，94.7% 的代币将变成 LP 奖励\n当前 APR 已达 1100%，到时或许能冲到几十万年化，\n真正的博弈点在第8天之后的 2 池飞轮期。\n\n官方设计了\n1、空投动态递减机制\n2、交易税分红机制\n3、持有奖励 \n3、持有奖励 \n5、LP质押奖励\n\n持有奖励：谁卖就被扣10%，不卖就能分这10%里的部分税，变相建立了持仓用户的联盟，这是典型的DeFi式“软锁仓机制”，不靠协议锁，而是靠你心疼收益不愿动。\n\n LP质押奖励 ： 锁币，90%供应用于LP挖矿，配上“未领取空投转入LP奖励池”这个机制，让你不仅想持币，还忍不住拉BNB进池子博高APR，像极了DeFi Summer时期那种“做市即信仰”的2池结构。这里大狮兄分享了他的策略，是延迟3天领取，另外博二池机会+挖卖提\n\n丰密认为这波确实是“会玩的官方”：空投只是开胃菜，真正的设计是一套连环激励机制，目的是把用户留住、卷起来，还顺便拱高TVL和币价。\n卖出相当于给别人分红，不卖领分红，加lp相当于吃奖励还可能价格上涨，空投延迟锁3天相当于拿更多初始空投及多拿奖励。\n\n每一个选择都对“卖出”设置了心理障碍，而对“继续参与”开了层层激励，把用户一步步卷入博弈闭环，相当于把撸毛党变成流动性贡献者的艺术，后期看飞轮能否飞起。适合DeFi老玩家和策略型用户，\n\n风险在于后续是否有人持续接盘、LP激励周期能否维持热度、团队是否具备长线运营能力等。\n\n官方推特@jager_BSC\nhttps://t.co/iWW2e1AvuP\n\n现在是早期，后面每涨2.5%，奖励就减产20%，早鸟优势非常大，别只当它是个几刀 meme，先领为敬4\n\n有部分人知道我想说啥，遥想当年的Aidoge+cheems，刚开始领取的时候也就几美金，疯狂的领取了几天几夜，之后暴涨500x，上百倍，每一个都是千刀大毛。不知何时能复相见。\n\nClaim链接：\nhttps://t.co/mkDGaPFrzM"}}},quoted_tweet_results:$R[327]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MTcyMzMxOTQ3MTU0NzIwMTE=",rest_id:"1917233194715472011",result:$R[328]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[329]=[],core:$R[330]={user_results:$R[331]={id:"VXNlclJlc3VsdHM6MTkxMzY2MjM4OTMzOTUwMDU0NA==",result:$R[332]={__typename:"User",avatar:$R[333]={image_url:"https://pbs.twimg.com/profile_images/1922327207227359232/jQfjWjmy_normal.jpg"},core:$R[334]={name:"Jager",screen_name:"jager_BSC"},id:"VXNlcjoxOTEzNjYyMzg5MzM5NTAwNTQ0",identity_profile_labels_highlighted_label:$R[335]={},privacy:$R[336]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[337]={followers:19627,following:37},rest_id:"1913662389339500544",super_follow_eligible:!1,tweet_counts:$R[338]={tweets:1037},verification:$R[339]={is_blue_verified:!0}}}},counts:$R[340]={bookmark_count:66,favorite_count:1417,quote_count:57,reply_count:507,retweet_count:447},details:$R[341]={cashtag_entities:$R[342]=[$R[343]={indices:$R[344]=[136,140],tag:$R[345]={id:"U21hcnRUYWc6Qk5C",info:$R[346]={info:$R[347]={ticker:"BNB"}}},text:"BNB"}],created_at_ms:1745938988000,display_text_range:$R[348]=[0,275],full_text:"The smallest unit of Bitcoin is called a Satoshi (Sats), named in honor of Satoshi Nakamoto.\n\nBut do you know what the smallest unit of $BNB is?\n\nCrypto is full of interesting stories.\n\nThe early days of any startup are often marked by struggle — \n\n@Binance was no exception. https://t.co/LQZwa55t86",hashtag_entities:$R[349]=[],smarttags:$R[350]=[],timestamp_entities:$R[351]=[]},edit_control:$R[352]={__typename:"EditControlInitial",edit_tweet_ids:$R[353]=["1917233194715472011"]},grok_translated_post_with_availability:$R[354]={is_available:!1},id:"VHdlZXQ6MTkxNzIzMzE5NDcxNTQ3MjAxMQ==",legacy:$R[355]={possibly_sensitive:!1},media_entities2:$R[356]=[$R[357]={allow_download_status:$R[358]={allow_download:!0},expanded_url:"https://x.com/jager_BSC/status/1917233194715472011/photo/1",ext_media_availability:$R[359]={status:"Available"},ext_playlists:$R[360]=[],features:$R[361]={},id_str:"1917233183202185216",indices:$R[362]=[276,299],media_url_https:"https://pbs.twimg.com/media/GpthbBRbkAAGvDr.jpg",original_info:$R[363]={height:853,width:1280},type:"photo"},$R[364]={allow_download_status:$R[365]={allow_download:!0},expanded_url:"https://x.com/jager_BSC/status/1917233194715472011/photo/1",ext_media_availability:$R[366]={status:"Available"},ext_playlists:$R[367]=[],features:$R[368]={},id_str:"1917233183277658112",indices:$R[369]=[276,299],media_url_https:"https://pbs.twimg.com/media/GpthbBjbMAA9FEx.jpg",original_info:$R[370]={height:853,width:1280},type:"photo"},$R[371]={allow_download_status:$R[372]={allow_download:!0},expanded_url:"https://x.com/jager_BSC/status/1917233194715472011/photo/1",ext_media_availability:$R[373]={status:"Available"},ext_playlists:$R[374]=[],features:$R[375]={},id_str:"1917233183424446464",indices:$R[376]=[276,299],media_url_https:"https://pbs.twimg.com/media/GpthbCGbAAAMZj2.jpg",original_info:$R[377]={height:853,width:1280},type:"photo"},$R[378]={allow_download_status:$R[379]={allow_download:!0},expanded_url:"https://x.com/jager_BSC/status/1917233194715472011/photo/1",ext_media_availability:$R[380]={status:"Available"},ext_playlists:$R[381]=[],features:$R[382]={},id_str:"1917233183227355136",indices:$R[383]=[276,299],media_url_https:"https://pbs.twimg.com/media/GpthbBXboAAwbqM.jpg",original_info:$R[384]={height:853,width:1280},type:"photo"}],mention_entities:$R[385]=[$R[386]={id_str:"877807935493033984",indices:$R[387]=[249,257],screen_name:"binance"}],note_tweet:$R[388]={is_expandable:!0,note_tweet_results:$R[389]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTE3MjMzMTk0NTU2MTQxNTY4",result:$R[390]={__typename:"NoteTweet",entity_set:$R[391]={hashtags:$R[392]=[],symbols:$R[393]=[$R[394]={indices:$R[395]=[136,140],tag:$R[396]={id:"U21hcnRUYWc6Qk5C",info:$R[397]={info:$R[398]={ticker:"BNB"}}},text:"BNB"},$R[399]={indices:$R[400]=[1006,1010],tag:$R[401]={id:"U21hcnRUYWc6Qk5C",info:$R[402]={info:$R[403]={ticker:"BNB"}}},text:"BNB"},$R[404]={indices:$R[405]=[1025,1031],tag:$R[406]={id:"U21hcnRUYWc6SmFnZXI=",info:$R[407]={}},text:"Jager"}],urls:$R[408]=[],user_mentions:$R[409]=[$R[410]={id_str:"877807935493033984",indices:$R[411]=[249,257],screen_name:"Binance"}]},id:"Tm90ZVR3ZWV0OjE5MTcyMzMxOTQ1NTYxNDE1Njg=",rest_id:"1917233194556141568",text:"The smallest unit of Bitcoin is called a Satoshi (Sats), named in honor of Satoshi Nakamoto.\n\nBut do you know what the smallest unit of $BNB is?\n\nCrypto is full of interesting stories.\n\nThe early days of any startup are often marked by struggle — \n\n@Binance was no exception.\n\nMuch of Binance’s rapid rise in its early days — and its continued leadership in the crypto industry today — can be attributed to one core principle: Community First.\n\nIn the early stages of Binance’s community building, the founders frequently communicated directly with users via Twitter and Telegram groups, listening to their needs and solving problems firsthand. This earned them a lot of praise.\n\nTheir passion and commitment to the community inspired the broader ecosystem — and together, they built something remarkable.\n\nOne of Binance’s early Telegram community managers was a person named Jager.\n\nTo recognize the value of “Community First” as a collective effort, Binance named the smallest unit of BNB after him.\n\n1 $BNB = 100,000,000 $Jager"}}},rest_id:"1917233194715472011",url_entities:$R[412]=[],views:$R[413]={count:"825855"}}},rest_id:"1918941863714889893",url_entities:$R[414]=[],views:$R[415]={count:"110990"}}}}},entry_id:"tweet-1918941863714889893",sort_index:"2103761973194784768"},$R[416]={content:$R[417]={__typename:"TimelineTimelineModule",client_event_info:$R[418]={component:"tweet"},display_type:"VerticalConversation",items:$R[419]=[$R[420]={entry_id:"conversationthread-1919415794779193563-tweet-1919415794779193563",item:$R[421]={__typename:"TimelineTimelineItem",client_event_info:$R[422]={component:"tweet",details:$R[423]={conversation_details:$R[424]={conversation_section:"HighQuality"},timelines_details:$R[425]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcznyRAAAAAA=="}},element:"tweet"},content:$R[426]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"SelfThread",tweet_results:$R[427]={id:"VHdlZXRSZXN1bHRzOjE5MTk0MTU3OTQ3NzkxOTM1NjM=",rest_id:"1919415794779193563",result:$R[428]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[429]=[],core:$R[430]={user_results:$R[431]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[432]={__typename:"User",avatar:$R[433]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[434]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",i