大便，却非要用语言文字来解释味道的好坏。\n\n承认问题，是成长的开始，承认错误，接地气一点不好吗？在这样下去，1 Sui大于 1 APT得日子马上就来！\n\n利益相关，持仓APT，自己FUD自己持仓，应该是最傻逼的行为，说些不好听的话，让项目方block我，让官方的工作人员也难受，成年人为自己的选择买单，但，\n\n说点真话，其实挺难的！\n\n说真话不是因为恨，而是因为还在乎。\n\n哎呀，卧槽，不喝点酒，又说多了。\n\n我擦"}}},rest_id:"1917176237971366178",url_entities:$R[79]=[$R[80]={display_url:"d.foresightnews.pro/article/detail…",expanded_url:"https://d.foresightnews.pro/article/detail/83274",indices:$R[81]=[63,86],url:"https://t.co/9JQXVxXZ57"}],views:$R[82]={count:"68988"}}}}}}}],graphqlRequestStream:$R[83]=($R[84]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[85]=($R[86]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="ELtiO9fGM2HBED0NxjUZ5w==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="ELtiO9fGM2HBED0NxjUZ5w==">($R=>$R[85].next($R[87]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1917176237971366178\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="ELtiO9fGM2HBED0NxjUZ5w==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="ELtiO9fGM2HBED0NxjUZ5w==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="ELtiO9fGM2HBED0NxjUZ5w==">($R=>$R[85].next($R[88]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1917176237971366178\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[89]={kind:"Result.Ok",value:$R[90]={data:$R[91]={threaded_conversation_with_injections_v2:$R[92]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[93]=[$R[94]={__typename:"TimelineClearCache"},$R[95]={__typename:"TimelineAddEntries",entries:$R[96]=[$R[97]={content:$R[98]={__typename:"TimelineTimelineItem",client_event_info:$R[99]={component:"tweet",element:"tweet"},content:$R[100]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[101]={id:"VHdlZXRSZXN1bHRzOjE5MTcxNzYyMzc5NzEzNjYxNzg=",rest_id:"1917176237971366178",result:$R[102]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[103]=[],core:$R[104]={user_results:$R[105]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[106]={__typename:"User",avatar:$R[107]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[108]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[109]={},privacy:$R[110]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[111]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[112]={tweets:9451},verification:$R[113]={is_blue_verified:!0}}}},counts:$R[114]={bookmark_count:32,favorite_count:163,quote_count:3,reply_count:57,retweet_count:62},details:$R[115]={cashtag_entities:$R[116]=[],created_at_ms:1745925409000,display_text_range:$R[117]=[0,177],full_text:"Aptos\n终于低头承认了失败，但那颗高傲的头颅，依然不肯落地\n-丰密\n\n刚走出西藏，看到这篇文章，忍不住又来说几句。\n原文：https://t.co/9JQXVxXZ57\n\n在 Foresight News @Foresight_News的采访中，Aptos @Aptos 官方首次正面承认了：\n1、营销不足\n2、散户采用率低\n3、生态开发者水平跟不上 https://t.co/3ddd0eRLu9",hashtag_entities:$R[118]=[],smarttags:$R[119]=[],timestamp_entities:$R[120]=[]},edit_control:$R[121]={__typename:"EditControlInitial",edit_tweet_ids:$R[122]=["1917176237971366178"]},grok_translated_post_with_availability:$R[123]={is_available:!1},id:"VHdlZXQ6MTkxNzE3NjIzNzk3MTM2NjE3OA==",legacy:$R[124]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[125]=[$R[126]={allow_download_status:$R[127]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1917176237971366178/photo/1",ext_media_availability:$R[128]={status:"Available"},ext_playlists:$R[129]=[],features:$R[130]={},id_str:"1917172266464649216",indices:$R[131]=[178,201],media_url_https:"https://pbs.twimg.com/media/GpsqBMvbIAA7gcF.jpg",original_info:$R[132]={height:2108,width:1280},type:"photo"},$R[133]={allow_download_status:$R[134]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1917176237971366178/photo/1",ext_media_availability:$R[135]={status:"Available"},ext_playlists:$R[136]=[],features:$R[137]={},id_str:"1917174828018323456",indices:$R[138]=[178,201],media_url_https:"https://pbs.twimg.com/media/GpssWTRaUAA3GKD.png",original_info:$R[139]={height:244,width:840},type:"photo"}],mention_entities:$R[140]=[$R[141]={id_str:"1478984642594177027",indices:$R[142]=[105,120],screen_name:"Foresight_News"},$R[143]={id_str:"1491526425580474368",indices:$R[144]=[131,137],screen_name:"Aptos"}],note_tweet:$R[145]={is_expandable:!0,note_tweet_results:$R[146]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTE3MTc2MjM3NzE5Nzg5NTY5",result:$R[147]={__typename:"NoteTweet",entity_set:$R[148]={hashtags:$R[149]=[],symbols:$R[150]=[],urls:$R[151]=[$R[152]={display_url:"d.foresightnews.pro/article/detail…",expanded_url:"https://d.foresightnews.pro/article/detail/83274",indices:$R[153]=[63,86],url:"https://t.co/QcU80SlMZk"}],user_mentions:$R[154]=[$R[155]={id_str:"1478984642594177027",indices:$R[156]=[105,120],screen_name:"Foresight_News"},$R[157]={id_str:"1491526425580474368",indices:$R[158]=[131,137],screen_name:"Aptos"}]},id:"Tm90ZVR3ZWV0OjE5MTcxNzYyMzc3MTk3ODk1Njk=",rest_id:"1917176237719789569",text:"Aptos\n终于低头承认了失败，但那颗高傲的头颅，依然不肯落地\n-丰密\n\n刚走出西藏，看到这篇文章，忍不住又来说几句。\n原文：https://t.co/QcU80SlMZk\n\n在 Foresight News @Foresight_News的采访中，Aptos @Aptos 官方首次正面承认了：\n1、营销不足\n2、散户采用率低\n3、生态开发者水平跟不上\n4、社区共识弱\n\n这些过去一年社区吐槽烂了的话，他们终于愿意自己说出口了：APTOS 没有财富效应！\n\n但你以为这是真认错？不，这更像是拿工程师出身当挡箭牌，把问题轻轻描绘成了「我们太优秀所以没讲清楚」\n\n🙃 本质上，他们还是觉得自己是最懂技术、最前沿，只是“群众不懂欣赏”。\n\n看完之后我的总结：套话连篇，战术后仰\n\n采访里充满了大量（漂亮的空话）\n打造“Global Trading Engine”\n支持交易规模扩展\n引入跨链账户\n帮助生态开发者\n2亿美金生态激励计划\n…一堆看似响亮的新词\n\n听起来很宏伟，但每一条落到地上，依然没有解释：\n\n👉 Aptos自己的真正独特价值在哪里？\n👉 用户为什么现在要来，而不是继续用EVM/Solana？\n👉 开发者来了之后，能拿到的，不只是钱，而是真实需求吗？\n👉 散户为什么要支持你们，曾经支持你们的都成为炮灰对吗？\n\n嘴上承认了问题，但行动还是保持着工程师高傲症患者的通病：喜欢讲未来蓝图，讨厌面对当下用户。\n\n丰密想说的话：\n\n首先肯定APTOS 作为MOVE系的明星，底子确实好，也做了蛮多工作，比如原生USDT USDC 已经部署，交易所重提币费用也最低等诸多亮点。\n我个人参与了生态很多Defi协议，挖补贴啥的各种骚操作，曾经也第一个喊过的emoji 🐶1天180倍，但官方运营实在是不敢苟同。\n\n真正的问题在我看来是：\naptos它始终高高在上，团队不懂WEB3，\n不懂社区，不懂用户，不成体系，运营方面毫无章法！大量利好都无法承接在币价及生态上！\n\n用户要的是「可以玩」的链，而不是TPS多少，要的是有财富效应！我等散户要的是「有钱赚」的机会，而不是一堆叠词包装出来的新叙事。\n\n开发者要的是「有真实用户」的链，过往APTOS给了大量激励给项目方，比如截图下的Amnis被丰密冠名，Amnis是apots生态的垃圾战斗机项目，具体用机，还是鸡🐔这个字都可以吧。你说呢？\n\naptos官方给了大量代币给这个项目方做营销，成为LFM的4个项目之一，在官方指导其TGE的时候，最终抛弃大部分用户，1方面说明越南仔不行，另外一方面说明aptos根本没能力扶持其生态原生协议走出来，为什么呢，因为团队不行！团队不懂！不对，我说错了，其实是懂得，官方懂得害怕大家拿了代币卖掉，形成抛压。\n\n你看这个工程师的发言就知道了，项目代币上线之后表现优异，跻身知名交易所（付钱就行），社区态度有所转变（你哪只眼睛看到转变了，99%的用户被杀掉，币价涨跌跟散户一毛钱关系没有）\n\n⚠️Aptos至今还活在自己设定的“技术优越感”里，不愿真正走进社区、用户、开发者的语言体系。\n就像一个拿着拿过矛盾文学奖的的大师，在街边卖大便，却非要用语言文字来解释味道的好坏。\n\n承认问题，是成长的开始，承认错误，接地气一点不好吗？在这样下去，1 Sui大于 1 APT得日子马上就来！\n\n利益相关，持仓APT，自己FUD自己持仓，应该是最傻逼的行为，说些不好听的话，让项目方block我，让官方的工作人员也难受，成年人为自己的选择买单，但，\n\n说点真话，其实挺难的！\n\n说真话不是因为恨，而是因为还在乎。\n\n哎呀，卧槽，不喝点酒，又说多了。\n\n我擦"}}},rest_id:"1917176237971366178",url_entities:$R[159]=[$R[160]={display_url:"d.foresightnews.pro/article/detail…",expanded_url:"https://d.foresightnews.pro/article/detail/83274",indices:$R[161]=[63,86],url:"https://t.co/9JQXVxXZ57"}],views:$R[162]={count:"68988"}}}}},entry_id:"tweet-1917176237971366178",sort_index:"2103761422138736640"},$R[163]={content:$R[164]={__typename:"TimelineTimelineModule",client_event_info:$R[165]={component:"tweet"},display_type:"VerticalConversation",items:$R[166]=[$R[167]={entry_id:"conversationthread-1917258562629194035-tweet-1917258562629194035",item:$R[168]={__typename:"TimelineTimelineItem",client_event_info:$R[169]={component:"tweet",details:$R[170]={conversation_details:$R[171]={conversation_section:"HighQuality"},timelines_details:$R[172]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczHr2AAAAAA=="}},element:"tweet"},content:$R[173]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[174]={id:"VHdlZXRSZXN1bHRzOjE5MTcyNTg1NjI2MjkxOTQwMzU=",rest_id:"1917258562629194035",result:$R[175]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[176]=[],core:$R[177]={user_results:$R[178]={id:"VXNlclJlc3VsdHM6MTA0NzM1NDQ1NTE0NDg1NzYwMA==",result:$R[179]={__typename:"User",avatar:$R[180]={image_url:"https://pbs.twimg.com/profile_images/1892462767107354624/whd4ZJRI_normal.jpg"},core:$R[181]={name:"sherry.apt",screen_name:"sherryxiao"},id:"VXNlcjoxMDQ3MzU0NDU1MTQ0ODU3NjAw",identity_profile_labels_highlighted_label:$R[182]={label:$R[183]={badge:$R[184]={url:"https://pbs.twimg.com/profile_images/1847315245431496704/XlK5TPa2_bigger.jpg"},description:"Aptos Labs",url:$R[185]={url:"https://twitter.com/AptosLabs"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[186]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[187]={followers:39301,following:84},rest_id:"1047354455144857600",super_follow_eligible:!1,tweet_counts:$R[188]={tweets:1374},verification:$R[189]={is_blue_verified:!0}}}},counts:$R[190]={bookmark_count:0,favorite_count:8,quote_count:0,reply_count:3,retweet_count:0},details:$R[191]={cashtag_entities:$R[192]=[],created_at_ms:1745945036000,display_text_range:$R[193]=[31,62],full_text:"@KuiGas @Foresight_News @Aptos 感谢丰密老师在乎，还愿意点评我们，希望之后能继续听到您的声音。",hashtag_entities:$R[194]=[],smarttags:$R[195]=[],timestamp_entities:$R[196]=[]},edit_control:$R[197]={__typename:"EditControlInitial",edit_tweet_ids:$R[198]=["1917258562629194035"]},grok_translated_post_with_availability:$R[199]={is_available:!1},id:"VHdlZXQ6MTkxNzI1ODU2MjYyOTE5NDAzNQ==",legacy:$R[200]={lang:"zh"},media_entities2:$R[201]=[],mention_entities:$R[202]=[$R[203]={id_str:"1372876871990272000",indices:$R[204]=[0,7],screen_name:"KuiGas"},$R[205]={id_str:"1478984642594177027",indices:$R[206]=[8,23],screen_name:"Foresight_News"},$R[207]={id_str:"1491526425580474368",indices:$R[208]=[24,30],screen_name:"Aptos"}],note_tweet:$R[209]={is_expandable:!0,note_tweet_results:$R[210]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTE3MjU4NTYyNTExNzQ5MTIx",result:$R[211]={__typename:"NoteTweet",entity_set:$R[212]={hashtags:$R[213]=[],symbols:$R[214]=[],urls:$R[215]=[],user_mentions:$R[216]=[]},id:"Tm90ZVR3ZWV0OjE5MTcyNTg1NjI1MTE3NDkxMjE=",rest_id:"1917258562511749121",text:"感谢丰密老师在乎，还愿意点评我们，希望之后能继续听到您的声音。\n\n作为一个工程师，确实远不如行业里像各位一样的老兵对这个领域了解得透彻，说得不好的地方还请多包涵。过去一段时间我们团队经历了不少变动，幸运的是，有很多这个领域里很优秀的同事们加入到团队中来，他们都比我有能力比我有经验，也相信因为还有社区里愿意给我们反馈的大家，我们未来才能找到更好的方向。\n\n我也非常希望未来有机会能多向您请教，我们的初衷都是为了让 Aptos 变得更好。"}}},reply_to_results:$R[217]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5MTcxNzYyMzc5NzEzNjYxNzg=",rest_id:"1917176237971366178"},reply_to_user_results:$R[218]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[219]={__typename:"User",core:$R[220]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1917258562629194035",url_entities:$R[221]=[],views:$R[222]={count:"571"}}}}}}],metadata:$R[223]={conversation_metadata:$R[224]={all_tweet_ids:$R[225]=["1917258562629194035"],enable_deduplication:!0}}},entry_id:"conversationthread-1917258562629194035",sort_index:"2103761422138736630"},$R[226]={content:$R[227]={__typename:"TimelineTimelineModule",client_event_info:$R[228]={component:"tweet"},display_type:"VerticalConversation",items:$R[229]=[$R[230]={entry_id:"conversationthread-1917192440177684904-tweet-1917192440177684904",item:$R[231]={__typename:"TimelineTimelineItem",client_event_info:$R[232]={component:"tweet",details:$R[233]={conversation_details:$R[234]={conversation_section:"HighQuality"},timelines_details:$R[235]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczHr2AAAAAA=="}},element:"tweet"},content:$R[236]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[237]={id:"VHdlZXRSZXN1bHRzOjE5MTcxOTI0NDAxNzc2ODQ5MDQ=",rest_id:"1917192440177684904",result:$R[238]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[239]=[],core:$R[240]={user_results:$R[241]={id:"VXNlclJlc3VsdHM6MTQ0Mjc5MzYzNjAyMjgwODU3OA==",result:$R[242]={__typename:"User",avatar:$R[243]={image_url:"https://pbs.twimg.com/profile_images/2024277599879651328/SnOzVJ5I_normal.jpg"},core:$R[244]={name:"ALERT的会所",screen_name: