1d2f490 r-bqkkf0 r-ywje51 r-dnmrzs r-u8s1d r-zchlnj r-1plcrui r-ipm5af r-lrvibr r-1blnp2b"><g><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path><path d="M 10,30 C 69,202 160,199 49,96 h 187 s 202,145 198,155 C 76,207 117,30 103,83 h 130 s 136,169 80,214 C 127,143 102,35 59,31 h 251 s 51,4 46,50 C 147,138 103,26 245,239 h 66 s 227,111 230,49 C 71,98 142,81 255,5 h 211 s 150,37 111,19 C 230,50 234,228 54,156 h 162 s 208,160 96,198 C 89,244 151,38 149,147 h 199 s 160,124 148,176 C 198,146 6,174 164,101 h 109 s 45,227 203,77 C 96,35 184,78 129,209 h 113 s 236,129 187,87 C 175,84 98,10 213,9 h 198 s 234,78 64,180 C 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="P8oLk6RHox4v+Q8ZUpS0ng==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="P8oLk6RHox4v+Q8ZUpS0ng==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410903749,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410903749,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1937542066449617162␀{}",u:1790410904140,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1937542066449617162",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1937542066449617162",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"Allin Layer2，让我拿到非常大的结果，但是也让我付出了非常大的惨痛的代价。\n这里不仅仅是资金上的损失，\n而是机会成本、机会成本、机会成本\n\n机会成本1:   $OP\n在Allin Layer2时期，我个人当时非常坚定地判断 OP 会是第一个发币的项目，这个判断来自于站在项目方与资本的视角所做出的决策。我依然清楚地记得，快照那天我还刷了 50 个号，不断的加号加号加号，最后复盘OP 的空投，均值单号大约在 $5500，这些代币我拿了一年多才卖出，发币后有一段时间跌的很惨，甚至在 $1+ 时继续加仓，我确实算是「钻石手」。但如果在上线卖出换成ETH或者其他资产可以创造更大的价值。\n\n机会成本2: $ARB\n\nARB发币上线好像1.3左右，之后到过1.7+，我拿了1年多才卖，直到24年2-3月才陆续在2.1卖掉。花了很长时间才claim完空投并且未归集，当时经历了一组钱包20个地址被盗丢失75000枚ARB（单号3750），吓的我赶紧把链上大部分代币归集到交易所，之后积极参与arb生态治理，当时在治理榜单委托总量全球第8，华语第1，委托地址数全球第2，在这持仓的1年多里，机会成本巨大。\n\n知道现在，我依然持有ARB，没有原因，因为热爱。\n\n机会成本3: $STRK\n我曾经说过我100%命中塔子哥，strk上线2块多钱吧，上线2块多，当时我陆续在挂单卖arb，我发现机会成本太高，选择陆续出货，塔子哥也在我的卖出清单，我已经有一套完整的卖出计划，第一时间卖出了1/3，但是由于有一部分转账到不用的okx交易所账号，未及时发现，后续看到的时候已经跌到1块多了，少卖了几十万U。但是现在来看，依然卖在了非常高的位置。毕竟塔子哥跌的实在太多了。跌幅95%。\n\n但撸猫人都应该感谢塔子哥，yyds，简单极致的大空投。\n\n机会成本4: $ZK\n\nzk上线fdv与盘前价格差很多，开盘的时候我个人没有卖出任何一颗zk，6个月后，才开始第一次在0.18+开始卖，均值算下来也就0.2+。现在回头来看，zk从去年底到现在跌掉了85%。\n\n我第一笔卖出的时候是340多万颗，如果换到现在的价格，只剩下当初卖的1/4。\n\n当然还有很多空投，比如 $W ，我就不一一细说了。\n\n说实话，这个周期变化之快，很多人还没反应过来（包括我个人），行情就已经走远了，期待的山寨毫无音讯。\n所以我想说的是：\n对我们这种一穷二白、靠手撸起家的屌丝来说，「如何卖出」，才是这一轮必须掌握的核心技能。\n\n说起来简单，不过是几个字；\n但做起来太难，\n每一个认真撸出来的项目，背后都是无数个深夜的调研、测试、反复交互，日积月累早已嵌入自己深深的感情在其中。\n撸到空投的那一刻，就像是亲手种出来的果实，甚至像自己的孩子一样，\n怎么忍心立刻卖掉？\n就算卖掉也是经历千百万次的心里拉扯，\n知道该卖，可就是点不下那个鼠标。。\n就像年少时第一次分手，\n明知道不合适，却怎么都说不出口那2个字。\n\n所以才懂得第一次的重要性。\n后来我才明白，才懂得，第一次的重要性。\n「卖出，分手，是一门必修课」\n\n我们必须学会：\n\n市场不会奖励感情用事，\n\n能卖掉的，才是属于你的",canonicalPath:"/KuiGas/status/1937542066449617162",canonicalUrl:"https://x.com/KuiGas/status/1937542066449617162",description:"Allin Layer2，让我拿到非常大的结果，但是也让我付出了非常大的惨痛的代价。\n这里不仅仅是资金上的损失，\n而是机会成本、机会成本、机会成本\n\n机会成本1:   $OP\n在Allin Layer2时期，我个人当时非常坚定地判断 OP 会是第一个发币的项目，这个判断来自于站在项目方与资本的视角所做出的决策。我依然清楚地记得，快照那天我还刷了 50 个号，不断的加号加号加号，最后复盘OP 的空投，均值单号大约在 $5500，这些代币我拿了一年多才卖出，发币后有一段时间跌的很惨，甚至在 $1+ 时继续加仓，我确实算是「钻石手」。但如果在上线卖出换成ETH或者其他资产可以创造更大的价值。\n\n机会成本2: $ARB\n\nARB发币上线好像1.3左右，之后到过1.7+，我拿了1年多才卖，直到24年2-3月才陆续在2.1卖掉。花了很长时间才claim完空投并且未归集，当时经历了一组钱包20个地址被盗丢失75000枚ARB（单号3750），吓的我赶紧把链上大部分代币归集到交易所，之后积极参与arb生态治理，当时在治理榜单委托总量全球第8，华语第1，委托地址数全球第2，在这持仓的1年多里，机会成本巨大。\n\n知道现在，我依然持有ARB，没有原因，因为热爱。\n\n机会成本3: $STRK\n我曾经说过我100%命中塔子哥，strk上线2块多钱吧，上线2块多，当时我陆续在挂单卖arb，我发现机会成本太高，选择陆续出货，塔子哥也在我的卖出清单，我已经有一套完整的卖出计划，第一时间卖出了1/3，但是由于有一部分转账到不用的okx交易所账号，未及时发现，后续看到的时候已经跌到1块多了，少卖了几十万U。但是现在来看，依然卖在了非常高的位置。毕竟塔子哥跌的实在太多了。跌幅95%。\n\n但撸猫人都应该感谢塔子哥，yyds，简单极致的大空投。\n\n机会成本4: $ZK\n\nzk上线fdv与盘前价格差很多，开盘的时候我个人没有卖出任何一颗zk，6个月后，才开始第一次在0.18+开始卖，均值算下来也就0.2+。现在回头来看，zk从去年底到现在跌掉了85%。\n\n我第一笔卖出的时候是340多万颗，如果换到现在的价格，只剩下当初卖的1/4。\n\n当然还有很多空投，比如 $W ，我就不一一细说了。\n\n说实话，这个周期变化之快，很多人还没反应过来（包括我个人），行情就已经走远了，期待的山寨毫无音讯。\n所以我想说的是：\n对我们这种一穷二白、靠手撸起家的屌丝来说，「如何卖出」，才是这一轮必须掌握的核心技能。\n\n说起来简单，不过是几个字；\n但做起来太难，\n每一个认真撸出来的项目，背后都是无数个深夜的调研、测试、反复交互，日积月累早已嵌入自己深深的感情在其中。\n撸到空投的那一刻，就像是亲手种出来的果实，甚至像自己的孩子一样，\n怎么忍心立刻卖掉？\n就算卖掉也是经历千百万次的心里拉扯，\n知道该卖，可就是点不下那个鼠标。。\n就像年少时第一次分手，\n明知道不合适，却怎么都说不出口那2个字。\n\n所以才懂得第一次的重要性。\n后来我才明白，才懂得，第一次的重要性。\n「卖出，分手，是一门必修课」\n\n我们必须学会：\n\n市场不会奖励感情用事，\n\n能卖掉的，才是属于你的",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:1382,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/GuOAq34agAgXVhw?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/GuOAq34agAgXVhw?format=webp&name=small 680w, https://pbs.twimg.com/media/GuOAq34agAgXVhw?format=webp&name=medium 1200w, https://pbs.twimg.com/media/GuOAq34agAgXVhw?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/GuOAq34agAgXVhw?format=webp&name=large",width:1944},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/1937542066449617162",publishedTime:"2025-06-24T16:03:21.000Z",replyCount:81,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/KuiG