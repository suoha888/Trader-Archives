"EditControlInitial",edit_tweet_ids:$R[280]=["1974379005605523682"]},grok_translated_post_with_availability:$R[281]={is_available:!1},id:"VHdlZXQ6MTk3NDM3OTAwNTYwNTUyMzY4Mg==",legacy:$R[282]={lang:"zh"},media_entities2:$R[283]=[],mention_entities:$R[284]=[$R[285]={id_str:"1372876871990272000",indices:$R[286]=[0,7],screen_name:"KuiGas"},$R[287]={id_str:"1622260212798291972",indices:$R[288]=[8,23],screen_name:"chameleon_jeff"}],reply_to_results:$R[289]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5NzQzNzc4NDQyODI0Mzc3NjU=",rest_id:"1974377844282437765"},reply_to_user_results:$R[290]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[291]={__typename:"User",core:$R[292]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1974379005605523682",url_entities:$R[293]=[],views:$R[294]={count:"1724"}}}}}}],metadata:$R[295]={conversation_metadata:$R[296]={all_tweet_ids:$R[297]=["1974379005605523682"],enable_deduplication:!0}}},entry_id:"conversationthread-1974379005605523682",sort_index:"2103761142898753516"},$R[298]={content:$R[299]={__typename:"TimelineTimelineModule",client_event_info:$R[300]={component:"tweet"},display_type:"VerticalConversation",items:$R[301]=[$R[302]={entry_id:"conversationthread-1974383416109101520-tweet-1974383416109101520",item:$R[303]={__typename:"TimelineTimelineItem",client_event_info:$R[304]={component:"tweet",details:$R[305]={conversation_details:$R[306]={conversation_section:"HighQuality"},timelines_details:$R[307]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcy3ckAAAAAA=="}},element:"tweet"},content:$R[308]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[309]={id:"VHdlZXRSZXN1bHRzOjE5NzQzODM0MTYxMDkxMDE1MjA=",rest_id:"1974383416109101520",result:$R[310]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[311]=[],core:$R[312]={user_results:$R[313]={id:"VXNlclJlc3VsdHM6MTQ1NTQzMDMxODQxMjgyMDQ4MQ==",result:$R[314]={__typename:"User",avatar:$R[315]={image_url:"https://pbs.twimg.com/profile_images/1745401326992003072/zO6vHzd4_normal.jpg"},core:$R[316]={name:"Arya@羊姐社区🦅",screen_name:"Arya_web3"},id:"VXNlcjoxNDU1NDMwMzE4NDEyODIwNDgx",identity_profile_labels_highlighted_label:$R[317]={},privacy:$R[318]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[319]={followers:43416,following:4878},rest_id:"1455430318412820481",super_follow_eligible:!1,tweet_counts:$R[320]={tweets:15620},verification:$R[321]={is_blue_verified:!0}}}},counts:$R[322]={bookmark_count:0,favorite_count:3,quote_count:0,reply_count:1,retweet_count:0},details:$R[323]={cashtag_entities:$R[324]=[],created_at_ms:1759564663000,display_text_range:$R[325]=[24,37],full_text:"@KuiGas @chameleon_jeff 信息量满满 够撸毛一阵子了",hashtag_entities:$R[326]=[],smarttags:$R[327]=[],timestamp_entities:$R[328]=[]},edit_control:$R[329]={__typename:"EditControlInitial",edit_tweet_ids:$R[330]=["1974383416109101520"]},grok_translated_post_with_availability:$R[331]={is_available:!1},id:"VHdlZXQ6MTk3NDM4MzQxNjEwOTEwMTUyMA==",legacy:$R[332]={lang:"zh"},media_entities2:$R[333]=[],mention_entities:$R[334]=[$R[335]={id_str:"1372876871990272000",indices:$R[336]=[0,7],screen_name:"KuiGas"},$R[337]={id_str:"1622260212798291972",indices:$R[338]=[8,23],screen_name:"chameleon_jeff"}],reply_to_results:$R[339]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5NzQzNzc4NDQyODI0Mzc3NjU=",rest_id:"1974377844282437765"},reply_to_user_results:$R[340]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[341]={__typename:"User",core:$R[342]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1974383416109101520",url_entities:$R[343]=[],views:$R[344]={count:"2024"}}}}}}],metadata:$R[345]={conversation_metadata:$R[346]={all_tweet_ids:$R[347]=["1974383416109101520"],enable_deduplication:!0}}},entry_id:"conversationthread-1974383416109101520",sort_index:"2103761142898753506"}]},$R[348]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[349]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[350]={id:"VHdlZXRSZXN1bHRzOjE5NzQzNzc4NDQyODI0Mzc3NjU=",rest_id:"1974377844282437765",result:$R[351]={__typename:"Tweet",core:$R[352]={user_results:$R[353]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[354]={__typename:"User",avatar:$R[355]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[356]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[357]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[358]={favorite_count:292,reply_count:74},details:$R[359]={full_text:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE https://t.co/9LqKvEcCVE",smarttags:$R[360]=[]},id:"VHdlZXQ6MTk3NDM3Nzg0NDI4MjQzNzc2NQ==",note_tweet:$R[361]={note_tweet_results:$R[362]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc0Mzc3ODQ0MDM0OTczNjk4",result:$R[363]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5NzQzNzc4NDQwMzQ5NzM2OTg=",text:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE 生态中所有项目的潜在机会点：我之前已经花了很多时间在HYPE生态投研，「生态拼图」里因为有强车头带动，如果考虑生态飞轮效应，局部的财富效应协议应该也会非常明显。\n\n2、我想到的是交易所的产品布局与我们的机会（如Aster，或者其他潜在Aster）\n\n在丰密看来，交易所的最大功能始终是「资产发行+交易」，这两个环节串起来，就是财富创造的闭环，\n\n前者引领财富效应与注意力，后者则构建流动性中心，撮合供需、形成价格。\n\n我把交易所的产品分为：\n进攻型产品、护城河产品、旗舰型产品、战略级产品\n\nHYPE如此优秀，其实是蚕食了Binance等一众CEX交易所的市场份额，其实就是抢占了交易所的交易特别是合约模块份额。\n\n试着思考一下，如果HYPE哪一天超过了Binance，如果换位思考CZ大表哥@cz_binance，这是肯定不被希望发生的。CZ 把 Binance 打造得如此成功，表面上当然希望有更多友商、更多巨兽来竞争，\n\n但站在自身角度，他绝不会希望有人真正颠覆 Binance，\n\n蚕食Binance的份额与领先地位，这就像一句老话：\n\n“又怕兄弟哭，又怕兄弟开路虎。”\n\n允许你竞争，但不允许也不希望你把我干趴在沙滩山！\n\n去年底我投资Aster时，核心思考点就是：它到底属于什么类型的产品？\n\n最开始的结论是，Aster是进攻型产品，因为BSC 生态急需一款收益型稳定币 + 衍生品交易的协同产品，而Aster当时提供了asUSDF/asBNB等各种AU积分，永续合约交易则是积累Rh积分，说白了，这种产品既能护城，又能进攻。\n\n随着 CZ 在 Aster 尚未发币前不断喊单，这其实已经表明了：\n\nBinance 想要用 Aster 来对标 HYPE。\n\n但从另一个角度看，Aster 也是 Binance 的护城河产品。Aster随之变成进攻+防守+旗舰产品\n\nAster发币之后，肉眼可见的是：Aster是战略级产品。\n\n什么是战略级产品，就是\n\n叙事已经决定了它只能成功，不能失败。\n\n只允许成功，不允许失败，\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n我是这么理解的，也是这么认为的，可能是片面的，\n\n也是我为什么会在之前所说，无论是投，撸，炒，我认为aster是个大机会，我在投了之后，撸了，2级失败了，深刻反思自己在大机会面前的准备不够充分，这种失败其实不可原谅，失败的不是没赚到钱，是因为大机会面前没有足够的聚焦，没有足够的准备。\n\n同样的思路，我一直在想是不是其他类型的产品依然有这样的机会，回来之后我又重新打开YZI LABS @yzilabs投的所有项目，其实已经看了无数变了，但是依然觉得会错过些啥，想看看每个产品到底是亲儿子系列，还是上面所说的产品类型。\n\n1、比如@OpenEden_X，这个项目直接上了Binance ，FDV直接飙到10个亿，非常令人意外，但细想之余好像也没问题，我认为这个就是个防守型产品，对标ONDO，OpenEden主攻RWA方向，核心产品是USDO ，全球首个受监管的、完全由代币化美国国债支持的收益型稳定币，投资机构里就只有YZI是2024年9月份做的战投，RWA方向绝对是潜力方向，市场容量与空间非常大。OpenEden 的增长动能持续强劲，许多项目在积分活动结束后 TVL 会回落，而 OpenEden 不仅在上市前保留了大部分 TVL，TGE 之后 TVL 还继续增长，OpenEden 最近宣布了与STBL 和 Plasma 的合作，这种外延扩展，意味着 OpenEden 已经逐步从一个单点产品，走向护城河型生态。\n\n2、比如@opinionlabsxyz，预测市场，@Polymarket已经有发币苗头了，团队已经释放一些消息，也有博主给出9B估值，毫无疑问项目方是希望FDV直接百亿美金起步，取了个中间值，试试市场热度。另外就Limitless @trylimitless，马上要在kaito打新，热度也很高，YZI投领投的这个O.LAB  @opinionlabsxyz，也是个预测市场，重点是BSC生态的，重点跟踪吧！\n\n3、比如@StableStock，专注于股票市场的 RWA 协议，yzi做了种子轮投资，这个方向的天花板无敌高，关注就对了。\n\n4、比如@brevis_zk ZK全链数据公证平台，Celer Network 联合创始人董沫老师做的，也是iosg合伙人，重点是nomad也在其列，应该是个潜在的buildpad标的。未来binance是稳了。卧槽，我真想投点啊。\n\n5、比如@aPriori 这个是monad原生协议，monad马上要发币了，aPriori 是其生态最重磅协议之一，MEV 基础设施和流动性质押，最近上了活动，无脑冲就对了。\n\n6、等空了继续补充，\n\n诚然，撸毛人/投资人，其实是投研人Alpha 人，本质上是要做信息与逻辑的先知。"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1974377844282437765:none:default"><ul><li><div class="outline-blue-500 tr