 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="5l+/Szyp0O/vzVKF7HDyZw==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410716254,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410716254,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1974377844282437765␀{}",u:1790410716600,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1974377844282437765",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1974377844282437765",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE 生态中所有项目的潜在机会点：我之前已经花了很多时间在HYPE生态投研，「生态拼图」里因为有强车头带动，如果考虑生态飞轮效应，局部的财富效应协议应该也会非常明显。\n\n2、我想到的是交易所的产品布局与我们的机会（如Aster，或者其他潜在Aster）\n\n在丰密看来，交易所的最大功能始终是「资产发行+交易」，这两个环节串起来，就是财富创造的闭环，\n\n前者引领财富效应与注意力，后者则构建流动性中心，撮合供需、形成价格。\n\n我把交易所的产品分为：\n进攻型产品、护城河产品、旗舰型产品、战略级产品\n\nHYPE如此优秀，其实是蚕食了Binance等一众CEX交易所的市场份额，其实就是抢占了交易所的交易特别是合约模块份额。\n\n试着思考一下，如果HYPE哪一天超过了Binance，如果换位思考CZ大表哥@cz_binance，这是肯定不被希望发生的。CZ 把 Binance 打造得如此成功，表面上当然希望有更多友商、更多巨兽来竞争，\n\n但站在自身角度，他绝不会希望有人真正颠覆 Binance，\n\n蚕食Binance的份额与领先地位，这就像一句老话：\n\n“又怕兄弟哭，又怕兄弟开路虎。”\n\n允许你竞争，但不允许也不希望你把我干趴在沙滩山！\n\n去年底我投资Aster时，核心思考点就是：它到底属于什么类型的产品？\n\n最开始的结论是，Aster是进攻型产品，因为BSC 生态急需一款收益型稳定币 + 衍生品交易的协同产品，而Aster当时提供了asUSDF/asBNB等各种AU积分，永续合约交易则是积累Rh积分，说白了，这种产品既能护城，又能进攻。\n\n随着 CZ 在 Aster 尚未发币前不断喊单，这其实已经表明了：\n\nBinance 想要用 Aster 来对标 HYPE。\n\n但从另一个角度看，Aster 也是 Binance 的护城河产品。Aster随之变成进攻+防守+旗舰产品\n\nAster发币之后，肉眼可见的是：Aster是战略级产品。\n\n什么是战略级产品，就是\n\n叙事已经决定了它只能成功，不能失败。\n\n只允许成功，不允许失败，\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n我是这么理解的，也是这么认为的，可能是片面的，\n\n也是我为什么会在之前所说，无论是投，撸，炒，我认为aster是个大机会，我在投了之后，撸了，2级失败了，深刻反思自己在大机会面前的准备不够充分，这种失败其实不可原谅，失败的不是没赚到钱，是因为大机会面前没有足够的聚焦，没有足够的准备。\n\n同样的思路，我一直在想是不是其他类型的产品依然有这样的机会，回来之后我又重新打开YZI LABS @yzilabs投的所有项目，其实已经看了无数变了，但是依然觉得会错过些啥，想看看每个产品到底是亲儿子系列，还是上面所说的产品类型。\n\n1、比如@OpenEden_X，这个项目直接上了Binance ，FDV直接飙到10个亿，非常令人意外，但细想之余好像也没问题，我认为这个就是个防守型产品，对标ONDO，OpenEden主攻RWA方向，核心产品是USDO ，全球首个受监管的、完全由代币化美国国债支持的收益型稳定币，投资机构里就只有YZI是2024年9月份做的战投，RWA方向绝对是潜力方向，市场容量与空间非常大。OpenEden 的增长动能持续强劲，许多项目在积分活动结束后 TVL 会回落，而 OpenEden 不仅在上市前保留了大部分 TVL，TGE 之后 TVL 还继续增长，OpenEden 最近宣布了与STBL 和 Plasma 的合作，这种外延扩展，意味着 OpenEden 已经逐步从一个单点产品，走向护城河型生态。\n\n2、比如@opinionlabsxyz，预测市场，@Polymarket已经有发币苗头了，团队已经释放一些消息，也有博主给出9B估值，毫无疑问项目方是希望FDV直接百亿美金起步，取了个中间值，试试市场热度。另外就Limitless @trylimitless，马上要在kaito打新，热度也很高，YZI投领投的这个O.LAB  @opinionlabsxyz，也是个预测市场，重点是BSC生态的，重点跟踪吧！\n\n3、比如@StableStock，专注于股票市场的 RWA 协议，yzi做了种子轮投资，这个方向的天花板无敌高，关注就对了。\n\n4、比如@brevis_zk ZK全链数据公证平台，Celer Network 联合创始人董沫老师做的，也是iosg合伙人，重点是nomad也在其列，应该是个潜在的buildpad标的。未来binance是稳了。卧槽，我真想投点啊。\n\n5、比如@aPriori 这个是monad原生协议，monad马上要发币了，aPriori 是其生态最重磅协议之一，MEV 基础设施和流动性质押，最近上了活动，无脑冲就对了。\n\n6、等空了继续补充，\n\n诚然，撸毛人/投资人，其实是投研人Alpha 人，本质上是要做信息与逻辑的先知。",canonicalPath:"/KuiGas/status/1974377844282437765",canonicalUrl:"https://x.com/KuiGas/status/1974377844282437765",description:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE 生态中所有项目的潜在机会点：我之前已经花了很多时间在HYPE生态投研，「生态拼图」里因为有强车头带动，如果考虑生态飞轮效应，局部的财富效应协议应该也会非常明显。\n\n2、我想到的是交易所的产品布局与我们的机会（如Aster，或者其他潜在Aster）\n\n在丰密看来，交易所的最大功能始终是「资产发行+交易」，这两个环节串起来，就是财富创造的闭环，\n\n前者引领财富效应与注意力，后者则构建流动性中心，撮合供需、形成价格。\n\n我把交易所的产品分为：\n进攻型产品、护城河产品、旗舰型产品、战略级产品\n\nHYPE如此优秀，其实是蚕食了Binance等一众CEX交易所的市场份额，其实就是抢占了交易所的交易特别是合约模块份额。\n\n试着思考一下，如果HYPE哪一天超过了Binance，如果换位思考CZ大表哥@cz_binance，这是肯定不被希望发生的。CZ 把 Binance 打造得如此成功，表面上当然希望有更多友商、更多巨兽来竞争，\n\n但站在自身角度，他绝不会希望有人真正颠覆 Binance，\n\n蚕食Binance的份额与领先地位，这就像一句老话：\n\n“又怕兄弟哭，又怕兄弟开路虎。”\n\n允许你竞争，但不允许也不希望你把我干趴在沙滩山！\n\n去年底我投资Aster时，核心思考点就是：它到底属于什么类型的产品？\n\n最开始的结论是，Aster是进攻型产品，因为BSC 生态急需一款收益型稳定币 + 衍生品交易的协同产品，而Aster当时提供了asUSDF/asBNB等各种AU积分，永续合约交易则是积累Rh积分，说白了，这种产品既能护城，又能进攻。\n\n随着 CZ 在 Aster 尚未发币前不断喊单，这其实已经表明了：\n\nBinance 想要用 Aster 来对标 HYPE。\n\n但从另一个角度看，Aster 也是 Binance 的护城河产品。Aster随之变成进攻+防守+旗舰产品\n\nAster发币之后，肉眼可见的是：Aster是战略级产品。\n\n什么是战略级产品，就是\n\n叙事已经决定了它只能成功，不能失败。\n\n只允许成功，不允许失败，\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n我是这么理解的，也是这么认为的，可能是片面的，\n\n也是我为什么会在之前所说，无论是投，撸，炒，我认为aster是个大机会，我在投了之后，撸了，2级失败了，深刻反思自己在大机会面前的准备不够充分，这种失败其实不可原谅，失败的不是没赚到钱，是因为大机会面前没有足够的聚焦，没有足够的准备。\n\n同样的思路，我一直在想是不是其他类型的产品依然有这样的机会，回来之后我又重新打开YZI LABS @yzilabs投的所有项目，其实已经看了无数变了，但是依然觉得会错过些啥，想看看每个产品到底是亲儿子系列，还是上面所说的产品类型。\n\n1、比如@OpenEden_X，这个项目直接上了Binance ，FDV直接飙到10个亿，非常令人意外，但细想之余好像也没问题，我认为这个就是个防守型产品，对标ONDO，OpenEden主攻RWA方向，核心产品是USDO ，全球首个受监管的、完全由代币化美国国债支持的收益型稳定币，投资机构里就只有YZI是2024年9月份做的战投，RWA方向绝对是潜力方向，市场容量与空间非常大。OpenEden 的增长动能持续强劲，许多项目在积分活动结束后 TVL 会回落，而 OpenEden 不仅在上市前保留了大部分 TVL，TGE 之后 TVL 还继续增长，OpenEden 最近宣布了与STBL 和 Plasma 的合作，这种外延扩展，意味着 OpenEden 已经逐步从一个单点产品，走向护城河型生态。\n\n2、比如@opinionlabsxyz，预测市场，@Polymarket已经有发币苗头了，团队已经释放一些消息，也有博主给出9B估值，毫无疑问项目方是希望FDV直接百亿美金起步，取了个中间值，试试市场热度。另外就Limitless @trylimitless，马上要在kaito打新，热度也很高，YZI投领投的这个O.LAB  @opinionlabsxyz，也是个预测市场，重点是BSC生态的，重点跟踪吧！\n\n3、比如@StableStock，专注于股票市场的 RWA 协议，yzi做了种子轮投资，这个方向的天花板无敌高，关注就对了。\n\n4、比如@brevis_zk ZK全链数据公证平台，Celer Network 联合创始人董沫老师做的，也是iosg合伙人，重点是nomad也在其列，应该是个潜在的buildpad标的。未来binance是稳了。卧槽，我真想投点啊。\n\n5、比如@aPriori 这个是monad原生协议，monad马上要发币了，aPriori 是其生态最重磅协议之一，MEV 基础设施和流动性质押，最近上了活动，无脑冲就对了。\n\n6、等空了继续补充，\n\n诚然，撸毛人/投资人，其实是投研人Alpha 人，本质上是要做信息与逻辑的先知。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:1280,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/G2Zh85-bMAQ9Rzp?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/G2Zh85-bMAQ9Rzp?format=webp&name=small 680w, https://pbs.twimg.com/media/G2Zh85-bMAQ9Rzp?format=webp&name=medium 1200w, https://pbs.twimg.com/media/G2Zh85-bMAQ9Rzp?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/G2Zh85-bMAQ9Rzp?format=webp&name=large",width:1707},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/1974377844282437765",publishedTime:"2025-10-04T07:35:34.000Z",replyCount:74,schema:void 0,socialTitle:"丰密 (@KuiGas) on X",title:"丰密 on X: \"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE 生态中所有项目的潜在机会点：我之前已经花了很多时间在HYPE生态投研，「生态拼图」里因为有强车头带动，如果考虑生态飞轮效应，局部的财富效应协议应该也会非常明显。\n\n2、我想到的是交易所的产品布局与我们的机会（如Aster，或者其他潜在Aster）\n\n在丰密看来，交易所的最大功能始终是「资产发行+交易」，这两个环节串起来，就是财富创造的闭环，\n\n前者引领财富效应与注意力，后者则构建流动性中心，撮合供需、形成价格。\n\n我把交易所的产品分为：\n进攻型产品、护城河产品、旗舰型产品、战略级产品\n\nHYPE如此优秀，其实是蚕食了Binance等一众CEX交易所的市场份额，其实就是抢占了交易所的交易特别是合约模块份额。\n\n试着思考一下，如果HYPE哪一天超过了Binance，如果换位思考CZ大表哥@cz_binance，这是肯定不被希望发生的。CZ 把 Binance 打造得如此成功，表面上当然希望有更多友商、更多巨兽来竞争，\n\n但站在自身角度，他绝不会希望有人真正颠覆 Binance，\n\n蚕食Binance的份额与领先地位，这就像一句老话：\n\n“又怕兄弟哭，又怕兄弟开路虎。”\n\n允许你竞争，但不允许也不希望你把我干趴在沙滩山！\n\n去年底我投资Aster时，核心思考点就是：它到底属于什么类型的产品？\n\n最开始的结论是，Aster是进攻型产品，因为BSC 生态急需一款收益型稳定币 + 衍生品交易的协同产品，而Aster当时提供了asUSDF/asBNB等各种AU积分，永续合约交易则是积累Rh积分，说白了，这种产品既能护城，又能进攻。\n\n随着 CZ 在 Aster 尚未发币前不断喊单，这其实已经表明了：\n\nBinance 想要用 Aster 来对标 HYPE。\n\n但从另一个角度看，Aster 也是 Binance 的护城河产品。Aster随之变成进攻+防守+旗舰产品\n\nAster发币之后，肉眼可见的是：Aster是战略级产品。\n\n什么是战略级产品，就是\n\n叙事已经决定了它只能成功，不能失败。\n\n只允许成功，不允许失败，\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n我是这么理解的，也是这么认为的，可能是片面的，\n\n也是我为什么会在之前所说，无论是投，撸，炒，我认为aster是个大机会，我在投了之后，撸了，2级失败了，深刻反思自己在大机会面前的准备不够充分，这种失败其实不可原谅，失败的不是没赚到钱，是因为大机会面前没有足够的聚焦，没有足够的准备。\n\n同样的思路，我一直在想是不是其他类型的产品依然有这样的机会，回来之后我又重新打开YZI LABS @yzilabs投的所有项目，其实已经看了无数变了，但是依然觉得会错过些啥，想看看每个产品到底是亲儿子系列，还是上面所说的产品类型。\n\n1、比如@OpenEden_X，这个项目直接上了Binance ，FDV直接飙到10个亿，非常令人意外，但细想之余好像也没问题，我认为这个就是个防守型产品，对标ONDO，OpenEden主攻RWA方向，核心产品是USDO ，全球首个受监管的、完全由代币化美国国债支持的收益型稳定币，投资机构里就只有YZI是2024年9月份做的战投，RWA方向绝对是潜力方向，市场容量与空间非常大。OpenEden 的增长动能持续强劲，许多项目在积分活动结束后 TVL 会回落，而 OpenEden 不仅在上市前保留了大部分 TVL，TGE 之后 TVL 还继续增长，OpenEden 最近宣布了与STBL 和 Plasma 的合作，这种外延扩展，意味着 OpenEden 已经逐步从一个单点产品，走向护城河型生态。\n\n2、比如@opinionlabsxyz，预测市场，@Polymarket已经有发币苗头了，团队已经释放一些消息，也有博主给出9B估值，毫无疑问项目方是希望FDV直接百亿美金起步，取了个中间值，试试市场热度。另外就Limitless @trylimitless，马上要在kaito打新，热度也很高，YZI投领投的这个O.LAB  @opinionlabsxyz，也是个预测市场，重点是BSC生态的，重点跟踪吧！\n\n3、比如@StableStock，专注于股票市场的 RWA 协议，yzi做了种子轮投资，这个方向的天花板无敌高，关注就对了。\n\n4、比如@brevis_zk ZK全链数据公证平台，Celer Network 联合创始人董沫老师做的，也是iosg合伙人，重点是nomad也在其列，应该是个潜在的buildpad标的。未来binance是稳了。卧槽，我真想投点啊。\n\n5、比如@aPriori 这个是monad原生协议，monad马上要发币了，aPriori 是其生态最重磅协议之一，MEV 基础设施和流动性质押，最近上了活动，无脑冲就对了。\n\n6、等空了继续补充，\n\n诚然，撸毛人/投资人，其实是投研人Alpha 人，本质上是要做信息与逻辑的先知。\""},replyCount:74,screenName:"KuiGas",status:"available",text:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE 生态中所有项目的潜在机会点：我之前已经花了很多时间在HYPE生态投研，「生态拼图」里因为有强车头带动，如果考虑生态飞轮效应，局部的财富效应协议应该也会非常明显。\n\n2、我想到的是交易所的产品布局与我们的机会（如Aster，或者其他潜在Aster）\n\n在丰密看来，交易所的最大功能始终是「资产发行+交易」，这两个环节串起来，就是财富创造的闭环，\n\n前者引领财富效应与注意力，后者则构建流动性中心，撮合供需、形成价格。\n\n我把交易所的产品分为：\n进攻型产品、护城河产品、旗舰型产品、战略级产品\n\nHYPE如此优秀，其实是蚕食了Binance等一众CEX交易所的市场份额，其实就是抢占了交易所的交易特别是合约模块份额。\n\n试着思考一下，如果HYPE哪一天超过了Binance，如果换位思考CZ大表哥@cz_binance，这是肯定不被希望发生的。CZ 把 Binance 打造得如此成功，表面上当然希望有更多友商、更多巨兽来竞争，\n\n但站在自身角度，他绝不会希望有人真正颠覆 Binance，\n\n蚕食Binance的份额与领先地位，这就像一句老话：\n\n“又怕兄弟哭，又怕兄弟开路虎。”\n\n允许你竞争，但不允许也不希望你把我干趴在沙滩山！\n\n去年底我投资Aster时，核心思考点就是：它到底属于什么类型的产品？\n\n最开始的结论是，Aster是进攻型产品，因为BSC 生态急需一款收益型稳定币 + 衍生品交易的协同产品，而Aster当时提供了asUSDF/asBNB等各种AU积分，永续合约交易则是积累Rh积分，说白了，这种产品既能护城，又能进攻。\n\n随着 CZ 在 Aster 尚未发币前不断喊单，这其实已经表明了：\n\nBinance 想要用 Aster 来对标 HYPE。\n\n但从另一个角度看，Aster 也是 Binance 的护城河产品。Aster随之变成进攻+防守+旗舰产品\n\nAster发币之后，肉眼可见的是：Aster是战略级产品。\n\n什么是战略级产品，就是\n\n叙事已经决定了它只能成功，不能失败。\n\n只允许成功，不允许失败，\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n我是这么理解的，也是这么认为的，可能是片面的，\n\n也是我为什么会在之前所说，无论是投，撸，炒，我认为aster是个大机会，我在投了之后，撸了，2级失败了，深刻反思自己在大机会面前的准备不够充分，这种失败其实不可原谅，失败的不是没赚到钱，是因为大机会面前没有足够的聚焦，没有足够的准备。\n\n同样的思路，我一直在想是不是其他类型的产品依然有这样的机会，回来之后我又重新打开YZI LABS @yzilabs投的所有项目，其实已经看了无数变了，但是依然觉得会错过些啥，想看看每个产品到底是亲儿子系列，还是上面所说的产品类型。\n\n1、比如@OpenEden_X，这个项目直接上了Binance ，FDV直接飙到10个亿，非常令人意外，但细想之余好像也没问题，我认为这个就是个防守型产品，对标ONDO，OpenEden主攻RWA方向，核心产品是USDO ，全球首个受监管的、完全由代币化美国国债支持的收益型稳定币，投资机构里就只有YZI是2024年9月份做的战投，RWA方向绝对是潜力方向，市场容量与空间非常大。OpenEden 的增长动能持续强劲，许多项目在积分活动结束后 TVL 会回落，而 OpenEden 不仅在上市前保留了大部分 TVL，TGE 之后 TVL 还继续增长，OpenEden 最近宣布了与STBL 和 Plasma 的合作，这种外延扩展，意味着 OpenEden 已经逐步从一个单点产品，走向护城河型生态。\n\n2、比如@opinionlabsxyz，预测市场，@Polymarket已经有发币苗头了，团队已经释放一些消息，也有博主给出9B估值，毫无疑问项目方是希望FDV直接百亿美金起步，取了个中间值，试试市场热度。另外就Limitless @trylimitless，马上要在kaito打新，热度也很高，YZI投领投的这个O.LAB  @opinionlabsxyz，也是个预测市场，重点是BSC生态的，重点跟踪吧！\n\n3、比如@StableStock，专注于股票市场的 RWA 协议，yzi做了种子轮投资，这个方向的天花板无敌高，关注就对了。\n\n4、比如@brevis_zk ZK全链数据公证平台，Celer Network 联合创始人董沫老师做的，也是iosg合伙人，重点是nomad也在其列，应该是个潜在的buildpad标的。未来binance是稳了。卧槽，我真想投点啊。\n\n5、比如@aPriori 这个是monad原生协议，monad马上要发币了，aPriori 是其生态最重磅协议之一，MEV 基础设施和流动性质押，最近上了活动，无脑冲就对了。\n\n6、等空了继续补充，\n\n诚然，撸毛人/投资人，其实是投研人Alpha 人，本质上是要做信息与逻辑的先知。"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[14]={messagesBeforeDehydration:$R[15]=[$R[16]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1974377844282437765\"}",name:"TweetResultByRestId"},$R[17]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1974377844282437765\"}",result:$R[18]={kind:"Result.Ok",value:$R[19]={data:$R[20]={tweet_result_by_rest_id:$R[21]={id:"VHdlZXRSZXN1bHRzOjE5NzQzNzc4NDQyODI0Mzc3NjU=",rest_id:"1974377844282437765",result:$R[22]={__typename:"Tweet",cashtag_attachments:$R[23]=[],core:$R[24]={user_results:$R[25]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[26]={__typename:"User",avatar:$R[27]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[28]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[29]={},privacy:$R[30]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[31]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[32]={tweets:9451},verification:$R[33]={is_blue_verified:!0}}}},counts:$R[34]={bookmark_count:140,favorite_count:292,quote_count:5,reply_count:74,retweet_count:49},details:$R[35]={cashtag_entities:$R[36]=[],created_at_ms:1759563334000,display_text_range:$R[37]=[0,159],full_text:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE https://t.co/9LqKvEcCVE",hashtag_entities:$R[38]=[],smarttags:$R[39]=[],timestamp_entities:$R[40]=[]},edit_control:$R[41]={__typename:"EditControlInitial",edit_tweet_ids:$R[42]=["1974377844282437765"]},grok_translated_post_with_availability:$R[43]={is_available:!1},id:"VHdlZXQ6MTk3NDM3Nzg0NDI4MjQzNzc2NQ==",legacy:$R[44]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[45]=[$R[46]={allow_download_status:$R[47]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1974377844282437765/photo/1",ext_media_availability:$R[48]={status:"Available"},ext_playlists:$R[49]=[],features:$R[50]={},id_str:"1974373185631236100",indices:$R[51]=[160,183],media_url_https:"https://pbs.twimg.com/media/G2Zh85-bMAQ9Rzp.jpg",original_info:$R[52]={height:1280,width:1707},type:"photo"},$R[53]={allow_download_status:$R[54]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1974377844282437765/photo/1",ext_media_availability:$R[55]={status:"Available"},ext_playlists:$R[56]=[],features:$R[57]={},id_str:"1974374568308674560",indices:$R[58]=[160,183],media_url_https:"https://pbs.twimg.com/media/G2ZjNY2akAA1bNf.jpg",original_info:$R[59]={height:666,width:1042},type:"photo"}],mention_entities:$R[60]=[$R[61]={id_str:"1622260212798291972",indices:$R[62]=[20,35],screen_name:"chameleon_jeff"}],note_tweet:$R[63]={is_expandable:!0,note_tweet_results:$R[64]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTc0Mzc3ODQ0MDM0OTczNjk4",result:$R[65]={__typename:"NoteTweet",entity_set:$R[66]={hashtags:$R[67]=[],symbols:$R[68]=[],urls:$R[69]=[],user_mentions:$R[70]=[$R[71]={id_str:"1622260212798291972",indices:$R[72]=[20,35],screen_name:"chameleon_jeff"},$R[73]={id_str:"902926941413453824",indices:$R[74]=[506,517],screen_name:"cz_binance"},$R[75]={id_str:"960036444885565442",indices:$R[76]=[1268,1276],screen_name:"yzilabs"},$R[77]={id_str:"1529032977380179969",indices:$R[78]=[1340,1351],screen_name:"OpenEden_X"},$R[79]={id_str:"1735189899266121728",indices:$R[80]=[1691,1706],screen_name:"opinionlabsxyz"},$R[81]={id_str:"1261335549215989760",indices:$R[82]=[1712,1723],screen_name:"Polymarket"},$R[83]={id_str:"1396594850598957061",indices:$R[84]=[1803,1816],screen_name:"trylimitless"},$R[85]={id_str:"1735189899266121728",indices:$R[86]=[1851,1866],screen_name:"opinionlabsxyz"},$R[87]={id_str:"1939873824943882240",indices:$R[88]=[1897,1909],screen_name:"StableStock"},$R[89]={id_str:"1638098353652404225",indices:$R[90]=[1961,1971],screen_name:"brevis_zk"},$R[91]={id_str:"758931449584062464",indices:$R[92]=[2079,2087],screen_name:"aPriori"}]},id:"Tm90ZVR3ZWV0OjE5NzQzNzc4NDQwMzQ5NzM2OTg=",rest_id:"1974377844034973698",text:"当我第一次在 AMA 上看到 Jeff @chameleon_jeff时，\n\n台上的他意气风发，谈吐轻松而随意。\n\n那一刻，我心里非常清晰地感受到：\n\nHYPE 的未来，还有很多可以发力的地方。\n\nHYPE 这个创始人，可能会让 CZ 们（交易所老板）感受到前所未有的压力。\n\n我脑海里立刻浮现出两点：\n\n1、HYPE 生态中所有项目的潜在机会点：我之前已经花了很多时间在HYPE生态投研，「生态拼图」里因为有强车头带动，如果考虑生态飞轮效应，局部的财富效应协议应该也会非常明显。\n\n2、我想到的是交易所的产品布局与我们的机会（如Aster，或者其他潜在Aster）\n\n在丰密看来，交易所的最大功能始终是「资产发行+交易」，这两个环节串起来，就是财富创造的闭环，\n\n前者引领财富效应与注意力，后者则构建流动性中心，撮合供需、形成价格。\n\n我把交易所的产品分为：\n进攻型产品、护城河产品、旗舰型产品、战略级产品\n\nHYPE如此优秀，其实是蚕食了Binance等一众CEX交易所的市场份额，其实就是抢占了交易所的交易特别是合约模块份额。\n\n试着思考一下，如果HYPE哪一天超过了Binance，如果换位思考CZ大表哥@cz_binance，这是肯定不被希望发生的。CZ 把 Binance 打造得如此成功，表面上当然希望有更多友商、更多巨兽来竞争，\n\n但站在自身角度，他绝不会希望有人真正颠覆 Binance，\n\n蚕食Binance的份额与领先地位，这就像一句老话：\n\n“又怕兄弟哭，又怕兄弟开路虎。”\n\n允许你竞争，但不允许也不希望你把我干趴在沙滩山！\n\n去年底我投资Aster时，核心思考点就是：它到底属于什么类型的产品？\n\n最开始的结论是，Aster是进攻型产品，因为BSC 生态急需一款收益型稳定币 + 衍生品交易的协同产品，而Aster当时提供了asUSDF/asBNB等各种AU积分，永续合约交易则是积累Rh积分，说白了，这种产品既能护城，又能进攻。\n\n随着 CZ 在 Aster 尚未发币前不断喊单，这其实已经表明了：\n\nBinance 想要用 Aster 来对标 HYPE。\n\n但从另一个角度看，Aster 也是 Binance 的护城河产品。Aster随之变成进攻+防守+旗舰产品\n\nAster发币之后，肉眼可见的是：Aster是战略级产品。\n\n什么是战略级产品，就是\n\n叙事已经决定了它只能成功，不能失败。\n\n只允许成功，不允许失败，\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n无论谁来做，都必须把它做成。\n\n我是这么理解的，也是这么认为的，可能是片面的，\n\n也是我为什么会在之前所说，无论是投，撸，炒，我认为aster是个大机会，我在投了之后，撸了，2级失败了，深刻反思自己在大机会面前的准备不够充分，这种失败其实不可原谅，失败的不是没赚到钱，是因为大机会面前没有足够的聚焦，没有足够的准备。\n\n同样的思路，我一直在想是不是其他类型的产品依然有这样的机会，回来之后我又重新打开YZI LABS @yzilabs投的所有项目，其实已经看了无数变了，但是依然觉得会错过些啥，想看看每个产品到底是亲儿子系列，还是上面所说的产品类型。\n\n1、比如@OpenEden_X，这个项目直接上了Binance ，FDV直接飙到10个亿，非常令人意外，但细想之余好像也没问题，我认为这个就是个防守型产品，对标ONDO，OpenEden主攻RWA方向，核心产品是USDO ，全球首个受监管的、完全由代币化美国国债支持的收益型稳定币，投资机构里就只有YZI是2024年9月份做的战投，RWA方向绝对是潜力方向，市场容量与空间非常大。OpenEden 的增长动能持续强劲，许多项目在积分活动结束后 TVL 会回落，而 OpenEden 不仅在上市前保留了大部分 TVL，TGE 之后 TVL 还继续增长，OpenEden 最近宣布了与STBL 和 Plasma 的合作，这种外延扩展，意味着 OpenEden 已经逐步从一个单点产品，走向护城河型生态。\n\n2、比如@opinionlabsxyz，预测市场，@Polymarket已经有发币苗头了，团队已经释放一些消息，也有博主给出9B估值，毫无疑问项目方是希望FDV直接百亿美金起步，取了个中间值，试试市场热度。另外就Limitless @trylimitless，马上要在kaito打新，热度也很高，YZI投领投的这个O.LAB  @opinionlabsxyz，也是个预测市场，重点是BSC生态的，重点跟踪吧！\n\n3、比如@StableStock，专注于股票市场的 RWA 协议，yzi做了种子轮投资，这个方向的天花板无敌高，关注就对了。\n\n4、比如@brevis_zk ZK全链数据公证平台，Celer Network 联合创始人董沫老师做的，也是iosg合伙人，重点是nomad也在其列，应该是个潜在的buildpad标的。未来binance是稳了。卧槽，我真想投点啊。\n\n5、比如@aPriori 这个是monad原生协议，monad马上要发币了，aPriori 是其生态最重磅协议之一，MEV 基础设施和流动性质押，最近上了活动，无脑冲就对了。\n\n6、等空了继续补充，\n\n诚然，撸毛人/投资人，其实是投研人Alpha 人，本质上是要做信息与逻辑的先知。"}}},rest_id:"1974377844282437765",url_entities:$R[93]=[],views:$R[94]={count:"45874"}}}}}}}],graphqlRequestStream:$R[95]=($R[96]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[97]=($R[98]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==">($R=>$R[97].next($R[99]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1974377844282437765\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="5l+/Szyp0O/vzVKF7HDyZw==">($R=>$R[97].next($R[100]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1974377844282437765\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[101]={kind:"Result.Ok",value:$R[102]={data:$R[103]={threaded_conversation_with_injections_v2:$R[104]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[105]=[$R[106]={__typename:"TimelineClearCache"},$R[107]={__typename:"TimelineAddEntries",entries:$R[108]=[$R[109]={content:$R[110]={__typename:"TimelineTimelineItem",client_event_info:$R[111]={component:"tweet",element:"tweet"},content:$R[112]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[113]={id:"VHdlZXRSZXN1bHRzOjE5NzQzNzc4NDQyODI0Mzc3NjU=",rest_id:"1974377844282437765",result:$R[114]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachm