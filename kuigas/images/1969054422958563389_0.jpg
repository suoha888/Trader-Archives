})())}})($R["tsr"]);{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="V7zFx4ehzhtF1neRHxYAag==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="V7zFx4ehzhtF1neRHxYAag==">($R=>$R[72].next($R[74]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1969054422958563389\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="V7zFx4ehzhtF1neRHxYAag==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="V7zFx4ehzhtF1neRHxYAag==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="V7zFx4ehzhtF1neRHxYAag==">($R=>$R[72].next($R[75]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1969054422958563389\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[76]={kind:"Result.Ok",value:$R[77]={data:$R[78]={threaded_conversation_with_injections_v2:$R[79]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[80]=[$R[81]={__typename:"TimelineClearCache"},$R[82]={__typename:"TimelineAddEntries",entries:$R[83]=[$R[84]={content:$R[85]={__typename:"TimelineTimelineItem",client_event_info:$R[86]={component:"tweet",element:"tweet"},content:$R[87]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[88]={id:"VHdlZXRSZXN1bHRzOjE5NjkwNTQ0MjI5NTg1NjMzODk=",rest_id:"1969054422958563389",result:$R[89]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[90]=[],core:$R[91]={user_results:$R[92]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI