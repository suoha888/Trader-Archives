mXZQ+mcWrYojA==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="3foarMZf8mXZQ+mcWrYojA==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410664496,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410664496,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1864656426150580723␀{}",u:1790410664947,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1864656426150580723",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1864656426150580723",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM 的易用性和多功能性与比特币的去中心化和安全性相结合，在比特币之上构建以太坊虚拟机 (EVM)。其定位非常清晰，希望成为比特币DeFi的中心，激活比特币资本市场，解锁比特币链上的万亿美元市场。\n\n如果你关心btc相关的项目，值得测试下\n1️⃣Aragog测试网：\n参与网址：https://t.co/TmLBjsISmt\n银河任务：https://t.co/9hn7Stvys2\nzealy任务：https://t.co/cbANBQ9wrw\n参与方式：配置钱包网络、领水、使用生态Dapp，部署合约或代币等。\n领水：https://t.co/5jtAjNExTq\n教程：文档教程1 https://t.co/yToQkcrUu3\n\n丰密一句话教程：小狐狸🦊打开https://t.co/yaNr74ahNa自动配置网络🛜，复制显示的btc地址到领水网站https://t.co/5jtAjNExTq，领水成功后跳转有一条HASH，点进去复制，粘贴到Register Transaction ID，然后claim，之后去参与下面的各类生态dapp，如果实在不懂，跟着https://t.co/TmLBjsISmt 点击查看教程，部署代币可以看文档教程里面有Ethereum Remix教你如何部署代币。\n另外也可以参与下面的大使计划，附带详细的教程https://t.co/MXjPSq7xk2\n\n2️⃣生态DAPP：\n1、生态：https://t.co/a87ZrlNLOR\n2、 DEX-bitzy：https://t.co/1cpMq7Y28E\n3、借贷-Spindle：https://t.co/7qkK7PkpFL\n4、稳定币-Palladium：https://t.co/ypz21OZpbd\n5、永续DEX-bitperp：https://t.co/9ICP79p8pW\n6、LRT-Rover：https://t.co/Qz5M3UtbPM\n7、社交-slogain：https://t.co/8qwOpWZ3XN\n8、NFT：https://t.co/8Cc9UMhOaA\nBotanix是目前以太坊和比特币核心社区最看好的比特币二层 之一，Chainlink、Aave、Vertex均会部署该网络。\n\n3️⃣ Botanix值得关注\n1、Botanix 利用比特币的工作量证明 (PoW) 作为基础结算和去中心化的第一层，使用权益证明 (PoS) 共识模型，其中权益（以比特币表示）安全地存储在Spiderchain上，Spiderchain 是一个分布式的去中心化多重签名网络，由随机的参与者子集保护。“蜘蛛链”这个名字源于对多重签名钱包的设想，其中蜘蛛的每条“腿”代表不同的参与者。每个比特币区块都与蜘蛛链中一组随机参与者创建的新多重签名相关联。\n2、Botanix EVM 是一种外观、感觉和行为都与以太坊区块链类似的基础设施。不同之处在于，您无需使用 ETH，而是所有内容（gas 费等）都将以 BTC 计价进行交易和执行所有操作。\n3、Botanix Labs总部位于纽约，成立于哈佛商学院， 已经完成 1150 万美元融资，投资方主要有Polychain Capital、Placeholder Capital 等顶级机构以及许多行业领先的投资人支持，其中就有BRC20协议创始人demo，Taproot Wizards 的联合创始人Eric另外还有dovey，AK等\n4、预计明年Q1上线主网，鼓励真实用户积极参与测试。\n5、项目是纯正的海外项目，拥有自己核心的架构与技术特点，项目创始团队好像对比特币 DeFi有强烈的愿景驱动，根据加密媒体报道，其创始人Willem毕业比利时排名第一的大学KU Leuven密码学，之后就读于哈佛MBA，并在就读期间发起了蜘蛛链项目。这里我整个下午我都在挖掘相关线索，发现该项目都是BTC OG大神们个人在支持的项目，对此，我个人也倾向于希望有机会参与投资。\n\n其他媒体网络相关介绍：\n1、吴说区块链播客：《对话 Botanix：做完全去中心化的比特币 Layer 2》\nhttps://t.co/xQO6JjSIc3\n2、解析 Botanix：比特币上第一个完全去中心化的 EVM 等效 L2 https://t.co/KB4GayCnRz\n3、Botanix’s final testnet is now live https://t.co/PTAgzjjjzb\n度假结束的第一天，BTC突破10万大关，BTCFi项目必须要重视起来，未来会持续探索并分享相关项目。\n\n#BTC #Botanix #BTCL2",canonicalPath:"/KuiGas/status/1864656426150580723",canonicalUrl:"https://x.com/KuiGas/status/1864656426150580723",description:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM 的易用性和多功能性与比特币的去中心化和安全性相结合，在比特币之上构建以太坊虚拟机 (EVM)。其定位非常清晰，希望成为比特币DeFi的中心，激活比特币资本市场，解锁比特币链上的万亿美元市场。\n\n如果你关心btc相关的项目，值得测试下\n1️⃣Aragog测试网：\n参与网址：https://t.co/TmLBjsISmt\n银河任务：https://t.co/9hn7Stvys2\nzealy任务：https://t.co/cbANBQ9wrw\n参与方式：配置钱包网络、领水、使用生态Dapp，部署合约或代币等。\n领水：https://t.co/5jtAjNExTq\n教程：文档教程1 https://t.co/yToQkcrUu3\n\n丰密一句话教程：小狐狸🦊打开https://t.co/yaNr74ahNa自动配置网络🛜，复制显示的btc地址到领水网站https://t.co/5jtAjNExTq，领水成功后跳转有一条HASH，点进去复制，粘贴到Register Transaction ID，然后claim，之后去参与下面的各类生态dapp，如果实在不懂，跟着https://t.co/TmLBjsISmt 点击查看教程，部署代币可以看文档教程里面有Ethereum Remix教你如何部署代币。\n另外也可以参与下面的大使计划，附带详细的教程https://t.co/MXjPSq7xk2\n\n2️⃣生态DAPP：\n1、生态：https://t.co/a87ZrlNLOR\n2、 DEX-bitzy：https://t.co/1cpMq7Y28E\n3、借贷-Spindle：https://t.co/7qkK7PkpFL\n4、稳定币-Palladium：https://t.co/ypz21OZpbd\n5、永续DEX-bitperp：https://t.co/9ICP79p8pW\n6、LRT-Rover：https://t.co/Qz5M3UtbPM\n7、社交-slogain：https://t.co/8qwOpWZ3XN\n8、NFT：https://t.co/8Cc9UMhOaA\nBotanix是目前以太坊和比特币核心社区最看好的比特币二层 之一，Chainlink、Aave、Vertex均会部署该网络。\n\n3️⃣ Botanix值得关注\n1、Botanix 利用比特币的工作量证明 (PoW) 作为基础结算和去中心化的第一层，使用权益证明 (PoS) 共识模型，其中权益（以比特币表示）安全地存储在Spiderchain上，Spiderchain 是一个分布式的去中心化多重签名网络，由随机的参与者子集保护。“蜘蛛链”这个名字源于对多重签名钱包的设想，其中蜘蛛的每条“腿”代表不同的参与者。每个比特币区块都与蜘蛛链中一组随机参与者创建的新多重签名相关联。\n2、Botanix EVM 是一种外观、感觉和行为都与以太坊区块链类似的基础设施。不同之处在于，您无需使用 ETH，而是所有内容（gas 费等）都将以 BTC 计价进行交易和执行所有操作。\n3、Botanix Labs总部位于纽约，成立于哈佛商学院， 已经完成 1150 万美元融资，投资方主要有Polychain Capital、Placeholder Capital 等顶级机构以及许多行业领先的投资人支持，其中就有BRC20协议创始人demo，Taproot Wizards 的联合创始人Eric另外还有dovey，AK等\n4、预计明年Q1上线主网，鼓励真实用户积极参与测试。\n5、项目是纯正的海外项目，拥有自己核心的架构与技术特点，项目创始团队好像对比特币 DeFi有强烈的愿景驱动，根据加密媒体报道，其创始人Willem毕业比利时排名第一的大学KU Leuven密码学，之后就读于哈佛MBA，并在就读期间发起了蜘蛛链项目。这里我整个下午我都在挖掘相关线索，发现该项目都是BTC OG大神们个人在支持的项目，对此，我个人也倾向于希望有机会参与投资。\n\n其他媒体网络相关介绍：\n1、吴说区块链播客：《对话 Botanix：做完全去中心化的比特币 Layer 2》\nhttps://t.co/xQO6JjSIc3\n2、解析 Botanix：比特币上第一个完全去中心化的 EVM 等效 L2 https://t.co/KB4GayCnRz\n3、Botanix’s final testnet is now live https://t.co/PTAgzjjjzb\n度假结束的第一天，BTC突破10万大关，BTCFi项目必须要重视起来，未来会持续探索并分享相关项目。\n\n#BTC #Botanix #BTCL2",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:698,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/GeCXHFFa0AQ7eJK?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/GeCXHFFa0AQ7eJK?format=webp&name=small 680w, https://pbs.twimg.com/media/GeCXHFFa0AQ7eJK?format=webp&name=medium 1200w, https://pbs.twimg.com/media/GeCXHFFa0AQ7eJK?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/GeCXHFFa0AQ7eJK?format=webp&name=large",width:1926},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2024-12-05T13:01:50.000Z",replyCount:23,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/BotanixLabs/status/1864325942208082423","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"BotanixLabs",identifier:"1602342563310182401",image:"https://pbs.twimg.com/profile_images/1949580425451507712/gCJjGLl8_400x400.jpg",name:"Botanix 🕷️",url:"https://x.com/BotanixLabs"},datePublished:"2024-12-04T15:08:36.000Z",identifier:"1864325942208082423",url:"https://x.com/BotanixLabs/status/1864325942208082423",engagement:$R[17]=[$R[18]={action:"LikeAction",name:"Likes",url:"https://x.com/BotanixLabs/status/1864325942208082423/likes",count:3219},$R[19]={action:"ShareAction",name:"Retweets",url:"https://x.com/BotanixLabs/status/1864325942208082423/retweets",count:437},$R[20]={action:"ReplyAction",name:"Replies",url:null,count:122},$R[21]={action:"ViewAction",name:"Views",count:262151}],text:"A decentralized Bitcoin L2, fully EVM equivalent, purpose-built for Bitcoin-native DeFi.\n\nBotanix’s final testnet is now live:"}},socialTitle:"丰密 (@KuiGas) on X",title:"丰密 on X: \"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM 的易用性和多功能性与比特币的去中心化和安全性相结合，在比特币之上构建以太坊虚拟机 (EVM)。其定位非常清晰，希望成为比特币DeFi的中心，激活比特币资本市场，解锁比特币链上的万亿美元市场。\n\n如果你关心btc相关的项目，值得测试下\n1️⃣Aragog测试网：\n参与网址：https://t.co/TmLBjsISmt\n银河任务：https://t.co/9hn7Stvys2\nzealy任务：https://t.co/cbANBQ9wrw\n参与方式：配置钱包网络、领水、使用生态Dapp，部署合约或代币等。\n领水：https://t.co/5jtAjNExTq\n教程：文档教程1 https://t.co/yToQkcrUu3\n\n丰密一句话教程：小狐狸🦊打开https://t.co/yaNr74ahNa自动配置网络🛜，复制显示的btc地址到领水网站https://t.co/5jtAjNExTq，领水成功后跳转有一条HASH，点进去复制，粘贴到Register Transaction ID，然后claim，之后去参与下面的各类生态dapp，如果实在不懂，跟着https://t.co/TmLBjsISmt 点击查看教程，部署代币可以看文档教程里面有Ethereum Remix教你如何部署代币。\n另外也可以参与下面的大使计划，附带详细的教程https://t.co/MXjPSq7xk2\n\n2️⃣生态DAPP：\n1、生态：https://t.co/a87ZrlNLOR\n2、 DEX-bitzy：https://t.co/1cpMq7Y28E\n3、借贷-Spindle：https://t.co/7qkK7PkpFL\n4、稳定币-Palladium：https://t.co/ypz21OZpbd\n5、永续DEX-bitperp：https://t.co/9ICP79p8pW\n6、LRT-Rover：https://t.co/Qz5M3UtbPM\n7、社交-slogain：https://t.co/8qwOpWZ3XN\n8、NFT：https://t.co/8Cc9UMhOaA\nBotanix是目前以太坊和比特币核心社区最看好的比特币二层 之一，Chainlink、Aave、Vertex均会部署该网络。\n\n3️⃣ Botanix值得关注\n1、Botanix 利用比特币的工作量证明 (PoW) 作为基础结算和去中心化的第一层，使用权益证明 (PoS) 共识模型，其中权益（以比特币表示）安全地存储在Spiderchain上，Spiderchain 是一个分布式的去中心化多重签名网络，由随机的参与者子集保护。“蜘蛛链”这个名字源于对多重签名钱包的设想，其中蜘蛛的每条“腿”代表不同的参与者。每个比特币区块都与蜘蛛链中一组随机参与者创建的新多重签名相关联。\n2、Botanix EVM 是一种外观、感觉和行为都与以太坊区块链类似的基础设施。不同之处在于，您无需使用 ETH，而是所有内容（gas 费等）都将以 BTC 计价进行交易和执行所有操作。\n3、Botanix Labs总部位于纽约，成立于哈佛商学院， 已经完成 1150 万美元融资，投资方主要有Polychain Capital、Placeholder Capital 等顶级机构以及许多行业领先的投资人支持，其中就有BRC20协议创始人demo，Taproot Wizards 的联合创始人Eric另外还有dovey，AK等\n4、预计明年Q1上线主网，鼓励真实用户积极参与测试。\n5、项目是纯正的海外项目，拥有自己核心的架构与技术特点，项目创始团队好像对比特币 DeFi有强烈的愿景驱动，根据加密媒体报道，其创始人Willem毕业比利时排名第一的大学KU Leuven密码学，之后就读于哈佛MBA，并在就读期间发起了蜘蛛链项目。这里我整个下午我都在挖掘相关线索，发现该项目都是BTC OG大神们个人在支持的项目，对此，我个人也倾向于希望有机会参与投资。\n\n其他媒体网络相关介绍：\n1、吴说区块链播客：《对话 Botanix：做完全去中心化的比特币 Layer 2》\nhttps://t.co/xQO6JjSIc3\n2、解析 Botanix：比特币上第一个完全去中心化的 EVM 等效 L2 https://t.co/KB4GayCnRz\n3、Botanix’s final testnet is now live https://t.co/PTAgzjjjzb\n度假结束的第一天，BTC突破10万大关，BTCFi项目必须要重视起来，未来会持续探索并分享相关项目。\n\n#BTC #Botanix #BTCL2\""},replyCount:23,screenName:"KuiGas",status:"available",text:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM 的易用性和多功能性与比特币的去中心化和安全性相结合，在比特币之上构建以太坊虚拟机 (EVM)。其定位非常清晰，希望成为比特币DeFi的中心，激活比特币资本市场，解锁比特币链上的万亿美元市场。\n\n如果你关心btc相关的项目，值得测试下\n1️⃣Aragog测试网：\n参与网址：https://t.co/TmLBjsISmt\n银河任务：https://t.co/9hn7Stvys2\nzealy任务：https://t.co/cbANBQ9wrw\n参与方式：配置钱包网络、领水、使用生态Dapp，部署合约或代币等。\n领水：https://t.co/5jtAjNExTq\n教程：文档教程1 https://t.co/yToQkcrUu3\n\n丰密一句话教程：小狐狸🦊打开https://t.co/yaNr74ahNa自动配置网络🛜，复制显示的btc地址到领水网站https://t.co/5jtAjNExTq，领水成功后跳转有一条HASH，点进去复制，粘贴到Register Transaction ID，然后claim，之后去参与下面的各类生态dapp，如果实在不懂，跟着https://t.co/TmLBjsISmt 点击查看教程，部署代币可以看文档教程里面有Ethereum Remix教你如何部署代币。\n另外也可以参与下面的大使计划，附带详细的教程https://t.co/MXjPSq7xk2\n\n2️⃣生态DAPP：\n1、生态：https://t.co/a87ZrlNLOR\n2、 DEX-bitzy：https://t.co/1cpMq7Y28E\n3、借贷-Spindle：https://t.co/7qkK7PkpFL\n4、稳定币-Palladium：https://t.co/ypz21OZpbd\n5、永续DEX-bitperp：https://t.co/9ICP79p8pW\n6、LRT-Rover：https://t.co/Qz5M3UtbPM\n7、社交-slogain：https://t.co/8qwOpWZ3XN\n8、NFT：https://t.co/8Cc9UMhOaA\nBotanix是目前以太坊和比特币核心社区最看好的比特币二层 之一，Chainlink、Aave、Vertex均会部署该网络。\n\n3️⃣ Botanix值得关注\n1、Botanix 利用比特币的工作量证明 (PoW) 作为基础结算和去中心化的第一层，使用权益证明 (PoS) 共识模型，其中权益（以比特币表示）安全地存储在Spiderchain上，Spiderchain 是一个分布式的去中心化多重签名网络，由随机的参与者子集保护。“蜘蛛链”这个名字源于对多重签名钱包的设想，其中蜘蛛的每条“腿”代表不同的参与者。每个比特币区块都与蜘蛛链中一组随机参与者创建的新多重签名相关联。\n2、Botanix EVM 是一种外观、感觉和行为都与以太坊区块链类似的基础设施。不同之处在于，您无需使用 ETH，而是所有内容（gas 费等）都将以 BTC 计价进行交易和执行所有操作。\n3、Botanix Labs总部位于纽约，成立于哈佛商学院， 已经完成 1150 万美元融资，投资方主要有Polychain Capital、Placeholder Capital 等顶级机构以及许多行业领先的投资人支持，其中就有BRC20协议创始人demo，Taproot Wizards 的联合创始人Eric另外还有dovey，AK等\n4、预计明年Q1上线主网，鼓励真实用户积极参与测试。\n5、项目是纯正的海外项目，拥有自己核心的架构与技术特点，项目创始团队好像对比特币 DeFi有强烈的愿景驱动，根据加密媒体报道，其创始人Willem毕业比利时排名第一的大学KU Leuven密码学，之后就读于哈佛MBA，并在就读期间发起了蜘蛛链项目。这里我整个下午我都在挖掘相关线索，发现该项目都是BTC OG大神们个人在支持的项目，对此，我个人也倾向于希望有机会参与投资。\n\n其他媒体网络相关介绍：\n1、吴说区块链播客：《对话 Botanix：做完全去中心化的比特币 Layer 2》\nhttps://t.co/xQO6JjSIc3\n2、解析 Botanix：比特币上第一个完全去中心化的 EVM 等效 L2 https://t.co/KB4GayCnRz\n3、Botanix’s final testnet is now live https://t.co/PTAgzjjjzb\n度假结束的第一天，BTC突破10万大关，BTCFi项目必须要重视起来，未来会持续探索并分享相关项目。\n\n#BTC #Botanix #BTCL2"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[22]={messagesBeforeDehydration:$R[23]=[$R[24]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1864656426150580723\"}",name:"TweetResultByRestId"},$R[25]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1864656426150580723\"}",result:$R[26]={kind:"Result.Ok",value:$R[27]={data:$R[28]={tweet_result_by_rest_id:$R[29]={id:"VHdlZXRSZXN1bHRzOjE4NjQ2NTY0MjYxNTA1ODA3MjM=",rest_id:"1864656426150580723",result:$R[30]={__typename:"Tweet",cashtag_attachments:$R[31]=[],core:$R[32]={user_results:$R[33]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[34]={__typename:"User",avatar:$R[35]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[36]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[37]={},privacy:$R[38]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[39]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[40]={tweets:9451},verification:$R[41]={is_blue_verified:!0}}}},counts:$R[42]={bookmark_count:294,favorite_count:275,quote_count:7,reply_count:23,retweet_count:135},details:$R[43]={cashtag_entities:$R[44]=[],created_at_ms:1733403710000,display_text_range:$R[45]=[0,154],full_text:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM https://t.co/FS2BLgq83I",hashtag_entities:$R[46]=[],smarttags:$R[47]=[],timestamp_entities:$R[48]=[]},edit_control:$R[49]={__typename:"EditControlEdit",edit_control_initial:$R[50]={edit_tweet_ids:$R[51]=["1864656300808044976","1864656426150580723"]}},grok_translated_post_with_availability:$R[52]={is_available:!1},id:"VHdlZXQ6MTg2NDY1NjQyNjE1MDU4MDcyMw==",legacy:$R[53]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[54]=[$R[55]={allow_download_status:$R[56]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1864656426150580723/photo/