lts:$R[511]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NjQ2NTY0MjYxNTA1ODA3MjM=",rest_id:"1864656426150580723"},reply_to_user_results:$R[512]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[513]={__typename:"User",core:$R[514]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1867897000320254424",url_entities:$R[515]=[],views:$R[516]={count:"414"}}}}}}],metadata:$R[517]={conversation_metadata:$R[518]={all_tweet_ids:$R[519]=["1867897000320254424"],enable_deduplication:!0}}},entry_id:"conversationthread-1867897000320254424",sort_index:"2103760925910630370"}]},$R[520]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[521]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[522]={id:"VHdlZXRSZXN1bHRzOjE4NjQ2NTY0MjYxNTA1ODA3MjM=",rest_id:"1864656426150580723",result:$R[523]={__typename:"Tweet",core:$R[524]={user_results:$R[525]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[526]={__typename:"User",avatar:$R[527]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[528]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[529]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[530]={favorite_count:275,reply_count:23},details:$R[531]={full_text:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM https://t.co/FS2BLgq83I",smarttags:$R[532]=[]},id:"VHdlZXQ6MTg2NDY1NjQyNjE1MDU4MDcyMw==",note_tweet:$R[533]={note_tweet_results:$R[534]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODY0NjU2NDI1NzY0NzA0MjYw",result:$R[535]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE4NjQ2NTY0MjU3NjQ3MDQyNjA=",text:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM 的易用性和多功能性与比特币的去中心化和安全性相结合，在比特币之上构建以太坊虚拟机 (EVM)。其定位非常清晰，希望成为比特币DeFi的中心，激活比特币资本市场，解锁比特币链上的万亿美元市场。\n\n如果你关心btc相关的项目，值得测试下\n1️⃣Aragog测试网：\n参与网址：https://t.co/TmLBjsISmt\n银河任务：https://t.co/9hn7Stvys2\nzealy任务：https://t.co/cbANBQ9wrw\n参与方式：配置钱包网络、领水、使用生态Dapp，部署合约或代币等。\n领水：https://t.co/5jtAjNExTq\n教程：文档教程1 https://t.co/yToQkcrUu3\n\n丰密一句话教程：小狐狸🦊打开https://t.co/yaNr74ahNa自动配置网络🛜，复制显示的btc地址到领水网站https://t.co/5jtAjNExTq，领水成功后跳转有一条HASH，点进去复制，粘贴到Register Transaction ID，然后claim，之后去参与下面的各类生态dapp，如果实在不懂，跟着https://t.co/TmLBjsISmt 点击查看教程，部署代币可以看文档教程里面有Ethereum Remix教你如何部署代币。\n另外也可以参与下面的大使计划，附带详细的教程https://t.co/MXjPSq7xk2\n\n2️⃣生态DAPP：\n1、生态：https://t.co/a87ZrlNLOR\n2、 DEX-bitzy：https://t.co/1cpMq7Y28E\n3、借贷-Spindle：https://t.co/7qkK7PkpFL\n4、稳定币-Palladium：https://t.co/ypz21OZpbd\n5、永续DEX-bitperp：https://t.co/9ICP79p8pW\n6、LRT-Rover：https://t.co/Qz5M3UtbPM\n7、社交-slogain：https://t.co/8qwOpWZ3XN\n8、NFT：https://t.co/8Cc9UMhOaA\nBotanix是目前以太坊和比特币核心社区最看好的比特币二层 之一，Chainlink、Aave、Vertex均会部署该网络。\n\n3️⃣ Botanix值得关注\n1、Botanix 利用比特币的工作量证明 (PoW) 作为基础结算和去中心化的第一层，使用权益证明 (PoS) 共识模型，其中权益（以比特币表示）安全地存储在Spiderchain上，Spiderchain 是一个分布式的去中心化多重签名网络，由随机的参与者子集保护。“蜘蛛链”这个名字源于对多重签名钱包的设想，其中蜘蛛的每条“腿”代表不同的参与者。每个比特币区块都与蜘蛛链中一组随机参与者创建的新多重签名相关联。\n2、Botanix EVM 是一种外观、感觉和行为都与以太坊区块链类似的基础设施。不同之处在于，您无需使用 ETH，而是所有内容（gas 费等）都将以 BTC 计价进行交易和执行所有操作。\n3、Botanix Labs总部位于纽约，成立于哈佛商学院， 已经完成 1150 万美元融资，投资方主要有Polychain Capital、Placeholder Capital 等顶级机构以及许多行业领先的投资人支持，其中就有BRC20协议创始人demo，Taproot Wizards 的联合创始人Eric另外还有dovey，AK等\n4、预计明年Q1上线主网，鼓励真实用户积极参与测试。\n5、项目是纯正的海外项目，拥有自己核心的架构与技术特点，项目创始团队好像对比特币 DeFi有强烈的愿景驱动，根据加密媒体报道，其创始人Willem毕业比利时排名第一的大学KU Leuven密码学，之后就读于哈佛MBA，并在就读期间发起了蜘蛛链项目。这里我整个下午我都在挖掘相关线索，发现该项目都是BTC OG大神们个人在支持的项目，对此，我个人也倾向于希望有机会参与投资。\n\n其他媒体网络相关介绍：\n1、吴说区块链播客：《对话 Botanix：做完全去中心化的比特币 Layer 2》\nhttps://t.co/xQO6JjSIc3\n2、解析 Botanix：比特币上第一个完全去中心化的 EVM 等效 L2 https://t.co/KB4GayCnRz\n3、Botanix’s final testnet is now live https://t.co/PTAgzjjjzb\n度假结束的第一天，BTC突破10万大关，BTCFi项目必须要重视起来，未来会持续探索并分享相关项目。\n\n#BTC #Botanix #BTCL2"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1864656426150580723:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg 48w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_x96.jpg 96w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col">