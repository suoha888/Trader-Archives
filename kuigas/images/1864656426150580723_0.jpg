labs.xyz/en/testnet",expanded_url:"https://botanixlabs.xyz/en/testnet",indices:$R[93]=[637,660],url:"https://t.co/TmLBjsISmt"},$R[94]={display_url:"botanixlabs.xyz/en/ambassadors",expanded_url:"https://www.botanixlabs.xyz/en/ambassadors",indices:$R[95]=[728,751],url:"https://t.co/MXjPSq7xk2"},$R[96]={display_url:"botanixlabs.xyz/en/ecosystem",expanded_url:"https://botanixlabs.xyz/en/ecosystem",indices:$R[97]=[769,792],url:"https://t.co/a87ZrlNLOR"},$R[98]={display_url:"bitzy-testnet.vercel.app/swap",expanded_url:"https://bitzy-testnet.vercel.app/swap",indices:$R[99]=[806,829],url:"https://t.co/1cpMq7Y28E"},$R[100]={display_url:"dev.app.spindlefinance.xyz",expanded_url:"https://dev.app.spindlefinance.xyz/",indices:$R[101]=[843,866],url:"https://t.co/7qkK7PkpFL"},$R[102]={display_url:"circuit.palladiumlabs.org",expanded_url:"https://circuit.palladiumlabs.org/",indices:$R[103]=[883,906],url:"https://t.co/ypz21OZpbd"},$R[104]={display_url:"app.bitperp.io",expanded_url:"https://app.bitperp.io/",indices:$R[105]=[923,946],url:"https://t.co/9ICP79p8pW"},$R[106]={display_url:"testnet.roverstaking.com",expanded_url:"https://testnet.roverstaking.com/",indices:$R[107]=[959,982],url:"https://t.co/Qz5M3UtbPM"},$R[108]={display_url:"botanix.slogain.gg",expanded_url:"http://botanix.slogain.gg/",indices:$R[109]=[996,1019],url:"https://t.co/8qwOpWZ3XN"},$R[110]={display_url:"btcterminal.io",expanded_url:"https://www.btcterminal.io/",indices:$R[111]=[1026,1049],url:"https://t.co/8Cc9UMhOaA"},$R[112]={display_url:"wublock123.com/index.php?m=co…",expanded_url:"https://www.wublock123.com/index.php?m=content&c=index&a=show&catid=47&id=34667",indices:$R[113]=[1875,1898],url:"https://t.co/xQO6JjSIc3"},$R[114]={display_url:"techflowpost.com/article/detail…",expanded_url:"https://www.techflowpost.com/article/detail_16790.html",indices:$R[115]=[1937,1960],url:"https://t.co/KB4GayCnRz"},$R[116]={display_url:"x.com/BotanixLabs/st…",expanded_url:"https://x.com/BotanixLabs/status/1864325942208082423",indices:$R[117]=[1999,2022],url:"https://t.co/PTAgzjjjzb"}],user_mentions:$R[118]=[$R[119]={id_str:"1602342563310182401",indices:$R[120]=[112,124],screen_name:"BotanixLabs"}]},id:"Tm90ZVR3ZWV0OjE4NjQ2NTY0MjU3NjQ3MDQyNjA=",rest_id:"1864656425764704260",text:"比特币L2项目蜘蛛链Spiderchain推出最终测试网Aragog，解锁比特币链上的万亿美元市场\n\n🕷️蜘蛛链Spiderchain昨天推出最终测试网，取名：Aragog\nSpiderchain由Botanix Labs @BotanixLabs开发，定位为比特币上的去中心化等效EVM二层。项目结合EVM 的易用性和多功能性与比特币的去中心化和安全性相结合，在比特币之上构建以太坊虚拟机 (EVM)。其定位非常清晰，希望成为比特币DeFi的中心，激活比特币资本市场，解锁比特币链上的万亿美元市场。\n\n如果你关心btc相关的项目，值得测试下\n1️⃣Aragog测试网：\n参与网址：https://t.co/TmLBjsISmt\n银河任务：https://t.co/9hn7Stvys2\nzealy任务：https://t.co/cbANBQ9wrw\n参与方式：配置钱包网络、领水、使用生态Dapp，部署合约或代币等。\n领水：https://t.co/5jtAjNExTq\n教程：文档教程1 https://t.co/yToQkcrUu3\n\n丰密一句话教程：小狐狸🦊打开https://t.co/yaNr74ahNa自动配置网络🛜，复制显示的btc地址到领水网站https://t.co/5jtAjNExTq，领水成功后跳转有一条HASH，点进去复制，粘贴到Register Transaction ID，然后claim，之后去参与下面的各类生态dapp，如果实在不懂，跟着https://t.co/TmLBjsISmt 点击查看教程，部署代币可以看文档教程里面有Ethereum Remix教你如何部署代币。\n另外也可以参与下面的大使计划，附带详细的教程https://t.co/MXjPSq7xk2\n\n2️⃣生态DAPP：\n1、生态：https://t.co/a87ZrlNLOR\n2、 DEX-bitzy：https://t.co/1cpMq7Y28E\n3、借贷-Spindle：https://t.co/7qkK7PkpFL\n4、稳定币-Palladium：https://t.co/ypz21OZpbd\n5、永续DEX-bitperp：https://t.co/9ICP79p8pW\n6、LRT-Rover：https://t.co/Qz5M3UtbPM\n7、社交-slogain：https://t.co/8qwOpWZ3XN\n8、NFT：https://t.co/8Cc9UMhOaA\nBotanix是目前以太坊和比特币核心社区最看好的比特币二层 之一，Chainlink、Aave、Vertex均会部署该网络。\n\n3️⃣ Botanix值得关注\n1、Botanix 利用比特币的工作量证明 (PoW) 作为基础结算和去中心化的第一层，使用权益证明 (PoS) 共识模型，其中权益（以比特币表示）安全地存储在Spiderchain上，Spiderchain 是一个分布式的去中心化多重签名网络，由随机的参与者子集保护。“蜘蛛链”这个名字源于对多重签名钱包的设想，其中蜘蛛的每条“腿”代表不同的参与者。每个比特币区块都与蜘蛛链中一组随机参与者创建的新多重签名相关联。\n2、Botanix EVM 是一种外观、感觉和行为都与以太坊区块链类似的基础设施。不同之处在于，您无需使用 ETH，而是所有内容（gas 费等）都将以 BTC 计价进行交易和执行所有操作。\n3、Botanix Labs总部位于纽约，成立于哈佛商学院， 已经完成 1150 万美元融资，投资方主要有Polychain Capital、Placeholder Capital 等顶级机构以及许多行业领先的投资人支持，其中就有BRC20协议创始人demo，Taproot Wizards 的联合创始人Eric另外还有dovey，AK等\n4、预计明年Q1上线主网，鼓励真实用户积极参与测试。\n5、项目是纯正的海外项目，拥有自己核心的架构与技术特点，项目创始团队好像对比特币 DeFi有强烈的愿景驱动，根据加密媒体报道，其创始人Willem毕业比利时排名第一的大学KU Leuven密码学，之后就读于哈佛MBA，并在就读期间发起了蜘蛛链项目。这里我整个下午我都在挖掘相关线索，发现该项目都是BTC OG大神们个人在支持的项目，对此，我个人也倾向于希望有机会参与投资。\n\n其他媒体网络相关介绍：\n1、吴说区块链播客：《对话 Botanix：做完全去中心化的比特币 Layer 2》\nhttps://t.co/xQO6JjSIc3\n2、解析 Botanix：比特币上第一个完全去中心化的 EVM 等效 L2 https://t.co/KB4GayCnRz\n3、Botanix’s final testnet is now live https://t.co/PTAgzjjjzb\n度假结束的第一天，BTC突破10万大关，BTCFi项目必须要重视起来，未来会持续探索并分享相关项目。\n\n#BTC #Botanix #BTCL2"}}},quoted_tweet_results:$R[121]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4NjQzMjU5NDIyMDgwODI0MjM=",rest_id:"1864325942208082423",result:$R[122]={__isTweetResult:"Tweet",__typename:"Tweet",card:$R[123]={id:"Q2FyZDpjYXJkOi8vMTg2NDMyNTk0MDQyMTI5MjAzMg==",legacy:$R[124]={binding_values:$R[125]=[$R[126]={key:"unified_card",value:$R[127]={string_value:"{\"type\":\"video_website\",\"component_objects\":{\"details_1\":{\"type\":\"details\",\"data\":{\"title\":{\"content\":\"Use Aragog Testnet Here! \",\"is_rtl\":false},\"subtitle\":{\"content\":\"botanixlabs.com\",\"is_rtl\":false},\"destination\":\"browser_with_docked_media_1\"}},\"media_1\":{\"type\":\"media\",\"data\":{\"id\":\"13_1864310545559478272\",\"destination\":\"browser_with_docked_media_1\"}}},\"destination_objects\":{\"browser_with_docked_media_1\":{\"type\":\"browser_with_docked_media\",\"data\":{\"url_data\":{\"url\":\"https://botanixlabs.xyz/en/testnet\",\"vanity\":\"botanixlabs.com\"},\"media_id\":\"13_1864310545559478272\"}}},\"components\":[\"media_1\",\"details_1\"],\"media_entities\":{\"13_1864310545559478272\":{\"id\":1864310545559478272,\"id_str\":\"1864310545559478272\",\"indices\":[0,0],\"media_url\":\"\",\"media_url_https\":\"https://pbs.twimg.com/amplify_video_thumb/1864310545559478272/img/75VspCxsSTPEwY_A.jpg\",\"url\":\"\",\"display_url\":\"\",\"expanded_url\":\"\",\"type\":\"video\",\"original_info\":{\"width\":3840,\"height\":2160},\"sizes\":{\"medium\":{\"w\":1200,\"h\":675,\"resize\":\"fit\"},\"large\":{\"w\":2048,\"h\":1152,\"resize\":\"fit\"},\"thumb\":{\"w\":150,\"h\":150,\"resize\":\"