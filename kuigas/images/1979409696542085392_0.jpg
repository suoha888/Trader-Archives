ript nonce="vlwhWm6vVJOvlsIhgej9dQ==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]};$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410758217,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410758217,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1979409696542085392␀{}",u:1790410758594,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1979409696542085392",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1979409696542085392",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"📌 提醒一下：之前绑定过 X 的用户都有空投资格，共计 8 万个链上地址 + 4 万个 X 账号。\n记得去检查：https://t.co/XBbeoWlscf\n\n之前分享过的 RIVER 已经上线了 Binance 永续合约，这可以说是一个阶段性的起点。\n\n目前大多数项目顶多能上 Alpha，再好一点才是 Alpha+Perp，而 RIVER 作为 Binance Wallet 首个超募 $1 亿美金的项目，基本面数据非常硬。最近无论是投票排行还是价格表现，都相当强势。\n\n更值得关注的是它的空投机制：\nRIVER 引入了一个动态空投转换机制，让“时间”本身成为代币经济学的一部分。符合资格的用户，能领取的 $RIVER 数量会随时间延迟而指数级增加，带有明显的博弈性质。\nRiver Pts积分可随时兑换成 RIVER 代币，配合合约可以衍生出更多策略玩法。\n\n从用户角度看是博弈游戏，让社区用户互相揣摩最佳领取时机，本身也能制造讨论热度。从项目方视角，玩法上的创新，它本质上就是一种控筹分布手段、稳住价格、提升用户粘性的思路。",canonicalPath:"/KuiGas/status/1979409696542085392",canonicalUrl:"https://x.com/KuiGas/status/1979409696542085392",description:"📌 提醒一下：之前绑定过 X 的用户都有空投资格，共计 8 万个链上地址 + 4 万个 X 账号。\n记得去检查：https://t.co/XBbeoWlscf\n\n之前分享过的 RIVER 已经上线了 Binance 永续合约，这可以说是一个阶段性的起点。\n\n目前大多数项目顶多能上 Alpha，再好一点才是 Alpha+Perp，而 RIVER 作为 Binance Wallet 首个超募 $1 亿美金的项目，基本面数据非常硬。最近无论是投票排行还是价格表现，都相当强势。\n\n更值得关注的是它的空投机制：\nRIVER 引入了一个动态空投转换机制，让“时间”本身成为代币经济学的一部分。符合资格的用户，能领取的 $RIVER 数量会随时间延迟而指数级增加，带有明显的博弈性质。\nRiver Pts积分可随时兑换成 RIVER 代币，配合合约可以衍生出更多策略玩法。\n\n从用户角度看是博弈游戏，让社区用户互相揣摩最佳领取时机，本身也能制造讨论热度。从项目方视角，玩法上的创新，它本质上就是一种控筹分布手段、稳住价格、提升用户粘性的思路。",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:660,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/G3hFaSnXoAAecV5?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/G3hFaSnXoAAecV5?format=webp&name=small 680w, https://pbs.twimg.com/media/G3hFaSnXoAAecV5?format=webp&name=medium 1200w, https://pbs.twimg.com/media/G3hFaSnXoAAecV5?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/G3hFaSnXoAAecV5?format=webp&name=large",width:1232},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2025-10-18T04:50:21.000Z",replyCount:127,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/RiverdotInc/status/1979225134180503601","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"RiverdotInc",identifier:"1749307986449985536",image:"https://pbs.twimg.com/profile_images/2061121712926969856/CTt3mwdr_400x400.jpg",name:"River",url:"https://x.com/RiverdotInc"},datePublished:"2025-10-17T16:36:58.000Z",identifier:"1979225134180503601",url:"https://x.com/RiverdotInc/status/1979225134180503601",image:$R[17]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/amplify_video_thumb/1979225075376418816/img/RRf3J6-w0aMGTATZ?format=webp&name=large",description:"RIVER/USDT Perp is LIVE on @binance",height:1080,name:"RIVER/USDT Perp is LIVE on @binance",thumbnailUrl:"https://pbs.twimg.com/amplify_video_thumb/1979225075376418816/img/RRf3J6-w0aMGTATZ?format=webp&name=small",uploadDate:"2025-10-17T16:36:58.000Z",url:"https://pbs.twimg.com/amplify_video_thumb/1979225075376418816/img/RRf3J6-w0aMGTATZ?format=webp&name=large",wid