137]=[158,181],media_url_https:"https://pbs.twimg.com/media/G1s2PJbaAAEuX1G.png",original_info:$R[138]={height:696,width:1102},type:"photo"}],mention_entities:$R[139]=[],note_tweet:$R[140]={is_expandable:!0,note_tweet_results:$R[141]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTcxMjI5NjQwODU4NzU5MTY4",result:$R[142]={__typename:"NoteTweet",entity_set:$R[143]={hashtags:$R[144]=[],symbols:$R[145]=[$R[146]={indices:$R[147]=[343,347],tag:$R[148]={id:"U21hcnRUYWc6WFBM",info:$R[149]={info:$R[150]={ticker:"XPL"}}},text:"XPL"}],urls:$R[151]=[$R[152]={display_url:"app.merkl.xyz",expanded_url:"https://app.merkl.xyz/",indices:$R[153]=[285,308],url:"https://t.co/Iwl8UAiYlO"},$R[154]={display_url:"bybit.com/zh-MY/trade/sp…",expanded_url:"https://www.bybit.com/zh-MY/trade/spot/token-splash/detail?code=20250923072548&ref=5OJ1GX",indices:$R[155]=[380,403],url:"https://t.co/XAGuqXiPrw"}],user_mentions:$R[156]=[$R[157]={id_str:"1970475051003813888",indices:$R[158]=[853,863],screen_name:"PlasmaFDN"}]},id:"Tm90ZVR3ZWV0OjE5NzEyMjk2NDA4NTg3NTkxNjg=",rest_id:"1971229640858759168",text:"Plasma又来一暴击⚡️\n打款冲公募的暴富🤑\n\n无论冲多少资金，都给低保9300个XPL，哪怕1美金，都有资格！\n\n真的，8000美金白给，其他随便算算超过1w刀大毛。\n\n而，上一个随便的万刀大毛项目还是虫洞wormhole\n\n这才是真正的高质量TX，1TX=1万美金，这是真正的大格局项目，FDV接近100亿。\n\n大格局项目方会在吸引用户+激励用户+留住用户方面真的做的无比简单，无比直接，无比令人满意。比如激励用户这块，生态里马上就开始了激励，比如AAVE的存款，可以拿到XPL的激励，目前APY 148.91%，丰密毫不犹豫，直接干了几M先。\n完整激励的看这里：https://t.co/Iwl8UAiYlO\n\n在交易所方面，其实也是搞了各种活动，其中Bybit给了900万个 $XPL 代币，价值超过810万美金。\n\n登录 Bybit 账户报名参与：https://t.co/XAGuqXiPrw\n\n活动主要分为\n1、拉新：新用户注册奖励 300 万枚 XPL，新用户需要充值至少充值 500 XPL，或者充值 100 USDT 并买入 100 USDT 等值 XPL 以完成首次现货交易。限制前 1万 名，单户可以获得300 XPL，看涨的情绪下会超过300美金。\n\n注册bybit：\n\n2、交易：新老用户交易奖励600万枚 XPL，550万美金激励蛋糕，需要最低完成至少 500 USDT 等值的 XPL 现货交易，最高单号奖励10000 XPL，不管多少人参加，奖池大小不变， 每个人的奖励跟自己交易量在总交易量里的占比成正比。交易量越大，占比越高，能分得的 XPL 越多，但最终多少还取决于所有人一共交易了多少。\n\n之前我们说过，Bybit 在新币上线时，会同步开启 Token Splash，把一部分代币作为奖励池，分发给完成任务的用户，实际上就是一个「新币上线＋激励活动」的组合。主要是围绕拉新以及激励交易。 如果没有bubit号的需要备几个，撸毛交易两不耽误！\n\n对于plasma @PlasmaFDN\n我个人是持续看好的，没什么可以说的，就是有钱的爹有超能力，能整活，半个币圈都得围着转。回想那个5月底的那段时间，阳光明媚的下午·····"}}},rest_id:"1971229641039020498",url_entities:$R[159]=[],views:$R[160]={count:"60792"}}}}},entry_id:"tweet-1971229641039020498",sort_index:"2103762262010363904"},$R[161]={content:$R[162]={__typename:"TimelineTimelineModule",client_event_info:$R[163]={component:"tweet"},display_type:"VerticalConversation",items:$R[164]=[$R[165]={entry_id:"conversationthread-1971232193361203290-tweet-1971232193361203290",item:$R[166]={__typename:"TimelineTimelineItem",client_event_info:$R[167]={component:"tweet",details:$R[168]={conversation_details:$R[169]={conversation_section:"HighQuality"},timelines_details:$R[170]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcz4mwAAAAAA=="}},element:"tweet"},content:$R[171]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[172]={id:"VHdlZXRSZXN1bHRzOjE5NzEyMzIxOTMzNjEyMDMyOTA=",rest_id:"1971232193361203290",result:$R[173]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[174]=[],core:$R[175]={user_results:$R[176]={id:"VXNlclJlc3VsdHM6MTQ1MjUwNTUyODEwNjU2OTcyOQ==",result:$R[177]={__typename:"User",avatar:$R[178]={image_url:"https://pbs.twimg.com/profile_images/2034563017992765440/0bmswBC__normal.jpg"},core:$R[179]={name:"大顺利",screen_name:"xiaoshunli"},id:"VXNlcjoxNDUyNTA1NTI4MTA2NTY5NzI5",identity_profile_labels_highlighted_label:$R[180]={},privacy:$R[181]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[182]={followers:50423,following:7451},rest_id:"1452505528106569729",super_follow_eligible:!1,tweet_counts:$R[183]={tweets:20608},verification:$R[184]={is_blue_verified:!0}}}},counts:$R[185]={bookmark_count:0,favorite_count:2,quote_count:0,reply_count:1,retweet_count:0},details:$R[186]={cashtag_entities:$R[187]=[],created_at_ms:1758813353000,display_text_range:$R[188]=[8,71],full_text:"@KuiGas 丰密老师 我老婆说XPL好猛 买少了 我跟她说 ：你已经忘记了当初拿到虫洞空投时候我们的豪横了😂 真正的1TX1万美金！太爽了",hashtag_entities:$R[189]=[],smarttags:$R[19