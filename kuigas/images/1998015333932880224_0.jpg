6_" data-base-ui-tooltip-trigger="" aria-label="Like" aria-pressed="false" class="group inline-flex items-center rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:pointer-events-none disabled:opacity-50 hover:text-magenta-500 text-secondary" type="button"><span class="relative isolate inline-flex items-center rounded-full before:-z-10 before:pointer-events-none before:absolute before:inset-0 before:rounded-full before:scale-[0.88] before:opacity-[0] before:transition-[opacity,scale] before:duration-[140ms] before:ease-[ease-out] group-hover:before:scale-100 group-hover:before:opacity-[1] motion-reduce:before:transition-none before:bg-magenta-500/10 h-10 px-3 [&amp;&gt;svg]:size-5"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-heart-stroke" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z"></path></svg><span class="inline-flex overflow-hidden" data-animated-count="true" style="opacity:1;width:auto;transform:none"><span class="inline-flex tabular-nums text-subtext2 ps-1"><span class="x-animated-count-visual inline-flex select-none" data-animated-count-visual="true" dir="ltr">139</span></span></span></span></button></div><div class="flex shrink-0 items-center"><div class=""><div class="min-w-0 flex-1" data-engagement-action="bookmark"><button id="base-ui-_R_1tltimb6b5336_" d