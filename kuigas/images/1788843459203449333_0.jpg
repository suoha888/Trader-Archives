:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:264,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/GNM_gNZa4AAuLjP?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/GNM_gNZa4AAuLjP?format=webp&name=small 680w, https://pbs.twimg.com/media/GNM_gNZa4AAuLjP?format=webp&name=medium 1200w, https://pbs.twimg.com/media/GNM_gNZa4AAuLjP?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/GNM_gNZa4AAuLjP?format=webp&name=large",width:654},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/1788843459203449333",publishedTime:"2024-05-10T08:08:10.000Z",replyCount:40,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/FaroTrading/status/1788836385488793718","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"FaroTrading",identifier:"1452468419673014272",image:"https://pbs.twimg.com/profile_images/1993988608731328512/kLDYv1kY_400x400.png",name:"Faro",url:"https://x.com/FaroTrading"},datePublished:"2024-05-10T07:40:03.000Z",identifier:"1788836385488793718",url:"https://x.com/FaroTrading/status/1788836385488793718",engagement:$R[17]=[$R[18]={action:"LikeAction",name:"Likes",url:"https://x.com/FaroTrading/status/1788836385488793718/likes",count:449},$R[19]={action:"ShareAction",name:"Retweets",url:"https://x.com/FaroTrading/status/1788836385488793718/retweets",count:89},$R[20]={action:"ReplyAction",name:"Replies",url:null,count:36},$R[21]={action:"ViewAction",name:"Views",count:268703}],text:"EIGEN claims open today at 17:00 UTC.\n\nIf you held rswETH or restaked swETH in EigenLayer in Season 1, you will be able to claim your EIGEN from this time.\n\nNote that EIGEN earned on rswETH in unresolved DeFi protocols will only be claimable in Phase 2, expected in June. This includes rswETH in Pendle, Penpie, Equilibria, and others.\n\nOn claiming, EIGEN will remain non-transferable. But you will be able to stake and delegate the tokens to secure AVS's.\n\n1. Claim\nhttps://t.co/YJ6TRXIuSz\n\n2. Stake\nhttps://t.co/tsRF8qY66o\n\n3. Delegate\nAt launch you will only be able to delegate to operators securing EigenDA, which is currently the only AVS that uses an EIGEN quorum. Other AVS's are expected to follow soon. Note that you can only delegate to 1 operator per address.\nhttps://t.co/LhIcr4VjHH\n\nFAQ\nhttps://t.co/YpTXmVwbAU"}},socialTitle:"丰密 (@KuiGas) on X",title:"丰密 on X: \"单号轻松过千收益，而且这些地址未来是金铲子。\n权重异常突出！\n领取 EIGEN\n1. Claim https://t.co/sxYzaWtKey \n2. Stake https://t.co/s8ZRFoKeqp\n\n之前我发布了几个关于swell内容\n\nhttps://t.co/ALu5ZpZMMb\nhttps://t.co/okZjdRmj8e\nhttps://t.co/8dEIYRLIEW\""},replyCount:40,screenName:"KuiGas",status:"available",text:"单号轻松过千收益，而且这些地址未来是金铲子。\n权重异常突出！\n领取 EIGEN\n1. Claim https://t.co/sxYzaWtKey \n2. Stake https://t.co/s8ZRFoKeqp\n\n之前我发布了几个关于swell内容\n\nhttps://t.co/ALu5ZpZMMb\nhttps://t.co/okZjdRmj8e\nhttps://t.co/8dEIYRLIEW https://t.co/K0I6vfxBGi"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[22]={messagesBeforeDehydration:$R[23]=[$R[24]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1788843459203449333\"}",name:"TweetResultByRestId"},$R[25]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1788843459203449333\"}",result:$R[26]={kind:"Result.Ok",value:$R[27]={data:$R[28]={tweet_result_by_rest_id:$R[29]={id:"VHdlZXRSZXN1bHRzOjE3ODg4NDM0NTkyMDM0NDkzMzM=",rest_id:"1788843459203449333",result:$R[30]={__typename:"Tweet",cashtag_attachments:$R[31]=[],core:$R[32]={user_results:$R[33]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[34]={__typename:"User",avatar:$R[35]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[36]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_prof