justify-center"><div class="animate-spin h-5 w-5"><svg height="100%" viewBox="0 0 32 32" width="100%"><circle class="opacity-20 stroke-brand" cx="16" cy="16" fill="none" r="14" stroke-width="4"></circle><circle class="stroke-brand" cx="16" cy="16" fill="none" r="14" stroke-dasharray="80" stroke-dashoffset="60" stroke-width="4"></circle></svg></div></div></div></section><!--/$--><!--/$--><nav class="flex flex-wrap items-center gap-y-1 px-4 py-3" aria-label="Footer"><span class="flex items-center"><a href="https://x.com/tos" class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-subtext3 font-[inherit] inline-flex min-h-6 items-center leading-6 text-gray-700" target="_blank" rel="noopener noreferrer nofollow">Terms</a><span class="max-w-full text-subtext3 font-normal px-1 text-gray-700 select-none" aria-hidden="true">·</span></span><span class="flex items-center"><a href="https://x.com/privacy" class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-subtext3 font-[inherit] inline-flex min-h-6 items-center leading-6 text-gray-700" target="_blank" rel="noopener noreferrer nofollow">Privacy</a><span class="max-w-full text-subtext3 font-normal px-1 text-gray-700 select-none" aria-hidden="true">·</span></span><span class="flex items-center"><a href="https://support.x.com/articles/20170514" class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-subtext3 font-[inherit] inline-flex min-h-6 items-center leading-6 text-gray-700" target="_blank" rel="noopener noreferrer nofollow">Cookies</a><span class="max-w-full text-subtext3 font-normal px-1 text-gray-700 select-none" aria-hidden="true">·</span></span><span class="flex items-center"><a href="https://help.x.com/resources/accessibility" class="rounded-xs focus-visible:outline-2 focus-visible:outline-of