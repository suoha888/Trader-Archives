ttps:"https://pbs.twimg.com/media/G9-wOASbcAAVGQg.jpg",original_info:$R[143]={height:1162,width:820},type:"photo"},$R[144]={allow_download_status:$R[145]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/2008520381905195278/photo/1",ext_media_availability:$R[146]={status:"Available"},ext_playlists:$R[147]=[],features:$R[148]={},id_str:"2008519969668296704",indices:$R[149]=[127,150],media_url_https:"https://pbs.twimg.com/media/G9-yRVRbcAAhox1.jpg",original_info:$R[150]={height:1154,width:808},type:"photo"},$R[151]={allow_download_status:$R[152]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/2008520381905195278/photo/1",ext_media_availability:$R[153]={status:"Available"},ext_playlists:$R[154]=[],features:$R[155]={},id_str:"2008517786436595716",indices:$R[156]=[127,150],media_url_https:"https://pbs.twimg.com/media/G9-wSQGbcAQkBAw.jpg",original_info:$R[157]={height:1168,width:832},type:"photo"}],mention_entities:$R[158]=[],note_tweet:$R[159]={is_expandable:!0,note_tweet_results:$R[160]={id:"Tm90ZVR3ZWV0UmVzdWx0czoyMDA4NTIwMzgxNzc1MTQ3MDA4",result:$R[161]={__typename:"NoteTweet",entity_set:$R[162]={hashtags:$R[163]=[],symbols:$R[164]=[],urls:$R[165]=[$R[166]={display_url:"d.dedao.cn/GpkB93IwZZvs2o…",expanded_url:"https://d.dedao.cn/GpkB93IwZZvs2osO",indices:$R[167]=[363,386],url:"https://t.co/nCNXljbaZE"}],user_mentions:$R[168]=[]},id:"Tm90ZVR3ZWV0OjIwMDg1MjAzODE3NzUxNDcwMDg=",rest_id:"2008520381775147008",text:"「好好活，是一门技术」\n\n尹烨老师在脱不花的节目里讲的就很干货。\n\n他的核心观点：\n\n1️⃣强调人体是一个动态平衡的生态系统而非机器，长寿的关键在于生活方式的重塑。\n\n2️⃣详细列举了饮食顺序、运动标准、深度睡眠以及情绪调节等五个维度的核心原则，比如。\n\n吃：先吃什么后吃什么（比如先菜再肉再主食这种顺序）\n\n动：运动要达到什么标准（不是瞎走两步）\n\n睡：重点盯“深度睡眠”怎么提高\n\n情绪：怎么把压力、焦虑从身体里放出去\n\n3️⃣通过提供具体到全天候的时间表和行动清单，把生活方式调过来。靠自律的日常，把身体状态和心理状态一起养稳、养长。\n\n修身\n\n撸毛这些年，钱钱没赚到，胖了几十斤。开年先撸一个好身体，未来的日子遇佛杀佛。\n撸猫人的意志力非常强，非常耐操。答应我，狗命要紧。\n听10遍。\n\n视频+音频---得到app-\nhttps://t.co/nCNXljbaZE"}}},rest_id:"2008520381905195278",url_entities:$R[169]=[],views:$R[170]={count:"18137"}}}}},entry_id:"tweet-2008520381905195278"