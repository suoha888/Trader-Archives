		style: "unit",
		unit: "hour",
		unitDisplay: "narrow"
	}).format(Math.floor(diffInSeconds / 3600));
	if (date.toLocaleDateString(lang, {
		year: "numeric",
		timeZone
	}) === now.toLocaleDateString(lang, {
		year: "numeric",
		timeZone
	})) return date.toLocaleDateString(lang, {
		month: "short",
		day: "numeric",
		timeZone
	});
