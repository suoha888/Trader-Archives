Hgi0_normal.jpg"},core:$R[394]={name:"胶原蛋白白",screen_name:"JiaoY82878"},id:"VXNlcjoxNjg4MDY1MTAzMjgxOTE3OTUy",identity_profile_labels_highlighted_label:$R[395]={},privacy:$R[396]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[397]={followers:329,following:508},rest_id:"1688065103281917952",super_follow_eligible:!1,tweet_counts:$R[398]={tweets:1463},verification:$R[399]={is_blue_verified:!1}}}},counts:$R[400]={bookmark_count:0,favorite_count:0,quote_count:0,reply_count:0,retweet_count:0},details:$R[401]={cashtag_entities:$R[402]=[],created_at_ms:1743583768000,display_text_range:$R[403]=[8,97],full_text:"@KuiGas 原来 @switchboardxyz  不仅仅是预言机 ，还包含了Jito 再质押（Restaking），把在 @MeteoraAG  组LP的sol存进去了，拆东墙补西墙。。。",hashtag_entities:$R[404]=[],smarttags:$R[405]=[],timestamp_entities:$R[406]=[]},edit_control:$R[407]={__typename:"EditControlInitial",edit_tweet_ids:$R[408]=["1907354685738229812"]},grok_translated_post_with_availability:$R[409]={is_available:!1},id:"VHdlZXQ6MTkwNzM1NDY4NTczODIyOTgxMg==",legacy:$R[410]={lang:"zh"},media_entities2:$R[411]=[],mention_entities:$R[412]=[$R[413]={id_str:"1372876871990272000",indices:$R[414]=[0,7],screen_name:"KuiGas"},$R[415]={id_str:"1384968566743740418",indices:$R[416]=[11,26],screen_name:"switchboardxyz"},$R[417]={id_str:"1384042881808166924",indices:$R[418]=[64,74],screen_name:"MeteoraAG"}],reply_to_results:$R[419]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTk3NzQxNDQ4OTc3NDUxOTg=",rest_id:"1899774144897745198"},reply_to_user_results:$R[420]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[421]={__typename:"User",core:$R[422]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1907354685738229812",url_entities:$R[423]=[],views:$R[424]={count:"62"}}}}}}],metadata:$R[425]={conversation_metadata:$R[426]={all_tweet_ids:$R[427]=["1907354685738229812"],enable_deduplication:!0}}},entry_id:"conversationthread-1907354685738229812",sort_index:"2103761698291711970"}]},$R[428]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[429]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[430]={id:"VHdlZXRSZXN1bHRzOjE4OTk3NzQxNDQ4OTc3NDUxOTg=",rest_id:"1899774144897745198",result:$R[431]={__typename:"Tweet",core:$R[432]={user_results:$R[433]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[434]={__typename:"User",avatar:$R[435]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[436]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[437]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[438]={favorite_count:118,reply_count:41},details:$R[439]={full_text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV https://t.co/pLyzNK63lT",smarttags:$R[440]=[]},id:"VHdlZXQ6MTg5OTc3NDE0NDg5Nzc0NTE5OA==",note_tweet:$R[441]={note_tweet_results:$R[442]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk5Nzc0MTQ0NDE1NTEwNTI4",result:$R[443]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE4OTk3NzQxNDQ0MTU1MTA1Mjg=",text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1899774144897745198:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg 48w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_x96.jpg 96w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/KuiGas" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">丰密</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1v5c9pimb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/KuiGas" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@KuiGas</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qqc9pimb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">Switchboard：Solana 生态首个再质押预言机协议
（内附参与教程）

在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。

Jito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。

Jito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。

其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。

今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard </span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-[length:inherit] font-[inherit] text-brand" href="/switchboardxyz">@<!-- -->switchboardxyz</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">

简单说：Switchboard =预言机 + Jito 再质押（Restaking）

Switchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。

Switchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：
1️⃣ 通过 Jito 参与
2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）

Fragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！
官方公告：</span><a class="font-chirp max-w-full whitespace-pre-wrap break-words text-brand text-[length:inherit] font-inherit hover:underline" href="https://x.com/switchboardxyz/status/1899467859052371978" rel="noopener noreferrer" target="_blank">x.com/switchboardxyz…</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">

二、如何参与？如何获得奖励？

方式 1️⃣：通过 Jito 再质押
1、进入jito金库</span><a class="font-chirp max-w-full whitespace-pre-wrap break-words text-brand text-[length:inherit] font-inherit hover:underline" href="https://www.jito.network/zh/restaking/vaults/" rel="noopener noreferrer" target="_blank">jito.network/zh/restaking/v…</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">
2、选择对应资产并找到匹配的保险库
3、存款后，你将收到 VRT作为凭证
4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益

方式 2️⃣：通过 Fragmetric 再质押（未发币）

这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会

1、打开</span><a class="font-chirp max-w-full whitespace-pre-wrap break-words text-brand text-[length:inherit] font-inherit hover:underline" href="https://app.fragmetric.xyz/restake/" rel="noopener noreferrer" target="_blank">app.fragmetric.xyz/restake/</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。

2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。

2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）

3、Fragmetric </span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-[length:inherit] font-[inherit] text-brand" href="/fragmetric">@<!-- -->fragmetric</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit"> 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。

三、项目及赛道概要

1. 预言机赛道的重要性

预言机是区块链的基础设施之一，估值普遍较高，例如：
•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。
•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。
•API3（API3）：去信任 API，连接现实世界 API 与区块链。
•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。

速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。

2. 项目情况

Switchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。

目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。

融资情况：
2021 年 6 月：完成 350 万美元 种子轮融资。
2023 年 5 月：完成 750 万美元 A 轮融资。
累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。

3、项目模式及亮点

Switchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。

1. 创新模式概要

预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。

Jito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。

2. 核心工作原理

激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。

再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。

资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。

TipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据
</span><a class="font-chirp max-w-full whitespace-pre-wrap break-words text-brand text-[length:inherit] font-inherit hover:underline" href="https://x.com/jito_sol/status/1891880407953502426" rel="noopener noreferrer" target="_blank">x.com/jito_sol/statu…</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">

3. 模式亮点与优势

-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。

-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。

-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。

-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。

Switchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。

