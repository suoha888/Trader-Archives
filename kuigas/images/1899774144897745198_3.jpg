33 245,35 h 100 s 136,86 71,135 C 229,227 205,168 224,119 h 163 s 196,83 57,77 C 243,2 234,229 164,139 h 97 s 206,95 119,98 C 35,246 73,238 121,48 h 81 s 211,139 145,137 C 146,236 63,172 76,150 h 77 s 84,132 209,143 C 203,72 36,246 25,40 h 2 s 69,42 154,243 C 43,3 223,165 230,97 h 107 s 16,90 146,204 C 184,187 9,246 220,3 h 147 s 26,30 147,51 C 116,220 71,1 229,254 h 219 s 40,94 171,244" fill="#1d9bf008"></path></g></svg><svg viewBox="0 0 24 24" id="loading-x-anim-3" aria-hidden="true" class="r-1p0dtai r-13gxpu9 r-4qtqp9 r-yyyyoo r-wy61xf r-1d2f490 r-bqkkf0 r-ywje51 r-dnmrzs r-u8s1d r-zchlnj r-1plcrui r-ipm5af r-lrvibr r-1blnp2b"><g><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path><path d="M 10,30 C 69,202 160,199 49,96 h 187 s 202,145 198,155 C 76,207 117,30 103,83 h 130 s 136,169 80,214 C 127,143 102,35 59,31 h 251 s 51,4 46,50 C 147,138 103,26 245,239 h 66 s 227,111 230,49 C 71,98 142,81 255,5 h 211 s 150,37 111,19 C 230,50 234,228 54,156 h 162 s 208,160 96,198 C 89,244 151,38 149,147 h 199 s 160,124 148,176 C 198,146 6,174 164,101 h 109 s 45,227 203,77 C 96,35 184,78 129,209 h 113 s 236,129 187,87 C 175,84 98,10 213,9 h 198 s 234,78 64,180 C 113,131 179,102 198,127 h 170 s 76,29 237,119 C 185,59 181,47 237,198 h 93 s 46,101 125,226 C 61,22 15,247 41,248 h 79 s 149,171 137,192 C 18,174 100,75 206,195 h 136 s 18,138 219,126 C 111,114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="MId43kPFOU1RbeegJgCr5w==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="MId43kPFOU1RbeegJgCr5w==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410848923,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410848923,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1899774144897745198␀{}",u:1790410849218,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1899774144897745198",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1899774144897745198",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO",canonicalPath:"/KuiGas/status/1899774144897745198",canonicalUrl:"https://x.com/KuiGas/status/1899774144897745198",description:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:1292,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH?format=webp&name=small 680w, https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH?format=webp&name=medium 1200w, https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH?format=webp&name=large",width:2900},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:"https://jf.x.com/images/media-preview/1899774144897745198",publishedTime:"2025-03-12T10:47:06.000Z",replyCount:41,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/jito/status/1891880407953502426","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"jito",identifier:"1552378476560355331",image:"https://pbs.twimg.com/profile_images/1687112019563188224/mnbhxwox_400x400.png",name:"Jito",url:"https://x.com/jito"},datePublished:"2025-02-18T16:00:13.000Z",identifier:"1891880407953502426",url:"https://x.com/jito/status/1891880407953502426",image:$R[17]={"@type":"ImageObject",contentUrl:"https://pbs.twimg.com/media/GkFPNEXWoAAo_3u?format=webp&name=large",description:"Permissionless data feeds 🌍🔌 \n\n@switchboardxyz is building a unique oracle solution leveraging Jito (Re)staking to make on &amp; off-chain data easily accessible to Solana developers. Its oracles also help secure &amp; decentralize MEV tip distribution via the TipRouter NCN! 🛡 🫡",height:1388,name:"Permissionless data feeds 🌍🔌 \n\n@switchboardxyz is building a unique oracle solution leveraging Jito (Re)staking to make on &amp; off-chain data easily accessible to Solana developers. Its oracles also help secure &amp; decentralize MEV tip distribution via the TipRouter NCN! 🛡 🫡",thumbnailUrl:"https://pbs.twimg.com/media/GkFPNEXWoAAo_3u?format=webp&name=small",uploadDate:"2025-02-18T16:00:13.000Z",url:"https://pbs.twimg.com/media/GkFPNEXWoAAo_3u?format=webp&name=large",width:1930},engagement:$R[18]=[$R[19]={action:"LikeAction",name:"Likes",url:"https://x.com/jito/status/1891880407953502426/likes",count:56},$R[20]={action:"ShareAction",name:"Retweets",url:"https://x.com/jito/status/1891880407953502426/retweets",count:8},$R[21]={action:"ReplyAction",name:"Replies",url:null,count:8},$R[22]={action:"ViewAction",name:"Views",count:11017}],text:"Permissionless data feeds 🌍🔌 \n\n@switchboardxyz is building a unique oracle solution leveraging Jito (Re)staking to make on &amp; off-chain data easily accessible to Solana developers. Its oracles also help secure &amp; decentralize MEV tip distribution via the TipRouter NCN! 🛡 🫡"}},socialTitle:"丰密 (@KuiGas) on X",title:"丰密 on X: \"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO\""},replyCount:41,screenName:"KuiGas",status:"available",text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[23]={messagesBeforeDehydration:$R[24]=[$R[25]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1899774144897745198\"}",name:"TweetResultByRestId"},$R[26]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1899774144897745198\"}",result:$R[27]={kind:"Result.Ok",value:$R[28]={data:$R[29]={tweet_result_by_rest_id:$R[30]={id:"VHdlZXRSZXN1bHRzOjE4OTk3NzQxNDQ4OTc3NDUxOTg=",rest_id:"1899774144897745198",result:$R[31]={__typename:"Tweet",cashtag_attachments:$R[32]=[],core:$R[33]={user_results:$R[34]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[35]={__typename:"User",avatar:$R[36]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[37]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[38]={},privacy:$R[39]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[40]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[41]={tweets:9451},verification:$R[42]={is_blue_verified:!0}}}},counts:$R[43]={bookmark_count:87,favorite_count:118,quote_count:1,reply_count:41,retweet_count:55},details:$R[44]={cashtag_entities:$R[45]=[],created_at_ms:1741776426000,display_text_range:$R[46]=[0,179],full_text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV https://t.co/pLyzNK63lT",hashtag_entities:$R[47]=[],smarttags:$R[48]=[],timestamp_entities:$R[49]=[]},edit_control:$R[50]={__typename:"EditControlInitial",edit_tweet_ids:$R[51]=["1899774144897745198"]},grok_translated_post_with_availability:$R[52]={is_available:!1},id:"VHdlZXQ6MTg5OTc3NDE0NDg5Nzc0NTE5OA==",legacy:$R[53]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[54]=[$R[55]={allow_download_status:$R[56]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[57]={status:"Available"},ext_playlists:$R[58]=[],features:$R[59]={},id_str:"1899725307478994944",indices:$R[60]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH.jpg",original_info:$R[61]={height:1292,width:2900},type:"photo"},$R[62]={allow_download_status:$R[63]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[64]={status:"Available"},ext_playlists:$R[65]=[],features:$R[66]={},id_str:"1899725828138876928",indices:$R[67]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0uk1TaQAAyiko.jpg",original_info:$R[68]={height:1474,width:3014},type:"photo"},$R[69]={allow_download_status:$R[70]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[71]={status:"Available"},ext_playlists:$R[72]=[],features:$R[73]={},id_str:"1899726020653002752",indices:$R[74]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0uwCeWsAAXST3.png",original_info:$R[75]={height:578,width:1572},type:"photo"},$R[76]={allow_download_status:$R[77]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[78]={status:"Available"},ext_playlists:$R[79]=[],features:$R[80]={},id_str:"1899726617666256896",indices:$R[81]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0vSyhaAAArPQ4.jpg",original_info:$R[82]={height:1476,width:3088},type:"photo"}],mention_entities:$R[83]=[],note_tweet:$R[84]={is_expandable:!0,note_tweet_results:$R[85]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk5Nzc0MTQ0NDE1NTEwNTI4",result:$R[86]={__typename:"NoteTweet",entity_set:$R[87]={hashtags:$R[88]=[],symbols:$R[89]=[],urls:$R[90]=[$R[91]={display_url:"x.com/switchboardxyz…",expanded_url:"https://x.com/switchboardxyz/status/1899467859052371978",indices:$R[92]=[1088,1111],url:"https://t.co/Ns6GcjHyDQ"},$R[93]={display_url:"jito.network/zh/restaking/v…",expanded_url:"https://www.jito.network/zh/restaking/vaults/",indices:$R[94]=[1158,1181],url:"https://t.co/RMFpBAnQn6"},$R[95]={display_url:"app.fragmetric.xyz/restake/",expanded_url:"https://app.fragmetric.xyz/restake/",indices:$R[96]=[1328,1351],url:"https://t.co/A0ZyUElA2b"},$R[97]={display_url:"x.com/jito_sol/statu…",expanded_url:"https://x.com/jito_sol/status/1891880407953502426",indices:$R[98]=[3465,3488],url:"https://t.co/VVcJpy3sQJ"},$R[99]={display_url:"switchboard.xyz",expanded_url:"https://switchboard.xyz/",indices:$R[100]=[3993,4016],url:"https://t.co/wZJm3FIL7k"},$R[101]={display_url:"x.com/switchboardxyz",expanded_url:"https://x.com/switchboardxyz",indices:$R[102]=[4021,4044],url:"https://t.co/Z6iKtPSnSO"}],user_mentions:$R[103]=[$R[104]={id_str:"1384968566743740418",indices:$R[105]=[691,706],screen_name:"switchboardxyz"},$R[106]={id_str:"1786285086926835712",indices:$R[107]=[1627,1638],screen_name:"fragmetric"}]},id:"Tm90ZVR3ZWV0OjE4OTk3NzQxNDQ0MTU1MTA1Mjg=",rest_id:"1899774144415510528",text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO"}}},quoted_tweet_results:$R[108]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTE4ODA0MDc5NTM1MDI0MjY=",rest_id:"1891880407953502426",result:$R[109]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[110]=[],core:$R[111]={user_results:$R[112]={id:"VXNlclJlc3VsdHM6MTU1MjM3ODQ3NjU2MDM1NTMzMQ==",result:$R[113]={__typename:"User",avatar:$R[114]={image_url:"https://pbs.twimg.com/profile_images/1687112019563188224/mnbhxwox_normal.png"},core:$R[115]={name:"Jito",screen_name:"jito"},id:"VXNlcjoxNTUyMzc4NDc2NTYwMzU1MzMx",identity_profile_labels_highlighted_label:$R[116]={},privacy:$R[117]={protected:!1},profile_image_shape:"Square",relationship_counts:$R[118]={followers:103729,following:1429},rest_id:"1552378476560355331",super_follow_eligible:!1,tweet_counts:$R[119]={tweets:9448},verification:$R[120]={is_blue_verified:!0,verified_type:"Business"}}}},counts:$R[121]={bookmark_count:1,favorite_count:56,quote_count:6,reply_count:8,retweet_count:8},details:$R[122]={cashtag_entities:$R[123]=[],created_at_ms:1739894413000,display_text_range:$R[124]=[0,279],full_text:"Permissionless data feeds 🌍🔌 \n\n@switchboardxyz is building a unique oracle solution leveraging Jito (Re)staking to make on &amp; off-chain data easily accessible to Solana developers. Its oracles also help secure &amp; decentralize MEV tip distribution via the TipRouter NCN! 🛡 🫡 https://t.co/nEOR4cEFyG",hashtag_entities:$R[125]=[],smarttags:$R[126]=[],timestamp_entities:$R[127]=[]},edit_control:$R[128]={__typename:"EditControlInitial",edit_tweet_ids:$R[129]=["1891880407953502426"]},grok_translated_post_with_availability:$R[130]={is_available:!1},id:"VHdlZXQ6MTg5MTg4MDQwNzk1MzUwMjQyNg==",legacy:$R[131]={possibly_sensitive:!1},media_entities2:$R[132]=[$R[133]={expanded_url:"https://x.com/jito_sol/status/1891880407953502426/photo/1",ext_media_availability:$R[134]={status:"Available"},ext_playlists:$R[135]=[],features:$R[136]={},id_str:"1891880404400906240",indices:$R[137]=[280,303],media_url_https:"https://pbs.twimg.com/media/GkFPNEXWoAAo_3u.jpg",original_info:$R[138]={height:1388,width:1930},type:"photo"}],mention_entities:$R[139]=[$R[140]={id_str:"1384968566743740418",indices:$R[141]=[31,46],screen_name:"switchboardxyz"}],rest_id:"1891880407953502426",url_entities:$R[142]=[],views:$R[143]={count:"11017"}}},rest_id:"1899774144897745198",url_entities:$R[144]=[],views:$R[145]={count:"20748"}}}}}}}],graphqlRequestStream:$R[146]=($R[147]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[148]=($R[149]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="MId43kPFOU1RbeegJgCr5w==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="MId43kPFOU1RbeegJgCr5w==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="MId43kPFOU1RbeegJgCr5w==">($R=>$R[148].next($R[150]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1899774144897745198\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="MId43kPFOU1RbeegJgCr5w==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="MId43kPFOU1RbeegJgCr5w==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="MId43kPFOU1RbeegJgCr5w==">($R=>$R[148].next($R[151]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1899774144897745198\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[152]={kind:"Result.Ok",value:$R[153]={data:$R[154]={threaded_conversation_with_injections_v2:$R[155]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[156]=[$R[157]={__typename:"TimelineClearCache"},$R[158]={__typename:"TimelineAddEntries",entries:$R[159]=[$R[160]={content:$R[161]={__typename:"TimelineTimelineItem",client_event_info:$R[162]={component:"tweet",element:"tweet"},content:$R[163]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[164]={id:"VHdlZXRSZXN1bHRzOjE4OTk3NzQxNDQ4OTc3NDUxOTg=",rest_id:"1899774144897745198",result:$R[165]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[166]=[],core:$R[167]={user_results:$R[168]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[169]={__typename:"User",avatar:$R[170]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[171]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[172]={},privacy:$R[173]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[174]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[175]={tweets:9451},verification:$R[176]={is_blue_verified:!0}}}},counts:$R[177]={bookmark_count:87,favorite_count:118,quote_count:1,reply_count:41,retweet_count:55},details:$R[178]={cashtag_entities:$R[179]=[],created_at_ms:1741776426000,display_text_range:$R[180]=[0,179],full_text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV https://t.co/pLyzNK63lT",hashtag_entities:$R[181]=[],smarttags:$R[182]=[],timestamp_entities:$R[183]=[]},edit_control:$R[184]={__typename:"EditControlInitial",edit_tweet_ids:$R[185]=["1899774144897745198"]},grok_translated_post_with_availability:$R[186]={is_available:!1},id:"VHdlZXQ6MTg5OTc3NDE0NDg5Nzc0NTE5OA==",legacy:$R[187]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[188]=[$R[189]={allow_download_status:$R[190]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[191]={status:"Available"},ext_playlists:$R[192]=[],features:$R[193]={},id_str:"1899725307478994944",indices:$R[194]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0uGhsa8AA2FsH.jpg",original_info:$R[195]={height:1292,width:2900},type:"photo"},$R[196]={allow_download_status:$R[197]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[198]={status:"Available"},ext_playlists:$R[199]=[],features:$R[200]={},id_str:"1899725828138876928",indices:$R[201]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0uk1TaQAAyiko.jpg",original_info:$R[202]={height:1474,width:3014},type:"photo"},$R[203]={allow_download_status:$R[204]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[205]={status:"Available"},ext_playlists:$R[206]=[],features:$R[207]={},id_str:"1899726020653002752",indices:$R[208]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0uwCeWsAAXST3.png",original_info:$R[209]={height:578,width:1572},type:"photo"},$R[210]={allow_download_status:$R[211]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1899774144897745198/photo/1",ext_media_availability:$R[212]={status:"Available"},ext_playlists:$R[213]=[],features:$R[214]={},id_str:"1899726617666256896",indices:$R[215]=[180,203],media_url_https:"https://pbs.twimg.com/media/Gl0vSyhaAAArPQ4.jpg",original_info:$R[216]={height:1476,width:3088},type:"photo"}],mention_entities:$R[217]=[],note_tweet:$R[218]={is_expandable:!0,note_tweet_results:$R[219]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxODk5Nzc0MTQ0NDE1NTEwNTI4",result:$R[220]={__typename:"NoteTweet",entity_set:$R[221]={hashtags:$R[222]=[],symbols:$R[223]=[],urls:$R[224]=[$R[225]={display_url:"x.com/switchboardxyz…",expanded_url:"https://x.com/switchboardxyz/status/1899467859052371978",indices:$R[226]=[1088,1111],url:"https://t.co/Ns6GcjHyDQ"},$R[227]={display_url:"jito.network/zh/restaking/v…",expanded_url:"https://www.jito.network/zh/restaking/vaults/",indices:$R[228]=[1158,1181],url:"https://t.co/RMFpBAnQn6"},$R[229]={display_url:"app.fragmetric.xyz/restake/",expanded_url:"https://app.fragmetric.xyz/restake/",indices:$R[230]=[1328,1351],url:"https://t.co/A0ZyUElA2b"},$R[231]={display_url:"x.com/jito_sol/statu…",expanded_url:"https://x.com/jito_sol/status/1891880407953502426",indices:$R[232]=[3465,3488],url:"https://t.co/VVcJpy3sQJ"},$R[233]={display_url:"switchboard.xyz",expanded_url:"https://switchboard.xyz/",indices:$R[234]=[3993,4016],url:"https://t.co/wZJm3FIL7k"},$R[235]={display_url:"x.com/switchboardxyz",expanded_url:"https://x.com/switchboardxyz",indices:$R[236]=[4021,4044],url:"https://t.co/Z6iKtPSnSO"}],user_mentions:$R[237]=[$R[238]={id_str:"1384968566743740418",indices:$R[239]=[691,706],screen_name:"switchboardxyz"},$R[240]={id_str:"1786285086926835712",indices:$R[241]=[1627,1638],screen_name:"fragmetric"}]},id:"Tm90ZVR3ZWV0OjE4OTk3NzQxNDQ0MTU1MTA1Mjg=",rest_id:"1899774144415510528",text:"Switchboard：Solana 生态首个再质押预言机协议\n（内附参与教程）\n\n在过去几年中，Solana 生态中真正带来财富效应的空投项目并不多，Jito 算是其中之一。2023 年 12 月，Jito 推出治理代币 JTO 并空投10% 代币份额给社区，随后上线币安，目前FDV依然超过20亿美金。\n\nJito 是 Solana 生态最重要的 MEV 基础设施之一，同时也是最大的流动性质押协议，其推出的 JitoSOL已成为 Solana 生态中的主流流动质押资产，而2024年推出的Jito 再质押协议（Restaking）更是让 Solana 进入了再质押时代。再质押是本轮周期中最具前景的创新概念之一，由 EigenLayer 在以太坊生态首创，随后 Jito 将这一新技术引入Solana。\n\nJito再质押框架包含两个主要组件：再质押程序和金库程序，可以将它们视为相互协作的两个独立实体，共同提供一个灵活、可扩展的基础设施，用于创建和管理：质押资产、金库收据代币（VRT）、节点共识网络（NCN，Node Consensus Network）。\n\n其中：VRT 是 Jito 在流动再质押代币领域的术语，类似 EigenLayer 生态的 LRT（Liquid Restaking Tokens）。NCN（节点共识网络） 则类似于 EigenLayer的主动验证服务（AVS），用于支持依赖 Jito 再质押解决方案的实体。\n\n今天要介绍的项目，就是 Solana 生态中第一个基于 Jito NCN启用大规模、多资产再质押的预言机协议：Switchboard @switchboardxyz\n\n简单说：Switchboard =预言机 + Jito 再质押（Restaking）\n\nSwitchboard 的模式非常创新，使得任何 Jito 资产持有者均可通过再质押赚取 SWTCH 代币奖励，同时为预言机网络提供安全保障。这也是全球首个支持跨资产再质押的预言机协议，是 Solana 生态的一次重大创新。\n\nSwitchboard昨晚宣布利用Fragmetric Vault 在 Jito 上启动再质押，目前有两种方式可以参与Switchboard NCN 再质押并获得 SWTCH 代币：\n1️⃣ 通过 Jito 参与\n2️⃣ 通过 Fragmetric 参与（Fragmetric 还未发币）\n\nFragmetric 是 Jito 在质押协议的提供商，最近刚获得 700 万美元融资，可以看作 Solana 生态下一波有潜力的项目之一！\n官方公告：https://t.co/Ns6GcjHyDQ\n\n二、如何参与？如何获得奖励？\n\n方式 1️⃣：通过 Jito 再质押\n1、进入jito金库https://t.co/RMFpBAnQn6\n2、选择对应资产并找到匹配的保险库\n3、存款后，你将收到 VRT作为凭证\n4、VRT的资产凭证可用于 DeFi 生态，同时还能获得额外收益\n\n方式 2️⃣：通过 Fragmetric 再质押（未发币）\n\n这个方式有多重预期：SWTCH 代币 + Fragmetric 未来空投机会\n\n1、打开https://t.co/A0ZyUElA2b，选择左上角的“重新质押”，然后选择以下两种资产之一：fragSOL 或 fragJTO，存入代币后按重新质押Restake。\n\n2、fragSOL 或 fragJTO资产可以随时在UNSTAKE赎回，但需要注意的是有3个不同周期大约 10 天解绑。\n\n2、Fragmetric 会优化收益，分配资产到 Jito 等平台，为用户提供质押收益 + MEV 奖励 + NCN 奖励，在 Fragmetric质押的资产会收到锁定的 SWTCH 代币，同时还能获得 F Points（可能是 Fragmetric 未来空投凭证！）\n\n3、Fragmetric @fragmetric 刚刚完成700 万美元种子轮融资，Finality Capital 和 Hashed 领投，个人投资人有Sol 创始人toly、 Sol基金会主席 Lily Liu、 Jito创始人 Lucasr 、Backpack 创始人Tristan、 Wintermute 联合创始人Yoann，从投资来看相当于把sol生态的核心协议的人都圈进来了，组局能力不错。\n\n三、项目及赛道概要\n\n1. 预言机赛道的重要性\n\n预言机是区块链的基础设施之一，估值普遍较高，例如：\n•Chainlink（LINK）：最早的预言机，已发展为跨链数据传输标准。\n•Band Protocol（BAND）：基于 Cosmos 生态，支持跨链预言机数据。\n•API3（API3）：去信任 API，连接现实世界 API 与区块链。\n•Pyth Network（PYTH）：高精度、高频市场数据供应商，服务 Solana、BNB Chain 等。\n\n速看了赛道的发展4个阶段，以及相关通过数据对比，能看到Switchboard的去中心化最高，Switchboard利用跨资产再质押（Restaking）的特性，推动预言机安全性和经济模型的去中心化升级。\n\n2. 项目情况\n\nSwitchboard 是 无许可、可定制、支持多链的预言机协议，可为 DeFi、NFT、GameFi 提供实时数据支持。预言机 + 再质押的模式开启新范式，Switchboard 作为 Solana 生态首个采用 Jito NCN（节点共识网络）的预言机协议，正推动去中心化数据基础设施进入新阶段。通过与 Jito 再质押（Restaking） 深度结合，它不仅提升了数据安全性，还让用户可通过再质押 Jito 资产（如 JitoSOL） 赚取额外奖励，同时保护 Switchboard 预言机网络。\n\n目前已保护40 亿美元以上资产，并为多个知名 dApp 提供服务，包括 MONAD 等。\n\n融资情况：\n2021 年 6 月：完成 350 万美元 种子轮融资。\n2023 年 5 月：完成 750 万美元 A 轮融资。\n累计融资 1100 万美元，投资者包括 Tribe Capital、RockawayX、CMS Holdings、Sui 开发商 Mysten Labs、Bixin Ventures等。\n\n3、项目模式及亮点\n\nSwitchboard 正在利用 Jito Network 的节点共识网络（NCN）在 Solana 上率先实现“再质押预言机”模式，开启预言机与再质押结合的新模式，这是预言机的首次。\n\n1. 创新模式概要\n\n预言机 + 再质押：Switchboard 是首个通过 Jito NCN 实现大规模、多资产再质押的预言机协议。它利用 Jito 的基础设施，不仅去中心化地保护预言机节点，还允许任何人将 Jito 支持的资产进行再质押，从而赚取 SWTCH 代币奖励来增强网络安全性。这是预言机领域的首次创新尝试。\n\nJito NCN 的作用：Jito NCN 是专为 Solana 生态设计的去中心化基础设施层，通过激励分布式节点运营商来提供安全、高效的数据服务。其优势类似于 Web2 云服务的去中心化替代方案，并与预言机、跨链通信、DeFi 质押等场景深度融合。\n\n2. 核心工作原理\n\n激励驱动的数据上链：利用 Jito NCN 的激励机制，Switchboard 能够确保数据快速、安全且抗操纵地上链。这一机制类似于 Eigenlayer 的主动验证服务（AVS），但专注于 Solana 的去中心化数据验证。\n\n再质押机制：用户可以通过质押 Jito 资产（例如 JitoSOL），来保护 Switchboard 预言机节点。质押不仅为网络提供安全保障，还能让参与者获得额外的 SWTCH 奖励。\n\n资产代币化：Jito 将质押资产转化为 VRT，这些凭证不仅证明了用户的质押行为，还可在 DeFi 生态中灵活使用，进一步提升资产利用率和流动性。\n\nTipRouter NCN 的分散优势：Switchboard 的预言机还利用 TipRouter NCN 分散和保护 MEV 小费分配，确保数据供应链的多样性与安全性。在这条推文里可以看到其正在利用 Jito (Re) staking 构建独特的预言机解决方案，使 Solana 开发人员可以轻松访问链上和链下数据\nhttps://t.co/VVcJpy3sQJ\n\n3. 模式亮点与优势\n\n-重新质押奖励与安全性提升：JitoSOL 持有者通过再质押保护预言机网络，既能获得原生质押收益，又可赚取 SWTCH 奖励。再质押的资产为数据供应提供了去中心化保障，显著降低了操纵风险。\n\n-依托 Jito 的强大基础设施：Switchboard 利用 Jito 广泛的质押资产和高性能节点网络，最大程度降低单点故障风险，通过 Jito NCN，预言机网络实现了高效、分布式的数据上链和验证，提升了整体安全性和速度。\n\n-多重收益模式：除了获得质押收益，用户还可以通过参与再质押获取额外的 SWTCH 代币奖励。未来，任何 Jito 支持的资产都有可能用于保护 Switchboard 网络，从而扩展用户的收益机会。\n\n-降低参与门槛：任何 JitoSOL 持有者都能简单一键参与，无需复杂操作。开放、无需许可的模式确保了广泛的社区参与和网络安全性。\n\nSwitchboard 与 Jito Network 的深度整合，这种模式不仅为 Solana 预言机生态提供了全新的安全保障机制，也为让SOL创造了更多参与和收益的机会，是去中心化预言机安全性与经济模型的一大突破。\n\n官网：https://t.co/wZJm3FIL7k\n\n推特：https://t.co/Z6iKtPSnSO"}}},quoted_tweet_results:$R[242]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE4OTE4ODA0MDc5NTM1MDI0MjY=",rest_id:"1891880407953502426",result:$R[243]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[244]=[],core:$R[245]={user_results:$R[246]={id:"VXNlclJlc3VsdHM6MTU1MjM3ODQ3NjU2MDM1NTMzMQ==",result:$R[247]={__typename:"User",avatar:$R[248]={image_url:"https://pbs.twimg.com/profile_images/1687112019563188224/mnbhxwox_normal.png"},core:$R[249]={name:"Jito",screen_name:"jito"},id:"VXNlcjoxNTUyMzc4NDc2NTYwMzU1MzMx",identity_profile_labels_highlighted_label:$R[250]={},privacy:$R[251]={protected:!1},profile_image_shape:"Square",relationship_counts:$R[252]={followers:103729,following:1429},rest_id:"1552378476560355331",super_follow_eligible:!1,tweet_counts:$R[253]={tweets:9448},verification:$R[254]={is_blue_verified:!0,verified_type:"Business"}}}},counts:$R[255]={bookmark_count:1,favorite_count:56,quote_count:6,reply_count:8,retweet_count:8},details:$R[256]={cashtag_entities:$R[257]=[],created_at_ms:1739894413000,display_text_range:$R[258]=[0,279],full_text:"Permissionless data feeds 🌍🔌 \n\n@switchboardxyz is building a unique oracle solution leveraging Jito (Re)staking to make on &amp; off-chain data easily accessible to Solana developers. Its oracles also help secure &amp; decentralize MEV tip distribution via the TipRouter NCN! 🛡 🫡 https://t.co/nEOR4cEFyG",hashtag_entities:$R[259]=[],smarttags:$R[260]=[],timestamp_entities:$R[261]=[]},edit_control:$R[262]={__typename:"EditControlInitial",edit_tweet_ids:$R[263]=["1891880407953502426"]},grok_translated_post_with_availability:$R[264]={is_available:!1},id:"VHdlZXQ6MTg5MTg4MDQwNzk1MzUwMjQyNg==",legacy:$R[265]={possibly_sensitive:!1},media_entities2:$R[266]=[$R[267]={expanded_url:"https://x.com/jito_sol/status/1891880407953502426/photo/1",ext_media_availability:$R[268]={status:"Available"},ext_playlists:$R[269]=[],features:$R[270]={},id_str:"1891880404400906240",indices:$R[271]=[280,303],media_url_https:"https://pbs.twimg.com/media/GkFPNEXWoAAo_3u.jpg",original_info:$R[272]={height:1388,width:1930},type:"photo"}],mention_entities:$R[273]=[$R[274]={id_str:"1384968566743740418",indices:$R[275]=[31,46],screen_name:"switchboardxyz"}],rest_id:"1891880407953502426",url_entities:$R[276]=[],views:$R[277]={count:"11017"}}},rest_id:"1899774144897745198",url_entities:$R[278]=[],views:$R[279]={count:"20748"}}}}},entry_id:"tweet-1899774144897745198",sort_index:"2103761698291712000"},$R[280]={content:$R[281]={__typename:"TimelineTimelineModule",client_event_info:$R[282]={component:"tweet"},display_type:"VerticalConversation",items:$R[283]=[$R[284]={entry_id:"conversationthread-1899789962083496274-tweet-1899789962083496274",item:$R[285]={__typename:"TimelineTimelineItem",client_event_info:$R[286]={component:"tweet",details:$R[287]={conversation_details:$R[288]={conversation_section:"HighQuality"},timelines_details:$R[289]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDczXzOAAAAAA=="}},element:"tweet"},content:$R[290]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[291]={id:"VHdlZXRSZXN1bHRzOjE4OTk3ODk5NjIwODM0OTYyNzQ=",rest_id:"1899789962083496274",result:$R[292]={__isTweetRes