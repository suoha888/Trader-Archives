et",cashtag_attachments:$R[78]=[],core:$R[79]={user_results:$R[80]={id:"VXNlclJlc3VsdHM6ODI1MTgzMTk5MTk4MjEyMDk2",result:$R[81]={__typename:"User",avatar:$R[82]={image_url:"https://pbs.twimg.com/profile_images/2011998329123770368/u69zr9Dx_normal.jpg"},core:$R[83]={name:"BITWU.ETH 🔆",screen_name:"Bitwux"},id:"VXNlcjo4MjUxODMxOTkxOTgyMTIwOTY=",identity_profile_labels_highlighted_label:$R[84]={},privacy:$R[85]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[86]={followers:386391,following:2376},rest_id:"825183199198212096",super_follow_eligible:!1,tweet_counts:$R[87]={tweets:37598},verification:$R[88]={is_blue_verified:!0}}}},counts:$R[89]={bookmark_count:27,favorite_count:162,quote_count:6,reply_count:85,retweet_count:7},details:$R[90]={cashtag_entities:$R[91]=[],created_at_ms:1764244908000,display_text_range:$R[92]=[0,143],full_text:"在火车行驶过程中，脑袋里回顾了这次 HK 的行程，我觉得还是会有很多启发，还是写下来！\n\n我想说：今天种下的每一个信任，会在未来以指数形式回报你——\n\nHK 晃悠了一圈，本来就是约了个爬山办卡，但是还是很多朋友约了各种局，然后就有了很多意想不到的收获，我想这就是出门的意义链接的好处吧！",hashtag_entities:$R[93]=[],smarttags:$R[94]=[],timestamp_entities:$R[95]=[]},edit_control:$R[96]={__typename:"EditControlInitial",edit_tweet_ids:$R[97]=["1994013787880345859"]},grok_translated_post_with_availability:$R[98]={is_available:!1},id:"VHdlZXQ6MTk5NDAxMzc4Nzg4MDM0NTg1OQ==",legacy:$R[99]={},media_entities2:$R[100]=[],mention_entities:$R[101]=[],note_tweet:$R[102]={is_expandable:!0,note_tweet_results:$R[103]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk0MDEzNzg3NzEyNjMwNzg0",result:$R[104]={__typename:"NoteTweet",entity_set:$R[105]={hashtags:$R[106]=[],symbols:$R[107]=[],urls:$R[108]=[],user_mentions:$R[109]=[$R[110]={id_str:"1372876871990272000",indices:$R[111]=[907,914],screen_name:"KuiGas"},$R[112]={id_str:"1338075202798809089",indices:$R[113]=[968,979],screen_name:"qinbafrank"},$R[114]={id_str:"1372876871990272000",indices:$R[115]=[984,991],screen_name:"KuiGas"},$R[116]={id_str:"1403881130802225152",indices:$R[117]=[1029,1037],screen_name:"BTCdayu"},$R[118]={id_str:"953156898118778880",indices:$R[119]=[1071,1085],screen_name:"KiwiCryptoBig"},$R[120]={id_str:"1627802277473038338",indices:$R[121]=[1123,1131],screen_name:"grvt_io"},$R[122]={id_str:"131887485",indices:$R[123]=[1135,1145],screen_name:"hong_grvt"}]},id:"Tm90ZVR3ZWV0OjE5OTQwMTM3ODc3MTI2MzA3ODQ=",rest_id:"1994013787712630784",text:"在火车行驶过程中，脑袋里回顾了这次 HK 的行程，我觉得还是会有很多启发，还是写下来！\n\n我想说：今天种下的每一个信任，会在未来以指数形式回报你——\n\nHK 晃悠了一圈，本来就是约了个爬山办卡，但是还是很多朋友约了各种局，然后就有了很多意想不到的收获，我想这就是出门的意义链接的好处吧！\n\n我之前看过一本书叫《别独自用餐》，每次外出都会让我感知到书的内容，所以先给大姐分享下：\n\n里面有几个我很认可的方向：\n\n1️⃣信任基础：\n\n你今天种下的每一个信任，会在未来以指数形式回报你：意思就是，真正强大的关系，在你需要之前就已经建立好了，日久见人心，靠谱不是你说出来的，而是别人看你做出来的，人与人的关系都是在平日慢慢建立起来的。\n反之，如果你做了不靠谱的事情，在别人那边埋下了种子，那么可能就很难再获取到别人的任何资源。\n我再次对于要诚以待人，用了更深的理解和认识。\n\n2️⃣主动连接，而不是被动等待：\n\n很多人社交的心态是“如果缘分到了就会认识朋友”。但作者说的一句我很认可的话：机会是自己去创造的，你必须主动迈向他人。主动意味着：敢开口，敢邀请、敢举办活动、敢向你欣赏的人靠近；\n很多人不敢向牛人靠近，很多人甚至不敢向别人求助，实际上人的基因里就是愿意帮助人的，主动连接一旦成为一种能力，你将会非常无敌。\n我建立社群也是给大家一个主动连接的平台，这可比财富密码管用。\n\n3️⃣先给予，再索取\n\n法拉奇的座右铭：“Be a giver, not a taker.”\n给予的类型包括：\n信息（洞察、资源）\n情绪（共情、支持）\n信任（无条件的善意）\n机会（引荐、合作）\n\n关键不是回报，而是：让自己成为别人真正愿意记住的人。而这个关键因素，就是需要线下见面，情绪和信任这些东西其实挺直观的，如果不能见到人很难产生。\n所以，别独自用餐的寓意也在这里。\n\n总之，每次外出一次，都加深了我对这本书的理解，用价值结交朋友，用信任创造未来，用诚心对待他人。\n\n而我，让人因为认识我而变得更好，我也会不断变强。\n\n所以感谢每次外出，我主动去见的，和愿意见我的很多朋友，大多数时候，你们给我的帮助要比我给你们的，要多得多！\n\n感谢 @KuiGas 在他的人生如此关键时刻，专门抽出时间陪我去一趟 HK 爬山和办理蓝狮子卡片，深深感动，记在心底！\n\n感谢 @qinbafrank 带我和 @KuiGas 爬狮子山，登顶后一览无余的中环的繁华和落日的剪影，美的动人心魄！\n\n感谢 @BTCdayu 给我关于资产配置、和美股投资以及美股如何定价逻辑的启发；\n\n感谢 @KiwiCryptoBig 陪我们晚上喝酒扯淡聊香港夜生活，虽然没有尝试，但是已经心生向往！\n\n感谢 @grvt_io 团队 @hong_grvt 抽出两个小时的时间一起探讨 Perp Dex 未来更大的可能性，学习到很多东西。"}}},rest_id:"1994013787880345859",url_entities:$R[124]=[],views:$R[125]={count:"196609"}}},rest_id:"1994048597726515502",url_entities:$R[126]=[],views:$R[127]={count:"255993"}}}}}}}],graphqlRequestStream:$R[128]=($R[129]=(stream) => new ReadableStream({ start(controller) {
	stream.on({
		next(value) {
			try {
				controller.enqueue(value);
			} catch (_error) {}
		},
		throw(value) {
			controller.error(value);
		},
		return() {
			try {
				controller.close();
			} catch (_error) {}
		}
	});
} }))($R[130]=($R[131]=() => {
	const buffer = [];
	const listeners = [];
	let alive = true;
	let success = false;
	let count = 0;
	const internal = {
		flush(value, mode, x) {
			for (x = 0; x < count; x++) if (listeners[x]) listeners[x][mode](value);
		},
		up(listener, x, z, current) {
			for (x = 0, z = buffer.length; x < z; x++) {
				current = buffer[x];
				if (!alive && x === z - 1) listener[success ? "return" : "throw"](current);
				else listener.next(current);
			}
		},
		on(listener, temp) {
			if (alive) {
				temp = count++;
				listeners[temp] = listener;
			}
			internal.up(listener);
			return () => {
				if (alive) {
					listeners[temp] = listeners[count];
					listeners[count--] = void 0;
				}
			};
		}
	};
	return {
		__SEROVAL_STREAM__: true,
		on(listener) {
			return internal.on(listener);
		},
		next(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "next");
			}
		},
		throw(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "throw");
				alive = false;
				success = false;
				listeners.length = 0;
			}
		},
		return(value) {
			if (alive) {
				buffer.push(value);
				internal.flush(value, "return");
				alive = false;
				success = true;
				listeners.length = 0;
			}
		}
	};
})())}})($R["tsr"])</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==" data-tsr-stream-part="">{let s=document.currentScript,p;while((p=s.previousElementSibling)&&p.hasAttribute('data-tsr-stream-part'))p.remove();s.remove()}</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==">document.currentScript.remove();/*$tsr-stream-boundary*/</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==">($R=>$R[130].next($R[132]={kind:"GraphQLRequestStream.Started",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1994048597726515502\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",name:"TweetDetail"}))($R["tsr"]);document.currentScript.remove()</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==">document.dispatchEvent(new Event("x-web:bootstrap-data"));document.currentScript.remove()</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==" id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==">($R=>$R[130].next($R[133]={kind:"GraphQLRequestStream.Completed",requestId:1,key:"6pz0_zAy52eyRU6PJk6AJg{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"cursor\":null,\"focalTweetId\":\"1994048597726515502\",\"rankingMode\":null,\"referrer\":null,\"withFocalTweet\":true}",result:$R[134]={kind:"Result.Ok",value:$R[135]={data:$R[136]={threaded_conversation_with_injections_v2:$R[137]={id:"LoggedOutRepliesProduct-Timeline",instructions:$R[138]=[$R[139]={__typename:"TimelineClearCache"},$R[140]={__typename:"TimelineAddEntries",entries:$R[141]=[$R[142]={content:$R[143]={__typename:"TimelineTimelineItem",client_event_info:$R[144]={component:"tweet",element:"tweet"},content:$R[145]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[146]={id:"VHdlZXRSZXN1bHRzOjE5OTQwNDg1OTc3MjY1MTU1MDI=",rest_id:"1994048597726515502",result:$R[147]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[148]=[],core:$R[149]={user_results:$R[150]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[151]={__typename:"User",avatar:$R[152]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[153]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[154]={},privacy:$R[155]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[156]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[157]={tweets:9451},verification:$R[158]={is_blue_verified:!0}}}},counts:$R[159]={bookmark_count:81,favorite_count:462,quote_count:5,reply_count:183,retweet_count:21},details:$R[160]={cashtag_entities:$R[161]=[],created_at_ms:1764253207000,display_text_range:$R[162]=[0,74],full_text:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。 https://t.co/lp7lhJgUGm",hashtag_entities:$R[163]=[],smarttags:$R[164]=[],timestamp_entities:$R[165]=[]},edit_control:$R[166]={__typename:"EditControlInitial",edit_tweet_ids:$R[167]=["1994048597726515502"]},grok_translated_post_with_availability:$R[168]={is_available:!1},id:"VHdlZXQ6MTk5NDA0ODU5NzcyNjUxNTUwMg==",legacy:$R[169]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[170]=[$R[171]={allow_download_status:$R[172]={allow_download:!0},expanded_url:"https://x.com/KuiGas/status/1994048597726515502/photo/1",ext_media_availability:$R[173]={status:"Available"},ext_playlists:$R[174]=[],features:$R[175]={},id_str:"1994048576662720515",indices:$R[176]=[75,98],media_url_https:"https://pbs.twimg.com/media/G6xInZTa0AMiI0h.jpg",original_info:$R[177]={height:3072,width:4096},type:"photo"}],mention_entities:$R[178]=[],note_tweet:$R[179]={is_expandable:!0,note_tweet_results:$R[180]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk0MDQ4NTk3NjEzMjY4OTkz",result:$R[181]={__typename:"NoteTweet",entity_set:$R[182]={hashtags:$R[183]=[],symbols:$R[184]=[],urls:$R[185]=[],user_mentions:$R[186]=[$R[187]={id_str:"1338075202798809089",indices:$R[188]=[396,407],screen_name:"qinbafrank"},$R[189]={id_str:"1403881130802225152",indices:$R[190]=[410,418],screen_name:"BTCdayu"},$R[191]={id_str:"953156898118778880",indices:$R[192]=[426,440],screen_name:"KiwiCryptoBig"}]},id:"Tm90ZVR3ZWV0OjE5OTQwNDg1OTc2MTMyNjg5OTM=",rest_id:"1994048597613268993",text:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。\n\n能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。\n\n1️⃣信任\n当他写下这句话的时候：\n\n“今天种下的每一个信任，会在未来以指数形式回报你。”\n\n我个人是毫无保留地认同的。\n\n比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，\n才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。\n\n也正是因为信任\nFrank @qinbafrank 大宇@BTCdayu  \nkiwi @KiwiCryptoBig  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，\n币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。\n\n2️⃣走出去\n\n如果你不走出去，\n你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。\n“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！\n\n我个人也得到很多的启发，所以未来我大概率会做几件事，\n\n1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。\n\n2、把专注地事情做好，给更多人提供价值，互通有无。\n\n3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/"}}},quoted_tweet_results:$R[193]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5OTQwMTM3ODc4ODAzNDU4NTk=",rest_id:"1994013787880345859",result:$R[194]={__isTweetResult:"Tweet",__typename:"Tweet",cashtag_attachments:$R[195]=[],core:$R[196]={user_results:$R[197]={id:"VXNlclJlc3VsdHM6ODI1MTgzMTk5MTk4MjEyMDk2",result:$R[198]={__typename:"User",avatar:$R[199]={image_url:"https://pbs.twimg.com/profile_images/2011998329123770368/u69zr9Dx_normal.jpg"},core:$R[200]={name:"BITWU.ETH 🔆",screen_name:"Bitwux"},id:"VXNlcjo4MjUxODMxOTkxOTgyMTIwOTY=",identity_profile_labels_highlighted_label:$R[201]={},privacy:$R[202]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[203]={followers:386391,following:2376},rest_id:"825183199198212096",super_follow_eligible:!1,tweet_counts:$R[204]={tweets:37598},verification:$R[205]={is_blue_verified:!0}}}},counts:$R[206]={bookmark_count:27,favorite_count:162,quote_count:6,reply_count:85,retweet_count:7},details:$R[207]={cashtag_entities:$R[208]=[],created_at_ms:1764244908000,display_text_range:$R[209]=[0,143],full_text:"在火车行驶过程中，脑袋里回顾了这次 HK 的行程，我觉得还是会有很多启发，还是写下来！\n\n我想说：今天种下的每一个信任，会在未来以指数形式回报你——\n\nHK 晃悠了一圈，本来就是约了个爬山办卡，但是还是很多朋友约了各种局，然后就有了很多意想不到的收获，我想这就是出门的意义链接的好处吧！",hashtag_entities:$R[210]=[],smarttags:$R[211]=[],timestamp_entities:$R[212]=[]},edit_control:$R[213]={__typename:"EditControlInitial",edit_tweet_ids:$R[214]=["1994013787880345859"]},grok_translated_post_with_availability:$R[215]={is_available:!1},id:"VHdlZXQ6MTk5NDAxMzc4Nzg4MDM0NTg1OQ==",legacy:$R[216]={},media_entities2:$R[217]=[],mention_entities:$R[218]=[],note_tweet:$R[219]={is_expandable:!0,note_tweet_results:$R[220]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk0MDEzNzg3NzEyNjMwNzg0",result:$R[221]={__typename:"NoteTweet",entity_set:$R[222]={hashtags:$R[223]=[],symbols:$R[224]=[],urls:$R[225]=[],user_mentions:$R[226]=[$R[227]={id_str:"1372876871990272000",indices:$R[228]=[907,914],screen_name:"KuiGas"},$R[229]={id_str:"1338075202798809089",indices:$R[230]=[968,979],screen_name:"qinbafrank"},$R[231]={id_str:"1372876871990272000",indices:$R[232]=[984,991],screen_name:"KuiGas"},$R[233]={id_str:"1403881130802225152",indices:$R[234]=[1029,1037],screen_name:"BTCdayu"},$R[235]={id_str:"953156898118778880",indices:$R[236]=[1071,1085],screen_name:"KiwiCryptoBig"},$R[237]={id_str:"1627802277473038338",indices:$R[238]=[1123,1131],screen_name:"grvt_io"},$R[239]={id_str:"131887485",indices:$R[240]=[1135,1145],screen_name:"hong_grvt"}]},id:"Tm90ZVR3ZWV0OjE5OTQwMTM3ODc3MTI2MzA3ODQ=",rest_id:"1994013787712630784",text:"在火车行驶过程中，脑袋里回顾了这次 HK 的行程，我觉得还是会有很多启发，还是写下来！\n\n我想说：今天种下的每一个信任，会在未来以指数形式回报你——\n\nHK 晃悠了一圈，本来就是约了个爬山办卡，但是还是很多朋友约了各种局，然后就有了很多意想不到的收获，我想这就是出门的意义链接的好处吧！\n\n我之前看过一本书叫《别独自用餐》，每次外出都会让我感知到书的内容，所以先给大姐分享下：\n\n里面有几个我很认可的方向：\n\n1️⃣信任基础：\n\n你今天种下的每一个信任，会在未来以指数形式回报你：意思就是，真正强大的关系，在你需要之前就已经建立好了，日久见人心，靠谱不是你说出来的，而是别人看你做出来的，人与人的关系都是在平日慢慢建立起来的。\n反之，如果你做了不靠谱的事情，在别人那边埋下了种子，那么可能就很难再获取到别人的任何资源。\n我再次对于要诚以待人，用了更深的理解和认识。\n\n2️⃣主动连接，而不是被动等待：\n\n很多人社交的心态是“如果缘分到了就会认识朋友”。但作者说的一句我很认可的话：机会是自己去创造的，你必须主动迈向他人。主动意味着：敢开口，敢邀请、敢举办活动、敢向你欣赏的人靠近；\n很多人不敢向牛人靠近，很多人甚至不敢向别人求助，实际上人的基因里就是愿意帮助人的，主动连接一旦成为一种能力，你将会非常无敌。\n我建立社群也是给大家一个主动连接的平台，这可比财富密码管用。\n\n3️⃣先给予，再索取\n\n法拉奇的座右铭：“Be a giver, not a taker.”\n给予的类型包括：\n信息（洞察、资源）\n情绪（共情、支持）\n信任（无条件的善意）\n机会（引荐、合作）\n\n关键不是回报，而是：让自己成为别人真正愿意记住的人。而这个关键因素，就是需要线下见面，情绪和信任这些东西其实挺直观的，如果不能见到人很难产生。\n所以，别独自用餐的寓意也在这里。\n\n总之，每次外出一次，都加深了我对这本书的理解，用价值结交朋友，用信任创造未来，用诚心对待他人。\n\n而我，让人因为认识我而变得更好，我也会不断变强。\n\n所以感谢每次外出，我主动去见的，和愿意见我的很多朋友，大多数时候，你们给我的帮助要比我给你们的，要多得多！\n\n感谢 @KuiGas 在他的人生如此关键时刻，专门抽出时间陪我去一趟 HK 爬山和办理蓝狮子卡片，深深感动，记在心底！\n\n感谢 @qinbafrank 带我和 @KuiGas 爬狮子山，登顶后一览无余的中环的繁华和落日的剪影，美的动人心魄！\n\n感谢 @BTCdayu 给我关于资产配置、和美股投资以及美股如何定价逻辑的启发；\n\n感谢 @KiwiCryptoBig 陪我们晚上喝酒扯淡聊香港夜生活，虽然没有尝试，但是已经心生向往！\n\n感谢 @grvt_io 团队 @hong_grvt 抽出两个小时的时间一起探讨 Perp Dex 未来更大的可能性，学习到很多东西。"}}},rest_id:"1994013787880345859",url_entities:$R[241]=[],views:$R[242]={count:"196609"}}},rest_id:"1994048597726515502",url_entities:$R[243]=[],views:$R[244]={count:"255993"}}}}},entry_id:"tweet-1994048597726515502",sort_index:"2103760954461257728"},$R[245]={content:$R[246]={__typename:"TimelineTimelineModule",client_event_info:$R[247]={component:"tweet"},display_type:"VerticalConversation",items:$R[248]=[$R[249]={entry_id:"conversationthread-1994225838754349477-tweet-1994225838754349477",item:$R[250]={__typename:"TimelineTimelineItem",client_event_info:$R[251]={component:"tweet",details:$R[252]={conversation_details:$R[253]={conversation_section:"HighQuality"},timelines_details:$R[254]={controller_data:"DAACDAAEDAABCgABAAAAAAAAAAEKAAIAAAAAAAAAAAoAAwAAAaDcysdJAAAAAA=="}},element:"tweet"},content:$R[255]={__isTimelineTimelineItemContent:"TimelineTweet",__typename:"TimelineTweet",display_type:"Tweet",tweet_results:$R[256]={id:"VHdlZXRSZXN1bHRzOjE5OTQyMjU4Mzg3NTQzNDk0Nzc