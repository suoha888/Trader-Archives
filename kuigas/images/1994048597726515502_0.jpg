name:"User",avatar:$R[358]={image_url:"https://pbs.twimg.com/profile_images/2010631877422616576/PJFmq4xR_normal.jpg"},core:$R[359]={name:"Cc笑茜茜｜Aster💛",screen_name:"Ccweb3hub"},id:"VXNlcjoxNzI5MDMzMTIzMTQzNTY1MzEy",identity_profile_labels_highlighted_label:$R[360]={label:$R[361]={badge:$R[362]={url:"https://pbs.twimg.com/profile_images/2008172513965326336/4MwHdULr_bigger.jpg"},description:"Aster 🥷",url:$R[363]={url:"https://twitter.com/Aster_DEX"},user_label_display_type:"Badge",user_label_type:"BusinessLabel"}},privacy:$R[364]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[365]={followers:13829,following:1148},rest_id:"1729033123143565312",super_follow_eligible:!1,tweet_counts:$R[366]={tweets:4475},verification:$R[367]={is_blue_verified:!0}}}},counts:$R[368]={bookmark_count:0,favorite_count:5,quote_count:0,reply_count:2,retweet_count:0},details:$R[369]={cashtag_entities:$R[370]=[],created_at_ms:1764293549000,display_text_range:$R[371]=[8,49],full_text:"@KuiGas 感谢丰密哥教我：做值得信任的朋友，保持专注力，和同频的人相处，不用太瘦，保持健康！",hashtag_entities:$R[372]=[],smarttags:$R[373]=[],timestamp_entities:$R[374]=[]},edit_control:$R[375]={__typename:"EditControlInitial",edit_tweet_ids:$R[376]=["1994217800370434266"]},grok_translated_post_with_availability:$R[377]={is_available:!1},id:"VHdlZXQ6MTk5NDIxNzgwMDM3MDQzNDI2Ng==",legacy:$R[378]={lang:"zh"},media_entities2:$R[379]=[],mention_entities:$R[380]=[$R[381]={id_str:"1372876871990272000",indices:$R[382]=[0,7],screen_name:"KuiGas"}],reply_to_results:$R[383]={__typename:"TweetResults",id:"VHdlZXRSZXN1bHRzOjE5OTQwNDg1OTc3MjY1MTU1MDI=",rest_id:"1994048597726515502"},reply_to_user_results:$R[384]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",rest_id:"1372876871990272000",result:$R[385]={__typename:"User",core:$R[386]={screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",rest_id:"1372876871990272000"}},rest_id:"1994217800370434266",url_entities:$R[387]=[],views:$R[388]={count:"2096"}}}}}}],metadata:$R[389]={conversation_metadata:$R[390]={all_tweet_ids:$R[391]=["1994217800370434266"],enable_deduplication:!0}}},entry_id:"conversationthread-1994217800370434266",sort_index:"2103760954461257698"}]},$R[392]={__typename:"TimelineTerminateTimeline",direction:"Top"},$R[393]={__typename:"TimelineTerminateTimeline",direction:"Bottom"}]},tweet_result_by_rest_id:$R[394]={id:"VHdlZXRSZXN1bHRzOjE5OTQwNDg1OTc3MjY1MTU1MDI=",rest_id:"1994048597726515502",result:$R[395]={__typename:"Tweet",core:$R[396]={user_results:$R[397]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[398]={__typename:"User",avatar:$R[399]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[400]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",profile_bio:$R[401]={description:"一切都是运气。记录亏Gas的历程，也记录亏钱路上的所思所想所惑。\n分享链上机会与个人判断，坚持以慢制快：成本＋赔率＋风险＋机会＋策略。\n\nhttps://t.co/x7s5UNLArg｜https://t.co/BKnvEl1f2q ｜https://t.co/GPiseM1ZWr｜\n\n建设33DAO @33daoweb3｜亏Club @kuiclub"}}}},counts:$R[402]={favorite_count:462,reply_count:183},details:$R[403]={full_text:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。 https://t.co/lp7lhJgUGm",smarttags:$R[404]=[]},id:"VHdlZXQ6MTk5NDA0ODU5NzcyNjUxNTUwMg==",note_tweet:$R[405]={note_tweet_results:$R[406]={id:"Tm90ZVR3ZWV0UmVzdWx0czoxOTk0MDQ4NTk3NjEzMjY4OTkz",result:$R[407]={__typename:"NoteTweet",id:"Tm90ZVR3ZWV0OjE5OTQwNDg1OTc2MTMyNjg5OTM=",text:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。\n\n能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。\n\n1️⃣信任\n当他写下这句话的时候：\n\n“今天种下的每一个信任，会在未来以指数形式回报你。”\n\n我个人是毫无保留地认同的。\n\n比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，\n才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。\n\n也正是因为信任\nFrank @qinbafrank 大宇@BTCdayu  \nkiwi @KiwiCryptoBig  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，\n币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。\n\n2️⃣走出去\n\n如果你不走出去，\n你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。\n“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！\n\n我个人也得到很多的启发，所以未来我大概率会做几件事，\n\n1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。\n\n2、把专注地事情做好，给更多人提供价值，互通有无。\n\n3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/"}}}}}}}}}))($R["tsr"]);document.currentScript.remove()</script><div hidden id="S:0"><div class="relative h-full overflow-hidden"><div class="h-full"><div class="mx-auto w-full max-w-[600px]" id="urt:conversation:1994048597726515502:none:default"><ul><li><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 px-horizontal py-vertical border-b border-gray-100" data-timeline-entry="" tabindex="-1"><article class="flex flex-col gap-1"><div class="flex flex-col gap-2"><div class="flex flex-col gap-3"><div class="flex gap-2"><div class="relative flex w-10 shrink-0 justify-center self-stretch"><div class="relative z-10"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none active" href="/KuiGas" data-status="active" aria-current="page"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-10 transition duration-200 hover:brightness-90"><img alt="@KuiGas" class="size-full object-cover" draggable="false" loading="lazy" sizes="40px" src="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg" srcSet="https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_mini.jpg 24w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg 48w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_bigger.jpg 73w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_x96.jpg 96w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_reasonably_small.jpg 128w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_200x200.jpg 200w, https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg 400w"/></div></a></div></div><div class="flex min-w-0 flex-1 flex-col"><div class="flex items-start justify-between gap-2"><div class="overflow-hidden flex flex-col items-start min-w-0"><span class="flex max-w-full min-w-0 shrink-0 items-center gap-1"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/KuiGas" data-status="active" aria-current="page"><div class="max-w-full text-body font-bold text-primary line-clamp-1 break-all min-w-0">丰密</div></a><div class="max-w-full text-body font-normal text-primary flex shrink-0 items-center gap-1"><span aria-label="Verified account" class="flex cursor-pointer items-center" role="button" tabindex="0" data-base-ui-click-trigger="" id="base-ui-_R_1v5c9pimb6b5336_" aria-haspopup="dialog" aria-expanded="false"><svg xmlns="http://www.w3.org/2000/svg" fill="none" data-icon="icon-verified-premium-color" viewBox="0 0 24 24" display="flex" role="img" width="1em" height="1em" aria-hidden="true" aria-label="Verified account" class="size-[1em] shrink-0"><path fill="#1d9bf0" fill-rule="evenodd" d="M12 1.75c1.4 0 2.62.87 3.34 2.19 1.44-.43 2.92-.17 3.91.81s1.24 2.47.81 3.91c1.32.72 2.2 1.94 2.2 3.34s-.88 2.62-2.2 3.34c.43 1.44.18 2.92-.81 3.9-.99 1-2.47 1.25-3.91.82-.72 1.32-1.94 2.19-3.34 2.19s-2.62-.87-3.34-2.2c-1.44.44-2.92.18-3.9-.8-1-.99-1.24-2.47-.82-3.91-1.32-.72-2.19-1.95-2.19-3.34 0-1.4.87-2.62 2.2-3.34-.43-1.44-.18-2.92.8-3.9.99-1 2.47-1.25 3.91-.82.72-1.32 1.95-2.19 3.34-2.19M10.45 13.3l-2.23-2.25-1.42 1.4 3.7 3.75 6.24-6.77-1.47-1.36z" clip-rule="evenodd"></path></svg></span></div></span><span class="flex min-w-0 items-center gap-2"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring text-[length:inherit] font-[inherit] text-[color:inherit] max-w-full min-w-0 active" href="/KuiGas" data-status="active" aria-current="page"><span class="max-w-full text-body font-normal text-secondary line-clamp-1 [font-feature-settings:&#x27;ss01&#x27;]">@KuiGas</span></a></span></div><div class="flex shrink-0 items-center gap-1 whitespace-nowrap"><button data-slot="xds-menu-trigger" type="button" tabindex="0" aria-haspopup="menu" aria-expanded="false" id="base-ui-_R_qqc9pimb6b5336_" aria-label="More" class="group relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full font-medium select-none transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-70 aria-disabled:cursor-not-allowed aria-disabled:opacity-70 h-8 min-w-8 text-subtext1 [&amp;_svg:not([class*=&#x27;size-&#x27;])]:size-4 text-primary hover:bg-btn-ghost-hover aria-expanded:bg-btn-ghost-hover active:bg-btn-ghost-pressed w-8 px-0 [&amp;_svg]:transition-transform [&amp;_svg]:duration-200 group-hover:[&amp;_svg]:scale-110 -my-2 shrink-0" style="border-radius:9999px"><span class="pointer-events-none absolute inset-0 flex items-center justify-center transition-opacity opacity-0"><svg aria-hidden="true" class="animate-spin size-4 text-[color:inherit]" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" fill="currentColor"></path></svg></span><span class="inline-flex items-center whitespace-nowrap" style="opacity:1"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" data-icon="icon-more" viewBox="0 0 24 24" width="1em" height="1em" display="flex" role="img" aria-hidden="true"><path d="M3 12c0-1.1.9-2 2-2s2 .9 2 2-.9 2-2 2-2-.9-2-2zm9 2c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm7 0c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2z"></path></svg></span></button></div></div></div></div><div dir="auto" class="font-chirp max-w-full whitespace-pre-wrap break-words text-text text-body font-normal"><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">我即将迎来自己人生中最大的一次空投🪂

但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。

能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。

1️⃣信任
当他写下这句话的时候：

“今天种下的每一个信任，会在未来以指数形式回报你。”

我个人是毫无保留地认同的。

比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，
才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。

也正是因为信任
Frank </span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-[length:inherit] font-[inherit] text-brand" href="/qinbafrank">@<!-- -->qinbafrank</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit"> 大宇</span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-[length:inherit] font-[inherit] text-brand" href="/BTCdayu">@<!-- -->BTCdayu</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">  
kiwi </span><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring hover:underline max-w-full text-[length:inherit] font-[inherit] text-brand" href="/KiwiCryptoBig">@<!-- -->KiwiCryptoBig</a><span class="font-chirp max-w-full whitespace-pre-wrap break-words text-inherit text-[length:inherit] font-inherit">  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，
币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。

2️⃣走出去

如果你不走出去，
你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。
“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！

我个人也得到很多的启发，所以未来我大概率会做几件事，

1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。

2、把专注地事情做好，给更多人提供价值，互通有无。

3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/</span></div><div class="flex flex-col gap-1 empty:hidden"><div class="relative overflow-hidden border border-gray-200 rounded-md" style="aspect-ratio:1.3333333333333333"><div class="relative h-full w-full"><div inert="" class="h-full w-full"><a class="rounded-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] block h-full w-full cursor-zoom-in appearance-none border-none bg-transparent p-0 text-inherit" aria-label="Image" href="/KuiGas/status/1994048597726515502/photo/1"><img fetchPriority="high" height="3072" width="4096" alt="" class="w-full" decoding="async" loading="eager" sizes="(max-width: 600px) calc(100vw - 80px), 600px" src="https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&amp;name=large" srcSet="https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&amp;name=small 680w, https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&amp;name=medium 1200w, https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&amp;name=large 2048w"/></a></div><a aria-label="View media" class="absolute inset-0 z-10" href="/KuiGas/status/1994048597726515502/photo/1"></a></div></div><div class="outline-blue-500 transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 rounded-2xl border border-gray-200 overflow-hidden cursor-pointer hover:bg-gray-100/50" data-href="/Bitwux/status/1994013787880345859" data-timeline-entry="" role="link" tabindex="0"><article><div class="flex flex-col gap-1 p-3"><div class="flex min-w-0 flex-1 flex-col gap-1"><div class="flex min-w-0 items-center gap-1"><a class="focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring max-w-full text-[length:inherit] font-[inherit] text-[color:inherit] rounded-none" href="/Bitwux"><div class="shrink-0 overflow-hidden bg-neutral-300 rounded-full size-6 transition duration-200 hover:brightness-90"><img alt="@Bitwux" class="size-full object-cover" draggable="fal