114 178,155 112,248 h 240 s 185,89 245,27 C 237,22 126,132 91,100 h 36 s 208,163 40,170" fill="#1d9bf008"></path></g></svg></div><script nonce="NkWdJyOxqajk9hSTO1Ex3A==" data-tsr-stream-part="">(self.$R=self.$R||{})["tsr"]=[];self.$_TSR={h(){this.hydrated=!0,this.c()},e(){this.streamEnded=!0,this.c()},c(){this.hydrated&&this.streamEnded&&(delete self.$_TSR,delete self.$R.tsr)},p(e){this.initialized?e():this.buffer.push(e)},buffer:[]}</script><script nonce="NkWdJyOxqajk9hSTO1Ex3A==" data-tsr-stream-part="">$_TSR.router=($R=>$R[0]={manifest:void 0,matches:$R[1]=[$R[2]={i:"__root__␀{}",u:1790410671222,s:"success",b:$R[3]={showsLoggedOutTrends:!0},l:$R[4]={guideTrends:void 0},ssr:!0},$R[5]={i:"␀$username␀KuiGas",u:1790410671222,s:"success",ssr:!0},$R[6]={i:"␀$username␀status␀$id␀␀KuiGas␀status␀1994048597726515502␀{}",u:1790410671587,s:"success",l:$R[7]={articleDocument:null,conversationOptions:$R[8]={rankingMode:void 0},emitTweetSchema:!1,metadata:$R[9]={authorAvatarUrl:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg",authorDescription:void 0,authorName:"丰密",focalTweetId:"1994048597726515502",hasArticle:!1,headMetadata:$R[10]={appLinkUrl:"twitter://status?id=1994048597726515502",articleTags:void 0,author:$R[11]={image:$R[12]={alt:"丰密 profile picture",url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_400x400.jpg"},screenName:"KuiGas",url:"https://x.com/KuiGas"},bodyText:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。\n\n能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。\n\n1️⃣信任\n当他写下这句话的时候：\n\n“今天种下的每一个信任，会在未来以指数形式回报你。”\n\n我个人是毫无保留地认同的。\n\n比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，\n才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。\n\n也正是因为信任\nFrank @qinbafrank 大宇@BTCdayu  \nkiwi @KiwiCryptoBig  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，\n币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。\n\n2️⃣走出去\n\n如果你不走出去，\n你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。\n“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！\n\n我个人也得到很多的启发，所以未来我大概率会做几件事，\n\n1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。\n\n2、把专注地事情做好，给更多人提供价值，互通有无。\n\n3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/",canonicalPath:"/KuiGas/status/1994048597726515502",canonicalUrl:"https://x.com/KuiGas/status/1994048597726515502",description:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。\n\n能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。\n\n1️⃣信任\n当他写下这句话的时候：\n\n“今天种下的每一个信任，会在未来以指数形式回报你。”\n\n我个人是毫无保留地认同的。\n\n比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，\n才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。\n\n也正是因为信任\nFrank @qinbafrank 大宇@BTCdayu  \nkiwi @KiwiCryptoBig  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，\n币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。\n\n2️⃣走出去\n\n如果你不走出去，\n你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。\n“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！\n\n我个人也得到很多的启发，所以未来我大概率会做几件事，\n\n1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。\n\n2、把专注地事情做好，给更多人提供价值，互通有无。\n\n3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/",faviconUrl:void 0,hasAiGeneratedMedia:void 0,image:$R[13]={alt:void 0,height:3072,isContent:!0,preloadUrl:"https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&name=large",preloadSrcSet:"https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&name=small 680w, https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&name=medium 1200w, https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&name=large 2048w",preloadSizes:"(max-width: 600px) calc(100vw - 80px), 600px",url:"https://pbs.twimg.com/media/G6xInZTa0AMiI0h?format=webp&name=large",width:4096},isAdult:!1,isArticle:!1,mediaPreviewImageUrl:void 0,publishedTime:"2025-11-27T14:20:07.000Z",replyCount:183,schema:$R[14]={citation:$R[15]={"@id":"https://x.com/Bitwux/status/1994013787880345859","@type":"SocialMediaPosting",author:$R[16]={"@type":"Person",alternateName:"Bitwux",identifier:"825183199198212096",image:"https://pbs.twimg.com/profile_images/2011998329123770368/u69zr9Dx_400x400.jpg",name:"BITWU.ETH 🔆",url:"https://x.com/Bitwux"},datePublished:"2025-11-27T12:01:48.000Z",identifier:"1994013787880345859",url:"https://x.com/Bitwux/status/1994013787880345859",engagement:$R[17]=[$R[18]={action:"LikeAction",name:"Likes",url:"https://x.com/Bitwux/status/1994013787880345859/likes",count:162},$R[19]={action:"ShareAction",name:"Retweets",url:"https://x.com/Bitwux/status/1994013787880345859/retweets",count:7},$R[20]={action:"ReplyAction",name:"Replies",url:null,count:85},$R[21]={action:"ViewAction",name:"Views",count:196609}],text:"在火车行驶过程中，脑袋里回顾了这次 HK 的行程，我觉得还是会有很多启发，还是写下来！\n\n我想说：今天种下的每一个信任，会在未来以指数形式回报你——\n\nHK 晃悠了一圈，本来就是约了个爬山办卡，但是还是很多朋友约了各种局，然后就有了很多意想不到的收获，我想这就是出门的意义链接的好处吧！\n\n我之前看过一本书叫《别独自用餐》，每次外出都会让我感知到书的内容，所以先给大姐分享下：\n\n里面有几个我很认可的方向：\n\n1️⃣信任基础：\n\n你今天种下的每一个信任，会在未来以指数形式回报你：意思就是，真正强大的关系，在你需要之前就已经建立好了，日久见人心，靠谱不是你说出来的，而是别人看你做出来的，人与人的关系都是在平日慢慢建立起来的。\n反之，如果你做了不靠谱的事情，在别人那边埋下了种子，那么可能就很难再获取到别人的任何资源。\n我再次对于要诚以待人，用了更深的理解和认识。\n\n2️⃣主动连接，而不是被动等待：\n\n很多人社交的心态是“如果缘分到了就会认识朋友”。但作者说的一句我很认可的话：机会是自己去创造的，你必须主动迈向他人。主动意味着：敢开口，敢邀请、敢举办活动、敢向你欣赏的人靠近；\n很多人不敢向牛人靠近，很多人甚至不敢向别人求助，实际上人的基因里就是愿意帮助人的，主动连接一旦成为一种能力，你将会非常无敌。\n我建立社群也是给大家一个主动连接的平台，这可比财富密码管用。\n\n3️⃣先给予，再索取\n\n法拉奇的座右铭：“Be a giver, not a taker.”\n给予的类型包括：\n信息（洞察、资源）\n情绪（共情、支持）\n信任（无条件的善意）\n机会（引荐、合作）\n\n关键不是回报，而是：让自己成为别人真正愿意记住的人。而这个关键因素，就是需要线下见面，情绪和信任这些东西其实挺直观的，如果不能见到人很难产生。\n所以，别独自用餐的寓意也在这里。\n\n总之，每次外出一次，都加深了我对这本书的理解，用价值结交朋友，用信任创造未来，用诚心对待他人。\n\n而我，让人因为认识我而变得更好，我也会不断变强。\n\n所以感谢每次外出，我主动去见的，和愿意见我的很多朋友，大多数时候，你们给我的帮助要比我给你们的，要多得多！\n\n感谢 @KuiGas 在他的人生如此关键时刻，专门抽出时间陪我去一趟 HK 爬山和办理蓝狮子卡片，深深感动，记在心底！\n\n感谢 @qinbafrank 带我和 @KuiGas 爬狮子山，登顶后一览无余的中环的繁华和落日的剪影，美的动人心魄！\n\n感谢 @BTCdayu 给我关于资产配置、和美股投资以及美股如何定价逻辑的启发；\n\n感谢 @KiwiCryptoBig 陪我们晚上喝酒扯淡聊香港夜生活，虽然没有尝试，但是已经心生向往！\n\n感谢 @grvt_io 团队 @hong_grvt 抽出两个小时的时间一起探讨 Perp Dex 未来更大的可能性，学习到很多东西。"}},socialTitle:"丰密 (@KuiGas) on X",title:"丰密 on X: \"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。\n\n能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。\n\n1️⃣信任\n当他写下这句话的时候：\n\n“今天种下的每一个信任，会在未来以指数形式回报你。”\n\n我个人是毫无保留地认同的。\n\n比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，\n才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。\n\n也正是因为信任\nFrank @qinbafrank 大宇@BTCdayu  \nkiwi @KiwiCryptoBig  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，\n币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。\n\n2️⃣走出去\n\n如果你不走出去，\n你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。\n“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！\n\n我个人也得到很多的启发，所以未来我大概率会做几件事，\n\n1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。\n\n2、把专注地事情做好，给更多人提供价值，互通有无。\n\n3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/\""},replyCount:183,screenName:"KuiGas",status:"available",text:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。\n\n能和一个真正走过底层周期、穿越过低谷、靠自己一步一步爬上来的人，在同一个时间窗口里，碎片化、毫无保留地深度交流几天，会在认知、判断、定力、格局上被持续“校准”，也会在很多关键问题与状态上，得到那种醍醐灌顶式的答案。\n\n1️⃣信任\n当他写下这句话的时候：\n\n“今天种下的每一个信任，会在未来以指数形式回报你。”\n\n我个人是毫无保留地认同的。\n\n比如这次，始于信任，经我推荐，走的是 VIP 通道直接办理（这是非常敏感的话题），鉴于我有丰富的撸汇丰经验，可以分享各种花式玩法给吴老师。也正是因为我有着比较丰富的“撸汇丰”实操经验，\n才能把各种真实可行的玩法、路径、套路与风控逻辑、，组合、原汁原味地分享给吴老师。\n\n也正是因为信任\nFrank @qinbafrank 大宇@BTCdayu  \nkiwi @KiwiCryptoBig  分别2天陪我们喝酒到凌晨，给我们分享当前的资产配置、美股投资逻辑，\n币圈与美股之间的平衡，甚至延伸到：家庭规划、生活方式、健身计划，任何一个点get到能都让我们彼此变得更「好」。\n\n2️⃣走出去\n\n如果你不走出去，\n你永远只会活在自己的信息茧房里。很多项目，很多策略，很多理解，每个人的认知与高密度的研究都不一样，细节对细节的真实互动中迭代。\n“走出去”变成一次超预期的链接，交流、认知碰撞，有可能是“机会”，也有可能是命运的拐点。就像吴老师说的第一点，「主动连接」才有可能性，按照撸毛法则，撸了不一定有，不撸肯定没有！\n\n我个人也得到很多的启发，所以未来我大概率会做几件事，\n\n1、定期主动约见值得「信任」的人，德不孤、必有邻。做好超级个体的同时，链接更多牛人，学习请教。\n\n2、把专注地事情做好，给更多人提供价值，互通有无。\n\n3、瘦下来，让自己帅一点，年轻的心态+更年轻的身体，拒绝油腻/"},isSinglePost:!1},ssr:!0}],dehydratedData:$R[22]={messagesBeforeDehydration:$R[23]=[$R[24]={kind:"GraphQLRequestStream.Started",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1994048597726515502\"}",name:"TweetResultByRestId"},$R[25]={kind:"GraphQLRequestStream.Completed",requestId:0,key:"TMzIJ2Rj1m25hqaHgZOkvw{\"__relay_internal__pv__appviewerisloggedinprovider\":false,\"restId\":\"1994048597726515502\"}",result:$R[26]={kind:"Result.Ok",value:$R[27]={data:$R[28]={tweet_result_by_rest_id:$R[29]={id:"VHdlZXRSZXN1bHRzOjE5OTQwNDg1OTc3MjY1MTU1MDI=",rest_id:"1994048597726515502",result:$R[30]={__typename:"Tweet",cashtag_attachments:$R[31]=[],core:$R[32]={user_results:$R[33]={id:"VXNlclJlc3VsdHM6MTM3Mjg3Njg3MTk5MDI3MjAwMA==",result:$R[34]={__typename:"User",avatar:$R[35]={image_url:"https://pbs.twimg.com/profile_images/1951510357769592890/oim_Z9Fl_normal.jpg"},core:$R[36]={name:"丰密",screen_name:"KuiGas"},id:"VXNlcjoxMzcyODc2ODcxOTkwMjcyMDAw",identity_profile_labels_highlighted_label:$R[37]={},privacy:$R[38]={protected:!1},profile_image_shape:"Circle",relationship_counts:$R[39]={followers:107778,following:1077},rest_id:"1372876871990272000",super_follow_eligible:!1,tweet_counts:$R[40]={tweets:9451},verification:$R[41]={is_blue_verified:!0}}}},counts:$R[42]={bookmark_count:81,favorite_count:462,quote_count:5,reply_count:183,retweet_count:21},details:$R[43]={cashtag_entities:$R[44]=[],created_at_ms:1764253207000,display_text_range:$R[45]=[0,74],full_text:"我即将迎来自己人生中最大的一次空投🪂\n\n但即便如此，我依然会选择在这个时间段，陪吴老师待上几天。这种机会真的挺难的，比任何一次空投都来得更高质量。。 https://t.co/lp7lhJgUGm",hashtag_entities:$R[46]=[],smarttags:$R[47]=[],timestamp_entities:$R[48]=[]},edit_control:$R[49]={__typename:"EditControlInitial",edit_tweet_ids:$R[50]=["1994048597726515502"]},grok_translated_post_with_availability:$R[51]={is_available:!1},id:"VHdlZXQ6MTk5NDA0ODU5NzcyNjUxNTUwMg==",legacy:$R[52]={lang:"zh",possibly_sensitive:!1},media_entities2:$R[53]=[$R[54]={allow_download_status:$R[55]={allow_download:!0},expanded_url:"https://x.com/KuiG